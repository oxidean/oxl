package main

// X4: std/crypto/ed25519 — RFC 8032 §7.1 test vectors 1-3 plus
// tamper, non-canonical and malformed rejects.
import "std/crypto/ed25519"

import "std/encoding/hex"

import "std/testing"

// hx decodes a hex literal — fixture helper
fn hx(s: str) -> own []byte {
    [b, e] = hex.decode(s)
    testing.expect(e == nil, "hex decode")
    return b
}

fn test_ed25519() {
    // RFC 8032 TEST 1 — empty message
    e := ed25519.verify(hx("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"), hx(""), hx("e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"))
    testing.expect(e == nil, "rfc8032 test 1")

    // TEST 2 — one-byte message 0x72
    e = ed25519.verify(hx("3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"), hx("72"), hx("92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00"))
    testing.expect(e == nil, "rfc8032 test 2")

    // TEST 3 — two-byte message 0xaf82
    e = ed25519.verify(hx("fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025"), hx("af82"), hx("6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a"))
    testing.expect(e == nil, "rfc8032 test 3")

    // tamper rejects: signature byte flip, R byte flip, wrong
    // message, wrong key
    sig := hx("92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00")
    pk := hx("3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c")
    msg := hx("72")
    sig[40] = sig[40] ^ 1
    e = ed25519.verify(pk, msg, sig)
    testing.expect(e != nil, "s tamper accepted")
    sig2 := hx("92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00")
    sig2[5] = sig2[5] ^ 1
    e = ed25519.verify(pk, msg, sig2)
    testing.expect(e != nil, "r tamper accepted")
    e = ed25519.verify(pk, hx("73"), sig2[0:64])
    testing.expect(e != nil, "wrong message accepted")
    e = ed25519.verify(hx("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"), msg, sig2)
    testing.expect(e != nil, "wrong key accepted")

    // malformed: short key, short sig, non-canonical y (y = p)
    e = ed25519.verify(pk[0:16], msg, sig2)
    testing.expect(e != nil, "short key accepted")
    e = ed25519.verify(pk, msg, sig2[0:32])
    testing.expect(e != nil, "short sig accepted")
    e = ed25519.verify(hx("edffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff7f"), msg, sig2)
    testing.expect(e != nil, "non-canonical y accepted")
    // S >= L rejects (S = L exactly)
    sig3 := hx("92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69daedd3f55c1a631258d69cf7a2def9de1400000000000000000000000000000010")
    e = ed25519.verify(pk, msg, sig3)
    testing.expect(e != nil, "S >= L accepted")
}
