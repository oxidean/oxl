package main

import "std/bytes"

import "std/io"

fn leak() -> io.Reader {
    h := new(bytes.Buffer)
    buf := bytes.newbuffer()
    r := h.asreader()
    i := 0
    for i < 2 {
        if i == 1 {
            return r
        }
        r = buf.asreader()
        i = i + 1
    }
    return h.asreader()
}

fn main() {}
