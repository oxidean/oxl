}

fn hpack_huffman_tree() -> HpackHuffman {
    cap := 8192
    tree := HpackHuffman{left: mkslice(int, cap), right: mkslice(int, cap), symbol: mkslice(int, cap), size: 1}
    lengths := hpack_huffman_lengths()
    counts := mkslice(int, 31)
    next_code := mkslice(int, 31)
    i := 0
    for i < len(lengths) {
        counts[lengths[i]] = counts[lengths[i]] + 1
        i = i + 1
    }
    code := 0
    bits := 1
    for bits <= 30 {
        code = (code + counts[bits - 1]) * 2
        next_code[bits] = code
        bits = bits + 1
    }
    sym := 0
    for sym < len(lengths) {
        width := lengths[sym]
        current := next_code[width]
        next_code[width] = current + 1
        divisor := hpack_pow2(width - 1)
        node := 0
        j := 0
        for j < width {
            bit := current / divisor % 2
            divisor = divisor / 2
            child := 0
            if bit == 0 {
                child = tree.left[node]
                if child == 0 {
                    if tree.size >= cap {
                        tree.size = -1
                        return tree
                    }
                    child = tree.size
                    tree.size = tree.size + 1
                    tree.left[node] = child
                }
            } else {
                child = tree.right[node]
                if child == 0 {
                    if tree.size >= cap {
                        tree.size = -1
                        return tree
                    }
                    child = tree.size
                    tree.size = tree.size + 1
                    tree.right[node] = child
                }
            }
            node = child
            j = j + 1
        }
        tree.symbol[node] = sym + 1
        sym = sym + 1
    }
    return tree
}

let HPACK_HUFFMAN_TREE = hpack_huffman_tree()

fn hpack_huffman_decode(data: []byte) -> [str, err] {
    if len(data) > 1048576 {
        return "", errors.new("http2: HPACK Huffman string too large")
    }
    tree := HPACK_HUFFMAN_TREE
    if tree.size <= 0 || tree.size > len(tree.left) {
        return "", errors.new("http2: invalid HPACK Huffman table")
    }
    out := mkslice(byte, 0)
    node := 0
    tail := 0
    tail_len := 0
    i := 0
    for i < len(data) {
        bitpos := 7
        for bitpos >= 0 {
            bit := data[i] / hpack_pow2(bitpos) % 2
            child := tree.left[node]
            if bit != 0 {
                child = tree.right[node]
            }
            if child == 0 {
                return "", errors.new("http2: invalid HPACK Huffman code")
            }
            node = child
            tail = (tail * 2 + bit) % 256
            tail_len = tail_len + 1
            value := tree.symbol[node]
            if value != 0 {
                symbol := value - 1
                if symbol == 256 {
                    return "", errors.new("http2: HPACK Huffman EOS in string")
                }
                out = push(out, symbol)
                if len(out) > 1048576 {
                    return "", errors.new("http2: decoded HPACK Huffman string too large")
                }
                node = 0
                tail = 0
                tail_len = 0
            }
            bitpos = bitpos - 1
        }
        i = i + 1
    }
    if tail_len > 7 || tail != hpack_pow2(tail_len) - 1 {
        return "", errors.new("http2: invalid HPACK Huffman padding")
    }
    return out as str, nil
}

fn hpack_int(data: []byte, pos: int, prefix: int) -> [HpackInt, err] {
    if pos < 0 || pos >= len(data) || prefix < 1 || prefix > 8 {
        return HpackInt{value: 0, next: pos}, errors.new("http2: truncated HPACK integer")
    }
    mask := hpack_pow2(prefix) - 1
    value := data[pos] & mask
    next := pos + 1
    if value < mask {
        return HpackInt{value: value, next: next}, nil
    }
    shift := 0
    for true {
        if next >= len(data) || shift > 28 {
            return HpackInt{value: 0, next: next}, errors.new("http2: invalid HPACK integer")
        }
        b := data[next]
        part := (b & 127) * hpack_pow2(shift)
        if part > 2147483647 - value {
            return HpackInt{value: 0, next: next}, errors.new("http2: HPACK integer overflow")
        }
        value = value + part
        next = next + 1
        if (b & 128) == 0 {
            return HpackInt{value: value, next: next}, nil
        }
        shift = shift + 7
    }
    return HpackInt{value: 0, next: next}, errors.new("http2: invalid HPACK integer")
}

fn hpack_string(data: []byte, pos: int) -> [HpackString, err] {
    if pos < 0 || pos >= len(data) {
        return HpackString{value: "", next: pos}, errors.new("http2: truncated HPACK string")
    }
    huffman := (data[pos] & 128) != 0
    [length_result, e] = hpack_int(data, pos, 7)
    if e != nil {
        return HpackString{value: "", next: length_result.next}, e
    }
    length := length_result.value
    next := length_result.next
    if length > len(data) - next {
        return HpackString{value: "", next: next}, errors.new("http2: truncated HPACK string")
    }
    if huffman {
        [decoded, de] = hpack_huffman_decode(data[next:next + length])
        if de != nil {
            return HpackString{value: "", next: next + length}, de
        }
        return HpackString{value: decoded, next: next + length}, nil
    }
    return HpackString{value: data[next:next + length] as str, next: next + length}, nil
}

fn hpack_lookup(d: ref Decoder, index: int) -> [Header, err] {
    if index <= 0 {
        return Header{name: "", value: ""}, errors.new("http2: invalid HPACK index")
    }
    if index <= 61 {
        return Header{name: hpack_static_name(index), value: hpack_static_value(index)}, nil
    }
    off := index - 62
    if off >= len(d.dynamic) {
        return Header{name: "", value: ""}, errors.new("http2: HPACK index outside dynamic table")
    }
    return d.dynamic[len(d.dynamic) - 1 - off], nil
}

fn hpack_evict(d: mut Decoder) {
    for d.dynamic_size > d.max_size && len(d.dynamic) > 0 {
        first := d.dynamic[0]
        d.dynamic_size = d.dynamic_size - len(first.name) - len(first.value) - 32
        d.dynamic = d.dynamic[1:]
    }
}

fn hpack_add(d: mut Decoder, header: Header) {
    size := len(header.name) + len(header.value) + 32
    if size > d.max_size {
        d.dynamic = mkslice(Header, 0)
        d.dynamic_size = 0
        return
    }
    d.dynamic = push(d.dynamic, header)
    d.dynamic_size = d.dynamic_size + size
    hpack_evict(d)
}

fn decode_headers(d: mut Decoder, block: []byte) -> [[]Header, err] {
    if len(block) > d.max_header_list {
        return mkslice(Header, 0), errors.new("http2: HPACK header block too large")
    }
    headers := mkslice(Header, 0)
    pos := 0
    total := 0
    field_seen := false
    for pos < len(block) {
        b := block[pos]
        if (b & 128) != 0 {
            [ir1, e1] = hpack_int(block, pos, 7)
            if e1 != nil {
                return mkslice(Header, 0), e1
            }
            [header1, le1] = hpack_lookup(d, ir1.value)
            if le1 != nil {
                return mkslice(Header, 0), le1
            }
            if !hpack_valid_header(header1) {
                return mkslice(Header, 0), errors.new("http2: invalid decoded header field")
            }
            total = total + len(header1.name) + len(header1.value) + 32
            if total > d.max_header_list {
                return mkslice(Header, 0), errors.new("http2: HPACK header list too large")
            }
            headers = push(headers, header1)
            pos = ir1.next
            field_seen = true
        } else if (b & 64) != 0 {
            [ir2, e2] = hpack_int(block, pos, 6)
            if e2 != nil {
                return mkslice(Header, 0), e2
            }
            next2 := ir2.next
            name2 := ""
            if ir2.value == 0 {
                [sr2, e3] = hpack_string(block, next2)
                if e3 != nil {
                    return mkslice(Header, 0), e3
                }
                name2 = sr2.value
                next2 = sr2.next
            } else {
                [named2, ne2] = hpack_lookup(d, ir2.value)
                if ne2 != nil {
                    return mkslice(Header, 0), ne2
                }
                name2 = named2.name
            }
            [vr2, e4] = hpack_string(block, next2)
            if e4 != nil {
                return mkslice(Header, 0), e4
            }
            header2 := Header{name: name2, value: vr2.value}
            if !hpack_valid_header(header2) {
                return mkslice(Header, 0), errors.new("http2: invalid decoded header field")
            }
            total = total + len(name2) + len(vr2.value) + 32
            if total > d.max_header_list {
                return mkslice(Header, 0), errors.new("http2: HPACK header list too large")
            }
            headers = push(headers, header2)
            hpack_add(d, header2)
            pos = vr2.next
            field_seen = true
        } else if (b & 32) != 0 {
            if field_seen {
                return mkslice(Header, 0), errors.new("http2: late HPACK table size update")
            }
            [ir3, e5] = hpack_int(block, pos, 5)
            if e5 != nil {
                return mkslice(Header, 0), e5
            }
            if ir3.value > d.limit {
                return mkslice(Header, 0), errors.new("http2: HPACK table size exceeds limit")
            }
            d.max_size = ir3.value
            hpack_evict(d)
            pos = ir3.next
        } else {
            [ir4, e6] = hpack_int(block, pos, 4)
            if e6 != nil {
                return mkslice(Header, 0), e6
            }
            next4 := ir4.next
            name4 := ""
            if ir4.value == 0 {
                [sr4, e7] = hpack_string(block, next4)
                if e7 != nil {
                    return mkslice(Header, 0), e7
                }
                name4 = sr4.value
                next4 = sr4.next
            } else {
                [named4, ne4] = hpack_lookup(d, ir4.value)
                if ne4 != nil {
                    return mkslice(Header, 0), ne4
                }
                name4 = named4.name
            }
            [vr4, e8] = hpack_string(block, next4)
            if e8 != nil {
                return mkslice(Header, 0), e8
            }
            header4 := Header{name: name4, value: vr4.value}
            if !hpack_valid_header(header4) {
                return mkslice(Header, 0), errors.new("http2: invalid decoded header field")
            }
            total = total + len(name4) + len(vr4.value) + 32
            if total > d.max_header_list {
                return mkslice(Header, 0), errors.new("http2: HPACK header list too large")
            }
            headers = push(headers, header4)
            pos = vr4.next
            field_seen = true
        }
    }
    return headers, nil
}

fn hpack_static_name_index(name: str) -> int {
    if name == ":authority" {
        return 1
    }
    if name == ":method" {
        return 2
    }
    if name == ":path" {
        return 4
    }
    if name == ":scheme" {
        return 6
    }
    if name == ":status" {
        return 8
    }
    if name == "accept-charset" {
        return 15
    }
    if name == "accept-encoding" {
        return 16
    }
    if name == "accept-language" {
        return 17
    }
    if name == "accept-ranges" {
        return 18
    }
    if name == "accept" {
        return 19
    }
    if name == "access-control-allow-origin" {
        return 20
    }
    if name == "age" {
        return 21
    }
    if name == "allow" {
        return 22
    }
    if name == "authorization" {
        return 23
    }
    if name == "cache-control" {
        return 24
    }
    if name == "content-disposition" {
        return 25
    }
    if name == "content-encoding" {
        return 26
    }
    if name == "content-language" {
        return 27
    }
    if name == "content-length" {
        return 28
    }
    if name == "content-location" {
        return 29
    }
    if name == "content-range" {
        return 30
    }
    if name == "content-type" {
        return 31
    }
    if name == "cookie" {
        return 32
    }
    if name == "date" {
        return 33
    }
    if name == "etag" {
        return 34
    }
    if name == "expect" {
        return 35
    }
    if name == "expires" {
        return 36
    }
    if name == "from" {
        return 37
    }
    if name == "host" {
        return 38
    }
    if name == "if-match" {
        return 39
    }
    if name == "if-modified-since" {
        return 40
    }
    if name == "if-none-match" {
        return 41
    }
    if name == "if-range" {
        return 42
    }
    if name == "if-unmodified-since" {
        return 43
    }
    if name == "last-modified" {
        return 44
    }
    if name == "link" {
        return 45
    }
    if name == "location" {
        return 46
    }
    if name == "max-forwards" {
        return 47
    }
    if name == "proxy-authenticate" {
        return 48
    }
    if name == "proxy-authorization" {
        return 49
    }
    if name == "range" {
        return 50
    }
    if name == "referer" {
        return 51
    }
    if name == "refresh" {
        return 52
    }
    if name == "retry-after" {
        return 53
    }
    if name == "server" {
        return 54
    }
    if name == "set-cookie" {
        return 55
    }
    if name == "strict-transport-security" {
        return 56
    }
    if name == "transfer-encoding" {
        return 57
    }
    if name == "user-agent" {
        return 58
    }
    if name == "vary" {
        return 59
    }
    if name == "via" {
        return 60
    }
    if name == "www-authenticate" {
        return 61
    }
    return 0
}

fn hpack_static_exact_index(name: str, value: str) -> int {
    if name == ":method" && value == "GET" {
        return 2
    }
    if name == ":method" && value == "POST" {
        return 3
    }
    if name == ":path" && value == "/" {
        return 4
    }
    if name == ":path" && value == "/index.html" {
        return 5
    }
    if name == ":scheme" && value == "http" {
        return 6
    }
    if name == ":scheme" && value == "https" {
        return 7
    }
    if name == ":status" && value == "200" {
        return 8
    }
    if name == ":status" && value == "204" {
        return 9
    }
    if name == ":status" && value == "206" {
        return 10
    }
    if name == ":status" && value == "304" {
        return 11
    }
    if name == ":status" && value == "400" {
        return 12
    }
    if name == ":status" && value == "404" {
        return 13
    }
    if name == ":status" && value == "500" {
        return 14
    }
    if name == "accept-encoding" && value == "gzip, deflate" {
        return 16
    }
    return 0
}

fn hpack_valid_name(name: str) -> bool {
    raw := name as []byte
    if len(raw) == 0 {
        return false
    }
    i := 0
    for i < len(raw) {
        c := raw[i]
        if i == 0 && c == 58 {
            i = i + 1
        } else if c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39 || c == 42 || c == 43 || c == 45 || c == 46 || c == 94 || c == 95 || c == 96 || c == 124 || c == 126 {
            i = i + 1
        } else {
            return false
        }
    }
    return true
}

fn hpack_valid_value(value: str) -> bool {
    raw := value as []byte
    i := 0
    for i < len(raw) {
        c := raw[i]
        if c == 0 || c == 10 || c == 13 || c == 127 || c < 32 && c != 9 {
            return false
        }
        i = i + 1
    }
    return true
}

fn hpack_valid_header(header: Header) -> bool {
    return hpack_valid_name(header.name) && hpack_valid_value(header.value)
}

fn hpack_encode_int(value: int, prefix: int, base: int) -> [[]byte, err] {
    if value < 0 || value > 2147483647 || prefix < 1 || prefix > 8 {
        return mkslice(byte, 0), errors.new("http2: invalid HPACK integer")
    }
    mask := hpack_pow2(prefix) - 1
    if (base & mask) != 0 {
        return mkslice(byte, 0), errors.new("http2: invalid HPACK integer prefix")
    }
    out := mkslice(byte, 0)
    if value < mask {
        return push(out, base + value), nil
    }
    out = push(out, base + mask)
    remaining := value - mask
    for remaining >= 128 {
        out = push(out, remaining % 128 + 128)
        remaining = remaining / 128
    }
    out = push(out, remaining)
    return out, nil
}

fn hpack_encode_string(value: str) -> [[]byte, err] {
    raw := value as []byte
    [out, e] = hpack_encode_int(len(raw), 7, 0)
    if e != nil {
        return mkslice(byte, 0), e
    }
    i := 0
    for i < len(raw) {
        out = push(out, raw[i])
        i = i + 1
    }
    return out, nil
}

fn hpack_append(dst: []byte, src: []byte) -> []byte {
    out := dst
    i := 0
    for i < len(src) {
        out = push(out, src[i])
        i = i + 1
    }
    return out
}

fn encode_headers(headers: []Header) -> [[]byte, err] {
    out := mkslice(byte, 0)
    total := 0
    i := 0
    for i < len(headers) {
        h := headers[i]
        if !hpack_valid_header(h) {
            return mkslice(byte, 0), errors.new("http2: invalid header field")
        }
        total = total + len(h.name) + len(h.value) + 32
        if total > 65536 {
            return mkslice(byte, 0), errors.new("http2: header list too large")
        }
        exact := hpack_static_exact_index(h.name, h.value)
        if exact != 0 {
            [encoded, ee] = hpack_encode_int(exact, 7, 128)
            if ee != nil {
                return mkslice(byte, 0), ee
            }
            out = hpack_append(out, encoded)
        } else {
            name_index := hpack_static_name_index(h.name)
            [encoded, ee] = hpack_encode_int(name_index, 4, 16)
            if ee != nil {
                return mkslice(byte, 0), ee
            }
            out = hpack_append(out, encoded)
            if name_index == 0 {
                [name_bytes, ne] = hpack_encode_string(h.name)
                if ne != nil {
                    return mkslice(byte, 0), ne
                }
                out = hpack_append(out, name_bytes)
            }
            [value_bytes, ve] = hpack_encode_string(h.value)
            if ve != nil {
                return mkslice(byte, 0), ve
            }
            out = hpack_append(out, value_bytes)
        }
        i = i + 1
    }
    return out, nil
}
