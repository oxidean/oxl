package aes

// std/crypto/aes — FIPS-197 AES key expansion + encrypt-only block.
// Decryption is omitted by design: aesgcm (X2's only consumer)
// encrypts in both directions, and TLS's AES suites are all GCM.
// Words ride in int64 masked to 32 bits (M32); the language has no
// shifts so x>>n is x/2**n and x<<n is (x*2**n)&M32 — operands stay
// non-negative so / is exact.
import "std/errors"

import "std/slices"

let M32: int = 4294967295

let M24: int = 16777215

/// Aes is an expanded AES key — rk holds the 16*(nr+1) round-key
/// bytes and nr the round count (10/12/14 for AES-128/192/256).
struct Aes { rk: []int, nr: int }

let SBOX: own []int = nil

