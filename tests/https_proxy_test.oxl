package main

import "std/crypto/x509"

import "std/errors"

import "std/net/http"

import "std/net/tls"

import "std/os"

import "std/strings"

import "std/testing"

fn test_https_proxy_connect() {
    mode := os.getenv("OXL_PROXY_MODE")
    origin := atoi(os.getenv("OXL_HTTPS_TEST_PORT"))
    proxy := atoi(os.getenv("OXL_HTTPS_PROXY_PORT"))
    ca_file := os.getenv("OXL_HTTPS_TEST_CA")
    capture_file := os.getenv("OXL_PROXY_CAPTURE")
    testing.expect(origin > 0, "origin port configured")
    if mode == "proxy_bypass_rule" {
        testing.expect(http.proxy_from_env("example.invalid", 1) == "", "NO_PROXY bypasses env proxy")
        return
    }
    if mode == "proxy_bypass_lower" {
        testing.expect(http.proxy_from_env("example.invalid", 1) == "", "no_proxy bypasses env proxy")
        return
    }
    if mode == "env_precedence" {
        testing.expect(http.proxy_from_env("example.invalid", 1) == "http://scheme.invalid", "HTTPS_PROXY precedes ALL_PROXY")
        return
    }
    if mode == "env_https_precedence" {
        testing.expect(http.proxy_from_env("example.invalid", 1) == "http://lowercase.invalid", "https_proxy precedes HTTPS_PROXY")
        return
    }
    if mode == "env_http_precedence" {
        testing.expect(http.proxy_from_env("example.invalid", 0) == "http://uppercase.invalid", "HTTP_PROXY keeps existing precedence")
        return
    }
    if mode == "http_proxy_cgi_guard" {
        testing.expect(http.proxy_from_env("example.invalid", 0) == "", "HTTP_PROXY ignored in CGI")
        return
    }
    cfg := tls.default_cfg()
    [n, ce] = cfg.roots.load_pem(os.readfile_(ca_file))
    testing.expect(ce == nil && n > 0, "trusted CA loaded")
    host := "example.invalid"
    if mode == "direct" || mode == "no_proxy" || mode == "badroot" {
        host = "127.0.0.1"
    }
    if mode == "origin_sni" {
        host = "localhost"
    }
    if mode == "badname" {
        host = "wrong-name.invalid"
    }
    if mode == "reject" {
        host = "reject.invalid"
    }
    if mode == "badgateway" {
        host = "badgateway.invalid"
    }
    if mode == "non200" {
        host = "notunnel.invalid"
    }
    if mode == "interim" {
        host = "interim.invalid"
    }
    if mode == "badcl" {
        host = "badcl.invalid"
    }
    if mode == "badte" {
        host = "badte.invalid"
    }
    if mode == "cumulative" {
        host = "cumulative.invalid"
    }
    if mode == "malformed" {
        host = "malformed.invalid"
    }
    if mode == "truncated" {
        host = "truncated.invalid"
    }
    if mode == "oversized" {
        host = "oversized.invalid"
    }
    if host == "example.invalid" || mode == "interim" || mode == "badroot" {
        cfg.server_name = "localhost"
    }
    if mode == "badroot" {
        roots := x509.Roots{cas: nil}
        [rn, re] = roots.load_pem(os.readfile_("tests/fixtures/x509/roots.pem"))
        testing.expect(re == nil && rn > 0, "unrelated CA loaded")
        cfg.roots = roots
    }
    cl := http.Client{tmo: 15000, tlscfg: cfg}
    if mode == "zero_timeout" {
        cl.tmo = 0
    }
    req := http.request_get("https://" + host + ":" + itoa(origin) + "/")
    if mode == "explicit" || mode == "origin_sni" || mode == "explicit_override" || mode == "reject" || mode == "badgateway" || mode == "non200" || mode == "interim" || mode == "badcl" || mode == "badte" || mode == "cumulative" || mode == "zero_timeout" || mode == "malformed" || mode == "truncated" || mode == "oversized" || mode == "badname" || mode == "badroot" {
        req.proxy = "http://127.0.0.1:" + itoa(proxy)
    }
    if mode == "bad_proxy_url" {
        req.proxy = "ftp://127.0.0.1"
    }
    if mode == "secure_proxy" {
        req.proxy = "https://127.0.0.1:" + itoa(proxy)
    }
    if mode == "direct" {
        req.proxy = "direct"
    }
    [resp, e] = cl.do(req)
    if mode == "bad_proxy_url" || mode == "secure_proxy" {
        testing.expect(e != nil, "invalid proxy configuration fails")
        if mode == "bad_proxy_url" {
            testing.expect(strings.contains(errors.msg(e), "bad proxy url"), "malformed proxy URL rejected")
        } else {
            testing.expect(strings.contains(errors.msg(e), "proxy url must be http"), "HTTPS proxy URL rejected")
        }
    } else if mode == "reject" || mode == "badgateway" || mode == "non200" {
        testing.expect(e != nil, "proxy rejection fails")
        if mode == "reject" {
            testing.expect(strings.contains(errors.msg(e), "407"), "proxy status preserved")
        } else if mode == "badgateway" {
            testing.expect(strings.contains(errors.msg(e), "502"), "proxy status preserved")
        } else {
            testing.expect(strings.contains(errors.msg(e), "204"), "only 200 establishes a tunnel")
        }
    } else if mode == "zero_timeout" {
        testing.expect(e != nil, "zero timeout fails before CONNECT")
    } else if mode == "malformed" || mode == "badcl" || mode == "badte" || mode == "cumulative" || mode == "truncated" || mode == "oversized" {
        testing.expect(e != nil, "invalid CONNECT response fails")
        if mode == "badcl" {
            testing.expect(strings.contains(errors.msg(e), "content length"), "invalid CONNECT content length is rejected")
        }
        if mode == "badte" {
            testing.expect(strings.contains(errors.msg(e), "transfer encoding"), "CONNECT transfer encoding is rejected")
        }
        if mode == "cumulative" || mode == "oversized" {
            testing.expect(strings.contains(errors.msg(e), "headers too large"), "CONNECT response cap is enforced")
        }
    } else if mode == "badname" {
        testing.expect(errors.is(e, x509.err_name()), "origin name error preserved")
    } else if mode == "badroot" {
        testing.expect(errors.is(e, x509.err_root()), "origin trust error preserved")
    } else {
        if e != nil {
            testing.expect(false, "CONNECT request: " + errors.msg(e))
            return
        }
        testing.expect_eq(resp.status, 200, "HTTPS response received")
        testing.expect(strings.contains(resp.body, "proxy origin ok"), "origin response body")
    }
    captured := os.readfile_(capture_file)
    if mode == "direct" || mode == "no_proxy" || mode == "zero_timeout" || mode == "bad_proxy_url" || mode == "secure_proxy" {
        testing.expect_eq(len(captured), 0, "bypass did not use proxy")
    } else if mode != "proxy_bypass_rule" {
        testing.expect(strings.contains(captured, "CONNECT " + host + ":" + itoa(origin) + " HTTP/1.1"), "CONNECT authority captured")
        testing.expect(strings.contains(captured, "host: " + host + ":" + itoa(origin)), "CONNECT Host captured")
    }
}
