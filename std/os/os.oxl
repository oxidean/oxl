package os

// std/os — process environment + file I/O, thin honest wrappers over
// the file/process builtins (argv/argc, readfile/writefile, exit).
// Named fns, not bare builtins, so user code can shadow builtins safely
// (same rationale as std/time and std/sync).

/// process args (index 0 is the program name)
fn args(i: int) -> str {
    return argv(i)
}

/// number of process args
fn nargs() -> int {
    return argc()
}

/// read an entire file; empty string on failure
fn readfile_(path: str) -> str {
    return readfile(path)
}

/// write an entire file (truncates); 0 ok, -1 on error
fn writefile_(path: str, data: str) -> int {
    return writefile(path, data)
}

/// exit the process with code
fn quit(code: int) {
    exit(code)
}

// --- fd-level files: the io.Reader/Writer impls ----------------------
// open/create return PathError-shaped messages ("open <path>: <errno
// text>"); fds are plain ints under the hood.
import "std/errors"

import "std/strings"

extern fn rt_open_read(path: str) -> int

extern fn rt_open_write(path: str) -> int

extern fn rt_fd_read(fd: int, b: []byte) -> int

extern fn rt_fd_write(fd: int, b: []byte) -> int

extern fn rt_fd_close(fd: int) -> int

extern fn rt_remove(path: str) -> int

extern fn rt_mkdir(path: str) -> int

extern fn rt_rmdir(path: str) -> int

extern fn rt_rename(old: str, new: str) -> int

extern fn rt_fexists(path: str) -> int

extern fn rt_isdir(path: str) -> int

extern fn rt_islnk(path: str) -> int

extern fn rt_lsdir(path: str) -> []str

extern fn rt_getenv(name: str) -> str

extern fn rt_fullpath(path: str) -> str

extern fn rt_is_windows() -> int

extern fn rt_errstr(code: int) -> str

/// File is an open fd — implements io.Reader/Writer/Closer.
struct File { fd: int }

/// open a file for reading; [File, err] (PathError-shaped message).
fn open(path: str) -> [File, err] {
    fd := rt_open_read(path)
    if fd < 0 {
        return File{fd: -1}, errors.new("open " + path + ": " + rt_errstr(-fd))
    }
    return File{fd: fd}, nil
}

/// create/truncate a file for writing; [File, err].
fn create(path: str) -> [File, err] {
    fd := rt_open_write(path)
    if fd < 0 {
        return File{fd: -1}, errors.new("open " + path + ": " + rt_errstr(-fd))
    }
    return File{fd: fd}, nil
}

/// read into b; 0,eof at end; [n, err].
fn (f ref File) read(b: []byte) -> [int, err] {
    n := rt_fd_read(f.fd, b)
    if n < 0 {
        return 0, errors.new("read: " + rt_errstr(-n))
    }
    if n == 0 {
        if len(b) == 0 {
            return 0, nil
        }
        return 0, io_eof()
    }
    return n, nil
}

/// write b fully's worth of one call; [n, err].
fn (f ref File) write(b: []byte) -> [int, err] {
    n := rt_fd_write(f.fd, b)
    if n < 0 {
        return 0, errors.new("write: " + rt_errstr(-n))
    }
    return n, nil
}

/// close the fd; nil on success, err on failure — deferred write
/// errors (full fs, NFS) surface here, so the result is real.
fn (f ref File) close() -> err {
    r := rt_fd_close(f.fd)
    if r < 0 {
        return errors.new("close: " + rt_errstr(-r))
    }
    return nil
}

// io.eof without an io import — os is io's substrate, not its client.
// The interned registry keeps the sentinel identical to io.eof()'s.
fn io_eof() -> err {
    return errors.new("EOF")
}

/// stdin — process standard input as an io.Reader.
fn stdin() -> File {
    return File{fd: 0}
}

/// stdout — process standard output as an io.Writer.
fn stdout() -> File {
    return File{fd: 1}
}

/// stderr — process standard error as an io.Writer.
fn stderr() -> File {
    return File{fd: 2}
}

/// remove deletes a file; nil on success, err on failure.
fn remove(path: str) -> err {
    r := rt_remove(path)
    if r == 0 {
        return nil
    }
    return errors.new("remove " + path + ": " + rt_errstr(-r))
}

/// exists reports whether path exists (file, dir, or link).
fn exists(path: str) -> bool {
    return rt_fexists(path) != 0 || rt_islnk(path) != 0
}

/// isdir reports whether path is a directory.
fn isdir(path: str) -> bool {
    return rt_isdir(path) != 0
}

/// ls returns the sorted entry names of directory path.
fn ls(path: str) -> own []str {
    return new(rt_lsdir(path))
}

/// getenv returns the value of environment variable name, "" when unset.
fn getenv(name: str) -> str {
    return rt_getenv(name)
}

/// fullpath returns the canonical absolute form of path.
fn fullpath(path: str) -> str {
    return rt_fullpath(path)
}

/// mkdir creates one directory level; err when it can't (EEXIST is an
/// error here — use mkdir_all for create-if-missing semantics).
fn mkdir(path: str) -> err {
    r := rt_mkdir(path)
    if r < 0 {
        return errors.new("mkdir " + path + ": " + rt_errstr(-r))
    }
    return nil
}

/// mkdir_all creates path and every missing parent. Existing dirs along
/// the way are fine; a non-dir in the path is an error.
fn mkdir_all(path: str) -> err {
    if isdir(path) {
        return nil
    }
    cur := ""
    parts := strings.split(path, "/")
    for parts != nil {
        p := parts.v
        parts = parts.next
        if len(p) == 0 {
            if len(cur) == 0 {
                cur = "/"
            }
            continue
        }
        if len(p) == 2 && byteat(p, 1) == 58 && len(cur) == 0 {
            // drive prefix (C:) — a single letter + colon at the path
            // start is a root, not a creatable dir. Anything longer
            // ending in ':' (e.g. "file:" from file:// module paths)
            // is an ordinary directory name.
            a := byteat(p, 0)
            if a >= 65 && a <= 90 || a >= 97 && a <= 122 {
                cur = cur + p
                continue
            }
        }
        if len(cur) == 0 || strings.endswith(cur, "/") {
            cur = cur + p
        } else {
            cur = cur + "/" + p
        }
        if isdir(cur) {
            continue
        }
        r := rt_mkdir(cur)
        if r < 0 && !isdir(cur) {
            return errors.new("mkdir " + cur + ": " + rt_errstr(-r))
        }
    }
    return nil
}

/// remove_all deletes path recursively — files, links, and dir trees.
/// Symlinks themselves are removed, never followed. A missing path is
/// not an error (same contract as the reference RemoveAll).
fn remove_all(path: str) -> err {
    if !exists(path) && rt_islnk(path) == 0 {
        return nil
    }
    if rt_islnk(path) != 0 || !isdir(path) {
        return remove(path)
    }
    ents := rt_lsdir(path)
    i := 0
    for i < len(ents) {
        e := remove_all(path + "/" + ents[i])
        if e != nil {
            return e
        }
        i = i + 1
    }
    r := rt_rmdir(path)
    if r < 0 {
        return errors.new("rmdir " + path + ": " + rt_errstr(-r))
    }
    return nil
}

/// rename moves/renames old to new, replacing an existing target and
/// crossing volumes where the platform allows it.
fn rename(old: str, new: str) -> err {
    r := rt_rename(old, new)
    if r < 0 {
        return errors.new("rename " + old + " -> " + new + ": " + rt_errstr(-r))
    }
    return nil
}

/// temp_dir returns the per-OS scratch directory: $TMPDIR or /tmp on
/// POSIX; %TMP%, %TEMP%, %USERPROFILE%, or C:/Windows on Windows.
fn temp_dir() -> str {
    if rt_is_windows() != 0 {
        names := mkslice(str, 0)
        names = push(names, "TMP")
        names = push(names, "TEMP")
        names = push(names, "USERPROFILE")
        i := 0
        for i < len(names) {
            v := rt_getenv(names[i])
            if len(v) > 0 {
                return v
            }
            i = i + 1
        }
        return "C:/Windows"
    }
    v := rt_getenv("TMPDIR")
    if len(v) > 0 {
        return v
    }
    return "/tmp"
}
