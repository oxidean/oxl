    }
    if name == "rt_err_wrap" {
        d = "i64 @rt_err_wrap(%OxlStr, i64)"
    }
    if name == "rt_err_cause" {
        d = "i64 @rt_err_cause(i64)"
    }
    if name == "rt_err_msg" {
        d = "%OxlStr @rt_err_msg(i64)"
    }
    if name == "rt_errstr" {
        d = "%OxlStr @rt_errstr(i64)"
    }
    // — args / env / time / sleep --
    if name == "rt_argc" {
        d = "i64 @rt_argc()"
    }
    if name == "rt_argv" {
        d = "%OxlStr @rt_argv(i64)"
    }
    if name == "rt_sleep" {
        d = "void @rt_sleep(i64)"
    }
    if name == "rt_msleep" {
