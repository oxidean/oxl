package main

import "std/net/http2"

import "std/bytes"

import "std/encoding/hex"

import "std/errors"

import "std/testing"

fn test_http2_connection_streams_and_trailers() {
    buf := bytes.newbuffer()
    writer := buf.aswriter()
    [settings, se] = http2.encode_frame(http2.FrameHeader{length: 0, kind: 4, flags: 0, stream_id: 0}, mkslice(byte, 0))
    testing.expect(se == nil, "encode peer SETTINGS")
    [_, we] = writer.write(settings)
    testing.expect(we == nil, "queue peer SETTINGS")
    [status, ste] = hex.decode("88")
    testing.expect(ste == nil, "encode response status")
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: 1, kind: 1, flags: 4, stream_id: 1}, status) == nil, "queue response HEADERS")
    padded := mkslice(byte, 0)
    padded = push(padded, 2)
    padded = push(padded, 97)
    padded = push(padded, 98)
    padded = push(padded, 99)
    padded = push(padded, 0)
    padded = push(padded, 0)
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: 6, kind: 0, flags: 8, stream_id: 1}, padded) == nil, "queue response DATA")
    trailer_headers := mkslice(http2.Header, 0)
    trailer_headers = push(trailer_headers, http2.Header{name: "x-check", value: "done"})
    [trailers, te] = http2.encode_headers(trailer_headers)
    testing.expect(te == nil, "encode response trailers")
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: len(trailers), kind: 1, flags: 5, stream_id: 1}, trailers) == nil, "queue response trailing HEADERS")
    rw := buf.asreadwriter()
    [conn, ce] = http2.new_conn(rw)
    testing.expect(ce == nil, "initialize prior-knowledge H2 connection")
    req := mkslice(http2.Header, 0)
    req = push(req, http2.Header{name: ":method", value: "GET"})
    req = push(req, http2.Header{name: ":scheme", value: "http"})
    req = push(req, http2.Header{name: ":path", value: "/"})
    req = push(req, http2.Header{name: ":authority", value: "127.0.0.1"})
    [id, oe] = conn.open_stream(req, true)
    testing.expect(oe == nil && id == 1, "open first request stream")
    [head, he] = conn.next_event()
    testing.expect(he == nil && head.stream_id == id && !head.trailers && head.headers[0].value == "200", "read response headers")
    [data, de] = conn.next_event()
    testing.expect(de == nil && data.stream_id == id && data.payload as str == "abc" && data.flow_bytes == 6, "read response data")
    testing.expect(conn.ack_data(id, data.flow_bytes) == nil, "ack response data flow-control window")
    [tail, te2] = conn.next_event()
    testing.expect(te2 == nil && tail.stream_id == id && tail.trailers && tail.headers[0].name == "x-check" && tail.headers[0].value == "done", "read response trailers")
}

fn test_http2_send_after_remote_end_stream() {
    buf := bytes.newbuffer()
    writer := buf.aswriter()
    [settings, se] = http2.encode_frame(http2.FrameHeader{length: 0, kind: 4, flags: 0, stream_id: 0}, mkslice(byte, 0))
    testing.expect(se == nil, "encode peer SETTINGS")
    [_, we] = writer.write(settings)
    testing.expect(we == nil, "queue peer SETTINGS")
    [status, ste] = hex.decode("88")
    testing.expect(ste == nil, "encode response status")
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: 1, kind: 1, flags: 5, stream_id: 1}, status) == nil, "queue response HEADERS with END_STREAM")
    [conn, ce] = http2.new_conn(buf.asreadwriter())
    testing.expect(ce == nil, "initialize half-closed connection")
    req := mkslice(http2.Header, 0)
    req = push(req, http2.Header{name: ":method", value: "POST"})
    req = push(req, http2.Header{name: ":scheme", value: "http"})
    req = push(req, http2.Header{name: ":path", value: "/"})
    req = push(req, http2.Header{name: ":authority", value: "127.0.0.1"})
    [id, oe] = conn.open_stream(req, false)
    testing.expect(oe == nil && id == 1, "open request stream before response")
    [head, he] = conn.next_event()
    testing.expect(he == nil && head.stream_id == id && head.headers[0].value == "200", "receive response END_STREAM")
    testing.expect(conn.send_data(id, "body" as []byte, true) == nil, "send request DATA after remote END_STREAM")
}

fn test_http2_connection_multiplexes_stream_ids() {
    buf := bytes.newbuffer()
    writer := buf.aswriter()
    [settings, se] = http2.encode_frame(http2.FrameHeader{length: 0, kind: 4, flags: 0, stream_id: 0}, mkslice(byte, 0))
    testing.expect(se == nil, "encode multiplex peer SETTINGS")
    [_, we] = writer.write(settings)
    testing.expect(we == nil, "queue multiplex peer SETTINGS")
    [status, ste] = hex.decode("88")
    testing.expect(ste == nil, "encode multiplex response status")
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: 1, kind: 1, flags: 5, stream_id: 3}, status) == nil, "queue stream 3 response")
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: 1, kind: 1, flags: 5, stream_id: 1}, status) == nil, "queue stream 1 response")
    [conn, ce] = http2.new_conn(buf.asreadwriter())
    testing.expect(ce == nil, "initialize multiplex connection")
    req := mkslice(http2.Header, 0)
    req = push(req, http2.Header{name: ":method", value: "GET"})
    req = push(req, http2.Header{name: ":scheme", value: "http"})
    req = push(req, http2.Header{name: ":path", value: "/"})
    req = push(req, http2.Header{name: ":authority", value: "127.0.0.1"})
    [id1, e1] = conn.open_stream(req, true)
    [id2, e2] = conn.open_stream(req, true)
    testing.expect(e1 == nil && e2 == nil && id1 == 1 && id2 == 3, "open concurrent request streams")
    [ev1, r1] = conn.next_event()
    [ev2, r2] = conn.next_event()
    testing.expect(r1 == nil && r2 == nil && ev1.stream_id == 3 && ev2.stream_id == 1, "route interleaved stream responses")
}

fn test_http2_peer_max_concurrent_streams() {
    buf := bytes.newbuffer()
    writer := buf.aswriter()
    max_streams := mkslice(byte, 0)
    max_streams = push(max_streams, 0)
    max_streams = push(max_streams, 3)
    max_streams = push(max_streams, 0)
    max_streams = push(max_streams, 0)
    max_streams = push(max_streams, 0)
    max_streams = push(max_streams, 1)
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: len(max_streams), kind: 4, flags: 0, stream_id: 0}, max_streams) == nil, "queue max-concurrent SETTINGS")
    [status, he] = hex.decode("88")
    testing.expect(he == nil, "encode max-concurrent response")
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: 1, kind: 1, flags: 5, stream_id: 1}, status) == nil, "queue completed stream response")
    [conn, ce] = http2.new_conn(buf.asreadwriter())
    testing.expect(ce == nil, "initialize max-concurrent connection")
    req := mkslice(http2.Header, 0)
    req = push(req, http2.Header{name: ":method", value: "GET"})
    req = push(req, http2.Header{name: ":scheme", value: "http"})
    req = push(req, http2.Header{name: ":path", value: "/"})
    req = push(req, http2.Header{name: ":authority", value: "127.0.0.1"})
    [id, oe] = conn.open_stream(req, false)
    testing.expect(oe == nil && id == 1, "open stream within peer limit")
    [_, limit_err] = conn.open_stream(req, false)
    testing.expect(limit_err != nil, "reject stream beyond peer limit")
    testing.expect(conn.send_body(id, mkslice(byte, 0)) == nil, "complete request body")
    [event, ee] = conn.next_event()
    testing.expect(ee == nil && event.stream_id == id, "complete response stream")
    [next_id, next_err] = conn.open_stream(req, false)
    testing.expect(next_err == nil && next_id == 3, "reuse peer stream slot after completion")
}

fn test_http2_cancel_reclaims_receive_credit_and_slot() {
    buf := bytes.newbuffer()
    writer := buf.aswriter()
    max_streams := mkslice(byte, 0)
    max_streams = push(max_streams, 0)
    max_streams = push(max_streams, 3)
    max_streams = push(max_streams, 0)
    max_streams = push(max_streams, 0)
    max_streams = push(max_streams, 0)
    max_streams = push(max_streams, 1)
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: len(max_streams), kind: 4, flags: 0, stream_id: 0}, max_streams) == nil, "queue cancel SETTINGS")
    [status, status_err] = hex.decode("88")
    testing.expect(status_err == nil, "encode cancel response status")
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: 1, kind: 1, flags: 4, stream_id: 1}, status) == nil, "queue cancel response HEADERS")
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: 3, kind: 0, flags: 0, stream_id: 1}, "abc" as []byte) == nil, "queue cancel response DATA")
    [conn, ce] = http2.new_conn(buf.asreadwriter())
    testing.expect(ce == nil, "initialize cancel connection")
    req := mkslice(http2.Header, 0)
    req = push(req, http2.Header{name: ":method", value: "GET"})
    req = push(req, http2.Header{name: ":scheme", value: "http"})
    req = push(req, http2.Header{name: ":path", value: "/"})
    req = push(req, http2.Header{name: ":authority", value: "127.0.0.1"})
    [id, oe] = conn.open_stream(req, true)
    testing.expect(oe == nil && id == 1, "open cancel request stream")
    [headers, headers_err] = conn.next_event()
    testing.expect(headers_err == nil && headers.kind == 1, "read cancel response HEADERS")
    [data, de] = conn.next_event()
    testing.expect(de == nil && data.kind == 0 && data.flow_bytes == 3, "read unacknowledged cancel DATA")
    testing.expect(conn.cancel_stream(id) == nil, "cancel stream after DATA")
    testing.expect(conn.conn_recv_window == 65535, "cancel restores connection receive credit")
    [next_id, next_err] = conn.open_stream(req, true)
    testing.expect(next_err == nil && next_id == 3, "cancelled stream releases peer concurrency slot")
}

fn test_http2_reset_reclaims_receive_credit_and_slot() {
    buf := bytes.newbuffer()
    writer := buf.aswriter()
    max_streams := mkslice(byte, 0)
    max_streams = push(max_streams, 0)
    max_streams = push(max_streams, 3)
    max_streams = push(max_streams, 0)
    max_streams = push(max_streams, 0)
    max_streams = push(max_streams, 0)
    max_streams = push(max_streams, 1)
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: len(max_streams), kind: 4, flags: 0, stream_id: 0}, max_streams) == nil, "queue reset SETTINGS")
    [status, status_err] = hex.decode("88")
    testing.expect(status_err == nil, "encode reset response status")
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: 1, kind: 1, flags: 4, stream_id: 1}, status) == nil, "queue reset response HEADERS")
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: 3, kind: 0, flags: 0, stream_id: 1}, "abc" as []byte) == nil, "queue reset response DATA")
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: 4, kind: 3, flags: 0, stream_id: 1}, http2.encode_u32(8)) == nil, "queue peer RST_STREAM")
    [conn, ce] = http2.new_conn(buf.asreadwriter())
    testing.expect(ce == nil, "initialize reset connection")
    req := mkslice(http2.Header, 0)
    req = push(req, http2.Header{name: ":method", value: "GET"})
    req = push(req, http2.Header{name: ":scheme", value: "http"})
    req = push(req, http2.Header{name: ":path", value: "/"})
    req = push(req, http2.Header{name: ":authority", value: "127.0.0.1"})
    [id, oe] = conn.open_stream(req, true)
    testing.expect(oe == nil && id == 1, "open reset request stream")
    [headers, headers_err] = conn.next_event()
    testing.expect(headers_err == nil && headers.kind == 1, "read reset response HEADERS")
    [data, de] = conn.next_event()
    testing.expect(de == nil && data.kind == 0 && data.flow_bytes == 3, "read unacknowledged reset DATA")
    [reset, re] = conn.next_event()
    testing.expect(re == nil && reset.kind == 3, "read peer RST_STREAM")
    testing.expect(conn.conn_recv_window == 65535, "RST_STREAM restores connection receive credit")
    [next_id, next_err] = conn.open_stream(req, true)
    testing.expect(next_err == nil && next_id == 3, "reset stream releases peer concurrency slot")
}

fn test_http2_send_body_handles_goaway_for_accepted_stream() {
    buf := bytes.newbuffer()
    writer := buf.aswriter()
    [settings, se] = http2.encode_frame(http2.FrameHeader{length: 0, kind: 4, flags: 0, stream_id: 0}, mkslice(byte, 0))
    testing.expect(se == nil, "encode GOAWAY SETTINGS")
    [_, we] = writer.write(settings)
    testing.expect(we == nil, "queue GOAWAY SETTINGS")
    goaway_payload := mkslice(byte, 0)
    goaway_payload = push(goaway_payload, 0)
    goaway_payload = push(goaway_payload, 0)
    goaway_payload = push(goaway_payload, 0)
    goaway_payload = push(goaway_payload, 1)
    goaway_payload = push(goaway_payload, 0)
    goaway_payload = push(goaway_payload, 0)
    goaway_payload = push(goaway_payload, 0)
    goaway_payload = push(goaway_payload, 0)
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: 8, kind: 7, flags: 0, stream_id: 0}, goaway_payload) == nil, "queue accepted-stream GOAWAY")
    window_update := mkslice(byte, 0)
    window_update = push(window_update, 0)
    window_update = push(window_update, 0)
    window_update = push(window_update, 0)
    window_update = push(window_update, 1)
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: 4, kind: 8, flags: 0, stream_id: 0}, window_update) == nil, "queue connection WINDOW_UPDATE")
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: 4, kind: 8, flags: 0, stream_id: 1}, window_update) == nil, "queue stream WINDOW_UPDATE")
    [status, he] = hex.decode("88")
    testing.expect(he == nil, "encode GOAWAY response status")
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: 1, kind: 1, flags: 5, stream_id: 1}, status) == nil, "queue accepted-stream response")
    [conn, ce] = http2.new_conn(buf.asreadwriter())
    testing.expect(ce == nil, "initialize accepted-stream connection")
    req := mkslice(http2.Header, 0)
    req = push(req, http2.Header{name: ":method", value: "POST"})
    req = push(req, http2.Header{name: ":scheme", value: "http"})
    req = push(req, http2.Header{name: ":path", value: "/"})
    req = push(req, http2.Header{name: ":authority", value: "127.0.0.1"})
    [id, oe] = conn.open_stream(req, false)
    testing.expect(oe == nil && id == 1, "open stream before GOAWAY")
    body := mkslice(byte, 65536)
    i := 0
    for i < len(body) {
        body[i] = 97
        i = i + 1
    }
    testing.expect(conn.send_body(id, body) == nil, "continue body on stream accepted by GOAWAY")
    [event, ee] = conn.next_event()
    testing.expect(ee == nil && event.kind == 7 && event.last_stream_id == id, "preserve accepted-stream GOAWAY event")
}

fn test_http2_send_body_rejects_goaway_excluded_stream() {
    buf := bytes.newbuffer()
    writer := buf.aswriter()
    [settings, se] = http2.encode_frame(http2.FrameHeader{length: 0, kind: 4, flags: 0, stream_id: 0}, mkslice(byte, 0))
    testing.expect(se == nil, "encode excluded-stream SETTINGS")
    [_, we] = writer.write(settings)
    testing.expect(we == nil, "queue excluded-stream SETTINGS")
    goaway_payload := mkslice(byte, 0)
    i := 0
    for i < 8 {
        goaway_payload = push(goaway_payload, 0)
        i = i + 1
    }
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: 8, kind: 7, flags: 0, stream_id: 0}, goaway_payload) == nil, "queue excluding GOAWAY")
    [conn, ce] = http2.new_conn(buf.asreadwriter())
    testing.expect(ce == nil, "initialize excluded-stream connection")
    req := mkslice(http2.Header, 0)
    req = push(req, http2.Header{name: ":method", value: "POST"})
    req = push(req, http2.Header{name: ":scheme", value: "http"})
    req = push(req, http2.Header{name: ":path", value: "/"})
    req = push(req, http2.Header{name: ":authority", value: "127.0.0.1"})
    [id, oe] = conn.open_stream(req, false)
    testing.expect(oe == nil && id == 1, "open stream before excluding GOAWAY")
    body := mkslice(byte, 65536)
    body_err := conn.send_body(id, body)
    testing.expect(body_err != nil, "stop sending body when GOAWAY excludes stream")
}

fn test_http2_goaway_last_stream_is_monotonic() {
    buf := bytes.newbuffer()
    writer := buf.aswriter()
    [settings, se] = http2.encode_frame(http2.FrameHeader{length: 0, kind: 4, flags: 0, stream_id: 0}, mkslice(byte, 0))
    testing.expect(se == nil, "encode monotonic GOAWAY SETTINGS")
    [_, we] = writer.write(settings)
    testing.expect(we == nil, "queue monotonic GOAWAY SETTINGS")
    first := mkslice(byte, 8)
    second := mkslice(byte, 8)
    second[3] = 1
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: 8, kind: 7, flags: 0, stream_id: 0}, first) == nil, "queue first GOAWAY")
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: 8, kind: 7, flags: 0, stream_id: 0}, second) == nil, "queue increased GOAWAY")
    [conn, ce] = http2.new_conn(buf.asreadwriter())
    testing.expect(ce == nil, "initialize monotonic GOAWAY connection")
    [event, ee] = conn.next_event()
    testing.expect(ee == nil && event.kind == 7 && event.last_stream_id == 0, "accept first GOAWAY")
    [_, increase_err] = conn.next_event()
    testing.expect(increase_err != nil, "reject increased GOAWAY last stream")
}

fn test_http2_pending_event_limit() {
    buf := bytes.newbuffer()
    writer := buf.aswriter()
    [settings, se] = http2.encode_frame(http2.FrameHeader{length: 0, kind: 4, flags: 0, stream_id: 0}, mkslice(byte, 0))
    testing.expect(se == nil, "encode pending-event SETTINGS")
    [_, we] = writer.write(settings)
    testing.expect(we == nil, "queue pending-event SETTINGS")
    [conn, ce] = http2.new_conn(buf.asreadwriter())
    testing.expect(ce == nil, "initialize pending-event connection")
    event := http2.Event{last_stream_id: 0, flow_bytes: 0, stream_id: 1, kind: 1, flags: 0, trailers: false, headers: mkslice(http2.Header, 0), payload: mkslice(byte, 0)}
    i := 0
    for i < 100 {
        testing.expect(conn.queue_event(event) == nil, "queue event within limit")
        i = i + 1
    }
    testing.expect(conn.queue_event(event) != nil, "reject event beyond queue limit")
}

fn test_http2_enable_push_setting() {
    zero_buf := bytes.newbuffer()
    zero_writer := zero_buf.aswriter()
    zero_push := mkslice(byte, 0)
    zero_push = push(zero_push, 0)
    zero_push = push(zero_push, 2)
    zero_push = push(zero_push, 0)
    zero_push = push(zero_push, 0)
    zero_push = push(zero_push, 0)
    zero_push = push(zero_push, 0)
    testing.expect(http2.write_frame(zero_writer, http2.FrameHeader{length: 6, kind: 4, flags: 0, stream_id: 0}, zero_push) == nil, "queue SETTINGS_ENABLE_PUSH=0")
    [zero_conn, zero_err] = http2.new_conn(zero_buf.asreadwriter())
    testing.expect(zero_err == nil, "accept SETTINGS_ENABLE_PUSH=0")
    zero_conn.close()

    one_buf := bytes.newbuffer()
    one_writer := one_buf.aswriter()
    one_push := mkslice(byte, 0)
    one_push = push(one_push, 0)
    one_push = push(one_push, 2)
    one_push = push(one_push, 0)
    one_push = push(one_push, 0)
    one_push = push(one_push, 0)
    one_push = push(one_push, 1)
    testing.expect(http2.write_frame(one_writer, http2.FrameHeader{length: 6, kind: 4, flags: 0, stream_id: 0}, one_push) == nil, "queue SETTINGS_ENABLE_PUSH=1")
    [_, one_err] = http2.new_conn(one_buf.asreadwriter())
    testing.expect(one_err != nil, "reject SETTINGS_ENABLE_PUSH=1")
}

fn test_http2_connection_control_frames() {
    buf := bytes.newbuffer()
    writer := buf.aswriter()
    [settings, se] = http2.encode_frame(http2.FrameHeader{length: 0, kind: 4, flags: 0, stream_id: 0}, mkslice(byte, 0))
    testing.expect(se == nil, "encode control SETTINGS")
    [_, we] = writer.write(settings)
    testing.expect(we == nil, "queue control SETTINGS")
    goaway := mkslice(byte, 0)
    i := 0
    for i < 8 {
        goaway = push(goaway, 0)
        i = i + 1
    }
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: 8, kind: 7, flags: 0, stream_id: 0}, goaway) == nil, "queue GOAWAY")
    [conn, ce] = http2.new_conn(buf.asreadwriter())
    testing.expect(ce == nil, "create GOAWAY test connection")
    [event, ee] = conn.next_event()
    testing.expect(ee == nil && event.kind == 7, "read GOAWAY")
    req := mkslice(http2.Header, 0)
    req = push(req, http2.Header{name: ":method", value: "GET"})
    req = push(req, http2.Header{name: ":scheme", value: "http"})
    req = push(req, http2.Header{name: ":path", value: "/"})
    req = push(req, http2.Header{name: ":authority", value: "127.0.0.1"})
    [_, oe] = conn.open_stream(req, true)
    testing.expect(oe != nil, "GOAWAY prevents new streams")
    [_, pe] = conn.next_event()
    testing.expect(pe != nil, "report peer close")

    reset_buf := bytes.newbuffer()
    reset_writer := reset_buf.aswriter()
    [_, rwe] = reset_writer.write(settings)
    testing.expect(rwe == nil, "queue reset SETTINGS")
    reset_payload := mkslice(byte, 0)
    reset_payload = push(reset_payload, 0)
    reset_payload = push(reset_payload, 0)
    reset_payload = push(reset_payload, 0)
    reset_payload = push(reset_payload, 8)
    testing.expect(http2.write_frame(reset_writer, http2.FrameHeader{length: 4, kind: 3, flags: 0, stream_id: 1}, reset_payload) == nil, "queue RST_STREAM")
    [reset_conn, rce] = http2.new_conn(reset_buf.asreadwriter())
    testing.expect(rce == nil, "create RST_STREAM test connection")
    [id, ioe] = reset_conn.open_stream(req, true)
    testing.expect(ioe == nil && id == 1, "open reset request stream")
    testing.expect(reset_conn.cancel_stream(id) == nil, "cancel request stream")
    expected_rst := mkslice(byte, 0)
    expected_rst = push(expected_rst, 0)
    expected_rst = push(expected_rst, 0)
    expected_rst = push(expected_rst, 4)
    expected_rst = push(expected_rst, 3)
    expected_rst = push(expected_rst, 0)
    expected_rst = push(expected_rst, 0)
    expected_rst = push(expected_rst, 0)
    expected_rst = push(expected_rst, 0)
    expected_rst = push(expected_rst, 1)
    expected_rst = push(expected_rst, 0)
    expected_rst = push(expected_rst, 0)
    expected_rst = push(expected_rst, 0)
    expected_rst = push(expected_rst, 8)
    first_rst := bytes.index(reset_buf.buf, expected_rst)
    second_rst := -1
    if first_rst >= 0 {
        second_rst = bytes.index(reset_buf.buf[first_rst + len(expected_rst):len(reset_buf.buf)], expected_rst)
    }
    testing.expect(second_rst >= 0, "emit RST_STREAM cancellation frame")
    [_, ree] = reset_conn.next_event()
    testing.expect(ree != nil, "ignore peer RST for cancelled stream then report peer close")
}

fn test_http2_rst_after_close_is_ignored() {
    buf := bytes.newbuffer()
    writer := buf.aswriter()
    [settings, se] = http2.encode_frame(http2.FrameHeader{length: 0, kind: 4, flags: 0, stream_id: 0}, mkslice(byte, 0))
    testing.expect(se == nil, "encode peer SETTINGS")
    [_, we] = writer.write(settings)
    testing.expect(we == nil, "queue peer SETTINGS")
    [status, ste] = hex.decode("88")
    testing.expect(ste == nil, "encode response status")
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: 1, kind: 1, flags: 5, stream_id: 1}, status) == nil, "queue first response HEADERS")
    rst_payload := mkslice(byte, 0)
    rst_payload = push(rst_payload, 0)
    rst_payload = push(rst_payload, 0)
    rst_payload = push(rst_payload, 0)
    rst_payload = push(rst_payload, 8)
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: 4, kind: 3, flags: 0, stream_id: 1}, rst_payload) == nil, "queue late RST_STREAM")
    testing.expect(http2.write_frame(writer, http2.FrameHeader{length: 1, kind: 1, flags: 5, stream_id: 3}, status) == nil, "queue second response HEADERS")
    [conn, ce] = http2.new_conn(buf.asreadwriter())
    testing.expect(ce == nil, "initialize connection")
    req := mkslice(http2.Header, 0)
    req = push(req, http2.Header{name: ":method", value: "GET"})
    req = push(req, http2.Header{name: ":scheme", value: "http"})
    req = push(req, http2.Header{name: ":path", value: "/"})
    req = push(req, http2.Header{name: ":authority", value: "127.0.0.1"})
    [id1, oe1] = conn.open_stream(req, true)
    testing.expect(oe1 == nil && id1 == 1, "open first stream")
    [id3, oe3] = conn.open_stream(req, true)
    testing.expect(oe3 == nil && id3 == 3, "open second stream")
    [ev1, he1] = conn.next_event()
    testing.expect(he1 == nil && ev1.stream_id == 1, "first response delivers")
    [ev3, he3] = conn.next_event()
    testing.expect(he3 == nil && ev3.stream_id == 3, "late RST on closed stream ignored before second response")
}

fn test_http2_dial_rejects_nonpositive_timeout() {
    [_, ze] = http2.dial_h2c("127.0.0.1", 1, 0)
    testing.expect(ze != nil, "reject zero timeout")
    testing.expect_streq(errors.msg(ze), "http2: timeout must be positive", "zero timeout error")
    [_, ne] = http2.dial_h2c("127.0.0.1", 1, -5)
    testing.expect(ne != nil && errors.msg(ne) == "http2: timeout must be positive", "reject negative timeout")
}

fn test_http2_control_frame_flood() {
    buf := bytes.newbuffer()
    writer := buf.aswriter()
    [settings, se] = http2.encode_frame(http2.FrameHeader{length: 0, kind: 4, flags: 0, stream_id: 0}, mkslice(byte, 0))
    testing.expect(se == nil, "encode peer SETTINGS")
    [_, we] = writer.write(settings)
    testing.expect(we == nil, "queue peer SETTINGS")
    ping_payload := mkslice(byte, 8)
    i := 0
    for i < 300 {
        testing.expect(http2.write_frame(writer, http2.FrameHeader{length: 8, kind: 6, flags: 0, stream_id: 0}, ping_payload) == nil, "queue PING")
        i = i + 1
    }
    [conn, ce] = http2.new_conn(buf.asreadwriter())
    testing.expect(ce == nil, "initialize connection")
    [_, fe] = conn.next_event()
    testing.expect(fe != nil, "bound control frame floods")
    testing.expect_streq(errors.msg(fe), "http2: control frame flood", "flood error")
}
