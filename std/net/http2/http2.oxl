package http2

import "std/errors"

import "std/io"

let FRAME_HEADER_SIZE = 9

let MAX_FRAME_SIZE = 16777215

struct FrameHeader { length: int, kind: int, flags: int, stream_id: int }

struct Frame { header: FrameHeader, payload: []byte }

fn bad_frame_header() -> FrameHeader {
    return FrameHeader{length: 0, kind: 0, flags: 0, stream_id: 0}
}

fn encode_frame_header(h: FrameHeader) -> [[]byte, err] {
    if h.length < 0 || h.length > MAX_FRAME_SIZE {
        return mkslice(byte, 0), errors.new("http2: invalid frame length")
    }
    if h.kind < 0 || h.kind > 255 || h.flags < 0 || h.flags > 255 {
        return mkslice(byte, 0), errors.new("http2: invalid frame type or flags")
    }
    if h.stream_id < 0 || h.stream_id > 2147483647 {
        return mkslice(byte, 0), errors.new("http2: invalid stream id")
    }
    out := mkslice(byte, FRAME_HEADER_SIZE)
    out[0] = h.length / 65536 % 256
    out[1] = h.length / 256 % 256
    out[2] = h.length % 256
    out[3] = h.kind
    out[4] = h.flags
    out[5] = h.stream_id / 16777216 % 128
    out[6] = h.stream_id / 65536 % 256
    out[7] = h.stream_id / 256 % 256
    out[8] = h.stream_id % 256
    return out, nil
}

fn encode_frame(h: FrameHeader, payload: []byte) -> [[]byte, err] {
    if len(payload) != h.length {
        return mkslice(byte, 0), errors.new("http2: frame payload length mismatch")
    }
    [header, e] = encode_frame_header(h)
    if e != nil {
        return mkslice(byte, 0), e
    }
    out := mkslice(byte, FRAME_HEADER_SIZE + len(payload))
    i := 0
    for i < FRAME_HEADER_SIZE {
        out[i] = header[i]
        i = i + 1
    }
    j := 0
    for j < len(payload) {
        out[FRAME_HEADER_SIZE + j] = payload[j]
        j = j + 1
    }
    return out, nil
}

fn decode_frame_header(raw: []byte, max_frame_size: int) -> [FrameHeader, err] {
    bad := bad_frame_header()
    if len(raw) != FRAME_HEADER_SIZE {
        return bad, errors.new("http2: invalid frame header length")
    }
    if max_frame_size < 16384 || max_frame_size > MAX_FRAME_SIZE {
        return bad, errors.new("http2: invalid maximum frame size")
    }
    if raw[5] >= 128 {
        return bad, errors.new("http2: reserved stream id bit set")
    }
    length := raw[0] * 65536 + raw[1] * 256 + raw[2]
    if length > max_frame_size {
        return bad, errors.new("http2: frame exceeds maximum size")
    }
    stream_id := raw[5] * 16777216 + raw[6] * 65536 + raw[7] * 256 + raw[8]
    return FrameHeader{length: length, kind: raw[3], flags: raw[4], stream_id: stream_id}, nil
}

fn read_exact(r: io.Reader, count: int) -> [[]byte, err] {
    if count < 0 {
        return mkslice(byte, 0), errors.new("http2: invalid read length")
    }
    out := mkslice(byte, count)
    off := 0
    for off < count {
        [n, e] = r.read(out[off:count])
        if n > 0 {
            off = off + n
        }
        if off == count {
            return out, nil
        }
        if e != nil {
            return out, errors.wrap("http2: truncated frame", e)
        }
        if n <= 0 {
            return out, errors.new("http2: reader made no progress")
        }
    }
    return out, nil
}

fn read_frame(r: io.Reader, max_frame_size: int) -> [Frame, err] {
    bad := Frame{header: bad_frame_header(), payload: mkslice(byte, 0)}
    [raw, re] = read_exact(r, FRAME_HEADER_SIZE)
    if re != nil {
        return bad, re
    }
    [header, he] = decode_frame_header(raw, max_frame_size)
    if he != nil {
        return bad, he
    }
    [payload, pe] = read_exact(r, header.length)
    if pe != nil {
        return bad, pe
    }
    frame := Frame{header: header, payload: payload}
    ve := validate_frame(frame)
    if ve != nil {
        return bad, ve
    }
    return frame, nil
}

fn write_all(w: io.Writer, data: []byte) -> err {
    off := 0
    for off < len(data) {
        [n, e] = w.write(data[off:])
        if n > 0 {
            off = off + n
        }
        if e != nil {
            return e
        }
        if n <= 0 {
            return errors.new("http2: writer made no progress")
        }
    }
    return nil
}

fn write_frame(w: io.Writer, header: FrameHeader, payload: []byte) -> err {
    [wire, e] = encode_frame(header, payload)
    if e != nil {
        return e
    }
    return write_all(w, wire)
}

fn read_exact_deadline(r: io.Reader, count: int, fd: int, deadline_ms: int) -> [[]byte, err] {
    if count < 0 {
        return mkslice(byte, 0), errors.new("http2: invalid read length")
    }
    out := mkslice(byte, count)
    off := 0
    for off < count {
        if fd >= 0 && deadline_ms > 0 {
            rem := deadline_ms - now_ms()
            if rem <= 0 {
                return out, errors.new("http2: read deadline exceeded")
            }
            set_rcvtimo_ms(fd, rem)
        }
        [n, e] = r.read(out[off:count])
        if n > 0 {
            off = off + n
        }
        if off == count {
            return out, nil
        }
        if e != nil {
            if fd >= 0 && deadline_ms > 0 && now_ms() >= deadline_ms {
                return out, errors.new("http2: read deadline exceeded")
            }
            return out, errors.wrap("http2: truncated frame", e)
        }
        if n <= 0 {
            return out, errors.new("http2: reader made no progress")
        }
    }
    return out, nil
}

fn read_frame_deadline(r: io.Reader, max_frame_size: int, fd: int, deadline_ms: int) -> [Frame, err] {
    bad := Frame{header: bad_frame_header(), payload: mkslice(byte, 0)}
    [raw, re] = read_exact_deadline(r, FRAME_HEADER_SIZE, fd, deadline_ms)
    if re != nil {
        return bad, re
    }
    [header, he] = decode_frame_header(raw, max_frame_size)
    if he != nil {
        return bad, he
    }
    [payload, pe] = read_exact_deadline(r, header.length, fd, deadline_ms)
    if pe != nil {
        return bad, pe
    }
    frame := Frame{header: header, payload: payload}
    ve := validate_frame(frame)
    if ve != nil {
        return bad, ve
    }
    return frame, nil
}

fn write_all_deadline(w: io.Writer, data: []byte, fd: int, deadline_ms: int) -> err {
    off := 0
    for off < len(data) {
        if fd >= 0 && deadline_ms > 0 {
            rem := deadline_ms - now_ms()
            if rem <= 0 {
                return errors.new("http2: write deadline exceeded")
            }
            set_sndtimo(fd, (rem + 999) / 1000)
        }
        [n, e] = w.write(data[off:])
        if n > 0 {
            off = off + n
        }
        if e != nil {
            if fd >= 0 && deadline_ms > 0 && now_ms() >= deadline_ms {
                return errors.new("http2: write deadline exceeded")
            }
            return e
        }
        if n <= 0 {
            return errors.new("http2: writer made no progress")
        }
    }
    return nil
}

fn write_frame_deadline(w: io.Writer, header: FrameHeader, payload: []byte, fd: int, deadline_ms: int) -> err {
    [wire, e] = encode_frame(header, payload)
    if e != nil {
        return e
    }
    return write_all_deadline(w, wire, fd, deadline_ms)
}

fn validate_frame(frame: Frame) -> err {
    h := frame.header
    [_, he] = encode_frame_header(h)
    if he != nil {
        return he
    }
    if len(frame.payload) != h.length {
        return errors.new("http2: frame payload length mismatch")
    }
    pad := 0
    if h.kind == 0 || h.kind == 1 || h.kind == 5 {
        if (h.flags & 8) != 0 {
            if len(frame.payload) == 0 {
                return errors.new("http2: missing padding length")
            }
            pad = frame.payload[0]
            if pad > len(frame.payload) - 1 {
                return errors.new("http2: invalid padding length")
            }
        }
    }
    start := 0
    if (h.flags & 8) != 0 && (h.kind == 1 || h.kind == 5) {
        start = 1
    }
    available := len(frame.payload) - pad
    if h.kind == 0 {
        if h.stream_id == 0 {
            return errors.new("http2: DATA on stream zero")
        }
    } else if h.kind == 1 {
        if h.stream_id == 0 {
            return errors.new("http2: HEADERS on stream zero")
        }
        if (h.flags & 32) != 0 {
            if available - start < 5 {
                return errors.new("http2: short HEADERS priority section")
            }
            dependency := (frame.payload[start] & 127) * 16777216 + frame.payload[start + 1] * 65536 + frame.payload[start + 2] * 256 + frame.payload[start + 3]
            if dependency == h.stream_id {
                return errors.new("http2: HEADERS depends on itself")
            }
        }
    } else if h.kind == 2 {
        if h.stream_id == 0 || h.length != 5 {
            return errors.new("http2: invalid PRIORITY frame")
        }
        dependency := (frame.payload[0] & 127) * 16777216 + frame.payload[1] * 65536 + frame.payload[2] * 256 + frame.payload[3]
        if dependency == h.stream_id {
            return errors.new("http2: PRIORITY depends on itself")
        }
    } else if h.kind == 3 {
        if h.stream_id == 0 || h.length != 4 {
            return errors.new("http2: invalid RST_STREAM frame")
        }
    } else if h.kind == 4 {
        if h.stream_id != 0 || h.length % 6 != 0 {
            return errors.new("http2: invalid SETTINGS frame")
        }
        if (h.flags & 1) != 0 && h.length != 0 {
            return errors.new("http2: non-empty SETTINGS acknowledgment")
        }
    } else if h.kind == 5 {
        if h.stream_id == 0 || available - start < 4 {
            return errors.new("http2: invalid PUSH_PROMISE frame")
        }
        if (frame.payload[start] & 128) != 0 {
            return errors.new("http2: reserved promised stream id bit set")
        }
    } else if h.kind == 6 {
        if h.stream_id != 0 || h.length != 8 {
            return errors.new("http2: invalid PING frame")
        }
    } else if h.kind == 7 {
        if h.stream_id != 0 || h.length < 8 {
            return errors.new("http2: invalid GOAWAY frame")
        }
        if (frame.payload[0] & 128) != 0 {
            return errors.new("http2: reserved last stream id bit set")
        }
    } else if h.kind == 8 {
        if h.length != 4 {
            return errors.new("http2: invalid WINDOW_UPDATE frame")
        }
        increment := (frame.payload[0] & 127) * 16777216 + frame.payload[1] * 65536 + frame.payload[2] * 256 + frame.payload[3]
        if increment == 0 {
            return errors.new("http2: zero window increment")
        }
    } else if h.kind == 9 {
        if h.stream_id == 0 {
            return errors.new("http2: CONTINUATION on stream zero")
        }
    }
    return nil
}

