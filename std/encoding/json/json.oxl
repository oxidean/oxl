package json

// std/encoding/json — a minimal JSON value tree, serializer, and parser.
//
// One node type carries everything:
//   kind: 0 null · 1 bool · 2 int · 3 str · 4 obj · 5 arr
//   key:  member name when this node sits inside an object
//   s/i/b: payload for str/int/bool nodes
//   child: first member (obj) or element (arr) — a linked list via next
//
// Numbers are ints only; string escapes handle \" \\ \n \t. That covers
// the pilot and config-file cases; floats land via j.f/jfloat,
// \uXXXX escapes are handled — deep unicode edge cases remain v1 work.
// explicit release for `own ?` buffers (mkbuf) — scope arenas don't
// reclaim them, so a temporary scratch must be freed by hand
extern fn rt_free(p: own void)

struct Json {
    kind: int,
    key: str,
    s: str,
    i: int,
    f: float,
    b: bool,
    child: own Json,
    next: own Json,
}

fn jnull() -> own Json {
    j := new(Json)
    j.kind = 0
    return j
}

fn jbool(v: bool) -> own Json {
    j := new(Json)
    j.kind = 1
    j.b = v
    return j
}

fn jint(v: int) -> own Json {
    j := new(Json)
    j.kind = 2
    j.i = v
    return j
}

fn jfloat(v: float) -> own Json {
    j := new(Json)
    j.kind = 6
    j.f = v
    return j
}

fn jstr(v: str) -> own Json {
    j := new(Json)
    j.kind = 3
    j.s = v
    return j
}

fn jobj() -> own Json {
    j := new(Json)
    j.kind = 4
    return j
}

fn jarr() -> own Json {
    j := new(Json)
    j.kind = 5
    return j
}

/// append member/element; key is ignored for arrays
fn jadd(parent: mut Json, key: str, val: own Json) {
    val.key = key
    if parent.child == nil {
        parent.child = val
        return
    }
    last := parent.child
    for last.next != nil {
        last = last.next
    }
    last.next = val
}

/// O(1) append builder for loops adding many members/elements — jadd
/// rescans child->end on every call, so building N nodes that way is
/// O(N^2). JArrB keeps the last node and links at it directly.
struct JArrB { arr: own Json, tail: own Json }

fn jarrb() -> own JArrB {
    b := new(JArrB)
    b.arr = jarr()
    return b
}

/// append v to b's array in O(1)
fn jarrb_add(b: mut JArrB, v: own Json) {
    if b.arr.child == nil {
        b.arr.child = v
        b.tail = b.arr.child
    } else {
        b.tail.next = v
        b.tail = b.tail.next
    }
}

/// the finished array
fn jarrb_arr(b: own JArrB) -> own Json {
    return b.arr
}

/// deep copy of a tree — the result is unlinked and owned outright
fn jclone(j: ref Json) -> own Json {
    c := jnull()
    c.kind = j.kind
    c.key = j.key
    c.s = j.s
    c.i = j.i
    c.f = j.f
    c.b = j.b
    m := j.child
    // link at a tracked tail — jadd rescans child->end per call, which
    // makes cloning an N-member container O(N^2)
    let tail: own Json = nil
    for m != nil {
        v := jclone(m)
        v.key = m.key
        if tail == nil {
            c.child = v
            tail = c.child
        } else {
            tail.next = v
            tail = tail.next
        }
        m = m.next
    }
    return c
}

/// first member with this key as a detached deep copy, or nil
fn jget(obj: ref Json, key: str) -> own Json {
    m := obj.child
    for m != nil {
        if m.key == key {
            return jclone(m)
        }
        m = m.next
    }
    return m
}

// ---------- serialize ----------
// length of the valid UTF-8 sequence at s[i], or 0 when the bytes
// there can't start or complete one (rejects overlongs/surrogates)
fn utf8_seq_len(s: str, i: int) -> int {
    c := byteat(s, i)
    n := 0
    if c >= 194 && c <= 223 {
        n = 2
    }
    if c >= 224 && c <= 239 {
        n = 3
    }
    if c >= 240 && c <= 244 {
        n = 4
    }
    if n == 0 || i + n > len(s) {
        return 0
    }
    k := 1
    for k < n {
        b := byteat(s, i + k)
        if b < 128 || b > 191 {
            return 0
        }
        k = k + 1
    }
    // overlongs: E0 needs A0-BF, F0 needs 90-BF in the second byte —
    // below those the same scalar fits a shorter sequence
    if c == 224 && byteat(s, i + 1) < 160 {
        return 0
    }
    if c == 240 && byteat(s, i + 1) < 144 {
        return 0
    }
    // ED A0-BF encodes UTF-16 surrogates; F4 90-BF exceeds U+10FFFF
    if c == 237 && byteat(s, i + 1) >= 160 {
        return 0
    }
    if c == 244 && byteat(s, i + 1) >= 144 {
        return 0
    }
    return n
}

// writes the escaped form of s into b at pos; returns the new pos.
// Same rules as the old jescape but emits directly — concat-per-byte
// was quadratic: a 100 KiB string allocated ~5 GB through rt_strcat.
fn jput_esc(b: mut void, pos: int, s: str) -> int {
    i := 0
    for i < len(s) {
        c := byteat(s, i)
        if c == 34 {
            pos = jput(b, pos, "\\\"")
        }
        if c == 92 {
            pos = jput(b, pos, "\\\\")
        }
        if c == 10 {
            pos = jput(b, pos, "\\n")
        }
        if c == 9 {
            pos = jput(b, pos, "\\t")
        }
        if c == 13 {
            pos = jput(b, pos, "\\r")
        }
        // RFC 8259: every other byte below 0x20 needs a \u00XX escape
        if c < 32 && c != 10 && c != 9 && c != 13 {
            pos = jput(b, pos, "\\u00")
            poke8(b, pos, byteat("0123456789abcdef", c / 16))
            poke8(b, pos + 1, byteat("0123456789abcdef", c % 16))
            pos = pos + 2
        }
        if c >= 128 {
            // bytes at/above 0x80 must form a valid UTF-8 sequence —
            // anything else becomes U+FFFD so the output a strict JSON
            // reader sees is still well-formed UTF-8
            n := utf8_seq_len(s, i)
            if n == 0 {
                pos = jput(b, pos, "\\ufffd")
            } else {
                k := 0
                for k < n {
                    poke8(b, pos + k, byteat(s, i + k))
                    k = k + 1
                }
                pos = pos + n
                i = i + n - 1
            }
        }
        if c != 34 && c != 92 && c >= 32 && c < 128 {
            poke8(b, pos, c)
            pos = pos + 1
        }
        i = i + 1
    }
    return pos
}

// linear-time writer: `out = out + piece` re-copies the whole prefix
// per field and scope arenas never reclaim the dead copies — quadratic
// on real payloads. Measure the output first, then emit into one sized
// mkbuf — no per-fragment heap nodes to leak.
fn jput(b: mut void, pos: int, s: str) -> int {
    i := 0
    for i < len(s) {
        poke8(b, pos + i, byteat(s, i))
        i = i + 1
    }
    return pos + len(s)
}

// v - v is NaN for inf and nan inputs, 0 for every finite v —
// JSON has no inf/nan literal, so emitters encode them as null
fn jfinite(v: float) -> bool {
    return v - v == 0.0
}

// upper bound on jemit's output: a string grows at most 6x under
// jput_esc (one byte -> \uXXXX at worst), numbers measure exactly
fn jsize(j: ref Json) -> int {
    if j == nil || j.kind == 0 {
        return 4 // "null"
    }
    if j.kind == 1 {
        if j.b {
            return 4 // "true"
        }
        return 5 // "false"
    }
    if j.kind == 2 {
        return len(itoa(j.i))
    }
    if j.kind == 6 {
        if !jfinite(j.f) {
            return 4 // "null" — JSON has no inf/nan literal
        }
        return len(ftoa(j.f))
    }
    if j.kind == 3 {
        return len(j.s) * 6 + 2
    }
    n := 2 // braces
    m := j.child
    first := true
    for m != nil {
        if first {
            first = false
        } else {
            n = n + 1
        }
        if j.kind == 4 {
            n = n + len(m.key) * 6 + 3 // "key":
        }
        n = n + jsize(m)
        m = m.next
    }
    return n
}

fn jemit(j: ref Json, b: mut void, pos: int) -> int {
    if j == nil || j.kind == 0 {
        return jput(b, pos, "null")
    }
    if j.kind == 1 {
        if j.b {
            return jput(b, pos, "true")
        }
        return jput(b, pos, "false")
    }
    if j.kind == 2 {
        return jput(b, pos, itoa(j.i))
    }
    if j.kind == 6 {
        if !jfinite(j.f) {
            return jput(b, pos, "null")
        }
        return jput(b, pos, ftoa(j.f))
    }
    if j.kind == 3 {
        pos = jput(b, pos, "\"")
        pos = jput_esc(b, pos, j.s)
        return jput(b, pos, "\"")
    }
    if j.kind == 4 {
        pos = jput(b, pos, "{")
    } else {
        pos = jput(b, pos, "[")
    }
    m := j.child
    first := true
    for m != nil {
        if first {
            first = false
        } else {
            pos = jput(b, pos, ",")
        }
        if j.kind == 4 {
            pos = jput(b, pos, "\"")
            pos = jput_esc(b, pos, m.key)
            pos = jput(b, pos, "\":")
        }
        pos = jemit(m, b, pos)
        m = m.next
    }
    if j.kind == 4 {
        return jput(b, pos, "}")
    }
    return jput(b, pos, "]")
}

fn tojson(j: ref Json) -> str {
    buf := mkbuf(jsize(j) + 1)
    n := jemit(j, buf, 0)
    out := bufstr(buf, n)
    rt_free(buf) // mkbuf is manual-free scratch — bufstr copies out
    return out
}

// ---------- parse ----------
struct JCur { src: str, pos: int, err: int, depth: int }

fn is_dig(c: int) -> bool {
    return c >= 48 && c <= 57
}

fn is_hexdig(c: int) -> bool {
    return is_dig(c) || c >= 97 && c <= 102 || c >= 65 && c <= 70
}

fn jskipws(p: mut JCur) {
    for p.pos < len(p.src) {
        c := byteat(p.src, p.pos)
        if c != 32 && c != 9 && c != 10 && c != 13 {
            return
        }
        p.pos = p.pos + 1
    }
}

// 4 hex digits -> code point (invalid digits fold to 0)
fn hex4(s: str) -> int {
    v := 0
    i := 0
    for i < 4 {
        c := byteat(s, i)
        d := 0
        if c >= 48 && c <= 57 {
            d = c - 48
        } else if c >= 97 && c <= 102 {
            d = c - 87
        } else if c >= 65 && c <= 70 {
            d = c - 55
        }
        v = v * 16 + d
        i = i + 1
    }
    return v
}

// code point -> UTF-8 string (the lexer only accepts \n \t \r \0 \\ \"
// escapes in source, so control bytes are built through mkbuf)
fn utf8_1(cp: int) -> str {
    buf := mkbuf(1)
    poke8(buf, 0, cp)
    out := bufstr(buf, 1)
    rt_free(buf)
    return out
}

fn utf8_2(cp: int) -> str {
    buf := mkbuf(2)
    poke8(buf, 0, 192 + cp / 64)
    poke8(buf, 1, 128 + cp % 64)
    out := bufstr(buf, 2)
    rt_free(buf)
    return out
}

fn utf8_3(cp: int) -> str {
    buf := mkbuf(3)
    poke8(buf, 0, 224 + cp / 4096)
    poke8(buf, 1, 128 + cp / 64 % 64)
    poke8(buf, 2, 128 + cp % 64)
    out := bufstr(buf, 3)
    rt_free(buf)
    return out
}

// escape sequences only shrink the input (\n 2B→1B, \uXXXX 6B→≤3B),
// so the remaining source length bounds the decode — build into one buffer
// instead of quadratic per-char concatenation
fn jparse_str(p: mut JCur) -> str {
    p.pos = p.pos + 1 // opening quote
    buf := mkbuf(len(p.src) - p.pos + 1)
    // own buf can't defer: capture moves it at registration — every
    // exit frees by hand after bufstr copies the bytes out
    n := 0
    for p.pos < len(p.src) {
        c := byteat(p.src, p.pos)
        if c == 34 {
            p.pos = p.pos + 1
            out := bufstr(buf, n)
            rt_free(buf)
            return out
        }
        if c == 92 {
            p.pos = p.pos + 1
            if p.pos >= len(p.src) {
                p.err = 1
                out := bufstr(buf, n)
                rt_free(buf)
                return out
            }
            e := byteat(p.src, p.pos)
            ok := e == 110 || e == 116 || e == 114 || e == 98 || e == 102 || e == 47 || e == 34 || e == 92
            if e == 117 {
                ok = p.pos + 4 < len(p.src) && is_hexdig(byteat(p.src, p.pos + 1)) && is_hexdig(byteat(p.src, p.pos + 2)) && is_hexdig(byteat(p.src, p.pos + 3)) && is_hexdig(byteat(p.src, p.pos + 4))
            }
            if !ok {
                p.err = 1
                out := bufstr(buf, n)
                rt_free(buf)
                return out
            }
            if e == 117 {
                // \uXXXX — UTF-8 encoded. A high surrogate must pair
                // with a following \uDC00-\uDFFF into one 4-byte seq;
                // lone surrogates are an error (never CESU-8 output)
                cp := hex4(substr(p.src, p.pos + 1, p.pos + 5))
                if cp >= 55296 && cp < 56320 {
                    // the low surrogate's own \uXXXX must be valid hex
                    // too — an invalid escape is malformed input, not a
                    // different codepoint
                    if p.pos + 10 < len(p.src) && byteat(p.src, p.pos + 5) == 92 && byteat(p.src, p.pos + 6) == 117 && is_hexdig(byteat(p.src, p.pos + 7)) && is_hexdig(byteat(p.src, p.pos + 8)) && is_hexdig(byteat(p.src, p.pos + 9)) && is_hexdig(byteat(p.src, p.pos + 10)) {
                        lo := hex4(substr(p.src, p.pos + 7, p.pos + 11))
                        if lo >= 56320 && lo < 57344 {
                            cp = 65536 + (cp - 55296) * 1024 + (lo - 56320)
                            p.pos = p.pos + 6
                        } else {
                            p.err = 1
                            out := bufstr(buf, n)
                            rt_free(buf)
                            return out
                        }
                    } else {
                        p.err = 1
                        out := bufstr(buf, n)
                        rt_free(buf)
                        return out
                    }
                } else if cp >= 56320 && cp < 57344 {
                    p.err = 1
                    out := bufstr(buf, n)
                    rt_free(buf)
                    return out
                }
                if cp < 128 {
                    poke8(buf, n, cp)
                    n = n + 1
                } else if cp < 2048 {
                    poke8(buf, n, 192 + cp / 64)
                    poke8(buf, n + 1, 128 + cp % 64)
                    n = n + 2
                } else if cp < 65536 {
                    poke8(buf, n, 224 + cp / 4096)
                    poke8(buf, n + 1, 128 + cp / 64 % 64)
                    poke8(buf, n + 2, 128 + cp % 64)
                    n = n + 3
                } else {
                    poke8(buf, n, 240 + cp / 262144)
                    poke8(buf, n + 1, 128 + cp / 4096 % 64)
                    poke8(buf, n + 2, 128 + cp / 64 % 64)
                    poke8(buf, n + 3, 128 + cp % 64)
                    n = n + 4
                }
                p.pos = p.pos + 4
            } else {
                b := e
                if e == 110 {
                    b = 10
                }
                if e == 116 {
                    b = 9
                }
                if e == 114 {
                    b = 13
                }
                if e == 98 {
                    b = 8
                }
                if e == 102 {
                    b = 12
                }
                poke8(buf, n, b)
                n = n + 1
            }
            p.pos = p.pos + 1
        } else {
            if c < 32 {
                // RFC 8259: control bytes must be escaped
                p.err = 1
                out := bufstr(buf, n)
                rt_free(buf)
                return out
            }
            poke8(buf, n, c)
            n = n + 1
            p.pos = p.pos + 1
        }
    }
    // unterminated string
    p.err = 1
    out := bufstr(buf, n)
    rt_free(buf)
    return out
}

fn jparse_num(p: mut JCur) -> own Json {
    // strict form: -?(0|[1-9][0-9]*)(.[0-9]+)?([eE][+-]?[0-9]+)?
    start := p.pos
    if byteat(p.src, p.pos) == 45 { // -
        p.pos = p.pos + 1
    }
    if p.pos >= len(p.src) || !is_dig(byteat(p.src, p.pos)) {
        p.err = 1
        return jnull()
    }
    if byteat(p.src, p.pos) == 48 { // 0 — leading zeros are not a form
        p.pos = p.pos + 1
        if p.pos < len(p.src) && is_dig(byteat(p.src, p.pos)) {
            p.err = 1
            return jnull()
        }
    } else {
        for p.pos < len(p.src) && is_dig(byteat(p.src, p.pos)) {
            p.pos = p.pos + 1
        }
    }
    isf := 0
    if p.pos < len(p.src) && byteat(p.src, p.pos) == 46 { // .
        isf = 1
        p.pos = p.pos + 1
        d0 := p.pos
        for p.pos < len(p.src) && is_dig(byteat(p.src, p.pos)) {
            p.pos = p.pos + 1
        }
        if p.pos == d0 {
            p.err = 1
            return jnull()
        }
    }
    if p.pos < len(p.src) && (byteat(p.src, p.pos) == 101 || byteat(p.src, p.pos) == 69) { // e E
        isf = 1
        p.pos = p.pos + 1
        if p.pos < len(p.src) && (byteat(p.src, p.pos) == 43 || byteat(p.src, p.pos) == 45) {
            p.pos = p.pos + 1
        }
        d0 := p.pos
        for p.pos < len(p.src) && is_dig(byteat(p.src, p.pos)) {
            p.pos = p.pos + 1
        }
        if p.pos == d0 {
            p.err = 1
            return jnull()
        }
    }
    if isf == 1 {
        return jfloat(atof(substr(p.src, start, p.pos)))
    }
    return jint(atoi(substr(p.src, start, p.pos)))
}

/// recursion guard — jparse_val's container branches descend through
/// here so a pathological [[[[...]]]] can't overflow the call stack
let MAX_JDEPTH = 256

fn jparse_nested(p: mut JCur) -> own Json {
    if p.depth >= MAX_JDEPTH {
        p.err = 1
        return jnull()
    }
    p.depth = p.depth + 1
    v := jparse_val(p)
    p.depth = p.depth - 1
    return v
}

fn jparse_val(p: mut JCur) -> own Json {
    jskipws(p)
    if p.pos >= len(p.src) {
        p.err = 1
        return jnull()
    }
    c := byteat(p.src, p.pos)
    if c == 34 {
        s := jparse_str(p)
        if p.err != 0 {
            return jnull()
        }
        return jstr(s)
    }
    if c == 123 { // {
        o := jobj()
        let otail: own Json = nil
        p.pos = p.pos + 1
        for p.pos < len(p.src) {
            jskipws(p)
            if p.pos < len(p.src) && byteat(p.src, p.pos) == 125 { // }
                p.pos = p.pos + 1
                return o
            }
            if p.pos >= len(p.src) || byteat(p.src, p.pos) != 34 {
                // member keys are strings only
                p.err = 1
                return o
            }
            k := jparse_str(p)
            if p.err != 0 {
                return o
            }
            jskipws(p)
            if p.pos >= len(p.src) || byteat(p.src, p.pos) != 58 { // :
                p.err = 1
                return o
            }
            p.pos = p.pos + 1
            v := jparse_nested(p)
            v.key = k
            if otail == nil {
                o.child = v
                otail = o.child
            } else {
                otail.next = v
                otail = otail.next
            }
            if p.err != 0 {
                return o
            }
            jskipws(p)
            if p.pos < len(p.src) && byteat(p.src, p.pos) == 44 { // ,
                p.pos = p.pos + 1
                jskipws(p)
                if p.pos >= len(p.src) || byteat(p.src, p.pos) != 34 {
                    // a comma must be followed by another member —
                    // rejects trailing commas too
                    p.err = 1
                    return o
                }
            } else if p.pos >= len(p.src) || byteat(p.src, p.pos) != 125 {
                // only ',' or '}' may follow a member
                p.err = 1
                return o
            }
        }
        // ran out of input inside an object
        p.err = 1
        return o
    }
    if c == 91 { // [
        a := jarr()
        let atail: own Json = nil
        p.pos = p.pos + 1
        for p.pos < len(p.src) {
            jskipws(p)
            if p.pos < len(p.src) && byteat(p.src, p.pos) == 93 { // ]
                p.pos = p.pos + 1
                return a
            }
            v := jparse_nested(p)
            if atail == nil {
                a.child = v
                atail = a.child
            } else {
                atail.next = v
                atail = atail.next
            }
            if p.err != 0 {
                return a
            }
            jskipws(p)
            if p.pos < len(p.src) && byteat(p.src, p.pos) == 44 {
                p.pos = p.pos + 1
                jskipws(p)
                if p.pos < len(p.src) && byteat(p.src, p.pos) == 93 {
                    // trailing comma
                    p.err = 1
                    return a
                }
            } else if p.pos >= len(p.src) || byteat(p.src, p.pos) != 93 {
                // only ',' or ']' may follow an element
                p.err = 1
                return a
            }
        }
        // ran out of input inside an array
        p.err = 1
        return a
    }
    if c == 116 && p.pos + 4 <= len(p.src) && substr(p.src, p.pos, p.pos + 4) == "true" {
        p.pos = p.pos + 4
        return jbool(true)
    }
    if c == 102 && p.pos + 5 <= len(p.src) && substr(p.src, p.pos, p.pos + 5) == "false" {
        p.pos = p.pos + 5
        return jbool(false)
    }
    if c == 110 && p.pos + 4 <= len(p.src) && substr(p.src, p.pos, p.pos + 4) == "null" {
        p.pos = p.pos + 4
        return jnull()
    }
    if c == 45 || is_dig(c) {
        return jparse_num(p)
    }
    p.err = 1
    return jnull()
}

/// parse text into a Json tree (null node on malformed input)
fn jparse(src: str) -> own Json {
    p := new(JCur)
    p.src = src
    p.pos = 0
    p.err = 0
    p.depth = 0
    v := jparse_val(p)
    jskipws(p)
    if p.err != 0 || p.pos != len(p.src) {
        // malformed input, or a valid prefix followed by garbage —
        // both must report the malformed-input result, not the tree.
        // (the partial tree leaks: `own T` can't cross rt_free's
        // `own void` FFI boundary in v0)
        return jnull()
    }
    return v
}
