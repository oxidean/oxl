package ed25519

// std/crypto/ed25519 — RFC 8032 Ed25519 signature verify only:
// compressed-point decode (sqrt-ratio over the 25519 field),
// SHA-512 from X1, and the [S]B == R + [k]A group equation over
// extended Edwards coordinates. The field is a private copy of the
// ref10-style 10-limb arithmetic — std/crypto/x25519 deliberately
// exports scalarmult only, so this package carries its own.
//
// Verify is over public data; nothing here is constant-time.
import "std/crypto/bignum"

import "std/crypto/sha512"

import "std/encoding/hex"

import "std/errors"

import "std/slices"

// powers of two — eager table (a lazy fill would publish a shared
// global unsynchronized); limb work needs / * on radix boundaries
fn mkp2() -> []int {
    t := mkslice(int, 33)
    v := 1
    i := 0
    for i < 33 {
        t[i] = v
        v = v * 2
        i = i + 1
    }
    return slices.clone(t)
}

let P2: []int = mkp2()

// ---- the 25519 field: 10 limbs, 26/25-bit alternating radix ----
fn lbits(i: int) -> int {
    if i % 2 == 0 {
        return 26
    }
    return 25
}

// plimb is p = 2^255-19 in limb form — the sub/neg bias (k*p adds
// nothing mod p)
fn plimb(i: int) -> int {
    if i == 0 {
        return P2[26] - 19
    }
    return P2[lbits(i)] - 1
}

fn fe0() -> []int {
    return mkslice(int, 10)
}

fn fe1() -> []int {
    h := mkslice(int, 10)
    h[0] = 1
    return h
}

fn fecopy(f: []int) -> []int {
    h := mkslice(int, 10)
    i := 0
    for i < 10 {
        h[i] = f[i]
        i = i + 1
    }
    return h
}

// carry: limb excesses propagate up; the wrap out of limb 9 folds
// into limb 0 times 19 (2^255 == 19 mod p)
fn carry(h: []int) {
    i := 0
    for i < 9 {
        b := P2[lbits(i)]
        c := h[i] / b
        h[i] = h[i] - c * b
        h[i + 1] = h[i + 1] + c
        i = i + 1
    }
    b := P2[25]
    c := h[9] / b
    h[9] = h[9] - c * b
    h[0] = h[0] + c * 19
    c = h[0] / P2[26]
    h[0] = h[0] - c * P2[26]
    h[1] = h[1] + c
}

// carry_drop propagates limb excesses up and drops the carry out
// of limb 9 — the tobytes subtract step, where pushing +19 must
// yield h + 19 - 2^255 (= h - p), not h + 19 mod p.
fn carry_drop(h: []int) {
    i := 0
    for i < 9 {
        b := P2[lbits(i)]
        c := h[i] / b
        h[i] = h[i] - c * b
        h[i + 1] = h[i + 1] + c
        i = i + 1
    }
    h[9] = h[9] - h[9] / P2[25] * P2[25]
}

fn fe_add(f: []int, g: []int) -> []int {
    h := mkslice(int, 10)
    i := 0
    for i < 10 {
        h[i] = f[i] + g[i]
        i = i + 1
    }
    carry(h)
    return h
}

fn fe_sub(f: []int, g: []int) -> []int {
    h := mkslice(int, 10)
    i := 0
    for i < 10 {
        h[i] = f[i] + 2 * plimb(i) - g[i]
        i = i + 1
    }
    carry(h)
    return h
}

fn fe_neg(f: []int) -> []int {
    h := mkslice(int, 10)
    i := 0
    for i < 10 {
        h[i] = 2 * plimb(i) - f[i]
        i = i + 1
    }
    carry(h)
    return h
}

// fe_mul: the alternating radix puts odd*odd products one bit above
// position i+j — direct terms fold at 2x, wrap (>= 2^255) at 38x.
fn fe_mul(f: []int, g: []int) -> []int {
    h := mkslice(int, 10)
    k := 0
    for k < 10 {
        s := 0
        i := 0
        for i <= k {
            j := k - i
            if i % 2 == 1 && j % 2 == 1 {
                s = s + 2 * f[i] * g[j]
            } else {
                s = s + f[i] * g[j]
            }
            i = i + 1
        }
        for i < 10 {
            j := k + 10 - i
            if i % 2 == 1 && j % 2 == 1 {
                s = s + 38 * f[i] * g[j]
            } else {
                s = s + 19 * f[i] * g[j]
            }
            i = i + 1
        }
        h[k] = s
        k = k + 1
    }
    carry(h)
    return h
}

fn fe_sq(f: []int) -> []int {
    return fe_mul(f, f)
}

// fe_pow252m3 is h^(2^252-3) — the (p-5)/8 exponent of the sqrt
// ratio; its bits are all 1 on [2,251] plus bit 0.
fn fe_pow252m3(h: []int) -> []int {
    r := fe1()
    i := 251
    for i >= 0 {
        r = fe_sq(r)
        if i >= 2 || i == 0 {
            r = fe_mul(r, h)
        }
        i = i - 1
    }
    return r
}

fn fe_frombytes(b: []byte) -> []int {
    h := mkslice(int, 10)
    w := 0
    i := 0
    for i < 10 {
        v := 0
        nb := lbits(i)
        bit := 0
        for bit < nb {
            pos := w + bit
            if b[pos / 8] / P2[pos % 8] % 2 == 1 {
                v = v + P2[bit]
            }
            bit = bit + 1
        }
        h[i] = v
        w = w + nb
        i = i + 1
    }
    return h
}

// geqp reports whether normalized h >= p (h + 19 reaching 2^255 —
// the carry survives only through all-max limbs)
fn geqp(h: []int) -> bool {
    c := (h[0] + 19) / P2[26]
    i := 1
    for i < 10 {
        c = (h[i] + c) / P2[lbits(i)]
        i = i + 1
    }
    return c > 0
}

fn fe_tobytes(h: []int) -> []byte {
    t := fecopy(h)
    carry(t)
    if geqp(t) {
        // h >= p: subtracting p == +19 then DISCARD the 2^255
        // overflow — carry_drop, not the mod-p folding carry
        t[0] = t[0] + 19
        carry_drop(t)
    }
    out := mkslice(byte, 32)
    pos := 0
    i := 0
    for i < 10 {
        v := t[i]
        nb := lbits(i)
        bit := 0
        for bit < nb {
            if v % 2 == 1 {
                j := pos / 8
                out[j] = out[j] + P2[pos % 8]
            }
            v = v / 2
            pos = pos + 1
            bit = bit + 1
        }
        i = i + 1
    }
    return out
}

fn fe_equal(f: []int, g: []int) -> bool {
    fb := fe_tobytes(f)
    gb := fe_tobytes(g)
    i := 0
    for i < 32 {
        if fb[i] != gb[i] {
            return false
        }
        i = i + 1
    }
    return true
}

fn fe_iszero(f: []int) -> bool {
    fb := fe_tobytes(f)
    i := 0
    for i < 32 {
        if fb[i] != 0 {
            return false
        }
        i = i + 1
    }
    return true
}

fn fe_parity(f: []int) -> int {
    b := fe_tobytes(f)
    return b[0] % 2
}

// ---- curve constants (limb form, verified against the RFC's
// decimal values) ----

// d = -121665/121666 mod p
fn mkfed() -> []int {
    t := mkslice(int, 10)
    t[0] = 56195235
    t[1] = 13857412
    t[2] = 51736253
    t[3] = 6949390
    t[4] = 114729
    t[5] = 24766616
    t[6] = 60832955
    t[7] = 30306712
    t[8] = 48412415
    t[9] = 21499315
    return slices.clone(t)
}

let FED: []int = mkfed()

// sqrt(-1) = 2^((p-1)/4)
fn mksqrtm1() -> []int {
    t := mkslice(int, 10)
    t[0] = 34513072
    t[1] = 25610706
    t[2] = 9377949
    t[3] = 3500415
    t[4] = 12389472
    t[5] = 33281959
    t[6] = 41962654
    t[7] = 31548777
    t[8] = 326685
    t[9] = 11406482
    return slices.clone(t)
}

let SQRTM1: []int = mksqrtm1()

// base point x/y in limb form
fn mkbx() -> []int {
    t := mkslice(int, 10)
    t[0] = 52811034
    t[1] = 25909283
    t[2] = 16144682
    t[3] = 17082669
    t[4] = 27570973
    t[5] = 30858332
    t[6] = 40966398
    t[7] = 8378388
    t[8] = 20764389
    t[9] = 8758491
    return slices.clone(t)
}

let BX: []int = mkbx()

fn mkby() -> []int {
    t := mkslice(int, 10)
    t[0] = 40265304
    t[1] = 26843545
    t[2] = 13421772
    t[3] = 20132659
    t[4] = 26843545
    t[5] = 6710886
    t[6] = 53687091
    t[7] = 13421772
    t[8] = 40265318
    t[9] = 26843545
    return slices.clone(t)
}

let BY: []int = mkby()

// ---- group order work rides on bignum ----

// lbn is the subgroup order L = 2^252 +
// 27742317777372353535851937790883648493 as bignum limbs
fn lbn() -> []int {
    [b, e] = hex.decode("1000000000000000000000000000000014def9dea2f79cd65812631a5cf5d3ed")
    if e != nil {
        assert(e == nil)
    }
    return bignum.from_be_bytes(b)
}

// le_to_bn reads a little-endian byte string as an integer
fn le_to_bn(b: []byte) -> []int {
    r := mkslice(byte, len(b))
    i := 0
    for i < len(b) {
        r[i] = b[len(b) - 1 - i]
        i = i + 1
    }
    return bignum.from_be_bytes(r)
}

// bn_bit extracts bit i of a bignum — / % on base-2^26 limbs
fn bn_bit(a: []int, i: int) -> int {
    li := i / 26
    if li >= len(a) {
        return 0
    }
    return a[li] / P2[i % 26] % 2
}

// ---- extended Edwards coordinates (a == -1) ----

// Point is (X:Y:Z:T) extended coordinates; affine (x/z, y/z), t=xy/z
struct Point { x: []int, y: []int, z: []int, t: []int }

fn ident() -> Point {
    return Point{x: fe0(), y: fe1(), z: fe1(), t: fe0()}
}

fn basepoint() -> Point {
    return Point{x: BX, y: BY, z: fe1(), t: fe_mul(BX, BY)}
}

// ge_add — add-2008-hwcd for a=-1 (C = d*T1*T2)
fn ge_add(p: Point, q: Point) -> Point {
    a := fe_mul(p.x, q.x)
    b := fe_mul(p.y, q.y)
    c := fe_mul(FED, fe_mul(p.t, q.t))
    d := fe_mul(p.z, q.z)
    e := fe_sub(fe_sub(fe_mul(fe_add(p.x, p.y), fe_add(q.x, q.y)), a), b)
    f := fe_sub(d, c)
    g := fe_add(d, c)
    h := fe_add(b, a)
    return Point{x: fe_mul(e, f), y: fe_mul(g, h), z: fe_mul(f, g), t: fe_mul(e, h)}
}

// ge_dbl — dbl-2008-hwcd
fn ge_dbl(p: Point) -> Point {
    a := fe_sq(p.x)
    b := fe_sq(p.y)
    c := fe_add(fe_sq(p.z), fe_sq(p.z))
    d := fe_neg(a)
    e := fe_sub(fe_sub(fe_sq(fe_add(p.x, p.y)), a), b)
    g := fe_add(d, b)
    f := fe_sub(g, c)
    h := fe_sub(d, b)
    return Point{x: fe_mul(e, f), y: fe_mul(g, h), z: fe_mul(f, g), t: fe_mul(e, h)}
}

// scalarmult is k*P — binary double-and-add over the bignum scalar
// bits (public data in verify, so no constant-time need).
fn scalarmult(p: Point, k: []int) -> Point {
    r := ident()
    i := bignum.bitlen(k) - 1
    for i >= 0 {
        r = ge_dbl(r)
        if bn_bit(k, i) == 1 {
            r = ge_add(r, p)
        }
        i = i - 1
    }
    return r
}

// pbytes is p = 2^255-19 little-endian — the canonical-y bound
fn pbytes() -> []byte {
    [b, e] = hex.decode("edffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff7f")
    if e != nil {
        assert(e == nil)
    }
    return b
}

// decode unpacks a compressed point: y from the low 255 bits
// (rejected unless canonical), x recovered by the sqrt ratio with
// the sign bit disambiguating.
fn decode(s: []byte) -> [Point, err] {
    zp := Point{x: nil, y: nil, z: nil, t: nil}
    if len(s) != 32 {
        return zp, errors.new("ed25519: point is not 32 bytes")
    }
    // canonical y: y < p — compare against p's LE bytes, top byte's
    // sign bit ignored
    pb := pbytes()
    lt := false
    i := 31
    for i >= 0 {
        a := s[i]
        if i == 31 {
            a = a & 127
        }
        if a < pb[i] {
            lt = true
            break
        }
        if a > pb[i] {
            break
        }
        i = i - 1
    }
    if !lt {
        return zp, errors.new("ed25519: non-canonical y")
    }
    sign := s[31] / 128
    y := fe_frombytes(s)
    yy := fe_sq(y)
    u := fe_sub(yy, fe1())
    v := fe_add(fe_mul(FED, yy), fe1())
    // x = u v^3 (u v^7)^((p-5)/8)
    v3 := fe_mul(v, fe_sq(v))
    v7 := fe_mul(v3, fe_sq(fe_sq(v)))
    x := fe_mul(fe_mul(u, v3), fe_pow252m3(fe_mul(u, v7)))
    vx2 := fe_mul(v, fe_sq(x))
    if !fe_equal(vx2, u) {
        if fe_equal(vx2, fe_neg(u)) {
            x = fe_mul(x, SQRTM1)
            if !fe_equal(fe_mul(v, fe_sq(x)), u) {
                return zp, errors.new("ed25519: no square root")
            }
        } else {
            return zp, errors.new("ed25519: no square root")
        }
    }
    if fe_iszero(x) && sign == 1 {
        return zp, errors.new("ed25519: x=0 with sign set")
    }
    if fe_parity(x) != sign {
        x = fe_neg(x)
    }
    return Point{x: x, y: y, z: fe1(), t: fe_mul(x, y)}, nil
}

/// verify checks a 64-byte Ed25519 signature (R || S) over msg
/// against the 32-byte public key: [S]B == R + [H(R||A||M)]A.
/// Returns nil on a good signature, a non-nil err on any failure —
/// decode failures and mismatches are the same posture.
fn verify(pub: []byte, msg: []byte, sig: []byte) -> err {
    if len(pub) != 32 {
        return errors.new("ed25519: public key is not 32 bytes")
    }
    if len(sig) != 64 {
        return errors.new("ed25519: signature is not 64 bytes")
    }
    sb := le_to_bn(sig[32:64])
    if bignum.cmp(sb, lbn()) >= 0 {
        return errors.new("ed25519: scalar S >= L")
    }
    [a, ea] = decode(pub)
    if ea != nil {
        return ea
    }
    [r, er] = decode(sig[0:32])
    if er != nil {
        return er
    }
    h := sha512.new()
    [w1, e1] = h.write(sig[0:32])
    [w2, e2] = h.write(pub)
    [w3, e3] = h.write(msg)
    kb := bignum.mod(le_to_bn(h.sum(nil)), lbn())
    // [S]B ?= R + [k]A — projective compare, no inversion needed
    sbp := scalarmult(basepoint(), sb)
    rk := ge_add(r, scalarmult(a, kb))
    xok := fe_equal(fe_mul(sbp.x, rk.z), fe_mul(rk.x, sbp.z))
    yok := fe_equal(fe_mul(sbp.y, rk.z), fe_mul(rk.y, sbp.z))
    if xok && yok {
        return nil
    }
    return errors.new("ed25519: signature mismatch")
}
