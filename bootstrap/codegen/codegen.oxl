package codegen

// bootstrap/codegen — the C emitter, written in .oxl.
// Fourth self-host component: ports oxl/src/codegen.rs over the
// bootstrap parser's `Node` AST, consuming check.oxl's tables (fn sigs,
// struct/enum layouts, globals, susp set). Emits C against runtime/rt.
//
//   oxl run bootstrap/cmd/codegen -- file.oxl > out.c
//   cc -O2 -pthread -Iruntime out.c runtime/rt.c -lsqlite3 -o out
//
// Full surface: methods + interfaces emit as RtIface/vtab pairs and
// generic fns mono-instantiate per call binding (seed insts).
import "oxl/bootstrap/check"

import "std/collections"

// ---------- output accumulation ----------
// `g.w` is the current line buffer; nested emitters (match block arms,
// closures, frame bodies) swap it out and join captures with `wjoin`
// (pairwise fold — repeated `+` concat is quadratic at file scale).
fn wjoin(parts: []str) -> str {
    if len(parts) == 0 {
        return ""
    }
    for len(parts) > 1 {
        next := mkslice(str, (len(parts) + 1) / 2)
        j := 0
        i := 0
        for i < len(parts) {
            if i + 1 < len(parts) {
                next[j] = parts[i] + parts[i + 1]
            } else {
                next[j] = parts[i]
            }
            j = j + 1
            i = i + 2
        }
        parts = next
    }
    return parts[0]
}

// ---------- generator state ----------

// where a suspend point's result lands (seed FDest)
struct GDest { k: int, a: str, b: str } // 0 void, 1 field, 2 assign, 3 pair

// one (name, init-expr, ty) decode from a match pattern
struct GBnd { n: str, ce: str, t: int, next: own GBnd }

fn gbnd(n: str, ce: str, t: int, next: own GBnd) -> own GBnd {
    c := new(GBnd)
    c.n = n
    c.ce = ce
    c.t = t
    c.next = next
    return c
}

// match arm decode: has=0 → unconditional (else), has=1 → `if (cond)`
struct GArm { has: int, cond: str, binds: own GBnd }

// enum variant lookup result (seed Option<(en, v, i)>)
struct GEV { ok: bool, en: str, vn: str, i: int }

// (continue, break) label pair per enclosing loop in a frame body
struct GLab { c: str, b: str, d: int }

// buffer-length snapshot before one decl's emission — every line an
// emit appends to a buffer lands in that decl's unit (seed drain())
struct GSnp {
    h: int,
    tp: int,
    fd: int,
    cp: int,
    vt: int,
    fb: int,
    ob: int,
    cb: int,
    gi: int,
}

// one reachability unit — the emitted C owned by a single decl (or a
// synthesized helper: instantiation, vtab pair, fn-value wrap) split
// across the output bands, the C symbols it defines, and oxl_main
// init lines for globals (seed Unit). A token in live text spelling
// one of defs is a use edge.
struct GUnit {
    hd: []str,
    tp: []str,
    fd: []str,
    cp: []str,
    vt: []str,
    fb: []str,
    ob: []str,
    cb: []str,
    gi: []str,
    defs: []str,
    root: int,
}

// forward-appending Node list builder for the hoist transform
struct GBuf { items: own parser.NList, tail: own parser.NList }

fn nput(b: mut GBuf, s: own parser.Node) {
    c := parser.ncons(s, nil)
    if b.items == nil {
        b.items = c
        b.tail = b.items
    } else {
        b.tail.next = c
        b.tail = b.tail.next
    }
}

// one queued monomorphized instantiation (seed insts entry)
struct GInst {
    q: str,
    mangled: str,
    bind: own collections.Map,
    next: own GInst,
}

// one materialized (iface, impl) vtab pair — newest first
struct GVU { w: str, impl: str, next: own GVU }

// how a resolved call emits (seed CallPlan): k 0 = not a call target,
// 1 = oxl fn (dotted=1 -> the receiver expr precedes args),
// 2 = iface vtab slot
struct GCP {
    k: int,
    dotted: int,
    q: str,
    w: str,
    midx: int,
    mname: str,
    ps: own check.IList,
    rk: int,
    r1: int,
}

// one call arg after coercion: text plus borrow marks around it
struct GArgOut { v: str, pre: str, post: str }

// resolved pair-call info: the emitted pair-struct tag + the val ty
struct GPair { tag: str, vt: int }

struct G {
    ck: own check.Ck,
    its: []check.It,
    fidx: own collections.Map, // qualified fn name -> its[] idx
    env: own check.Env, // emission scopes: name -> ty handle
    benv: own check.Env, // match-pattern binds for xty
    fsl: own check.Env, // frame slots: name -> -2 (p_name) or vN idx
    w: []str, // current output target
    wst: own WStk, // saved buffers for nested emit contexts
    wlast: []str, // buffer detached by the last wpop
    head: []str, // header + type decls + protos
    out: []str, // fn bodies
    tramp: []str, // spawn trampolines
    fhead: []str, // frame struct decls + poll protos
    fbody: []str, // poll driver bodies
    clpro: []str, // closure env structs + protos + fnv wraps
    clbod: []str, // closure wrapper bodies
    ginit: []str, // global initializer stmts for oxl_main
    maink: int, // 0 none, 1 susp main, 2 plain main
    testm: int, // 1 = emit a test_* runner as oxl_main
    defers: own parser.NList, // LIFO defer calls for the current fn
    fnv: own check.SList, // named fns needing zero-env wrappers
    fdecls: []str, // collected "cty vN;" frame fields
    sdecls: []str, // "RtScope scN;" frame fields
    states: []int, // resume labels used in this frame
    loops: []GLab, // (continue, break) label stack
    sopen: []int, // sdecls indices of scopes open at this emission point
    tmpn: int,
    scopen: int,
    cln: int,
    staten: int,
    labeln: int,
    hoistn: int,
    retk: int, // current fn ret kind (2 = [T, err])
    cret: int, // current fn declared ret1 tyid (-1 none; conv target)
    subst: own collections.Map, // tyvar -> tyid for the inst being emitted (nil = off)
    drop_tys: []str, // struct/enum names needing an o_drop_<n> chan-payload destructor
    drop_word: int, // payload kinds that only need rt_free on the word
    drop_slice: int, // own-slice payloads needing the two-free thunk
    insts: own GInst, // pending instantiation queue (LIFO)
    inst_done: own collections.Map, // mangled inst name -> 1
    vtabs: own GVU, // materialized (iface, impl) pairs, newest first
    vtab_set: own collections.Map, // "w|impl" -> 1 dedup
    vout: []str, // vtab thunks + arrays (emitted after out)
    cur: str, // current fn's qualified name
    inframe: int,
    // G1 — reachability units + their def->claimant chains (Map
    // values are int-only, so dchain holds [unit idx, next] pairs)
    units: []GUnit,
    dpos: own collections.Map,
    dchain: []int,
    uhits: []int,
    live: []int,
}

fn wl(g: mut G, s: str) {
    g.w = push(g.w, s)
}

fn wln(g: mut G, s: str) {
    g.w = push(g.w, s + "\n")
}

struct WStk { w: []str, next: own WStk }

// save the current emit target on a stack, start a fresh one
fn wpush(g: mut G) {
    s := new(WStk)
    s.w = g.w
    s.next = g.wst
    g.wst = s
    g.w = mkslice(str, 0)
}

// finish the current buffer into g.wlast, restore the saved one
fn wpop(g: mut G) {
    g.wlast = g.w
    g.w = g.wst.w
    g.wst = g.wst.next
}

// ---------- G1 reachability (seed Unit/drain/scan_refs) ----------
fn gusnap(g: ref G) -> GSnp {
    return GSnp{h: len(g.head), tp: len(g.tramp), fd: len(g.fhead), cp: len(g.clpro), vt: len(g.vout), fb: len(g.fbody), ob: len(g.w), cb: len(g.clbod), gi: len(g.ginit)}
}

// open a fresh unit — returns its index
fn gubegin(g: mut G) -> int {
    g.units = push(g.units, GUnit{hd: nil, tp: nil, fd: nil, cp: nil, vt: nil, fb: nil, ob: nil, cb: nil, gi: nil, defs: nil, root: 0})
    return len(g.units) - 1
}

// move every line appended since `s` into unit `u`'s band slices —
// buffers stay as staging only; output joins live units per band
fn gudrain(g: mut G, u: int, s: GSnp) {
    i := s.h
    for i < len(g.head) {
        g.units[u].hd = push(g.units[u].hd, g.head[i])
        i = i + 1
    }
    i = s.tp
    for i < len(g.tramp) {
        g.units[u].tp = push(g.units[u].tp, g.tramp[i])
        i = i + 1
    }
    i = s.fd
    for i < len(g.fhead) {
        g.units[u].fd = push(g.units[u].fd, g.fhead[i])
        i = i + 1
    }
    i = s.cp
    for i < len(g.clpro) {
        g.units[u].cp = push(g.units[u].cp, g.clpro[i])
        i = i + 1
    }
    i = s.vt
    for i < len(g.vout) {
        g.units[u].vt = push(g.units[u].vt, g.vout[i])
        i = i + 1
    }
    i = s.fb
    for i < len(g.fbody) {
        g.units[u].fb = push(g.units[u].fb, g.fbody[i])
        i = i + 1
    }
    i = s.ob
    for i < len(g.w) {
        g.units[u].ob = push(g.units[u].ob, g.w[i])
        i = i + 1
    }
    i = s.cb
    for i < len(g.clbod) {
        g.units[u].cb = push(g.units[u].cb, g.clbod[i])
        i = i + 1
    }
    i = s.gi
    for i < len(g.ginit) {
        g.units[u].gi = push(g.units[u].gi, g.ginit[i])
        i = i + 1
    }
}

// init-phase drain: eval stmts appended to g.w join the global's init
// band ahead of the assign line — they compute the init value, so
// they belong inside oxl_main's prologue (seed u.init)
fn gudrain_init(g: mut G, u: int, s: GSnp) {
    i := s.ob
    for i < len(g.w) {
        g.units[u].gi = push(g.units[u].gi, g.w[i])
        i = i + 1
    }
    gudrain(g, u, s)
}

// register a C symbol `s` as defined by unit `u` — colliding
// spellings chain every claimant through dchain
fn gdef(g: mut G, u: int, sym: str) {
    g.units[u].defs = push(g.units[u].defs, sym)
    old := -1
    if collections.map_has(g.dpos, sym) {
        [v, err] = collections.map_get(g.dpos, sym)
        if err == nil {
            old = v
        }
    }
    g.dchain = push(g.dchain, u)
    g.dchain = push(g.dchain, old)
    collections.map_set(g.dpos, sym, len(g.dchain) - 2)
}

// every identifier token in `text` that some unit defines is a use
// edge — the emitted C names exactly the symbols it links against, so
// scanning it yields the resolved call/type/vtab edges directly
// (seed scan_refs). Claimant unit indices append to g.uhits.
fn gscan(g: mut G, text: str) {
    n := len(text)
    i := 0
    for i < n {
        c := byteat(text, i)
        if c == 95 || c >= 65 && c <= 90 || c >= 97 && c <= 122 {
            st := i
            i = i + 1
            for i < n {
                c = byteat(text, i)
                if c == 95 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c >= 48 && c <= 57 {
                    i = i + 1
                } else {
                    break
                }
            }
            h := -1
            if collections.map_has(g.dpos, substr(text, st, i)) {
                [v, err] = collections.map_get(g.dpos, substr(text, st, i))
                if err == nil {
                    h = v
                }
            }
            for h >= 0 {
                g.uhits = push(g.uhits, g.dchain[h])
                h = g.dchain[h + 1]
            }
        } else {
            i = i + 1
        }
    }
}

// does `s` contain a '.' — main-package globals carry bare names
fn ghasdot(s: str) -> int {
    i := 0
    for i < len(s) {
        if byteat(s, i) == 46 {
            return 1
        }
        i = i + 1
    }
    return 0
}

// replace the first `mark` in `s` with `ins` (the @@GLOBALS@@ hole)
fn gsplice(s: str, mark: str, ins: str) -> str {
    i := 0
    for i + len(mark) <= len(s) {
        if substr(s, i, i + len(mark)) == mark {
            return substr(s, 0, i) + ins + substr(s, i + len(mark), len(s))
        }
        i = i + 1
    }
    return s
}

// collect call args as evaluated C fragments (linked list — []str returns
// can't be written in the `->` position)
struct GAv { v: str, next: own GAv }

fn gav(g: mut G, args: ref parser.NList) -> own GAv {
    let head: own GAv = nil
    let tail: own GAv = nil
    l := args
    for l != nil {
        v := gx(g, l.v)
        c := new(GAv)
        c.v = v
        if head == nil {
            head = c
            tail = c
        } else {
            tail.next = c
            tail = tail.next
        }
        l = l.next
    }
    return head
}

fn gav_at(a: ref GAv, i: int) -> str {
    n := i
    for a != nil && n > 0 {
        a = a.next
        n = n - 1
    }
    if a == nil {
        return "0"
    }
    return a.v
}

fn gav_join(a: ref GAv) -> str {
    j := ""
    first := true
    for a != nil {
        if !first {
            j = j + ", "
        }
        first = false
        j = j + a.v
        a = a.next
    }
    return j
}

// ---------- name / literal helpers ----------

// oxl `mod.name` -> C identifier `mod_name`
fn cname(s: str) -> str {
    out := ""
    i := 0
    for i < len(s) {
        c := substr(s, i, i + 1)
        if byteat(s, i) == 46 {
            c = "_"
        }
        out = out + c
        i = i + 1
    }
    return out
}

fn hex2(c: int) -> str {
    d := "0123456789abcdef"
    return substr(d, c / 16, c / 16 + 1) + substr(d, c % 16, c % 16 + 1)
}

fn c_escape(s: str) -> str {
    out := ""
    i := 0
    for i < len(s) {
        c := byteat(s, i)
        if c == 92 {
            out = out + "\\\\"
        }
        if c == 34 {
            out = out + "\\\""
        }
        if c == 10 {
            out = out + "\\n"
        }
        if c == 13 {
            out = out + "\\r"
        }
        if c == 9 {
            out = out + "\\t"
        }
        if c == 0 {
            out = out + "\\0"
        }
        if c < 32 && c != 0 && c != 9 && c != 10 && c != 13 {
            out = out + "\\x" + hex2(c)
        }
        if c >= 32 && c != 34 && c != 92 {
            out = out + substr(s, i, i + 1)
        }
        i = i + 1
    }
    return out
}

// ---------- type helpers over the checker's interned handles ----------

// `Node.Ty` payload -> ty handle
fn gty(g: mut G, n: ref parser.Node) -> int {
    return check.ty_parse(g.ck, check.ty_str(n))
}

// ty kind of a handle (-1 for missing)
fn tyk(g: ref G, t: int) -> int {
    if t < 0 || t >= len(g.ck.tyv) {
        return -1
    }
    return g.ck.tyv[t].k
}

// inner handle of own/ref/mut/slice (-1)
fn tyi(g: ref G, t: int) -> int {
    if t < 0 || t >= len(g.ck.tyv) {
        return -1
    }
    return g.ck.tyv[t].i
}

// ty -> C type (seed cty)
fn gcty(g: mut G, t: int) -> str {
    t = gsub(g, t)
    k := tyk(g, t)
    if k == check.k_int() || k == check.k_err() {
        return "int64_t"
    }
    if k == check.k_byte() {
        return "uint8_t"
    }
    if k == check.k_float() {
        return "double"
    }
    if k == check.k_bool() {
        return "int"
    }
    if k == check.k_str() {
        return "OxlStr"
    }
    if k == check.k_cstr() {
        return "const char*"
    }
    if k == check.k_void() {
        return "void"
    }
    if k == check.k_chan() {
        return "RtChan*"
    }
    if k == check.k_shared() {
        return "RtShared*"
    }
    if k == check.k_scope() {
        return "RtScope*"
    }
    if k == check.k_slice() {
        return "RtSlice"
    }
    if k == check.k_fn() {
        return "RtFnv"
    }
    if k == check.k_iface() {
        return "RtIface"
    }
    if k == check.k_struct() {
        return "struct o_s_" + cname(g.ck.tyv[t].name)
    }
    if k == check.k_enum() {
        return "struct o_en_" + cname(g.ck.tyv[t].name)
    }
    if k == check.k_own() || k == check.k_ref() || k == check.k_mut() {
        i := tyi(g, t)
        ik := tyk(g, i)
        if ik == check.k_struct() {
            return "struct o_s_" + cname(g.ck.tyv[i].name) + "*"
        }
        if ik == check.k_enum() {
            return "struct o_en_" + cname(g.ck.tyv[i].name) + "*"
        }
        if ik == check.k_slice() {
            return "RtSlice*"
        }
        return "void*"
    }
    return "int64_t"
}

// `E.V` -> enum/variant/index (seed enum_variant)
fn gev(g: mut G, path: str) -> GEV {
    r := GEV{ok: false, en: "", vn: "", i: -1}
    ld := check.last_dot(path)
    if ld < 0 {
        return r
    }
    en := check.resolve_named(g.ck, substr(path, 0, ld))
    if !collections.map_has(g.ck.enums, en) {
        return r
    }
    [ei, err] = collections.map_get(g.ck.enums, en)
    if err != nil {
        return r
    }
    vn := substr(path, ld + 1, len(path))
    vl := g.ck.enumsv[ei].vars
    i := 0
    for vl != nil {
        if vl.v.n == vn {
            r.ok = true
            r.en = en
            r.vn = vn
            r.i = i
            return r
        }
        i = i + 1
        vl = vl.next
    }
    return r
}

// ---------- scoped env (name -> ty handle; globals live in ck.globals) ----------
fn genv_get(e: ref check.Env, n: str) -> int {
    i := len(e.scopes) - 1
    for i >= 0 {
        if collections.map_has(e.scopes[i].m, n) {
            [v, err] = collections.map_get(e.scopes[i].m, n)
            if err == nil {
                return v
            }
        }
        i = i - 1
    }
    return -1
}

// seed lookup(): bind env (match arms), then locals, then globals
fn gx_lookup(g: mut G, n: str) -> int {
    t := genv_get(g.benv, n)
    if t >= 0 {
        return t
    }
    t = genv_get(g.env, n)
    if t >= 0 {
        return t
    }
    gn2 := check.qname(g.ck.cur_mod, n)
    if gn2 != n && collections.map_has(g.ck.globals, gn2) {
        [v2, err2] = collections.map_get(g.ck.globals, gn2)
        if err2 == nil {
            return v2
        }
    }
    if collections.map_has(g.ck.globals, n) {
        [v, err] = collections.map_get(g.ck.globals, n)
        if err == nil {
            return v
        }
    }
    return -1
}

// is `n` a local (any emission scope), not a global/fn?
fn g_local(g: mut G, n: str) -> bool {
    return genv_get(g.env, n) >= 0
}

// qualified fn sig lookup — returns fnsv index or -1
fn gfn(g: mut G, name: str) -> int {
    qn := check.resolve_named(g.ck, name)
    if !collections.map_has(g.ck.fns, qn) {
        return -1
    }
    [fi, err] = collections.map_get(g.ck.fns, qn)
    if err != nil {
        return -1
    }
    return fi
}

// the Fn AST node for a qualified name (-1)
fn gfn_item(g: mut G, qn: str) -> int {
    if !collections.map_has(g.fidx, qn) {
        return -1
    }
    [i, err] = collections.map_get(g.fidx, qn)
    if err != nil {
        return -1
    }
    return i
}

// @PART2

// ---------- xty: the emitter's lightweight inference (seed expr_ty) ----------

// callee resolves to a `fn(...)` value type — fn-typed var or expr
fn xfnval_ty(g: mut G, f: ref parser.Node) -> int {
    if check.nk(f) == 2 {
        match f {
            parser.Node.Name{n} => {
                t := gx_lookup(g, n)
                if t >= 0 && tyk(g, t) == check.k_fn() {
                    return t
                }
            }
            _ => {
            }
        }
        return -1
    }
    return xty(g, f)
}

// (name, ty) binds a pattern introduces — for benv during xty of match arms
fn xpatbinds(g: mut G, pat: ref parser.Node, st: int) -> own GBnd {
    if check.nk(pat) == 46 {
        match pat {
            parser.Node.PatBind{name} => {
                return gbnd(name, "", st, nil)
            }
            _ => {
            }
        }
        return nil
    }
    if check.nk(pat) != 34 {
        return nil
    }
    match pat {
        parser.Node.Pat{path, binds} => {
            qpath := check.resolve_named(g.ck, path)
            if !collections.map_has(g.ck.structs, qpath) {
                return nil
            }
            [si, err] = collections.map_get(g.ck.structs, qpath)
            if err != nil {
                return nil
            }
            fields := g.ck.structsv[si].fields
            let out: own GBnd = nil
            if check.fall_positional(fields) {
                wl := fields
                bl := binds
                for bl != nil && wl != nil {
                    match bl.v {
                        parser.Node.Name{n} => {
                            if n != "_" {
                                out = gbnd(n, "", wl.v.t, out)
                            }
                        }
                        _ => {
                        }
                    }
                    wl = wl.next
                    bl = bl.next
                }
                return out
            }
            bl := binds
            for bl != nil {
                match bl.v {
                    parser.Node.Name{n} => {
                        if n != "_" {
                            ft := check.ffind(fields, n)
                            if ft >= 0 {
                                out = gbnd(n, "", ft, out)
                            }
                        }
                    }
                    _ => {
                    }
                }
                bl = bl.next
            }
            return out
        }
        _ => {
            return nil
        }
    }
    return nil
}

// closure return type: first `return <expr>` in the body, else void
fn xclret_match(g: mut G, e: ref parser.Node) -> int {
    if e == nil || check.nk(e) != 32 {
        return check.t_void(g.ck)
    }
    match e {
        parser.Node.Match{arms} => {
            a := arms
            for a != nil {
                match a.v {
                    parser.Node.MArm{body} => {
                        if body != nil && check.nk(body) == 23 {
                            t := xclret(g, body)
                            if tyk(g, t) != check.k_void() {
                                return t
                            }
                        }
                    }
                    _ => {
                    }
                }
                a = a.next
            }
        }
        _ => {
        }
    }
    return check.t_void(g.ck)
}

fn xclret(g: mut G, b: ref parser.Node) -> int {
    if b == nil {
        return check.t_void(g.ck)
    }
    if check.nk(b) == 21 {
        // bare else-if chain — descend as one stmt
        match b {
            parser.Node.If{then, els} => {
                t := xclret(g, then)
                if tyk(g, t) != check.k_void() {
                    return t
                }
                if els != nil {
                    return xclret(g, els)
                }
            }
            _ => {
            }
        }
        return check.t_void(g.ck)
    }
    if check.nk(b) != 23 {
        return check.t_void(g.ck)
    }
    match b {
        parser.Node.List{items} => {
            l := items
            for l != nil {
                s := l.v
                match s {
                    parser.Node.Ret{vals} => {
                        if vals != nil && vals.next == nil {
                            return xty(g, vals.v)
                        }
                    }
                    parser.Node.If{then, els} => {
                        t := xclret(g, then)
                        if tyk(g, t) != check.k_void() {
                            return t
                        }
                        if els != nil {
                            t = xclret(g, els)
                            if tyk(g, t) != check.k_void() {
                                return t
                            }
                        }
                    }
                    parser.Node.For{body} => {
                        t := xclret(g, body)
                        if tyk(g, t) != check.k_void() {
                            return t
                        }
                    }
                    parser.Node.Scope{body} => {
                        t := xclret(g, body)
                        if tyk(g, t) != check.k_void() {
                            return t
                        }
                    }
                    parser.Node.Unsafe{body} => {
                        t := xclret(g, body)
                        if tyk(g, t) != check.k_void() {
                            return t
                        }
                    }
                    parser.Node.Select{arms} => {
                        sa := arms
                        for sa != nil {
                            match sa.v {
                                parser.Node.SArm{body} => {
                                    t := xclret(g, body)
                                    if tyk(g, t) != check.k_void() {
                                        return t
                                    }
                                }
                                _ => {
                                }
                            }
                            sa = sa.next
                        }
                    }
                    parser.Node.ExprStmt{e} => {
                        t := xclret_match(g, e)
                        if tyk(g, t) != check.k_void() {
                            return t
                        }
                    }
                    parser.Node.Bind{init} => {
                        t := xclret_match(g, init)
                        if tyk(g, t) != check.k_void() {
                            return t
                        }
                    }
                    parser.Node.Let{init} => {
                        t := xclret_match(g, init)
                        if tyk(g, t) != check.k_void() {
                            return t
                        }
                    }
                    _ => {
                    }
                }
                l = l.next
            }
        }
        _ => {
        }
    }
    return check.t_void(g.ck)
}

// element type of a slice-valued expr (unwraps own/ref/mut headers)
fn xsel(g: mut G, obj: ref parser.Node) -> int {
    ot := xty(g, obj)
    k := tyk(g, ot)
    if k == check.k_slice() {
        return tyi(g, ot)
    }
    if k == check.k_own() || k == check.k_ref() || k == check.k_mut() {
        i := tyi(g, ot)
        if tyk(g, i) == check.k_slice() {
            return tyi(g, i)
        }
    }
    return check.t_unk(g.ck)
}

fn xty(g: mut G, e: ref parser.Node) -> int {
    if e == nil {
        return check.t_unk(g.ck)
    }
    t := match e {
        parser.Node.JInt(_) => check.t_int(g.ck)
        parser.Node.JFloat(_) => check.tk(g.ck, check.k_float())
        parser.Node.JStr(_) => check.t_str(g.ck)
        parser.Node.Name{n} => xty_name(g, n)
        parser.Node.Call{f, args} => xty_call(g, f, args)
        parser.Node.Field{obj, name} => xty_field(g, obj, name)
        parser.Node.Lit{obj} => xty_lit(g, obj)
        parser.Node.As{ty} => xty_as(g, ty)
        parser.Node.Match{e, arms} => xty_match(g, e, arms)
        parser.Node.Index{obj} => xsel(g, obj)
        parser.Node.Slice{obj} => xty_slice(g, obj)
        parser.Node.Closure{params, body} => xty_closure(g, params, body)
        parser.Node.Bin{op, l, r} => xty_bin(g, op, l, r)
        parser.Node.Un{op, e} => xty_un(g, op, e)
        parser.Node.Ty{f0} => check.t_void(g.ck)
        _ => check.t_unk(g.ck)
    }
    return t
}

fn xty_name(g: mut G, n: str) -> int {
    if n == "nil" {
        return check.t_err(g.ck)
    }
    if n == "true" || n == "false" {
        return check.t_bool(g.ck)
    }
    t := gx_lookup(g, n)
    if t >= 0 {
        return t
    }
    fi := gfn(g, n)
    if fi >= 0 {
        sig := g.ck.fnsv[fi]
        if sig.typarams != nil {
            // generic fns can't be fn values (seed: ty_params guard)
            return check.t_unk(g.ck)
        }
        r1 := sig.ret1
        if sig.retk == 0 {
            r1 = check.t_void(g.ck)
        }
        return check.tm(g.ck, check.k_fn(), -1, sig.params, r1, "")
    }
    return check.t_unk(g.ck)
}

fn xty_call(g: mut G, f: ref parser.Node, args: ref parser.NList) -> int {
    ft := xfnval_ty(g, f)
    if ft >= 0 && tyk(g, ft) == check.k_fn() {
        return g.ck.tyv[ft].r
    }
    name := check.callee_name(f)
    if len(name) == 0 {
        return check.t_unk(g.ck)
    }
    ev := gev(g, name)
    if ev.ok {
        return check.tn(g.ck, check.k_enum(), ev.en)
    }
    // `e.kind()` — enum tag accessor
    if args == nil {
        match f {
            parser.Node.Field{obj, name} => {
                if name == "kind" {
                    ot := xty(g, obj)
                    if tyk(g, ot) == check.k_enum() {
                        return check.t_int(g.ck)
                    }
                    if tyk(g, ot) == check.k_own() {
                        if tyk(g, tyi(g, ot)) == check.k_enum() {
                            return check.t_int(g.ck)
                        }
                    }
                }
            }
            _ => {
            }
        }
    }
    // method/vtab/generic call result ty (seed expr_ty call path)
    cp := gcall_plan(g, f, args)
    if cp.k == 2 {
        if cp.rk == 0 {
            return check.t_void(g.ck)
        }
        return cp.r1
    }
    fi := gfn(g, name)
    if fi < 0 && cp.k == 1 {
        fi = gfn(g, cp.q)
    }
    if fi >= 0 {
        sig := g.ck.fnsv[fi]
        if sig.retk == 1 || sig.retk == 2 {
            rt := sig.ret1
            if sig.typarams != nil {
                b := gcall_bindf(g, fi, f, args, cp.dotted)
                rt = check.subst_ty(g.ck, rt, b)
            }
            return gsub(g, rt)
        }
        return check.t_void(g.ck)
    }
    if name == "mkchan" || name == "smkchan" {
        if args != nil {
            pt := check.chan_payload_arg(g.ck, args.v)
            if pt >= 0 {
                return check.ti(g.ck, check.k_chan(), pt)
            }
        }
        return check.tk(g.ck, check.k_chan())
    }
    if name == "mkslice" {
        et := check.t_unk(g.ck)
        if args != nil {
            a := args.v
            if check.nk(a) == 2 {
                match a {
                    parser.Node.Name{n} => {
                        et = check.ty_parse(g.ck, n)
                    }
                    _ => {
                    }
                }
            }
            if check.nk(a) == 3 {
                et = gty(g, a)
            }
        }
        return check.ti(g.ck, check.k_slice(), et)
    }
    if name == "push" && args != nil {
        return xty(g, args.v)
    }
    if name == "recv" {
        if args != nil {
            ct := xty(g, args.v)
            if ct >= 0 && tyk(g, ct) == check.k_chan() && tyi(g, ct) >= 0 {
                return tyi(g, ct)
            }
        }
        return check.t_int(g.ck)
    }
    if name == "try_send" || name == "is_root" {
        return check.t_bool(g.ck)
    }
    if name == "mkscope" || name == "curscope" {
        return check.tk(g.ck, check.k_scope())
    }
    if name == "sjoin" {
        return check.t_int(g.ck)
    }
    if name == "scancel" {
        return check.t_void(g.ck)
    }
    if name == "argc" || name == "len" || name == "byteat" || name == "find" || name == "atoi" || name == "ftoi" || name == "htons" || name == "htonl" || name == "sqlite_exec" || name == "writefile" || name == "sget" || name == "scas" || name == "sadd" || name == "now" || name == "now_ms" {
        return check.t_int(g.ck)
    }
    if name == "itof" || name == "atof" {
        return check.tk(g.ck, check.k_float())
    }
    if name == "argv" || name == "itoa" || name == "substr" || name == "bufstr" || name == "sqlite_query" || name == "readfile" || name == "ftoa" {
        return check.t_str(g.ck)
    }
    if name == "str" {
        return check.t_str(g.ck)
    }
    if name == "cstr" {
        return check.tk(g.ck, check.k_cstr())
    }
    if name == "mkbuf" || name == "sqlite_open" {
        unk := check.t_unk(g.ck)
        return check.ti(g.ck, check.k_own(), unk)
    }
    if name == "mkshared" {
        return check.tk(g.ck, check.k_shared())
    }
    if name == "new" {
        if args != nil {
            a := args.v
            // qualified `pkg.T` arrives as Node.Field — flatten to
            // the dotted path before the struct lookup (seed Ident)
            an := check.callee_name(a)
            if len(an) > 0 {
                q := check.resolve_named(g.ck, an)
                // `E.V` sits in structs for `as` payloads but is a value
                // expression here — gev gates the struct-type shortcut
                if collections.map_has(g.ck.structs, q) && !gev(g, q).ok {
                    st := check.tn(g.ck, check.k_struct(), q)
                    return check.ti(g.ck, check.k_own(), st)
                }
            }
            at := xty(g, a)
            return check.ti(g.ck, check.k_own(), at)
        }
        unk2 := check.t_unk(g.ck)
        return check.ti(g.ck, check.k_own(), unk2)
    }
    return check.t_unk(g.ck)
}

fn xty_field(g: mut G, obj: ref parser.Node, name: str) -> int {
    base := check.callee_name(obj)
    if len(base) > 0 {
        ev := gev(g, base + "." + name)
        if ev.ok {
            return check.tn(g.ck, check.k_enum(), ev.en)
        }
        // `pkg.fn` in value position — the path resolves to a fn, not
        // member access (gxfield's module-path arm; checker mirrors it
        // via field_expr -> ident). Same retk/typarams guards.
        fi2 := gfn(g, base + "." + name)
        if fi2 >= 0 {
            sig := g.ck.fnsv[fi2]
            if sig.typarams == nil && sig.retk != 2 {
                r1 := sig.ret1
                if sig.retk == 0 {
                    r1 = check.t_void(g.ck)
                }
                return check.tm(g.ck, check.k_fn(), -1, sig.params, r1, "")
            }
        }
        gq := check.resolve_named(g.ck, base + "." + name)
        if collections.map_has(g.ck.globals, gq) {
            [gt2, gerr2] = collections.map_get(g.ck.globals, gq)
            if gerr2 == nil {
                return gt2
            }
        }
    }
    ot := xty(g, obj)
    sn := ""
    ok := tyk(g, ot)
    if ok == check.k_struct() {
        sn = g.ck.tyv[ot].name
    }
    if ok == check.k_own() || ok == check.k_ref() || ok == check.k_mut() {
        i := tyi(g, ot)
        if tyk(g, i) == check.k_struct() {
            sn = g.ck.tyv[i].name
        }
    }
    if len(sn) == 0 {
        return check.t_unk(g.ck)
    }
    if !collections.map_has(g.ck.structs, sn) {
        return check.t_unk(g.ck)
    }
    [si, err] = collections.map_get(g.ck.structs, sn)
    if err != nil {
        return check.t_unk(g.ck)
    }
    ft := check.ffind(g.ck.structsv[si].fields, name)
    if ft < 0 {
        return check.t_unk(g.ck)
    }
    return ft
}

fn xty_lit(g: mut G, obj: ref parser.Node) -> int {
    name := check.callee_name(obj)
    path := check.resolve_named(g.ck, name)
    ev := gev(g, path)
    if ev.ok {
        return check.tn(g.ck, check.k_enum(), ev.en)
    }
    return check.tn(g.ck, check.k_struct(), path)
}

fn xty_as(g: mut G, ty: ref parser.Node) -> int {
    // declared target type — conversions and enum payloads alike
    return gty(g, ty)
}

fn xty_match(g: mut G, scrut: ref parser.Node, arms: ref parser.NList) -> int {
    st := xty(g, scrut)
    a := arms
    for a != nil {
        match a.v {
            parser.Node.MArm{pat, body} => {
                if body != nil && check.nk(body) != 23 {
                    check.env_push(g.benv)
                    pb := xpatbinds(g, pat, st)
                    for pb != nil {
                        check.env_bind(g.benv, pb.n, pb.t)
                        pb = pb.next
                    }
                    t := xty(g, body)
                    check.env_pop(g.benv)
                    return t
                }
            }
            _ => {
            }
        }
        a = a.next
    }
    return check.t_void(g.ck)
}

fn xty_slice(g: mut G, obj: ref parser.Node) -> int {
    ot := xty(g, obj)
    k := tyk(g, ot)
    if k == check.k_slice() {
        return ot
    }
    if k == check.k_own() || k == check.k_ref() || k == check.k_mut() {
        i := tyi(g, ot)
        if tyk(g, i) == check.k_slice() {
            return i
        }
    }
    return check.t_unk(g.ck)
}

fn xty_closure(g: mut G, params: ref parser.NList, body: ref parser.Node) -> int {
    let ps: own check.IList = nil
    pl := params
    for pl != nil {
        match pl.v {
            parser.Node.Param{ty} => {
                ps = check.icons(gty(g, ty), ps)
            }
            _ => {
            }
        }
        pl = pl.next
    }
    ps = check.irev(ps)
    rt := xclret(g, body)
    return check.tm(g.ck, check.k_fn(), -1, ps, rt, "")
}

fn xty_bin(g: mut G, op: str, l: ref parser.Node, r: ref parser.Node) -> int {
    if op == "&&" || op == "||" || op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
        return check.t_bool(g.ck)
    }
    lt := xty(g, l)
    rt := xty(g, r)
    lk := tyk(g, lt)
    rk := tyk(g, rt)
    if op == "+" && lk == check.k_str() && rk == check.k_str() {
        return check.t_str(g.ck)
    }
    if lk == check.k_float() || rk == check.k_float() {
        return check.tk(g.ck, check.k_float())
    }
    if lk == check.k_byte() && rk == check.k_byte() {
        return check.t_byte(g.ck)
    }
    return check.t_int(g.ck)
}

fn xty_un(g: mut G, op: str, e: ref parser.Node) -> int {
    if op == "!" {
        return check.t_bool(g.ck)
    }
    return xty(g, e)
}

// @PART3

// ---------- emission internals ----------
// `gx` emits a susp-free C fragment. In frame context (`inframe`) a nested
// susp call parks inline: its suspend code lands in g.w before the fragment
// is consumed, and the call reads back as `fr->vN` — the same shape the seed's
// AST hoist produces, without rebuilding the tree.

// deref own/ref/mut to the pointee handle (seed dt)
fn gdt(g: mut G, t: int) -> int {
    for tyk(g, t) == check.k_own() || tyk(g, t) == check.k_ref() || tyk(g, t) == check.k_mut() {
        t = tyi(g, t)
    }
    return t
}

// ---------- generics + iface machinery (seed insts/conv/vtabs) ----------

// subst a declared ty through the active inst bind (seed dt)
fn gsub(g: mut G, t: int) -> int {
    if t < 0 || g.subst == nil {
        return t
    }
    return check.subst_ty(g.ck, t, g.subst)
}

// ty -> C-identifier fragment for inst names (seed mangle_ty)
fn gmangle(g: mut G, t: int) -> str {
    n := check.ty_name(g.ck, t)
    out := ""
    i := 0
    for i < len(n) {
        c := byteat(n, i)
        ok := c >= 65 && c <= 90 || c >= 97 && c <= 122 || c >= 48 && c <= 57
        if ok {
            out = out + substr(n, i, i + 1)
        } else {
            out = out + "_"
        }
        i = i + 1
    }
    return out
}

// inst name for a generic callee — `q__<ty>__<ty>` in typarams order
// (seed inst_name); unbound params default to int
fn ginst_name(g: mut G, q: str, tpl: ref check.TPList, bind: ref collections.Map) -> str {
    n := q
    tp := tpl
    for tp != nil {
        t := check.t_int(g.ck)
        if collections.map_has(bind, tp.v.n) {
            [v, err] = collections.map_get(bind, tp.v.n)
            if err == nil {
                t = v
            }
        }
        n = n + "__" + gmangle(g, t)
        tp = tp.next
    }
    return n
}

// queue a generic instantiation for emission (seed insts push);
// dedup is by mangled name — returns the callee name either way.
// The proto + pair-ret decl are emitted here so uses always see them.
fn ginst_queue(g: mut G, q: str, tpl: ref check.TPList, bind: own collections.Map) -> str {
    m := ginst_name(g, q, tpl, bind)
    if collections.map_has(g.inst_done, m) {
        return m
    }
    collections.map_set(g.inst_done, m, 1)
    in := new(GInst)
    in.q = q
    in.mangled = m
    in.bind = bind
    in.next = g.insts
    g.insts = in
    return m
}

// an inst's pair-ret decl + proto — emitted inside the inst's own
// unit at pop time: queueing can run inside another decl's emission,
// and the decl must be attributed to the inst, not the emitter (the
// text itself is unchanged from the pre-G1 queue-time emission)
fn ginst_head(g: mut G, q: str, m: str, bind: ref collections.Map) {
    // q is already qualified — direct lookup (see gfunc_inst; a
    // resolve_named pass would double-prefix under a stale cur_mod
    // and silently drop the proto).
    fi := -1
    if collections.map_has(g.ck.fns, q) {
        [fi2, fe] = collections.map_get(g.ck.fns, q)
        if fe == nil {
            fi = fi2
        }
    }
    if fi < 0 {
        return
    }
    sig := g.ck.fnsv[fi]
    if sig.retk == 2 {
        g.head = push(g.head, "struct o_ret_" + cname(m) + " { " + gcty(g, check.subst_ty(g.ck, sig.ret1, bind)) + " val; int64_t err; };\n")
    }
    if !check.sl_has(g.ck.susp, q) {
        // susp insts emit only frames — no o_f_ proto
        rc := "void"
        if sig.retk == 1 {
            rc = gcty(g, check.subst_ty(g.ck, sig.ret1, bind))
        }
        if sig.retk == 2 {
            rc = "struct o_ret_" + cname(m)
        }
        ps := ""
        first := true
        il := sig.params
        for il != nil {
            if !first {
                ps = ps + ", "
            }
            first = false
            ps = ps + gcty(g, check.subst_ty(g.ck, il.v, bind))
            il = il.next
        }
        if first {
            ps = "void"
        }
        g.head = push(g.head, rc + " o_f_" + cname(m) + "(" + ps + ");\n")
    }
}

// bind declared sig params (incl. the receiver slot when `recv` is
// set) against effective arg types (seed call_bindings) — nil for
// non-generic sigs
fn gcall_bind(g: mut G, fi: int, recv: ref parser.Node, args: ref parser.NList) -> own collections.Map {
    sig := g.ck.fnsv[fi]
    if sig.typarams == nil {
        return nil
    }
    bind := collections.map_new()
    wl := sig.params
    if recv != nil && wl != nil {
        rt := gsub(g, xty(g, recv))
        check.bind_vars(g.ck, wl.v, rt, bind)
        wl = wl.next
    }
    al := args
    for al != nil && wl != nil {
        gt := gsub(g, xty(g, al.v))
        check.bind_vars(g.ck, wl.v, gt, bind)
        wl = wl.next
        al = al.next
    }
    tp := sig.typarams
    for tp != nil {
        if !collections.map_has(bind, tp.v.n) {
            collections.map_set(bind, tp.v.n, check.t_int(g.ck))
        }
        tp = tp.next
    }
    return bind
}

// call-binding helper: dotted method calls bind the receiver slot too
fn gcall_bindf(g: mut G, fi: int, f: ref parser.Node, args: ref parser.NList, dotted: int) -> own collections.Map {
    if dotted == 1 {
        match f {
            parser.Node.Field{obj} => {
                return gcall_bind(g, fi, obj, args)
            }
            _ => {
            }
        }
    }
    return gcall_bind(g, fi, nil, args)
}

// base struct/enum name behind own/ref/mut — impl keys (seed ty_base)
fn gty_base(g: mut G, t: int) -> str {
    t = gsub(g, t)
    k := tyk(g, t)
    if k == check.k_struct() || k == check.k_enum() {
        return g.ck.tyv[t].name
    }
    if k == check.k_own() || k == check.k_ref() || k == check.k_mut() {
        return gty_base(g, tyi(g, t))
    }
    return ""
}

// method name -> vtab slot index inside iface `w` (-1 when absent)
fn gimidx(g: mut G, w: str, m: str) -> int {
    ii := check.iface_ent(g.ck, w)
    if ii < 0 {
        return -1
    }
    ml := g.ck.ifacesv[ii].methods
    i := 0
    for ml != nil {
        if ml.v.n == m {
            return i
        }
        ml = ml.next
        i = i + 1
    }
    return -1
}

// record an (iface, impl) pair for vtab emission (seed vtab_uses)
fn gvtab_use(g: mut G, w: str, implkey: str) {
    k := w + "|" + implkey
    if collections.map_has(g.vtab_set, k) {
        return
    }
    collections.map_set(g.vtab_set, k, 1)
    v := new(GVU)
    v.w = w
    v.impl = implkey
    v.next = g.vtabs
    g.vtabs = v
}

// vtab symbol fragment for an impl key — `iface:W2` rewraps sanitize
// to `iface_W2` since ':' is not a C identifier char
fn gvtkey(implkey: str) -> str {
    if len(implkey) > 6 && substr(implkey, 0, 6) == "iface:" {
        return "iface_" + cname(substr(implkey, 6, len(implkey)))
    }
    return cname(implkey)
}

// `{data, o_vt_W_I}` — pointer impls hand over directly, values box so
// the data outlives the stack slot (seed iface_wrap)
fn giface_wrap_v(g: mut G, e: ref parser.Node, v: str, w: str, implkey: str) -> str {
    gvtab_use(g, w, implkey)
    got := gsub(g, xty(g, e))
    vt := "o_vt_" + cname(w) + "_" + gvtkey(implkey)
    gk := tyk(g, got)
    if gk == check.k_own() || gk == check.k_ref() || gk == check.k_mut() {
        return "(RtIface){ (void*)(" + v + "), " + vt + " }"
    }
    if gk == check.k_iface() {
        return "({ RtIface *_iw = rt_alloc_own(sizeof(RtIface)); *_iw = (" + v + "); (RtIface){ (void*)_iw, " + vt + " }; })"
    }
    ct := gcty(g, got)
    return "({ " + ct + " *_iw = rt_alloc_own(sizeof(" + ct + ")); *_iw = (" + v + "); (RtIface){ (void*)_iw, " + vt + " }; })"
}

// emit `v` (the already-emitted `e`) coerced to `want` — only iface
// conversions do anything: nil -> the empty pair, same iface passes
// through, other iface rewraps, concrete impls box (seed conv)
fn gconv_v(g: mut G, e: ref parser.Node, v: str, want: int) -> str {
    w := gsub(g, want)
    got := gsub(g, xty(g, e))
    // nil (err-typed) into a slice slot: the zero RtSlice — bare `0`
    // isn't a valid struct initializer (seed conv_v mirrors)
    if got >= 0 && tyk(g, got) == check.k_err() && w >= 0 && tyk(g, w) == check.k_slice() {
        return "(RtSlice){ 0, 0, 0, 0 }"
    }
    // own []T -> []T borrow coercion outside call args (the arg loop
    // derefs via this same arm): own slices are RtSlice* where the
    // slot wants RtSlice
    if w >= 0 && tyk(g, w) == check.k_slice() && got >= 0 && tyk(g, got) == check.k_own() {
        gi := g.ck.tyv[got].i
        if gi >= 0 && tyk(g, gi) == check.k_slice() {
            return "(*" + v + ")"
        }
    }
    if w < 0 || tyk(g, w) != check.k_iface() {
        return v
    }
    wn := g.ck.tyv[w].name
    gk := tyk(g, got)
    if gk == check.k_err() {
        return "(RtIface){ 0, 0 }"
    }
    if gk == check.k_iface() {
        gn := g.ck.tyv[got].name
        if gn == wn {
            return v
        }
        return giface_wrap_v(g, e, v, wn, "iface:" + gn)
    }
    b := gty_base(g, got)
    if len(b) > 0 {
        return giface_wrap_v(g, e, v, wn, b)
    }
    return v
}

fn gconv(g: mut G, e: ref parser.Node, want: int) -> str {
    return gconv_v(g, e, gx(g, e), want)
}

// receiver arg adapted to the method's receiver ty (seed adapt_recv):
// value wants deref pointers, pointer wants ref values
fn gadapt_v(g: mut G, e: ref parser.Node, ev: str, want: int) -> str {
    got := gsub(g, xty(g, e))
    w := gsub(g, want)
    wk := tyk(g, w)
    gk := tyk(g, got)
    if (wk == check.k_struct() || wk == check.k_enum()) && (gk == check.k_own() || gk == check.k_ref() || gk == check.k_mut()) {
        return "(*" + ev + ")"
    }
    if (wk == check.k_own() || wk == check.k_ref() || wk == check.k_mut()) && (gk == check.k_struct() || gk == check.k_enum()) {
        return "(&" + ev + ")"
    }
    return ev
}

// resolve a call target the way the checker did (seed call_plan):
// plain fn, `x.m` -> `T.m` or an iface vtab slot, bare `m(x, ..)` ->
// `T.m` with args[0] already the receiver
fn gcall_plan(g: mut G, f: ref parser.Node, args: ref parser.NList) -> own GCP {
    cp := new(GCP)
    cp.k = 0
    cp.dotted = 0
    cp.q = ""
    cp.w = ""
    cp.midx = -1
    cp.mname = ""
    cp.ps = nil
    cp.rk = -1
    cp.r1 = -1
    name := check.callee_name(f)
    if len(name) == 0 {
        return cp
    }
    if gfn(g, name) >= 0 {
        cp.k = 1
        cp.q = check.resolve_named(g.ck, name)
        return cp
    }
    match f {
        parser.Node.Field{obj, name} => {
            ot := gsub(g, xty(g, obj))
            if ot >= 0 {
                mt := check.method_target(g.ck, ot, name)
                if mt.k == 1 {
                    cp.k = 1
                    cp.dotted = 1
                    cp.q = mt.q
                    return cp
                }
                if mt.k == 2 {
                    cp.k = 2
                    cp.dotted = 1
                    cp.w = g.ck.tyv[ot].name
                    cp.mname = name
                    cp.midx = gimidx(g, cp.w, name)
                    cp.ps = check.il_clone(mt.ps)
                    cp.rk = mt.rk
                    cp.r1 = mt.r1
                    return cp
                }
            }
        }
        _ => {
        }
    }
    if args != nil {
        t0 := gsub(g, xty(g, args.v))
        if t0 >= 0 {
            mt := check.method_target(g.ck, t0, name)
            if mt.k == 1 {
                cp.k = 1
                cp.q = mt.q
                return cp
            }
        }
    }
    return cp
}

// (pair-tag, val-ty) for a pair call — 'o_vret_<W>_<m>' for vtab
// slots, 'o_ret_<callee-or-inst>' for fns; "" / -1 when not a pair call
fn gpair_info(g: mut G, call: ref parser.Node) -> GPair {
    r := GPair{tag: "", vt: -1}
    if call == nil || check.nk(call) != 8 {
        return r
    }
    match call {
        parser.Node.Call{f, args} => {
            cp := gcall_plan(g, f, args)
            if cp.k == 2 && cp.rk == 2 {
                r.tag = "o_vret_" + cname(cp.w) + "_" + cname(cp.mname)
                r.vt = cp.r1
                return r
            }
            if cp.k == 1 {
                fi := gfn(g, cp.q)
                if fi >= 0 && g.ck.fnsv[fi].retk == 2 {
                    sig := g.ck.fnsv[fi]
                    r.tag = "o_ret_" + cname(cp.q)
                    r.vt = sig.ret1
                    if sig.typarams != nil {
                        b := gcall_bindf(g, fi, f, args, cp.dotted)
                        r.tag = "o_ret_" + cname(ginst_name(g, cp.q, sig.typarams, b))
                        r.vt = check.subst_ty(g.ck, r.vt, b)
                    }
                    return r
                }
            }
        }
        _ => {
        }
    }
    return r
}

// pair-struct name a call produces — "" for non-pair or unknown callees
fn gpairsig(g: mut G, call: ref parser.Node) -> str {
    return gpair_info(g, call).tag
}

// one call arg coerced to its declared param (subst'd via the callee
// bind when generic, then through the current inst): iface conv,
// str->cstr, own->mut/ref borrow marks
fn garg_c(g: mut G, e: ref parser.Node, v: str, pt: int, bind: ref collections.Map) -> GArgOut {
    o := GArgOut{v: "", pre: "", post: ""}
    o.v = v
    if pt < 0 {
        return o
    }
    pt2 := pt
    if bind != nil {
        pt2 = check.subst_ty(g.ck, pt2, bind)
    }
    pt2 = gsub(g, pt2)
    o.v = gconv_v(g, e, o.v, pt2)
    raw := gsub(g, xty(g, e))
    if tyk(g, pt2) == check.k_cstr() && tyk(g, raw) == check.k_str() {
        o.v = "rt_cstr(" + o.v + ")"
    }
    if tyk(g, raw) == check.k_own() {
        pk := tyk(g, pt2)
        if pk == check.k_mut() {
            o.pre = "rt_borrow_mut(" + o.v + "); "
            o.post = "rt_unborrow(" + o.v + "); "
        }
        if pk == check.k_ref() {
            o.pre = "rt_borrow_read(" + o.v + "); "
            o.post = "rt_unborrow(" + o.v + "); "
        }
    }
    return o
}

// frame slot name for an fsl value (-2 -> p_<name>, else v<i>)
fn fslot_str(name: str, v: int) -> str {
    if v == -2 {
        return "p_" + name
    }
    return "v" + itoa(v)
}

// a local's C access path — `fr-><slot>` in frame, bare name otherwise
fn gref(g: mut G, n: str) -> str {
    if g.inframe == 1 {
        s := genv_get(g.fsl, n)
        if s != -1 {
            return "fr->" + fslot_str(n, s)
        }
    }
    return n
}

// register a frame field for an oxl local (seed fslot)
fn gfslot(g: mut G, name: str, ct: str) -> str {
    i := len(g.fdecls)
    g.fdecls = push(g.fdecls, ct + " v" + itoa(i) + ";")
    check.env_bind(g.fsl, name, i)
    return "v" + itoa(i)
}

// drain the fn's runtime defer stack down to its entry mark — emitted
// at every return / fn end (seed emit_defers). Frame fns keep the mark
// in `fr->_dmark`; plain fns + closure wrappers hold a local `_dmark`.
fn gdefers(g: mut G) {
    if g.inframe == 1 {
        wln(g, "    rt_defer_drain_to(fr->_dmark);")
    } else {
        wln(g, "    rt_defer_drain_to(_dmark);")
    }
}

// `defer call` — register a thunk on the task's defer stack NOW (per
// execution: loops accumulate, untaken branches register nothing).
// Call args evaluate at registration into _da<di>_<i> temps; a
// generated env captures register-time values so the deferred call
// reads them at drain (seed stmt_defer).
fn gdefer(g: mut G, call: own parser.Node) {
    di := 0
    d := g.defers
    for d != nil {
        di = di + 1
        d = d.next
    }
    // g.defers only counts defers now — marker node per stmt
    g.defers = parser.ncons(new(parser.Node.Name{n: "", lo: 0, hi: 0}), g.defers)
    cn := cname(g.cur)
    denv := "o_denv_" + cn + "_" + itoa(di)
    thunk := "o_def_" + cn + "_" + itoa(di)
    // args -> registration temps; the thunk's call reads the temps
    // through the env capture. Non-call / arg-less `defer` keeps
    // eval-at-drain (seed stmt_defer).
    let rewritten: own parser.Node = nil
    match call {
        parser.Node.Call{f, args} => {
            if args != nil {
                let nargs: own parser.NList = nil
                i := 0
                al := args
                for al != nil {
                    t := xty(g, al.v)
                    an := "_da" + itoa(di) + "_" + itoa(i)
                    v := gx(g, al.v)
                    wln(g, "    " + gcty(g, t) + " " + an + " = " + v + ";")
                    check.env_bind(g.env, an, t)
                    nargs = parser.ncons(new(parser.Node.Name{n: an, lo: 0, hi: 0}), nargs)
                    i = i + 1
                    al = al.next
                }
                rewritten = new(parser.Node.Call{f: f, args: dnrev(nargs)})
            } else {
                rewritten = new(parser.Node.Call{f: f, args: args})
            }
        }
        _ => {
            rewritten = call
        }
    }
    sc := new(GS)
    sc.l = nil
    gscan_e(g, sc, rewritten)
    let caps: own GBnd = nil
    u := sc.l
    for u != nil {
        // a dotted name arrives whole (`b.stop`); the capturable
        // binding is its longest env-bound prefix — qualified
        // globals/module heads emit directly and capture nothing
        // (seed defer_caps).
        n := u.v
        for len(n) > 0 {
            t := gx_lookup(g, n)
            if t >= 0 {
                if g_local(g, n) {
                    caps = gbnd(n, "", t, caps)
                }
                break
            }
            ld := check.last_dot(n)
            if ld < 0 {
                break
            }
            n = substr(n, 0, ld)
        }
        u = u.next
    }
    envf := " char _none;"
    if caps != nil {
        envf = ""
        cp := caps
        for cp != nil {
            envf = envf + " " + gcty(g, cp.t) + " " + cname(cp.n) + ";"
            cp = cp.next
        }
    }
    g.clpro = push(g.clpro, "struct " + denv + " {" + envf + " };")
    g.clpro = push(g.clpro, "static void " + thunk + "(void *);")
    save_frame := g.inframe
    g.inframe = 0
    wpush(g)
    wln(g, "static void " + thunk + "(void *_env) {")
    wln(g, "    struct " + denv + " *_e = _env;")
    check.env_push(g.env)
    cp2 := caps
    for cp2 != nil {
        wln(g, "    " + gcty(g, cp2.t) + " " + cname(cp2.n) + " = _e->" + cname(cp2.n) + ";")
        check.env_bind(g.env, cp2.n, cp2.t)
        cp2 = cp2.next
    }
    v2 := gx(g, rewritten)
    wln(g, "    (void)(" + v2 + ");")
    check.env_pop(g.env)
    wln(g, "}")
    wpop(g)
    g.clbod = push(g.clbod, wjoin(g.wlast))
    g.inframe = save_frame
    inits := ""
    cp3 := caps
    for cp3 != nil {
        inits = inits + " _de->" + cname(cp3.n) + " = " + gxname(g, cp3.n) + ";"
        cp3 = cp3.next
    }
    wln(g, "    { struct " + denv + " *_de = malloc(sizeof *_de);" + inits + " rt_defer_push(" + thunk + ", _de); }")
}

// NList reverse (parser nrev is package-private)
fn dnrev(l: own parser.NList) -> own parser.NList {
    let out: own parser.NList = nil
    for l != nil {
        n := l.next
        l.next = out
        out = l
        l = n
    }
    return out
}

// susp callee name: bare leaf builtin or qualified oxl fn ("" = not susp)
// does this call park? returns the EMIT name — builtin leaf, oxl fn
// base, or the mangled inst for generic susp callees (seed call_is_susp)
fn g_call_susp(g: mut G, e: ref parser.Node) -> str {
    if e == nil || check.nk(e) != 8 {
        return ""
    }
    match e {
        parser.Node.Call{f, args} => {
            n := check.callee_name(f)
            if len(n) == 0 {
                return ""
            }
            qn := check.resolve_named(g.ck, n)
            if check.is_susp_builtin(qn) {
                return qn
            }
            cp := gcall_plan(g, f, args)
            if cp.k != 1 || !check.sl_has(g.ck.susp, cp.q) {
                return ""
            }
            fi := gfn(g, cp.q)
            if fi >= 0 && g.ck.fnsv[fi].typarams != nil {
                bind := gcall_bindf(g, fi, f, args, cp.dotted)
                return ginst_queue(g, cp.q, g.ck.fnsv[fi].typarams, bind)
            }
            return cp.q
        }
        _ => {
        }
    }
    return ""
}

// expr-level susp scan over the codegen env (seed expr_has_susp) —
// check.expr_has_susp can't see method callees (`x.m()` resolves
// through gcall_plan + xty, not resolve_named), so `&&`/`||` guards
// and nested scans use this g-level mirror
fn gexpr_has_susp(g: mut G, e: ref parser.Node) -> bool {
    if e == nil {
        return false
    }
    match e {
        parser.Node.Call{f, args} => {
            if len(g_call_susp(g, e)) > 0 {
                return true
            }
            if gexpr_has_susp(g, f) {
                return true
            }
            l := args
            for l != nil {
                if gexpr_has_susp(g, l.v) {
                    return true
                }
                l = l.next
            }
        }
        parser.Node.Bin{l, r} => {
            if gexpr_has_susp(g, l) || gexpr_has_susp(g, r) {
                return true
            }
        }
        parser.Node.Un{e} => {
            if gexpr_has_susp(g, e) {
                return true
            }
        }
        parser.Node.Field{obj} => {
            if gexpr_has_susp(g, obj) {
                return true
            }
        }
        parser.Node.As{e} => {
            if gexpr_has_susp(g, e) {
                return true
            }
        }
        parser.Node.Lit{fields} => {
            fl := fields
            for fl != nil {
                match fl.v {
                    parser.Node.NamedField{val} => {
                        if gexpr_has_susp(g, val) {
                            return true
                        }
                    }
                    _ => {
                    }
                }
                fl = fl.next
            }
        }
        parser.Node.Index{obj, idx} => {
            if gexpr_has_susp(g, obj) || gexpr_has_susp(g, idx) {
                return true
            }
        }
        parser.Node.Slice{obj, lo, hi} => {
            if gexpr_has_susp(g, obj) {
                return true
            }
            if lo != nil && gexpr_has_susp(g, lo) {
                return true
            }
            if hi != nil && gexpr_has_susp(g, hi) {
                return true
            }
        }
        _ => {
        }
    }
    return false
}

// pattern -> (cond, binds) over scrutinee accessor `acc` (seed arm_cond)
fn garm(g: mut G, pat: ref parser.Node, acc: str, st: int) -> GArm {
    r := GArm{has: -1, cond: "", binds: nil}
    if pat == nil {
        return r
    }
    k := check.nk(pat)
    if k == 35 {
        return r
    } // `_`
    if k == 46 { // bare ident binds whole
        match pat {
            parser.Node.PatBind{name} => {
                r.binds = gbnd(name, "_ms", st, nil)
            }
            _ => {
            }
        }
        return r
    }
    if k == 36 { // literal
        match pat {
            parser.Node.PatLit{v} => {
                lv := gx(g, v)
                if tyk(g, gdt(g, st)) == check.k_str() {
                    r.has = 1
                    r.cond = "rt_streq(" + acc + ", " + lv + ")"
                } else {
                    r.has = 1
                    r.cond = "(" + acc + " == " + lv + ")"
                }
            }
            _ => {
            }
        }
        return r
    }
    if k != 34 {
        return r
    }
    match pat {
        parser.Node.Pat{path, binds} => {
            qpath := check.resolve_named(g.ck, path)
            ev := gev(g, qpath)
            r.has = 1
            if !ev.ok {
                r.cond = "0"
                return r
            }
            r.cond = acc + ".tag == " + itoa(ev.i)
            if !collections.map_has(g.ck.structs, qpath) {
                return r
            }
            [si, err] = collections.map_get(g.ck.structs, qpath)
            if err != nil {
                return r
            }
            fields := g.ck.structsv[si].fields
            let out: own GBnd = nil
            if check.fall_positional(fields) {
                wl := fields
                bl := binds
                for bl != nil && wl != nil {
                    match bl.v {
                        parser.Node.Name{n} => {
                            if n != "_" {
                                ce := acc + ".u.v" + itoa(ev.i) + ".f_" + wl.v.n
                                out = gbnd(n, ce, wl.v.t, out)
                            }
                        }
                        _ => {
                        }
                    }
                    wl = wl.next
                    bl = bl.next
                }
            } else {
                bl := binds
                for bl != nil {
                    match bl.v {
                        parser.Node.Name{n} => {
                            if n != "_" {
                                ce := acc + ".u.v" + itoa(ev.i) + ".f_" + n
                                out = gbnd(n, ce, check.ffind(fields, n), out)
                            }
                        }
                        _ => {
                        }
                    }
                    bl = bl.next
                }
            }
            // cons order reverses binds; emission doesn't care (decls commute)
            r.binds = out
        }
        _ => {
        }
    }
    return r
}

// `match` -> C statement-expression (seed match_expr). Block arms emit
// through the stmt path via a buffer swap.
fn gmatch(g: mut G, scrut: ref parser.Node, arms: ref parser.NList) -> str {
    st := xty(g, scrut)
    sct := gcty(g, st)
    rt := xty_match(g, scrut, arms)
    valued := tyk(g, rt) != check.k_void() && tyk(g, rt) != check.k_unk()
    acc := "_ms"
    sk := tyk(g, st)
    if sk == check.k_own() || sk == check.k_ref() || sk == check.k_mut() {
        acc = "(*_ms)"
    }
    sv := gx(g, scrut)
    o := "({ " + sct + " _ms = " + sv + "; "
    if valued {
        o = o + gcty(g, rt) + " _mr; "
    }
    first := true
    a := arms
    for a != nil {
        match a.v {
            parser.Node.MArm{pat, body} => {
                ga := garm(g, pat, acc, st)
                if ga.has == 1 {
                    if first {
                        o = o + "if (" + ga.cond + ") { "
                    }
                    if !first {
                        o = o + "else if (" + ga.cond + ") { "
                    }
                } else {
                    o = o + "else { "
                }
                first = false
                check.env_push(g.env)
                pb := ga.binds
                for pb != nil {
                    o = o + gcty(g, pb.t) + " " + pb.n + " = " + pb.ce + "; "
                    check.env_bind(g.env, pb.n, pb.t)
                    pb = pb.next
                }
                if body != nil && check.nk(body) == 23 {
                    wpush(g)
                    match body {
                        parser.Node.List{items} => {
                            li := items
                            for li != nil {
                                gs(g, li.v)
                                li = li.next
                            }
                        }
                        _ => {
                        }
                    }
                    wpop(g)
                    o = o + wjoin(g.wlast)
                } else if body != nil {
                    bv := gx(g, body)
                    if valued {
                        o = o + "_mr = " + bv + "; "
                    } else {
                        o = o + "(" + bv + "); "
                    }
                }
                check.env_pop(g.env)
                o = o + "} "
            }
            _ => {
            }
        }
        a = a.next
    }
    if valued {
        o = o + "_mr; "
    }
    return o + "})"
}

// builtins that expand to an rt_* call (seed builtin_emit)
fn gbuiltin(g: mut G, name: str, args: ref parser.NList, argvs: ref GAv) -> str {
    a0 := ""
    if argvs != nil {
        a0 = argvs.v
    }
    j := gav_join(argvs)
    if name == "assert" {
        return "((" + a0 + ") ? (void)0 : (rt_trap(3)))"
    }
    if name == "mkchan" || name == "smkchan" {
        // a leading type arg (Event / own Event) is detected on the AST —
        // argvs positions follow the same index, so value refs start at 1
        payload := -1
        if args != nil {
            payload = check.chan_payload_arg(g.ck, args.v)
        }
        drop := "0 /*no drop*/"
        if payload >= 0 {
            drop = drop_sym(g, payload)
        }
        scoped := name == "smkchan"
        cap := "0LL"
        sc := "0LL"
        if scoped {
            if argvs != nil && argvs.next != nil {
                cap = argvs.next.v
            }
            if argvs != nil && argvs.next != nil && argvs.next.next != nil {
                sc = argvs.next.next.v
            }
        } else {
            ci := 0
            if payload >= 0 {
                ci = 1
            }
            cv := gav_at(argvs, ci)
            if len(cv) > 0 {
                cap = cv
            }
        }
        return "rt_mkchan_scoped((void*)" + sc + ", " + cap + ", " + drop + ")"
    }
    if name == "send" {
        return "rt_send(" + a0 + ", (int64_t)(" + gav_at(argvs, 1) + "))"
    }
    if name == "try_send" {
        return "rt_try_send(" + a0 + ", (int64_t)(" + gav_at(argvs, 1) + "))"
    }
    if name == "is_root" {
        return "rt_is_root()"
    }
    if name == "mkscope" {
        return "rt_scope_named()"
    }
    if name == "curscope" {
        return "rt_scope_current()"
    }
    if name == "scancel" {
        return "rt_scope_cancel((void*)" + a0 + ")"
    }
    if name == "sjoin" {
        return "rt_scope_join_named((void*)" + a0 + ")"
    }
    if name == "recv" {
        // typed payload chan: recv's word result casts back to own T
        if args != nil {
            ct := xty(g, args.v)
            if ct >= 0 && tyk(g, ct) == check.k_chan() && tyi(g, ct) >= 0 {
                return "((" + gcty(g, tyi(g, ct)) + ")rt_recv(" + a0 + "))"
            }
        }
        return "rt_recv(" + a0 + ")"
    }
    if name == "sleep" {
        return "rt_sleep(" + a0 + ")"
    }
    if name == "msleep" {
        return "rt_msleep(" + a0 + ")"
    }
    if name == "itoa" {
        return "rt_itoa(" + a0 + ")"
    }
    if name == "argc" {
        return "rt_argc()"
    }
    if name == "argv" {
        return "rt_argv(" + a0 + ")"
    }
    if name == "len" {
        return "rt_len(" + a0 + ")"
    }
    if name == "byteat" || name == "substr" || name == "find" || name == "bufstr" || name == "poke8" || name == "poke16" || name == "poke32" || name == "sqlite_exec" || name == "sqlite_query" {
        return "rt_" + name + "(" + j + ")"
    }
    if name == "atoi" || name == "mkbuf" || name == "htons" || name == "htonl" || name == "cstr" || name == "str" || name == "sqlite_open" || name == "sqlite_close" || name == "sqlite_exec_bind" || name == "set_rcvtimo" || name == "set_rcvtimo_ms" || name == "set_sndtimo" || name == "readfile" || name == "writefile" || name == "exit" || name == "mkshared" || name == "sget" || name == "sset" || name == "scas" || name == "sadd" || name == "now" || name == "now_ms" || name == "usleep" || name == "atof" || name == "ftoa" {
        return "rt_" + name + "(" + j + ")"
    }
    if name == "ftoi" {
        return "((int64_t)(" + a0 + "))"
    }
    if name == "itof" {
        return "((double)(" + a0 + "))"
    }
    return ""
}

// ---------- expr emission (seed expr) ----------

// expr-position susp call inside a frame: park inline, land in a fresh slot
fn gxsusp(g: mut G, e: ref parser.Node, sn: str) -> str {
    rt := xty(g, e)
    fd := gfslot(g, "_h" + itoa(g.hoistn), gcty(g, rt))
    g.hoistn = g.hoistn + 1
    match e {
        parser.Node.Call{f, args} => {
            if check.is_susp_builtin(sn) {
                gfsusp_leaf(g, sn, args, 1, fd, "")
            } else {
                gfsusp_call(g, e, sn, 1, fd, "")
            }
        }
        _ => {
        }
    }
    return "fr->" + fd
}

// `a && <susp>` / `a || <susp>` — guarded eval of the right side (the AST
// hoist's if-desugar, emitted in place)
fn gxguard(g: mut G, op: str, l: ref parser.Node, r: ref parser.Node) -> str {
    fd := gfslot(g, "_b" + itoa(g.hoistn), "int")
    g.hoistn = g.hoistn + 1
    lv := gx(g, l)
    wln(g, "    fr->" + fd + " = " + lv + ";")
    lb := "L" + itoa(g.labeln)
    g.labeln = g.labeln + 1
    if op == "&&" {
        wln(g, "    if (!(fr->" + fd + ")) goto " + lb + ";")
    } else {
        wln(g, "    if (fr->" + fd + ") goto " + lb + ";")
    }
    rv := gx(g, r)
    wln(g, "    fr->" + fd + " = " + rv + ";")
    wln(g, "    " + lb + ": ;")
    return "fr->" + fd
}

fn gxbin(g: mut G, op: str, l: ref parser.Node, r: ref parser.Node, e: ref parser.Node) -> str {
    lt := xty(g, l)
    lv := gx(g, l)
    rv := gx(g, r)
    // byte arithmetic wraps mod 256 — C would promote to int and
    // carry bits the oxl type says don't exist. Wrap iff the result
    // ty is byte (byte op byte): byte op int widens per check, so
    // `b[i] * 65536` must not truncate (seed gxbin mirrors).
    ltk := tyk(g, gdt(g, gsub(g, lt)))
    if tyk(g, gdt(g, gsub(g, xty(g, e)))) == check.k_byte() && (op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "&" || op == "|" || op == "^") {
        return "((uint8_t)(" + lv + " " + op + " " + rv + "))"
    }
    if op == "+" && ltk == check.k_str() {
        return "rt_strcat(" + lv + ", " + rv + ")"
    }
    if (op == "==" || op == "!=") && ltk == check.k_str() {
        neg := ""
        if op == "!=" {
            neg = "!"
        }
        return "(" + neg + "rt_streq(" + lv + ", " + rv + "))"
    }
    if (op == "<" || op == "<=" || op == ">" || op == ">=") && ltk == check.k_str() {
        return "(rt_str_cmp(" + lv + ", " + rv + ") " + op + " 0)"
    }
    // unit enums: the tag is the whole value (payload enums are
    // rejected at check). The parens matter — `.tag` on the
    // compound-literal RHS needs them (seed binary op mirrors).
    if (op == "==" || op == "!=") && tyk(g, gsub(g, lt)) == check.k_enum() {
        return "((" + lv + ").tag " + op + " (" + rv + ").tag)"
    }
    // iface eq/ne compares the erased data ptr (seed binary op)
    if op == "==" || op == "!=" {
        lt2 := gsub(g, lt)
        rt2 := gsub(g, xty(g, r))
        if tyk(g, lt2) == check.k_iface() || tyk(g, rt2) == check.k_iface() {
            le := lv
            re := rv
            if tyk(g, lt2) == check.k_iface() {
                le = lv + ".data"
            }
            if tyk(g, rt2) == check.k_iface() {
                re = rv + ".data"
            }
            return "(" + le + " " + op + " (void*)" + re + ")"
        }
    }
    if op == "*" && ltk == check.k_int() {
        // signed int64 overflow is UB in C — int mul wraps in the
        // language, so go through unsigned where -O2 can't exploit
        // it (stdlib fnv relies on the wrap; seed gxbin mirrors)
        return "((int64_t)((uint64_t)(" + lv + ") * (uint64_t)(" + rv + ")))"
    }
    return "(" + lv + " " + op + " " + rv + ")"
}

// slice expr as a C value — own/ref/mut headers dereference (seed slice_val)
fn gslice_val(g: mut G, obj: ref parser.Node) -> str {
    ov := gx(g, obj)
    ot := gdt(g, xty(g, obj))
    if ot != xty(g, obj) {
        return "(*" + ov + ")"
    }
    return ov
}

fn gxfield(g: mut G, obj: ref parser.Node, name: str) -> str {
    // module path: unit variant or fn value — never a member access
    base := check.callee_name(obj)
    if len(base) > 0 {
        qn := check.resolve_named(g.ck, base + "." + name)
        ev := gev(g, qn)
        if ev.ok {
            return "(struct o_en_" + cname(ev.en) + "){ .tag = " + itoa(ev.i) + " }"
        }
        fi := gfn(g, base + "." + name)
        if fi >= 0 {
            sig := g.ck.fnsv[fi]
            if !check.sl_has(g.ck.susp, qn) && sig.retk != 2 {
                if !check.sl_has(g.fnv, qn) {
                    g.fnv = check.scons(qn, g.fnv)
                }
                return "(RtFnv){ 0, (void*)o_fnv_wrap_" + cname(qn) + " }"
            }
        }
        if collections.map_has(g.ck.globals, qn) {
            return "o_g_" + cname(qn)
        }
    }
    o := gx(g, obj)
    ot := xty(g, obj)
    ok := tyk(g, ot)
    if ok == check.k_own() || ok == check.k_ref() || ok == check.k_mut() {
        return o + "->f_" + name
    }
    return o + ".f_" + name
}

// declared ty of field `fname` on struct `sname` (-1 unknown) —
// variant payloads register under their `E.V`-qualified name too
fn gfield_ty(g: mut G, sname: str, fname: str) -> int {
    if !collections.map_has(g.ck.structs, sname) {
        return -1
    }
    [si, err] = collections.map_get(g.ck.structs, sname)
    if err != nil {
        return -1
    }
    fl := g.ck.structsv[si].fields
    for fl != nil {
        if fl.v.n == fname {
            return fl.v.t
        }
        fl = fl.next
    }
    return -1
}

fn gxlit(g: mut G, obj: ref parser.Node, fields: ref parser.NList) -> str {
    name := check.callee_name(obj)
    path := check.resolve_named(g.ck, name)
    ev := gev(g, path)
    init := ""
    fl := fields
    for fl != nil {
        match fl.v {
            parser.Node.NamedField{name, val} => {
                v := gx(g, val)
                ft := gfield_ty(g, path, name)
                if ft >= 0 {
                    v = gconv_v(g, val, v, ft)
                }
                if len(init) > 0 {
                    init = init + ", "
                }
                init = init + ".f_" + name + " = " + v
            }
            _ => {
            }
        }
        fl = fl.next
    }
    if ev.ok {
        return "(struct o_en_" + cname(ev.en) + "){ .tag = " + itoa(ev.i) + ", .u.v" + itoa(ev.i) + " = (struct o_s_" + cname(path) + "){ " + init + " } }"
    }
    return "(struct o_s_" + cname(path) + "){ " + init + " }"
}

fn gxas(g: mut G, inner: ref parser.Node, ty: ref parser.Node) -> str {
    // `as` conversions — str<->[]byte and int<->byte; `own T` unwraps
    // like the seed's `base`
    ot := xty(g, inner)
    deref := false
    bt := ot
    if tyk(g, ot) == check.k_own() {
        i2 := tyi(g, ot)
        if i2 >= 0 {
            bt = i2
            deref = true
        }
    }
    iv := gx(g, inner)
    if deref {
        iv = "(*" + iv + ")"
    }
    wt := gty(g, ty)
    bok := tyk(g, bt)
    wk := tyk(g, wt)
    if bok == check.k_str() && wk == check.k_slice() && tyk(g, tyi(g, wt)) == check.k_byte() {
        return "rt_bytes_str(" + iv + ")"
    }
    if bok == check.k_slice() && tyk(g, tyi(g, bt)) == check.k_byte() && wk == check.k_str() {
        return "rt_str_bytes(" + iv + ")"
    }
    if bok == check.k_int() && wk == check.k_byte() {
        return "((uint8_t)(" + iv + "))"
    }
    if bok == check.k_byte() && wk == check.k_int() {
        return "((int64_t)(" + iv + "))"
    }
    tn := check.ty_str(ty)
    ev := gev(g, check.resolve_named(g.ck, tn))
    if !ev.ok {
        return "(" + gx(g, inner) + ")"
    }
    e := gx(g, inner)
    ec := cname(ev.en)
    it := xty(g, inner)
    ik := tyk(g, it)
    if ik == check.k_own() || ik == check.k_ref() || ik == check.k_mut() {
        return "({ struct o_en_" + ec + " *_ev = (" + e + "); if ((*_ev).tag != " + itoa(ev.i) + ") rt_trap(9); (*_ev).u.v" + itoa(ev.i) + "; })"
    }
    return "({ struct o_en_" + ec + " _ev = (" + e + "); if (_ev.tag != " + itoa(ev.i) + ") rt_trap(9); _ev.u.v" + itoa(ev.i) + "; })"
}

// named fn as a value — zero-env fat pair (seed Ident fnval branch)
fn gxfnv(g: mut G, n: str) -> str {
    qn := check.resolve_named(g.ck, n)
    if !collections.map_has(g.ck.fns, qn) {
        return ""
    }
    if check.sl_has(g.ck.susp, qn) {
        return ""
    }
    [fi, err] = collections.map_get(g.ck.fns, qn)
    if err != nil {
        return ""
    }
    if g.ck.fnsv[fi].retk == 2 {
        return ""
    }
    if !check.sl_has(g.fnv, qn) {
        g.fnv = check.scons(qn, g.fnv)
    }
    return "(RtFnv){ 0, (void*)o_fnv_wrap_" + cname(qn) + " }"
}

fn gx(g: mut G, e: ref parser.Node) -> str {
    if e == nil {
        return "0"
    }
    if g.inframe == 1 {
        sn := g_call_susp(g, e)
        if len(sn) > 0 {
            return gxsusp(g, e, sn)
        }
        // `&&`/`||` with a susp right side — the guard desugar
        early := ""
        hit := false
        match e {
            parser.Node.Bin{op, l, r} => {
                if (op == "&&" || op == "||") && gexpr_has_susp(g, r) {
                    early = gxguard(g, op, l, r)
                    hit = true
                }
            }
            _ => {
            }
        }
        if hit {
            return early
        }
    }
    out := match e {
        parser.Node.JInt(v) => itoa(v) + "LL"
        parser.Node.JFloat(s) => s
        parser.Node.JStr(s) => "rt_str_lit(\"" + s + "\")"
        parser.Node.Name{n} => gxname(g, n)
        parser.Node.Call{f, args} => gcall(g, f, args)
        parser.Node.Field{obj, name} => gxfield(g, obj, name)
        parser.Node.Lit{obj, fields} => gxlit(g, obj, fields)
        parser.Node.As{e, ty} => gxas(g, e, ty)
        parser.Node.Bin{op, l, r} => gxbin(g, op, l, r, e)
        parser.Node.Un{op, e} => gxun(g, op, e)
        parser.Node.Match{e, arms} => gmatch(g, e, arms)
        parser.Node.Index{obj, idx} => gxindex(g, obj, idx)
        parser.Node.Slice{obj, lo, hi} => gxslice(g, obj, lo, hi)
        parser.Node.Closure{params, body} => gclosure(g, params, body)
        _ => "0"
    }
    return out
}

fn gxname(g: mut G, n: str) -> str {
    if n == "nil" {
        return "0"
    }
    if n == "true" {
        return "1"
    }
    if n == "false" {
        return "0"
    }
    if g.inframe == 1 {
        s := genv_get(g.fsl, n)
        if s != -1 {
            return "fr->" + fslot_str(n, s)
        }
    }
    if g_local(g, n) {
        return n
    }
    gn3 := check.qname(g.ck.cur_mod, n)
    if gn3 != n && collections.map_has(g.ck.globals, gn3) {
        return "o_g_" + cname(gn3)
    }
    if collections.map_has(g.ck.globals, n) {
        return "o_g_" + cname(n)
    }
    v := gxfnv(g, n)
    if len(v) > 0 {
        return v
    }
    return n
}

fn gxun(g: mut G, op: str, inner: ref parser.Node) -> str {
    v := gx(g, inner)
    if op == "!" {
        return "(!" + v + ")"
    }
    return "(-" + v + ")"
}

fn gxindex(g: mut G, obj: ref parser.Node, idx: ref parser.Node) -> str {
    el := xsel(g, obj)
    ect := gcty(g, el)
    sv := gslice_val(g, obj)
    iv := gx(g, idx)
    return "(*({ RtSlice _ms = " + sv + "; int64_t _mi = " + iv + "; if (_mi < 0 || _mi >= _ms.len) rt_trap(10); (" + ect + "*)_ms.ptr + _mi; }))"
}

fn gxslice(g: mut G, obj: ref parser.Node, lo: ref parser.Node, hi: ref parser.Node) -> str {
    el := xsel(g, obj)
    ect := gcty(g, el)
    sv := gslice_val(g, obj)
    av := "0LL"
    bv := "_ms.len"
    if lo != nil {
        av = gx(g, lo)
    }
    if hi != nil {
        bv = gx(g, hi)
    }
    return "({ RtSlice _ms = " + sv + "; int64_t _ma = " + av + "; int64_t _mb = " + bv + "; if (_ma < 0 || _mb < _ma || _mb > _ms.len) rt_trap(10); (RtSlice){ (" + ect + "*)_ms.ptr + _ma, _mb - _ma, _ms.cap - _ma, _ms.heap }; })"
}

// ---------- call emission (seed call) ----------
fn gcall(g: mut G, f: ref parser.Node, args: ref parser.NList) -> str {
    argvs := gav(g, args)
    // indirect call through a fn value — bind once, jump through fp
    ft := xfnval_ty(g, f)
    if ft >= 0 && tyk(g, ft) == check.k_fn() {
        fv := gx(g, f)
        rt := g.ck.tyv[ft].r
        ret_c := gcty(g, rt)
        sig := "void*"
        il := g.ck.tyv[ft].args
        for il != nil {
            sig = sig + ", " + gcty(g, il.v)
            il = il.next
        }
        // conv each arg to the declared fn param ty — raw argvs skip
        // nil->slice / own->slice coercion (seed fn-value path same)
        argl := ""
        il2 := g.ck.tyv[ft].args
        al2 := args
        av2 := argvs
        for al2 != nil {
            v := av2.v
            if il2 != nil {
                v = gconv_v(g, al2.v, v, il2.v)
                il2 = il2.next
            }
            argl = argl + ", " + v
            al2 = al2.next
            av2 = av2.next
        }
        return "({ RtFnv _fv = " + fv + "; ((" + ret_c + " (*)(" + sig + "))_fv.fp)(_fv.env" + argl + "); })"
    }
    name := check.callee_name(f)
    if len(name) == 0 {
        return "0 /*badcall*/"
    }
    qn := check.resolve_named(g.ck, name)
    // enum variant construction `E.V(..)`
    ev := gev(g, qn)
    if ev.ok {
        return "(struct o_en_" + cname(ev.en) + "){ .tag = " + itoa(ev.i) + ", .u.v" + itoa(ev.i) + " = (struct o_s_" + cname(qn) + "){ " + gav_join(argvs) + " } }"
    }
    // `e.kind()` — enum tag accessor (deref own handles)
    if args == nil && check.nk(f) == 9 {
        match f {
            parser.Node.Field{obj, name} => {
                if name == "kind" {
                    ot := xty(g, obj)
                    if tyk(g, ot) == check.k_enum() {
                        return "(" + gx(g, obj) + ").tag"
                    }
                    if tyk(g, ot) == check.k_own() || tyk(g, ot) == check.k_ref() || tyk(g, ot) == check.k_mut() {
                        if tyk(g, tyi(g, ot)) == check.k_enum() {
                            return "(*" + gx(g, obj) + ").tag"
                        }
                    }
                }
            }
            _ => {
            }
        }
    }
    // builtins dispatch on the resolved name — `lexlib.push` ≠ `push`
    if qn == "print" || qn == "println" {
        a0 := ""
        if argvs != nil {
            a0 = argvs.v
        }
        t := check.t_unk(g.ck)
        if args != nil {
            t = gdt(g, xty(g, args.v))
        }
        sfx := "i64"
        a := a0
        if tyk(g, t) == check.k_str() {
            sfx = "str"
        }
        if tyk(g, t) == check.k_cstr() {
            sfx = "str"
            a = "rt_str(" + a0 + ")"
        }
        if tyk(g, t) == check.k_float() {
            sfx = "f64"
        }
        return "rt_" + name + "_" + sfx + "(" + a + ")"
    }
    if qn == "close" {
        a0 := "0"
        if argvs != nil {
            a0 = argvs.v
        }
        t := check.t_unk(g.ck)
        if args != nil {
            t = gdt(g, xty(g, args.v))
        }
        if tyk(g, t) == check.k_chan() {
            return "rt_close(" + a0 + ")"
        }
        return "close(" + a0 + ")"
    }
    if qn == "new" && args != nil {
        // `new(T)` — a qualified `pkg.T` is a Node.Field here, not a
        // Name; flatten Name and Field chains to the dotted path (the
        // seed's parser folds both into one Ident)
        sn := check.callee_name(args.v)
        if len(sn) > 0 {
            q := check.resolve_named(g.ck, sn)
            if collections.map_has(g.ck.structs, q) && !gev(g, q).ok {
                return "({ struct o_s_" + cname(q) + " *_nb = rt_alloc_own(sizeof(struct o_s_" + cname(q) + ")); __builtin_memset(_nb, 0, sizeof(struct o_s_" + cname(q) + ")); _nb; })"
            }
        }
        // new(slice) — deep-copy header+backing to heap so the own
        // slice can outlive the scope arena (seed emit mirrors)
        st2 := xty(g, args.v)
        if tyk(g, st2) == check.k_slice() {
            return "rt_slice_own(" + argvs.v + ", sizeof(" + gcty(g, tyi(g, st2)) + "))"
        }
        ct := gcty(g, xty(g, args.v))
        v := argvs.v
        return "({ " + ct + " *_nb = rt_alloc_own(sizeof(" + ct + ")); *_nb = (" + v + "); _nb; })"
    }
    if qn == "mkslice" && args != nil {
        et := check.t_unk(g.ck)
        if check.nk(args.v) == 2 {
            match args.v {
                parser.Node.Name{n} => {
                    et = check.ty_parse(g.ck, n)
                }
                _ => {
                }
            }
        }
        if check.nk(args.v) == 3 {
            et = gty(g, args.v)
        }
        n := "0LL"
        if args.next != nil {
            n = gav_at(argvs, 1)
        }
        return "rt_mkslice(" + n + ", sizeof(" + gcty(g, et) + "))"
    }
    if qn == "push" && args != nil {
        st := xty(g, args.v)
        el := check.t_unk(g.ck)
        owned := false
        if tyk(g, st) == check.k_slice() {
            el = tyi(g, st)
        }
        if tyk(g, st) == check.k_own() || tyk(g, st) == check.k_ref() || tyk(g, st) == check.k_mut() {
            i := tyi(g, st)
            if tyk(g, i) == check.k_slice() {
                el = tyi(g, i)
                owned = true
            }
        }
        ect := gcty(g, el)
        sv := argvs.v
        if owned {
            sv = "(*" + sv + ")"
        }
        v := gav_at(argvs, 1)
        return "({ " + ect + " _pv = " + v + "; rt_slice_push(" + sv + ", sizeof(" + ect + "), &_pv); })"
    }
    if qn == "len" && args != nil {
        st := gdt(g, xty(g, args.v))
        a0 := argvs.v
        if tyk(g, st) == check.k_slice() {
            if tyk(g, xty(g, args.v)) == check.k_slice() {
                return "(" + a0 + ").len"
            }
            return "(*" + a0 + ").len"
        }
        return "rt_len(" + a0 + ")"
    }
    b := gbuiltin(g, qn, args, argvs)
    if len(b) > 0 {
        return b
    }
    // method + iface dispatch (D3) and monomorphized generics (seed
    // call_plan / insts): `x.m(..)` -> `T.m(x, ..)`, `w.m(..)` -> a
    // vtab slot call, bare `m(x, ..)` -> `T.m(x, ..)`
    cp := gcall_plan(g, f, args)
    if cp.k == 2 {
        match f {
            parser.Node.Field{obj} => {
                ov := gx(g, obj)
                ret_c := "void"
                if cp.rk == 1 {
                    ret_c = gcty(g, cp.r1)
                }
                if cp.rk == 2 {
                    ret_c = "struct o_vret_" + cname(cp.w) + "_" + cname(cp.mname)
                }
                sig := "void*"
                il := cp.ps
                for il != nil {
                    sig = sig + ", " + gcty(g, il.v)
                    il = il.next
                }
                argl := ""
                il = cp.ps
                al := args
                av := argvs
                for al != nil {
                    v := av.v
                    if il != nil {
                        v = gconv_v(g, al.v, v, il.v)
                        raw := gsub(g, xty(g, al.v))
                        if tyk(g, il.v) == check.k_cstr() && tyk(g, raw) == check.k_str() {
                            v = "rt_cstr(" + v + ")"
                        }
                        il = il.next
                    }
                    argl = argl + ", " + v
                    al = al.next
                    av = av.next
                }
                return "({ RtIface _iv = " + ov + "; ((" + ret_c + " (*)(" + sig + "))_iv.vtab[" + itoa(cp.midx) + "])(_iv.data" + argl + "); })"
            }
            _ => {
            }
        }
    }
    // fnsv resolution: dotted `x.m` resolves through the plan, plain
    // and bare-method calls come off `name`
    fi := gfn(g, name)
    eq := qn
    if fi < 0 && cp.k == 1 {
        fi = gfn(g, cp.q)
        eq = cp.q
    }
    if fi < 0 {
        return name + "(" + gav_join(argvs) + ")"
    }
    sig := g.ck.fnsv[fi]
    // generic callees queue a mono instantiation — the name resolves
    // now; the queue happens at bind's last use (own move)
    let bind: own collections.Map = nil
    mangled := ""
    callee := name
    if sig.is_extern == 0 {
        callee = "o_f_" + cname(eq)
        if sig.typarams != nil {
            bind = gcall_bindf(g, fi, f, args, cp.dotted)
            mangled = ginst_name(g, eq, sig.typarams, bind)
            callee = "o_f_" + cname(mangled)
        }
    }
    // str -> cstr coercion + own-arg borrows around the call; iface
    // args wrap through conv (seed conv call sites)
    pre := ""
    post := ""
    il := sig.params
    let coerced: own GAv = nil
    let ctail: own GAv = nil
    if cp.k == 1 && cp.dotted == 1 && il != nil {
        // `x.m(..)` — the receiver is an implicit first arg adapted to
        // the declared receiver ty, never conv'd (seed adapt_recv)
        pt := il.v
        if bind != nil {
            pt = check.subst_ty(g.ck, pt, bind)
        }
        pt = gsub(g, pt)
        match f {
            parser.Node.Field{obj} => {
                c := new(GAv)
                c.v = gadapt_v(g, obj, gx(g, obj), pt)
                // own receiver to a mut/ref method borrows for the
                // call — the same wrap garg_c puts on own args
                raw := gsub(g, xty(g, obj))
                if tyk(g, raw) == check.k_own() {
                    pk := tyk(g, pt)
                    if pk == check.k_mut() {
                        pre = pre + "rt_borrow_mut(" + c.v + "); "
                        post = "rt_unborrow(" + c.v + "); " + post
                    }
                    if pk == check.k_ref() {
                        pre = pre + "rt_borrow_read(" + c.v + "); "
                        post = "rt_unborrow(" + c.v + "); " + post
                    }
                }
                coerced = c
                ctail = c
            }
            _ => {
            }
        }
        il = il.next
    }
    al := args
    av := argvs
    for al != nil {
        v := av.v
        if il != nil {
            o := garg_c(g, al.v, v, il.v, bind)
            v = o.v
            pre = pre + o.pre
            post = post + o.post
            il = il.next
        }
        c := new(GAv)
        c.v = v
        if coerced == nil {
            coerced = c
            ctail = c
        } else {
            ctail.next = c
            ctail = ctail.next
        }
        al = al.next
        av = av.next
    }
    rt1 := sig.ret1
    if bind != nil {
        rt1 = check.subst_ty(g.ck, rt1, bind)
    }
    rt1 = gsub(g, rt1)
    retag := "o_ret_" + cname(eq)
    if len(mangled) > 0 {
        retag = "o_ret_" + cname(mangled)
    }
    if sig.typarams != nil {
        ginst_queue(g, eq, sig.typarams, bind)
    }
    inner := callee + "(" + gav_join(coerced) + ")"
    if len(pre) == 0 {
        return inner
    }
    if sig.retk == 0 {
        return "({ " + pre + inner + "; " + post + "})"
    }
    if sig.retk == 1 {
        return "({ " + gcty(g, rt1) + " __rc; " + pre + "__rc = " + inner + "; " + post + "__rc; })"
    }
    return "({ struct " + retag + " __rc; " + pre + "__rc = " + inner + "; " + post + "__rc; })"
}

// ---------- spawn (seed spawn) ----------
// arg vector coerced to declared sig params (subst'd when generic) —
// `recv` prepends as an adapted first arg for dotted method calls
fn gav_decl(g: mut G, args: ref parser.NList, fi: int, bind: ref collections.Map, recv: ref parser.Node) -> own GAv {
    let head: own GAv = nil
    let tail: own GAv = nil
    let il: own check.IList = nil
    if fi >= 0 {
        il = g.ck.fnsv[fi].params
    }
    if recv != nil {
        v := gx(g, recv)
        if il != nil {
            pt := il.v
            if bind != nil {
                pt = check.subst_ty(g.ck, pt, bind)
            }
            pt = gsub(g, pt)
            v = gadapt_v(g, recv, v, pt)
            il = il.next
        }
        c := new(GAv)
        c.v = v
        head = c
        tail = c
    }
    al := args
    for al != nil {
        v := gx(g, al.v)
        if il != nil {
            o := garg_c(g, al.v, v, il.v, bind)
            v = o.v
            il = il.next
        }
        c := new(GAv)
        c.v = v
        if head == nil {
            head = c
            tail = c
        } else {
            tail.next = c
            tail = tail.next
        }
        al = al.next
    }
    return head
}

// destructor thunk symbol for a `chan own T` payload; registers the
// underlying type (and every own field reachable from it) so
// gemit_drops writes each o_drop_<n> once. Non-struct payloads get the
// shared rt_free shim.
fn drop_sym(g: mut G, payload: int) -> str {
    inner := tyi(g, payload)
    if inner < 0 {
        return "0 /*no drop*/"
    }
    ik := tyk(g, inner)
    let stack: own check.IList = nil
    stack = check.icons(inner, stack)
    for stack != nil {
        t := stack.v
        stack = stack.next
        tk := tyk(g, t)
        if tk == check.k_struct() || tk == check.k_enum() {
            n := g.ck.tyv[t].name
            if sl_has_str(g.drop_tys, n) {
                continue
            }
            g.drop_tys = push(g.drop_tys, n)
        } else {
            g.drop_word = 1
        }
        // enqueue own fields/variant payloads of the type just seen
        if tk == check.k_struct() {
            [si, err] = collections.map_get(g.ck.structs, g.ck.tyv[t].name)
            if err == 0 {
                fl := g.ck.structsv[si].fields
                for fl != nil {
                    ft := fl.v.t
                    if tyk(g, ft) == check.k_own() {
                        stack = check.icons(tyi(g, ft), stack)
                    } else if tyk(g, ft) == check.k_str() {
                        g.drop_word = 1
                    }
                    fl = fl.next
                }
            }
        }
        if tk == check.k_enum() {
            [ei, err2] = collections.map_get(g.ck.enums, g.ck.tyv[t].name)
            if err2 == 0 {
                vl := g.ck.enumsv[ei].vars
                for vl != nil {
                    fl := vl.v.fields
                    for fl != nil {
                        ft := fl.v.t
                        if tyk(g, ft) == check.k_own() {
                            stack = check.icons(tyi(g, ft), stack)
                        } else if tyk(g, ft) == check.k_str() {
                            g.drop_word = 1
                        }
                        fl = fl.next
                    }
                    vl = vl.next
                }
            }
        }
    }
    if ik == check.k_struct() || ik == check.k_enum() {
        return "o_drop_" + cname(g.ck.tyv[inner].name)
    }
    // an own-slice payload is a heap box over a heap backing — the
    // shared word shim would free the box but leak ptr
    if ik == check.k_slice() {
        g.drop_slice = 1
        return "o_drop_slice"
    }
    g.drop_word = 1
    return "o_drop_word"
}

fn sl_has_str(l: []str, n: str) -> bool {
    i := 0
    for i < len(l) {
        if l[i] == n {
            return true
        }
        i = i + 1
    }
    return false
}

// one C stmt dropping an own field/payload word; borrowed fields are
// untouched (they share the owner's lifetime, not the object's)
fn drop_field(g: mut G, acc: str, ft: int) -> str {
    if tyk(g, ft) != check.k_own() {
        return ""
    }
    it := tyi(g, ft)
    ik := tyk(g, it)
    if ik == check.k_struct() || ik == check.k_enum() {
        return "    o_drop_" + cname(g.ck.tyv[it].name) + "((int64_t)" + acc + ");\n"
    }
    if ik == check.k_slice() {
        return "    if (" + acc + ") { rt_free(((RtSlice*)" + acc + ")->ptr); rt_free(" + acc + "); }\n"
    }
    return "    rt_free((void*)" + acc + ");\n"
}

// write each registered o_drop_<n> into the root unit's trampoline
// section — emitted once, `static`, scanned by the mark like any other
// referenced symbol
fn gemit_drops(g: mut G, ru: int) {
    if len(g.drop_tys) == 0 && g.drop_word == 0 && g.drop_slice == 0 {
        return
    }
    src := ""
    if g.drop_word == 1 {
        src = src + "static void o_drop_word(int64_t _v) { rt_free((void*)_v); }\n"
    }
    if g.drop_slice == 1 {
        src = src + "static void o_drop_slice(int64_t _v) { RtSlice *s = (RtSlice *)_v; if (s) { rt_free(s->ptr); rt_free(s); } }\n"
    }
    i := 0
    for i < len(g.drop_tys) {
        src = src + "static void o_drop_" + cname(g.drop_tys[i]) + "(int64_t _v);\n"
        i = i + 1
    }
    i = 0
    for i < len(g.drop_tys) {
        n := g.drop_tys[i]
        cn := cname(n)
        if collections.map_has(g.ck.structs, n) {
            body := "static void o_drop_" + cn + "(int64_t _v) { struct o_s_" + cn + " *p = (struct o_s_" + cn + " *)_v; if (!p) return;\n"
            [si, err] = collections.map_get(g.ck.structs, n)
            if err == 0 {
                fl := g.ck.structsv[si].fields
                for fl != nil {
                    body = body + drop_field(g, "p->f_" + fl.v.n, fl.v.t)
                    fl = fl.next
                }
            }
            body = body + "    rt_free(p);\n}\n"
            src = src + body
        } else if collections.map_has(g.ck.enums, n) {
            body := "static void o_drop_" + cn + "(int64_t _v) { struct o_en_" + cn + " *p = (struct o_en_" + cn + " *)_v; if (!p) return; switch (p->tag) {\n"
            [ei, err2] = collections.map_get(g.ck.enums, n)
            if err2 == 0 {
                vi := 0
                vl := g.ck.enumsv[ei].vars
                for vl != nil {
                    fl := vl.v.fields
                    casebody := ""
                    for fl != nil {
                        casebody = casebody + drop_field(g, "p->u.v" + itoa(vi) + ".f_" + fl.v.n, fl.v.t)
                        fl = fl.next
                    }
                    if len(casebody) > 0 {
                        body = body + "    case " + itoa(vi) + ":\n" + casebody + "        break;\n"
                    }
                    vi = vi + 1
                    vl = vl.next
                }
            }
            body = body + "    }\n    rt_free(p);\n}\n"
            src = src + body
        }
        i = i + 1
    }
    g.units[ru].tp = push(g.units[ru].tp, src)
}

fn gspawn(g: mut G, sc: ref parser.Node, e: ref parser.Node, blocking: bool) {
    if e == nil || check.nk(e) != 8 {
        return
    }
    match e {
        parser.Node.Call{f, args} => {
            // fn value callee — pack the fat pair as a0
            ft := xfnval_ty(g, f)
            if ft >= 0 && tyk(g, ft) == check.k_fn() {
                id := g.tmpn
                g.tmpn = g.tmpn + 1
                sid := itoa(id)
                tr := "struct o_args_" + sid + " { RtFnv a0;"
                il := g.ck.tyv[ft].args
                i := 1
                for il != nil {
                    tr = tr + " " + gcty(g, il.v) + " a" + itoa(i) + ";"
                    i = i + 1
                    il = il.next
                }
                tr = tr + " };\n"
                ret_c := gcty(g, g.ck.tyv[ft].r)
                sig := "void*"
                argl := ""
                il = g.ck.tyv[ft].args
                i = 1
                for il != nil {
                    sig = sig + ", " + gcty(g, il.v)
                    argl = argl + ", a->a" + itoa(i)
                    i = i + 1
                    il = il.next
                }
                tr = tr + "static void* l_tr_" + sid + "(void* _p) { struct o_args_" + sid + "* a = _p; ((" + ret_c + " (*)(" + sig + "))a->a0.fp)(a->a0.env" + argl + "); return 0; }\n"
                g.tramp = push(g.tramp, tr)
                wln(g, "    { struct o_args_" + sid + "* a = rt_alloc(sizeof(struct o_args_" + sid + "));")
                fv := gx(g, f)
                wln(g, "      a->a0 = " + fv + ";")
                i = 1
                al := args
                for al != nil {
                    wln(g, "      a->a" + itoa(i) + " = " + gx(g, al.v) + ";")
                    i = i + 1
                    al = al.next
                }
                sp := "rt_spawn"
                if blocking {
                    sp = "rt_spawnb"
                }
                wln(g, "      " + sp + "(l_tr_" + sid + ", a); }")
                return
            }
            name := check.callee_name(f)
            if len(name) == 0 {
                return
            }
            // dotted `x.m` spawns resolve to `T.m` with a receiver slot;
            // generic callees queue an inst (seed call_plan/inst_name)
            cp := gcall_plan(g, f, args)
            base := check.resolve_named(g.ck, name)
            fi2 := -1
            if cp.k == 1 {
                base = cp.q
                fi2 = gfn(g, cp.q)
            }
            let bind: own collections.Map = nil
            ename := base
            if fi2 >= 0 && g.ck.fnsv[fi2].typarams != nil {
                bind = gcall_bindf(g, fi2, f, args, cp.dotted)
                ename = ginst_name(g, base, g.ck.fnsv[fi2].typarams, bind)
            }
            let rnode: ref parser.Node = nil
            if cp.k == 1 && cp.dotted == 1 {
                match f {
                    parser.Node.Field{obj} => {
                        rnode = obj
                    }
                    _ => {
                    }
                }
            }
            // suspendable callee — heap frame + poll driver task
            if cp.k == 1 && check.sl_has(g.ck.susp, base) {
                cn := cname(ename)
                argvs := gav_decl(g, args, fi2, bind, rnode)
                if bind != nil {
                    ginst_queue(g, base, g.ck.fnsv[fi2].typarams, bind)
                }
                tnew := "rt_task_new(o_poll_" + cn + ", (int64_t)sizeof(struct o_frm_" + cn + "))"
                if sc != nil {
                    sv := gx(g, sc)
                    tnew = "rt_task_new_in((void*)" + sv + ", o_poll_" + cn + ", (int64_t)sizeof(struct o_frm_" + cn + "))"
                }
                wln(g, "    { struct o_frm_" + cn + " *_t = (struct o_frm_" + cn + " *)" + tnew + ";")
                gspawn_args(g, base, "_t", argvs)
                sp := "rt_spawn_task"
                if blocking {
                    sp = "rt_spawnb_task"
                }
                wln(g, "      " + sp + "((RtFrame *)_t); }")
                return
            }
            // regular callee — args struct + file-scope trampoline
            id := g.tmpn
            g.tmpn = g.tmpn + 1
            sid := itoa(id)
            tr := "struct o_args_" + sid + " {"
            // declared param types when resolvable (subst'd for insts;
            // the receiver slot leads for dotted methods), else expr ty
            let il: own check.IList = nil
            if fi2 >= 0 {
                il = g.ck.fnsv[fi2].params
            }
            i := 0
            if rnode != nil {
                at := gsub(g, xty(g, rnode))
                if il != nil {
                    at = il.v
                    if bind != nil {
                        at = check.subst_ty(g.ck, at, bind)
                    }
                    at = gsub(g, at)
                    il = il.next
                }
                tr = tr + " " + gcty(g, at) + " a" + itoa(i) + ";"
                i = i + 1
            }
            al := args
            for al != nil {
                at := gsub(g, xty(g, al.v))
                if il != nil {
                    at = il.v
                    if bind != nil {
                        at = check.subst_ty(g.ck, at, bind)
                    }
                    at = gsub(g, at)
                    il = il.next
                }
                tr = tr + " " + gcty(g, at) + " a" + itoa(i) + ";"
                i = i + 1
                al = al.next
            }
            tr = tr + " };\n"
            // the arg-ref list as a GAv so gbuiltin can consume it
            let afs: own GAv = nil
            let atail: own GAv = nil
            k2 := 0
            for k2 < i {
                c := new(GAv)
                c.v = "a->a" + itoa(k2)
                if afs == nil {
                    afs = c
                    atail = c
                } else {
                    atail.next = c
                    atail = atail.next
                }
                k2 = k2 + 1
            }
            arefs := gav_join(afs)
            body := ""
            if name == "print" || name == "println" || name == "new" {
                body = "rt_trap(9);"
            } else if name == "close" {
                t := check.t_unk(g.ck)
                if args != nil {
                    t = gdt(g, xty(g, args.v))
                }
                if tyk(g, t) == check.k_chan() {
                    body = "rt_close(a->a0);"
                } else {
                    body = "close(a->a0);"
                }
            } else {
                bb := gbuiltin(g, name, args, afs)
                if len(bb) > 0 {
                    body = bb + ";"
                } else {
                    callee := name
                    if fi2 >= 0 && g.ck.fnsv[fi2].is_extern == 0 {
                        callee = "o_f_" + cname(ename)
                    }
                    body = callee + "(" + arefs + ");"
                }
            }
            tr = tr + "static void* l_tr_" + sid + "(void* _p) { struct o_args_" + sid + "* a = _p; " + body + " return 0; }\n"
            g.tramp = push(g.tramp, tr)
            wln(g, "    { struct o_args_" + sid + "* a = rt_alloc(sizeof(struct o_args_" + sid + "));")
            fills := gav_decl(g, args, fi2, bind, rnode)
            if bind != nil {
                ginst_queue(g, base, g.ck.fnsv[fi2].typarams, bind)
            }
            av := fills
            i = 0
            for av != nil {
                wln(g, "      a->a" + itoa(i) + " = " + av.v + ";")
                i = i + 1
                av = av.next
            }
            sp := "rt_spawn"
            if blocking {
                sp = "rt_spawnb"
            }
            wln(g, "      " + sp + "(l_tr_" + sid + ", a); }")
        }
        _ => {
        }
    }
}

// write spawn/fsusp-call args into `dst->p_<param>` slots
fn gspawn_args(g: mut G, qn: str, dst: str, argvs: ref GAv) {
    fi := gfn_item(g, qn)
    if fi < 0 {
        return
    }
    if check.nk(g.its[fi].node) != 24 {
        return
    }
    match g.its[fi].node {
        parser.Node.Fn{recv, params} => {
            av := argvs
            if recv != nil && av != nil {
                match recv {
                    parser.Node.Param{name} => {
                        wln(g, "      " + dst + "->p_" + name + " = " + av.v + ";")
                    }
                    _ => {
                    }
                }
                av = av.next
            }
            pl := params
            for pl != nil && av != nil {
                match pl.v {
                    parser.Node.Param{name} => {
                        wln(g, "      " + dst + "->p_" + name + " = " + av.v + ";")
                    }
                    _ => {
                    }
                }
                pl = pl.next
                av = av.next
            }
        }
        _ => {
        }
    }
}

// ---------- closures (seed closure_expr + BodyScan) ----------
struct GS { l: own check.SList }

fn gsc_add(s: mut GS, n: str) {
    if len(n) == 0 {
        return
    }
    if !check.sl_has(s.l, n) {
        s.l = check.scons(n, s.l)
    }
}

// every Name use under a node — the capture scan over-collects and lets
// gx_lookup filter (module heads, field names, pattern binds drop out)
fn gscan_e(g: mut G, s: mut GS, e: ref parser.Node) {
    if e == nil {
        return
    }
    match e {
        parser.Node.Name{n} => {
            gsc_add(s, n)
        }
        parser.Node.Call{f, args} => {
            gscan_e(g, s, f)
            al := args
            for al != nil {
                gscan_e(g, s, al.v)
                al = al.next
            }
        }
        parser.Node.Field{obj} => {
            gscan_e(g, s, obj)
        }
        parser.Node.Lit{obj, fields} => {
            gscan_e(g, s, obj)
            fl := fields
            for fl != nil {
                match fl.v {
                    parser.Node.NamedField{val} => {
                        gscan_e(g, s, val)
                    }
                    _ => {
                    }
                }
                fl = fl.next
            }
        }
        parser.Node.Bin{l, r} => {
            gscan_e(g, s, l)
            gscan_e(g, s, r)
        }
        parser.Node.Un{e} => {
            gscan_e(g, s, e)
        }
        parser.Node.As{e} => {
            gscan_e(g, s, e)
        }
        parser.Node.Match{e, arms} => {
            gscan_e(g, s, e)
            al := arms
            for al != nil {
                match al.v {
                    parser.Node.MArm{pat, body} => {
                        gscan_pat(g, s, pat)
                        if body != nil && check.nk(body) == 23 {
                            gscan_b(g, s, body)
                        } else {
                            gscan_e(g, s, body)
                        }
                    }
                    _ => {
                    }
                }
                al = al.next
            }
        }
        parser.Node.Index{obj, idx} => {
            gscan_e(g, s, obj)
            gscan_e(g, s, idx)
        }
        parser.Node.Slice{obj, lo, hi} => {
            gscan_e(g, s, obj)
            gscan_e(g, s, lo)
            gscan_e(g, s, hi)
        }
        parser.Node.Closure{body} => {
            gscan_b(g, s, body)
        }
        _ => {
        }
    }
}

fn gscan_pat(g: mut G, s: mut GS, pat: ref parser.Node) {
    if pat == nil {
        return
    }
    match pat {
        parser.Node.PatLit{v} => {
            gscan_e(g, s, v)
        }
        _ => {
        }
    }
}

fn gscan_s(g: mut G, s: mut GS, st: ref parser.Node) {
    if st == nil {
        return
    }
    match st {
        parser.Node.Let{init} => {
            gscan_e(g, s, init)
        }
        parser.Node.Bind{init} => {
            gscan_e(g, s, init)
        }
        parser.Node.Let2{call} => {
            gscan_e(g, s, call)
        }
        parser.Node.Assign{target, val} => {
            gscan_e(g, s, target)
            gscan_e(g, s, val)
        }
        parser.Node.ExprStmt{e} => {
            gscan_e(g, s, e)
        }
        parser.Node.Ret{vals} => {
            l := vals
            for l != nil {
                gscan_e(g, s, l.v)
                l = l.next
            }
        }
        parser.Node.If{cond, then, els} => {
            gscan_e(g, s, cond)
            gscan_b(g, s, then)
            if els != nil && check.nk(els) == 23 {
                gscan_b(g, s, els)
            }
            if els != nil && check.nk(els) != 23 {
                gscan_s(g, s, els)
            }
        }
        parser.Node.For{cond, body} => {
            gscan_e(g, s, cond)
            gscan_b(g, s, body)
        }
        parser.Node.Scope{body} => {
            gscan_b(g, s, body)
        }
        parser.Node.Unsafe{body} => {
            gscan_b(g, s, body)
        }
        parser.Node.Spawn{e} => {
            gscan_e(g, s, e)
        }
        parser.Node.SpawnBlocking{e} => {
            gscan_e(g, s, e)
        }
        parser.Node.Go{e} => {
            gscan_e(g, s, e)
        }
        parser.Node.GoIn{sc, e} => {
            gscan_e(g, s, sc)
            gscan_e(g, s, e)
        }
        parser.Node.Defer{call} => {
            gscan_e(g, s, call)
        }
        parser.Node.Select{arms} => {
            al := arms
            for al != nil {
                match al.v {
                    parser.Node.SArm{ch, ms, body} => {
                        gscan_e(g, s, ch)
                        gscan_e(g, s, ms)
                        gscan_b(g, s, body)
                    }
                    _ => {
                    }
                }
                al = al.next
            }
        }
        parser.Node.List{items} => {
            l := items
            for l != nil {
                gscan_s(g, s, l.v)
                l = l.next
            }
        }
        _ => {
        }
    }
}

fn gscan_b(g: mut G, s: mut GS, body: ref parser.Node) {
    if body == nil || check.nk(body) != 23 {
        return
    }
    match body {
        parser.Node.List{items} => {
            l := items
            for l != nil {
                gscan_s(g, s, l.v)
                l = l.next
            }
        }
        _ => {
        }
    }
}

fn gscan_param(params: ref parser.NList, n: str) -> bool {
    pl := params
    for pl != nil {
        match pl.v {
            parser.Node.Param{name} => {
                if name == n {
                    return true
                }
            }
            _ => {
            }
        }
        pl = pl.next
    }
    return false
}

// `{ |params| stmts }` — env struct + wrapper fn + {env, fp} value
fn gclosure(g: mut G, params: ref parser.NList, body: ref parser.Node) -> str {
    id := g.cln
    g.cln = g.cln + 1
    sid := itoa(id)
    sc := new(GS)
    sc.l = nil
    gscan_b(g, sc, body)
    let caps: own GBnd = nil
    u := sc.l
    for u != nil {
        if !gscan_param(params, u.v) {
            t := gx_lookup(g, u.v)
            if t >= 0 {
                caps = gbnd(u.v, "", t, caps)
            }
        }
        u = u.next
    }
    psig := ""
    pl := params
    for pl != nil {
        match pl.v {
            parser.Node.Param{name, ty} => {
                psig = psig + ", " + gcty(g, gty(g, ty)) + " " + cname(name)
            }
            _ => {
            }
        }
        pl = pl.next
    }
    ret_c := gcty(g, xclret(g, body))
    envf := ""
    cp := caps
    for cp != nil {
        envf = envf + " " + gcty(g, cp.t) + " " + cname(cp.n) + ";"
        cp = cp.next
    }
    g.clpro = push(g.clpro, "struct o_env_" + sid + " {" + envf + " };")
    g.clpro = push(g.clpro, "static " + ret_c + " o_cl_" + sid + "(struct o_env_" + sid + " *_e" + psig + ");")
    // wrapper body — a plain fn: captures arrive via _e
    save_frame := g.inframe
    g.inframe = 0
    save_def := g.defers
    g.defers = nil
    save_ret := g.retk
    g.retk = 0
    save_cret := g.cret
    g.cret = xclret(g, body)
    save_cur := g.cur
    g.cur = "o_cl_" + sid
    wpush(g)
    wln(g, "static " + ret_c + " o_cl_" + sid + "(struct o_env_" + sid + " *_e" + psig + ") {")
    wln(g, "    RtDefer *_dmark = rt_defer_mark();")
    check.env_push(g.env)
    cp = caps
    for cp != nil {
        wln(g, "    " + gcty(g, cp.t) + " " + cname(cp.n) + " = _e->" + cname(cp.n) + ";")
        check.env_bind(g.env, cp.n, cp.t)
        cp = cp.next
    }
    pl = params
    for pl != nil {
        match pl.v {
            parser.Node.Param{name, ty} => {
                check.env_bind(g.env, name, gty(g, ty))
            }
            _ => {
            }
        }
        pl = pl.next
    }
    gblk(g, body)
    gdefers(g)
    check.env_pop(g.env)
    wln(g, "}")
    wpop(g)
    g.clbod = push(g.clbod, wjoin(g.wlast))
    g.inframe = save_frame
    g.defers = save_def
    g.retk = save_ret
    g.cret = save_cret
    g.cur = save_cur
    // the value: env populated from the enclosing scope
    inits := ""
    cp = caps
    for cp != nil {
        inits = inits + " _e->" + cname(cp.n) + " = " + gxname(g, cp.n) + ";"
        cp = cp.next
    }
    return "({ struct o_env_" + sid + " *_e = rt_alloc_own(sizeof(struct o_env_" + sid + "));" + inits + " (RtFnv){ _e, (void*)o_cl_" + sid + " }; })"
}

// ---------- stmt emission (seed stmt, non-frame path) ----------
fn gblk(g: mut G, body: ref parser.Node) {
    if body == nil || check.nk(body) != 23 {
        return
    }
    match body {
        parser.Node.List{items} => {
            l := items
            for l != nil {
                gs(g, l.v)
                l = l.next
            }
        }
        _ => {
        }
    }
}

// `[a, err] = call` — pair-return destructure (seed Stmt::Let2)
fn glet2(g: mut G, names: str, call: ref parser.Node) {
    cn := ""
    match call {
        parser.Node.Call{f} => {
            cn = check.callee_name(f)
        }
        _ => {
        }
    }
    i := find(names, ",")
    na := names
    nb := ""
    if i >= 0 {
        na = substr(names, 0, i)
        nb = substr(names, i + 1, len(names))
    }
    pr := gpair_info(g, call)
    tag := pr.tag
    vt := pr.vt
    if vt < 0 {
        vt = check.t_unk(g.ck)
    }
    if len(tag) == 0 {
        tag = "o_ret_" + cname(check.resolve_named(g.ck, cn))
    }
    n := g.tmpn
    g.tmpn = g.tmpn + 1
    c := gx(g, call)
    wln(g, "    struct " + tag + " _r" + itoa(n) + " = " + c + ";")
    if len(na) > 0 && na != "_" {
        wln(g, "    " + gcty(g, vt) + " " + na + " = _r" + itoa(n) + ".val;")
        check.env_bind(g.env, na, vt)
    }
    if len(nb) > 0 && nb != "_" {
        wln(g, "    int64_t " + nb + " = _r" + itoa(n) + ".err;")
        check.env_bind(g.env, nb, check.t_err(g.ck))
    }
}

fn gs(g: mut G, s: ref parser.Node) {
    if s == nil {
        return
    }
    match s {
        parser.Node.Let{name, ty, init} => {
            t := check.t_unk(g.ck)
            if ty != nil {
                t = gty(g, ty)
            }
            if ty == nil {
                t = xty(g, init)
            }
            // bare `let` zero-inits: the compound literal is the typed
            // zero for scalars and structs alike (str, slice, pair)
            v := "(" + gcty(g, t) + "){0}"
            if init != nil {
                v = gx(g, init)
                v = gconv_v(g, init, v, t)
            }
            wln(g, "    " + gcty(g, t) + " " + name + " = " + v + ";")
            check.env_bind(g.env, name, t)
        }
        parser.Node.Bind{name, init} => {
            t := xty(g, init)
            v := gx(g, init)
            v = gconv_v(g, init, v, t)
            wln(g, "    " + gcty(g, t) + " " + name + " = " + v + ";")
            check.env_bind(g.env, name, t)
        }
        parser.Node.Let2{names, call} => {
            glet2(g, names, call)
        }
        parser.Node.Assign{target, val} => {
            t := gx(g, target)
            v := gx(g, val)
            v = gconv_v(g, val, v, xty(g, target))
            wln(g, "    " + t + " = " + v + ";")
        }
        parser.Node.ExprStmt{e} => {
            v := gx(g, e)
            wln(g, "    " + v + ";")
        }
        parser.Node.Defer{call} => {
            gdefer(g, call)
        }
        parser.Node.Ret{vals} => {
            gdefers(g)
            if vals == nil {
                wln(g, "    return;")
            } else if g.retk == 2 && vals.next != nil {
                v := gx(g, vals.v)
                v = gconv_v(g, vals.v, v, g.cret)
                e2 := gx(g, vals.next.v)
                wln(g, "    return (struct o_ret_" + cname(g.cur) + "){ " + v + ", " + e2 + " };")
            } else if g.retk == 2 {
                // `return paircall()` forwards — rewrap when the
                // callee's pair tag differs (seed o_vret_ -> o_ret_)
                v := gx(g, vals.v)
                tag := gpairsig(g, vals.v)
                cur := "o_ret_" + cname(g.cur)
                if len(tag) > 0 && tag != cur {
                    cv := gconv_v(g, vals.v, "_fw.val", g.cret)
                    wln(g, "    { struct " + tag + " _fw = " + v + "; return (struct " + cur + "){ " + cv + ", _fw.err }; }")
                } else {
                    wln(g, "    return " + v + ";")
                }
            } else {
                v := gx(g, vals.v)
                v = gconv_v(g, vals.v, v, g.cret)
                wln(g, "    return " + v + ";")
            }
        }
        parser.Node.If{cond, then, els} => {
            c := gx(g, cond)
            wln(g, "    if (" + c + ") {")
            check.env_push(g.env)
            gblk(g, then)
            check.env_pop(g.env)
            if els == nil {
                wln(g, "    }")
            } else if check.nk(els) == 23 {
                wln(g, "    } else {")
                check.env_push(g.env)
                gblk(g, els)
                check.env_pop(g.env)
                wln(g, "    }")
            } else {
                wl(g, "    } else ")
                gs(g, els)
            }
        }
        parser.Node.For{cond, body} => {
            c := gx(g, cond)
            wln(g, "    while (" + c + ") {")
            check.env_push(g.env)
            gblk(g, body)
            check.env_pop(g.env)
            wln(g, "    }")
        }
        parser.Node.Break => {
            wln(g, "    break;")
        }
        parser.Node.Continue => {
            wln(g, "    continue;")
        }
        parser.Node.Scope{body} => {
            id := g.scopen
            g.scopen = g.scopen + 1
            wln(g, "    { RtScope _sc" + itoa(id) + "; rt_scope_enter(&_sc" + itoa(id) + ");")
            check.env_push(g.env)
            gblk(g, body)
            check.env_pop(g.env)
            wln(g, "      rt_scope_leave(&_sc" + itoa(id) + "); }")
        }
        parser.Node.Spawn{e} => {
            gspawn(g, nil, e, false)
        }
        parser.Node.Go{e} => {
            gspawn(g, nil, e, false)
        }
        parser.Node.GoIn{sc, e} => {
            gspawn(g, sc, e, false)
        }
        parser.Node.SpawnBlocking{e} => {
            gspawn(g, nil, e, true)
        }
        parser.Node.Select{arms} => {
            wln(g, "    fprintf(stderr, \"select in non-suspendable fn\\n\"); abort();")
        }
        parser.Node.Unsafe{body} => {
            check.env_push(g.env)
            gblk(g, body)
            check.env_pop(g.env)
        }
        parser.Node.List{items} => {
            l := items
            for l != nil {
                gs(g, l.v)
                l = l.next
            }
        }
        _ => {
        }
    }
}

// ---------- suspension state machine (seed fsusp_*/fstmt/func_frame) ----------

// `fr->cur_scope = tls_scope; tls_scope = saved; return <code>;`
fn gsusp_ret(g: mut G, code: str) {
    wln(g, "    fr->cur_scope = tls_scope; tls_scope = saved; return " + code + ";")
}

// suspend point for an oxl-fn call: alloc child frame, poll it, propagate
// PENDING/CANCEL, bind the result on READY (seed fsusp_call)
// dk: 0 void, 1 frame-field(da), 2 assign-target(da), 3 pair(da,db; ""=blank)
fn gfsusp_call(g: mut G, call: ref parser.Node, name: str, dk: int, da: str, db: str) {
    cn := cname(name)
    frty := "o_frm_" + cn
    // re-plan for the base qn + decl-aware arg fills (recv adapts,
    // params conv — incl. generic susp insts where `name` is mangled)
    let argvs: own GAv = nil
    bname := ""
    match call {
        parser.Node.Call{f, args} => {
            cp := gcall_plan(g, f, args)
            bname = cp.q
            fi := -1
            let bind: own collections.Map = nil
            let rnode: ref parser.Node = nil
            if cp.k == 1 {
                fi = gfn(g, cp.q)
            }
            if fi >= 0 && g.ck.fnsv[fi].typarams != nil {
                bind = gcall_bindf(g, fi, f, args, cp.dotted)
            }
            if cp.dotted == 1 {
                match f {
                    parser.Node.Field{obj} => {
                        rnode = obj
                    }
                    _ => {
                    }
                }
            }
            argvs = gav_decl(g, args, fi, bind, rnode)
        }
        _ => {
        }
    }
    if len(bname) == 0 {
        bname = name
    }
    wln(g, "    { struct " + frty + " *_c = (struct " + frty + " *)malloc(sizeof(struct " + frty + "));")
    wln(g, "      ((RtFrame *)_c)->cur_scope = tls_scope; ((RtFrame *)_c)->state = 0;")
    gspawn_args(g, bname, "_c", argvs)
    k := g.staten
    g.staten = g.staten + 1
    g.states = push(g.states, k)
    wln(g, "      fr->child = (RtFrame *)_c; fr->state = " + itoa(k) + ";")
    wln(g, "    s" + itoa(k) + ": ;")
    wln(g, "      _p = o_poll_" + cn + "(fr->child, task);")
    wln(g, "      if (_p != RT_READY) { fr->cur_scope = tls_scope; tls_scope = saved; return _p; }")
    if dk == 1 {
        wln(g, "      fr->" + da + " = ((struct " + frty + " *)fr->child)->result;")
    }
    if dk == 2 {
        wln(g, "      " + da + " = ((struct " + frty + " *)fr->child)->result;")
    }
    if dk == 3 {
        wln(g, "      { struct o_ret_" + cn + " _r = ((struct " + frty + " *)fr->child)->result;")
        if len(da) > 0 {
            wln(g, "        fr->" + da + " = _r.val;")
        }
        if len(db) > 0 {
            wln(g, "        fr->" + db + " = _r.err;")
        }
        wln(g, "      }")
    }
    wln(g, "      free(fr->child);")
    wln(g, "    }")
}

// leaf suspends: recv/send/sleep park on the chan/timer wait queue
fn gfsusp_leaf(g: mut G, name: str, args: ref parser.NList, dk: int, da: str, db: str) {
    argvs := gav(g, args)
    k := g.staten
    g.staten = g.staten + 1
    g.states = push(g.states, k)
    // sjoin's finish is the join's second half — a cancelled joiner
    // still owes the named scope its teardown and the parent its
    // hold release, so the join polls and finishes ahead of any
    // cancel delivery (Rust fsusp_leaf parity).
    if name != "sjoin" {
        wln(g, "    if (rt_cancelled()) { fr->cur_scope = tls_scope; tls_scope = saved; return RT_CANCEL; }")
    }
    wln(g, "    fr->state = " + itoa(k) + ";")
    poll := ""
    if name == "recv" {
        poll = "rt_recv_poll(" + gav_at(argvs, 0) + ", task)"
    }
    if name == "send" {
        poll = "rt_send_poll(" + gav_at(argvs, 0) + ", (int64_t)(" + gav_at(argvs, 1) + "), task)"
    }
    if name == "sleep" {
        poll = "rt_sleep_poll(" + gav_at(argvs, 0) + ", task)"
    }
    if name == "msleep" {
        poll = "rt_msleep_poll(" + gav_at(argvs, 0) + ", task)"
    }
    if name == "sjoin" {
        poll = "rt_scope_join_poll((RtScope*)" + gav_at(argvs, 0) + ", task)"
    }
    wln(g, "    if (" + poll + " == RT_PENDING) { fr->cur_scope = tls_scope; tls_scope = saved; return RT_PENDING; }")
    wln(g, "    s" + itoa(k) + ": ;")
    res := "rt_task_data(task)"
    if name == "recv" && args != nil {
        ct := xty(g, args.v)
        if ct >= 0 && tyk(g, ct) == check.k_chan() && tyi(g, ct) >= 0 {
            res = "((" + gcty(g, tyi(g, ct)) + ")rt_task_data(task))"
        }
    }
    if name == "sjoin" {
        // join completed (that's what woke us) — teardown runs on the
        // joiner's thread and delivers the scope's trap code
        res = "rt_scope_finish_named((void*)" + gav_at(argvs, 0) + ")"
    }
    if name == "sjoin" {
        // the finish is the join's second half — it must run before any
        // cancel delivery, even when the err result is discarded, or the
        // named scope's teardown and the parent's hold release leak
        // into join_scope
        if dk == 1 {
            wln(g, "    fr->" + da + " = " + res + ";")
        }
        if dk == 2 {
            wln(g, "    " + da + " = " + res + ";")
        }
        if dk != 1 && dk != 2 {
            wln(g, "    " + res + ";")
        }
        // scope finished — deliver a cancel that woke the join
        wln(g, "    if (rt_cancelled()) { fr->cur_scope = tls_scope; tls_scope = saved; return RT_CANCEL; }")
    } else {
        // a cancel-driven wake delivers no value — die at the resume point
        wln(g, "    if (rt_cancelled()) { fr->cur_scope = tls_scope; tls_scope = saved; return RT_CANCEL; }")
        if dk == 1 {
            wln(g, "    fr->" + da + " = " + res + ";")
        }
        if dk == 2 {
            wln(g, "    " + da + " = " + res + ";")
        }
    }
}

// dispatch a stmt-level susp call: leaf builtin or oxl frame call
fn gfsusp_go(g: mut G, call: ref parser.Node, dk: int, da: str, db: str) {
    sn := g_call_susp(g, call)
    if len(sn) == 0 {
        return
    }
    match call {
        parser.Node.Call{args} => {
            if check.is_susp_builtin(sn) {
                gfsusp_leaf(g, sn, args, dk, da, db)
            } else {
                gfsusp_call(g, call, sn, dk, da, db)
            }
        }
        _ => {
        }
    }
}

fn gfblk(g: mut G, body: ref parser.Node) {
    if body == nil || check.nk(body) != 23 {
        return
    }
    match body {
        parser.Node.List{items} => {
            l := items
            for l != nil {
                gfstmt(g, l.v)
                l = l.next
            }
        }
        _ => {
        }
    }
}

// statement-level match inside a frame — real if-chain so block arms can
// suspend; payload binds live in frame slots (seed fstmt_match)
fn gfmatch(g: mut G, scrut: ref parser.Node, arms: ref parser.NList) {
    st := xty(g, scrut)
    sct := gcty(g, st)
    acc := "_ms"
    sk := tyk(g, st)
    if sk == check.k_own() || sk == check.k_ref() || sk == check.k_mut() {
        acc = "(*_ms)"
    }
    sv := gx(g, scrut)
    wln(g, "    { " + sct + " _ms = " + sv + ";")
    first := true
    a := arms
    for a != nil {
        match a.v {
            parser.Node.MArm{pat, body} => {
                ga := garm(g, pat, acc, st)
                if ga.has == 1 {
                    if first {
                        wln(g, "    if (" + ga.cond + ") {")
                    }
                    if !first {
                        wln(g, "    else if (" + ga.cond + ") {")
                    }
                } else {
                    wln(g, "    else {")
                }
                first = false
                check.env_push(g.env)
                check.env_push(g.fsl)
                pb := ga.binds
                for pb != nil {
                    fd := gfslot(g, pb.n, gcty(g, pb.t))
                    check.env_bind(g.env, pb.n, pb.t)
                    wln(g, "      fr->" + fd + " = " + pb.ce + ";")
                    pb = pb.next
                }
                if body != nil && check.nk(body) == 23 {
                    gfblk(g, body)
                } else if body != nil {
                    gfstmt_expr(g, body)
                }
                check.env_pop(g.fsl)
                check.env_pop(g.env)
                wln(g, "    }")
            }
            _ => {
            }
        }
        a = a.next
    }
    wln(g, "    }")
}

// an expr in stmt position inside a frame (ExprStmt / match arm body)
fn gfstmt_expr(g: mut G, e: ref parser.Node) {
    if check.nk(e) == 8 && len(g_call_susp(g, e)) > 0 {
        gfsusp_go(g, e, 0, "", "")
        return
    }
    if check.nk(e) == 32 {
        match e {
            parser.Node.Match{e, arms} => {
                gfmatch(g, e, arms)
                return
            }
            _ => {
            }
        }
    }
    v := gx(g, e)
    wln(g, "    " + v + ";")
}

// select { v := recv(ch) => .. timeout(ms) => .. else => .. }
fn gfselect(g: mut G, arms: ref parser.NList) {
    // evaluate arm chans / timeout ms once, before the suspend
    let chs: own check.IList = nil // arm index per recv slot (reversed ok)
    let cvs: own GAv = nil
    let cvtail: own GAv = nil
    ncv := 0
    tmo := "-1"
    has_else := false
    a := arms
    for a != nil {
        match a.v {
            parser.Node.SArm{kind, ch, ms} => {
                if kind == "recv" {
                    cv := new(GAv)
                    cv.v = gx(g, ch)
                    if cvs == nil {
                        cvs = cv
                        cvtail = cv
                    } else {
                        cvtail.next = cv
                        cvtail = cvtail.next
                    }
                    ncv = ncv + 1
                }
                if kind == "timeout" {
                    tmo = gx(g, ms)
                }
                if kind == "else" {
                    has_else = true
                }
            }
            _ => {
            }
        }
        a = a.next
    }
    k := g.staten
    g.staten = g.staten + 1
    g.states = push(g.states, k)
    wln(g, "    if (rt_cancelled()) { fr->cur_scope = tls_scope; tls_scope = saved; return RT_CANCEL; }")
    wln(g, "    fr->state = " + itoa(k) + ";")
    wln(g, "    { RtChan *_sc[" + itoa(ncv) + "];")
    j := 0
    cv := cvs
    for cv != nil {
        wln(g, "      _sc[" + itoa(j) + "] = " + cv.v + ";")
        j = j + 1
        cv = cv.next
    }
    he := "0"
    if has_else {
        he = "1"
    }
    wln(g, "      if (rt_select_poll(_sc, " + itoa(ncv) + ", " + tmo + ", " + he + ", task) == RT_PENDING) { fr->cur_scope = tls_scope; tls_scope = saved; return RT_PENDING; } }")
    wln(g, "    s" + itoa(k) + ": ;")
    wln(g, "    if (rt_cancelled()) { fr->cur_scope = tls_scope; tls_scope = saved; return RT_CANCEL; }")
    // dispatch: recv slot j -> arm at recv position j; TMO/ELSE specials
    lend := "L" + itoa(g.labeln)
    g.labeln = g.labeln + 1
    alabs := mkslice(str, check.nl_len(arms))
    aidx := 0
    a = arms
    for a != nil {
        alabs[aidx] = "L" + itoa(g.labeln)
        g.labeln = g.labeln + 1
        aidx = aidx + 1
        a = a.next
    }
    wln(g, "    switch ((int)rt_select_arm(task)) {")
    j = 0
    aidx = 0
    tmo_arm := -1
    else_arm := -1
    a = arms
    for a != nil {
        match a.v {
            parser.Node.SArm{kind} => {
                if kind == "recv" {
                    wln(g, "      case " + itoa(j) + ": goto " + alabs[aidx] + ";")
                    j = j + 1
                }
                if kind == "timeout" {
                    tmo_arm = aidx
                }
                if kind == "else" {
                    else_arm = aidx
                }
            }
            _ => {
            }
        }
        aidx = aidx + 1
        a = a.next
    }
    if tmo_arm >= 0 {
        wln(g, "      case RT_SEL_TMO: goto " + alabs[tmo_arm] + ";")
    }
    if else_arm >= 0 {
        wln(g, "      case RT_SEL_ELSE: goto " + alabs[else_arm] + ";")
    }
    wln(g, "      default: goto " + lend + ";")
    wln(g, "    }")
    aidx = 0
    a = arms
    for a != nil {
        match a.v {
            parser.Node.SArm{kind, ch, bind, body} => {
                wln(g, "    " + alabs[aidx] + ": ;")
                if kind == "recv" && len(bind) > 0 {
                    bt := check.t_int(g.ck)
                    ct := xty(g, ch)
                    if ct >= 0 && tyk(g, ct) == check.k_chan() && tyi(g, ct) >= 0 {
                        bt = tyi(g, ct)
                    }
                    fd := gfslot(g, bind, gcty(g, bt))
                    check.env_bind(g.env, bind, bt)
                    wln(g, "    fr->" + fd + " = (" + gcty(g, bt) + ")rt_task_data(task);")
                }
                check.env_push(g.env)
                check.env_push(g.fsl)
                gfblk(g, body)
                check.env_pop(g.fsl)
                check.env_pop(g.env)
                wln(g, "    goto " + lend + ";")
            }
            _ => {
            }
        }
        aidx = aidx + 1
        a = a.next
    }
    wln(g, "    " + lend + ": ;")
}

// stmt inside a suspendable fn (seed fstmt)
fn gfstmt(g: mut G, s: ref parser.Node) {
    if s == nil {
        return
    }
    match s {
        parser.Node.Let{name, ty, init} => {
            t := check.t_unk(g.ck)
            if ty != nil {
                t = gty(g, ty)
            }
            if ty == nil {
                t = xty(g, init)
            }
            ct := gcty(g, t)
            fd := gfslot(g, name, ct)
            check.env_bind(g.env, name, t)
            if init == nil {
                // bare `let` in a susp fn: typed zero for the slot
                wln(g, "    fr->" + fd + " = (" + ct + "){0};")
            } else if len(g_call_susp(g, init)) > 0 {
                gfsusp_go(g, init, 1, fd, "")
            } else {
                v := gx(g, init)
                v = gconv_v(g, init, v, t)
                wln(g, "    fr->" + fd + " = " + v + ";")
            }
        }
        parser.Node.Bind{name, init} => {
            t := xty(g, init)
            fd := gfslot(g, name, gcty(g, t))
            check.env_bind(g.env, name, t)
            if len(g_call_susp(g, init)) > 0 {
                gfsusp_go(g, init, 1, fd, "")
            } else {
                v := gx(g, init)
                v = gconv_v(g, init, v, t)
                wln(g, "    fr->" + fd + " = " + v + ";")
            }
        }
        parser.Node.Let2{names, call} => {
            i := find(names, ",")
            na := names
            nb := ""
            if i >= 0 {
                na = substr(names, 0, i)
                nb = substr(names, i + 1, len(names))
            }
            cn := ""
            match call {
                parser.Node.Call{f} => {
                    cn = check.callee_name(f)
                }
                _ => {
                }
            }
            sn := g_call_susp(g, call)
            fa := ""
            fb := ""
            pr := gpair_info(g, call)
            tag := pr.tag
            vt := pr.vt
            if vt < 0 {
                vt = check.t_unk(g.ck)
            }
            if len(tag) == 0 {
                tag = "o_ret_" + cname(check.resolve_named(g.ck, cn))
            }
            if len(na) > 0 && na != "_" {
                fa = gfslot(g, na, gcty(g, vt))
                check.env_bind(g.env, na, vt)
            }
            if len(nb) > 0 && nb != "_" {
                fb = gfslot(g, nb, "int64_t")
                check.env_bind(g.env, nb, check.t_err(g.ck))
            }
            if len(sn) > 0 {
                match call {
                    parser.Node.Call{args} => {
                        if check.is_susp_builtin(sn) {
                            gfsusp_leaf(g, sn, args, 3, fa, fb)
                        } else {
                            gfsusp_call(g, call, sn, 3, fa, fb)
                        }
                    }
                    _ => {
                    }
                }
                return
            }
            n := g.tmpn
            g.tmpn = g.tmpn + 1
            c := gx(g, call)
            wln(g, "    { struct " + tag + " _r" + itoa(n) + " = " + c + ";")
            if len(fa) > 0 {
                wln(g, "      fr->" + fa + " = _r" + itoa(n) + ".val;")
            }
            if len(fb) > 0 {
                wln(g, "      fr->" + fb + " = _r" + itoa(n) + ".err;")
            }
            wln(g, "    }")
        }
        parser.Node.Assign{target, val} => {
            sn := g_call_susp(g, val)
            if len(sn) > 0 {
                tc := gx(g, target)
                match val {
                    parser.Node.Call{args} => {
                        if check.is_susp_builtin(sn) {
                            gfsusp_leaf(g, sn, args, 2, tc, "")
                        } else {
                            gfsusp_call(g, val, sn, 2, tc, "")
                        }
                    }
                    _ => {
                    }
                }
            } else {
                t := gx(g, target)
                v := gx(g, val)
                v = gconv_v(g, val, v, xty(g, target))
                wln(g, "    " + t + " = " + v + ";")
            }
        }
        parser.Node.ExprStmt{e} => {
            gfstmt_expr(g, e)
        }
        parser.Node.Defer{call} => {
            gdefer(g, call)
        }
        parser.Node.Ret{vals} => {
            // `return suspPair()` forwards [v, err] — desugar via two slots
            sn := ""
            if vals != nil && vals.next == nil {
                sn = g_call_susp(g, vals.v)
            }
            if len(sn) > 0 {
                pr2 := gpair_info(g, vals.v)
                if len(pr2.tag) > 0 {
                    pa := gfslot(g, "_pa" + itoa(g.hoistn), gcty(g, pr2.vt))
                    g.hoistn = g.hoistn + 1
                    pe := gfslot(g, "_pe" + itoa(g.hoistn), "int64_t")
                    g.hoistn = g.hoistn + 1
                    gfscope_drain(g, 0)
                    gdefers(g)
                    gfsusp_call(g, vals.v, sn, 3, pa, pe)
                    cv2 := gconv_v(g, vals.v, "fr->" + pa, g.cret)
                    wln(g, "    fr->result = (struct o_ret_" + cname(g.cur) + "){ " + cv2 + ", fr->" + pe + " };")
                    gsusp_ret(g, "RT_READY")
                    return
                }
            }
            gfscope_drain(g, 0)
            gdefers(g)
            if vals != nil {
                if g.retk == 2 && vals.next != nil {
                    v := gx(g, vals.v)
                    v = gconv_v(g, vals.v, v, g.cret)
                    e2 := gx(g, vals.next.v)
                    wln(g, "    fr->result = (struct o_ret_" + cname(g.cur) + "){ " + v + ", " + e2 + " };")
                } else if g.retk == 2 {
                    v := gx(g, vals.v)
                    tag := gpairsig(g, vals.v)
                    cur := "o_ret_" + cname(g.cur)
                    if len(tag) > 0 && tag != cur {
                        cv3 := gconv_v(g, vals.v, "_fw.val", g.cret)
                        wln(g, "    { struct " + tag + " _fw = " + v + "; fr->result = (struct " + cur + "){ " + cv3 + ", _fw.err }; }")
                    } else {
                        wln(g, "    fr->result = " + v + ";")
                    }
                } else {
                    v := gx(g, vals.v)
                    v = gconv_v(g, vals.v, v, g.cret)
                    wln(g, "    fr->result = " + v + ";")
                }
            }
            gsusp_ret(g, "RT_READY")
        }
        parser.Node.If{cond, then, els} => {
            c := gx(g, cond)
            lelse := "L" + itoa(g.labeln)
            g.labeln = g.labeln + 1
            lend := "L" + itoa(g.labeln)
            g.labeln = g.labeln + 1
            wln(g, "    if (!(" + c + ")) goto " + lelse + ";")
            check.env_push(g.env)
            check.env_push(g.fsl)
            gfblk(g, then)
            check.env_pop(g.fsl)
            check.env_pop(g.env)
            wln(g, "    goto " + lend + ";")
            wln(g, "    " + lelse + ": ;")
            if els != nil {
                check.env_push(g.env)
                check.env_push(g.fsl)
                if check.nk(els) == 23 {
                    gfblk(g, els)
                } else {
                    gfstmt(g, els)
                }
                check.env_pop(g.fsl)
                check.env_pop(g.env)
            }
            wln(g, "    " + lend + ": ;")
        }
        parser.Node.For{cond, body} => {
            lhead := "L" + itoa(g.labeln)
            g.labeln = g.labeln + 1
            lend := "L" + itoa(g.labeln)
            g.labeln = g.labeln + 1
            c := gx(g, cond)
            wln(g, "    " + lhead + ": ;")
            wln(g, "    if (!(" + c + ")) goto " + lend + ";")
            g.loops = push(g.loops, GLab{c: lhead, b: lend, d: len(g.sopen)})
            check.env_push(g.env)
            check.env_push(g.fsl)
            gfblk(g, body)
            check.env_pop(g.fsl)
            check.env_pop(g.env)
            gpop_loop(g)
            wln(g, "    goto " + lhead + ";")
            wln(g, "    " + lend + ": ;")
        }
        parser.Node.Break => {
            if len(g.loops) > 0 {
                gfscope_drain(g, g.loops[len(g.loops) - 1].d)
                wln(g, "    goto " + g.loops[len(g.loops) - 1].b + ";")
            }
        }
        parser.Node.Continue => {
            if len(g.loops) > 0 {
                gfscope_drain(g, g.loops[len(g.loops) - 1].d)
                wln(g, "    goto " + g.loops[len(g.loops) - 1].c + ";")
            }
        }
        parser.Node.Scope{body} => {
            i := len(g.sdecls)
            g.sdecls = push(g.sdecls, "RtScope sc" + itoa(i) + ";")
            wln(g, "    rt_scope_enter(&fr->sc" + itoa(i) + ");")
            g.sopen = push(g.sopen, i)
            check.env_push(g.env)
            check.env_push(g.fsl)
            gfblk(g, body)
            check.env_pop(g.fsl)
            check.env_pop(g.env)
            gpop_sopen(g)
            gfscope_close(g, i)
        }
        parser.Node.Spawn{e} => {
            gspawn(g, nil, e, false)
        }
        parser.Node.Go{e} => {
            gspawn(g, nil, e, false)
        }
        parser.Node.GoIn{sc, e} => {
            gspawn(g, sc, e, false)
        }
        parser.Node.SpawnBlocking{e} => {
            gspawn(g, nil, e, true)
        }
        parser.Node.Select{arms} => {
            gfselect(g, arms)
        }
        parser.Node.Unsafe{body} => {
            check.env_push(g.env)
            check.env_push(g.fsl)
            gfblk(g, body)
            check.env_pop(g.fsl)
            check.env_pop(g.env)
        }
        parser.Node.List{items} => {
            l := items
            for l != nil {
                gfstmt(g, l.v)
                l = l.next
            }
        }
        _ => {
        }
    }
}

// drop the innermost loop label (loop stack pop)
fn gpop_loop(g: mut G) {
    n := len(g.loops)
    if n == 0 {
        return
    }
    ys := mkslice(GLab, n - 1)
    i := 0
    for i < n - 1 {
        ys[i] = g.loops[i]
        i = i + 1
    }
    g.loops = ys
}

// join+finish frame scope sc<i> — same suspend point a scope's own exit
// emits: park until children drain, then tear the scope down
fn gfscope_close(g: mut G, i: int) {
    k := g.staten
    g.staten = g.staten + 1
    g.states = push(g.states, k)
    wln(g, "    fr->state = " + itoa(k) + ";")
    wln(g, "    if (rt_scope_join_poll(&fr->sc" + itoa(i) + ", task) == RT_PENDING) { fr->cur_scope = tls_scope; tls_scope = saved; return RT_PENDING; }")
    wln(g, "    s" + itoa(k) + ": ;")
    wln(g, "    { int64_t _e = rt_scope_finish(&fr->sc" + itoa(i) + ");")
    wln(g, "      if (_e) rt_scope_propagate(tls_scope, _e); }")
}

// close every frame scope open at stack depth `from`, innermost first —
// break/continue/return exits route through this: a bare goto orphans
// the scope's live children and leaks the frame-resident RtScope
fn gfscope_drain(g: mut G, from: int) {
    j := len(g.sopen) - 1
    for j >= from {
        gfscope_close(g, g.sopen[j])
        j = j - 1
    }
}

// pop the innermost open frame scope (mirror of gpop_loop)
fn gpop_sopen(g: mut G) {
    n := len(g.sopen)
    if n == 0 {
        return
    }
    ys := mkslice(int, n - 1)
    i := 0
    for i < n - 1 {
        ys[i] = g.sopen[i]
        i = i + 1
    }
    g.sopen = ys
}

// ---------- fn emission (seed func/func_frame/generate) ----------

// ret kind of a Fn.ret node: 0 void / 1 single / 2 pair
fn gretdk(g: mut G, ret: ref parser.Node) -> int {
    if ret == nil {
        return 0
    }
    if check.nk(ret) == 23 {
        return 2
    }
    return 1
}

fn gret1(g: mut G, ret: ref parser.Node) -> int {
    if ret == nil {
        return check.t_void(g.ck)
    }
    if check.nk(ret) == 23 {
        match ret {
            parser.Node.List{items} => {
                if items != nil {
                    return gty(g, items.v)
                }
            }
            _ => {
            }
        }
        return check.t_unk(g.ck)
    }
    return gty(g, ret)
}

// C return type text (seed ret_decl — externs degrade pairs to int64_t)
fn gret_c(g: mut G, ret: ref parser.Node, name: str, is_oxl: bool) -> str {
    k := gretdk(g, ret)
    if k == 0 {
        return "void"
    }
    if k == 1 {
        return gcty(g, gret1(g, ret))
    }
    if is_oxl {
        return "struct o_ret_" + cname(name)
    }
    return "int64_t"
}

fn gparams(g: mut G, params: ref parser.NList) -> str {
    s := ""
    pl := params
    for pl != nil {
        match pl.v {
            parser.Node.Param{name, ty} => {
                if len(s) > 0 {
                    s = s + ", "
                }
                s = s + gcty(g, gty(g, ty)) + " " + name
            }
            _ => {
            }
        }
        pl = pl.next
    }
    if len(s) == 0 {
        return "void"
    }
    return s
}

// declared param list with an optional receiver prepended — method
// sigs carry the receiver slot first (seed func param emission)
fn gparams2(g: mut G, recv: ref parser.Node, params: ref parser.NList) -> str {
    rp := ""
    if recv != nil {
        match recv {
            parser.Node.Param{name, ty} => {
                rp = gcty(g, gty(g, ty)) + " " + name
            }
            _ => {
            }
        }
    }
    pl := params
    for pl != nil {
        match pl.v {
            parser.Node.Param{name, ty} => {
                if len(rp) > 0 {
                    rp = rp + ", "
                }
                rp = rp + gcty(g, gty(g, ty)) + " " + name
            }
            _ => {
            }
        }
        pl = pl.next
    }
    if len(rp) == 0 {
        return "void"
    }
    return rp
}

// frame path for a susp fn (seed func_frame): struct o_frm_ + o_poll_ driver
fn gframe(g: mut G, qn: str, recv: ref parser.Node, params: ref parser.NList, ret: ref parser.Node, body: ref parser.Node) {
    g.inframe = 1
    g.fsl = check.env_new()
    check.env_push(g.fsl)
    g.fdecls = mkslice(str, 0)
    g.sdecls = mkslice(str, 0)
    g.states = mkslice(int, 0)
    g.staten = 1
    g.loops = mkslice(GLab, 0)
    g.sopen = mkslice(int, 0)
    g.defers = nil
    check.env_push(g.env)
    pfields := ""
    if recv != nil {
        match recv {
            parser.Node.Param{name, ty} => {
                t := gty(g, ty)
                pfields = pfields + " " + gcty(g, t) + " p_" + name + ";"
                check.env_bind(g.env, name, t)
                check.env_bind(g.fsl, name, -2)
            }
            _ => {
            }
        }
    }
    pl := params
    for pl != nil {
        match pl.v {
            parser.Node.Param{name, ty} => {
                t := gty(g, ty)
                pfields = pfields + " " + gcty(g, t) + " p_" + name + ";"
                check.env_bind(g.env, name, t)
                check.env_bind(g.fsl, name, -2)
            }
            _ => {
            }
        }
        pl = pl.next
    }
    res := ""
    if g.retk == 1 {
        res = " " + gcty(g, gret1(g, ret)) + " result;"
    }
    if g.retk == 2 {
        res = " struct o_ret_" + cname(qn) + " result;"
    }
    wpush(g)
    check.env_push(g.fsl)
    wln(g, "    fr->_dmark = rt_defer_mark();")
    gfblk(g, body)
    check.env_pop(g.fsl)
    gdefers(g)
    wpop(g)
    bodytxt := wjoin(g.wlast)
    check.env_pop(g.env)
    cases := "case 0: goto s0;"
    i := 0
    for i < len(g.states) {
        cases = cases + " case " + itoa(g.states[i]) + ": goto s" + itoa(g.states[i]) + ";"
        i = i + 1
    }
    fdj := ""
    i = 0
    for i < len(g.fdecls) {
        fdj = fdj + g.fdecls[i] + " "
        i = i + 1
    }
    sdj := ""
    i = 0
    for i < len(g.sdecls) {
        sdj = sdj + g.sdecls[i] + " "
        i = i + 1
    }
    ce := cname(qn)
    g.fhead = push(g.fhead, "struct o_frm_" + ce + " { RtScope *cur_scope; int state; RtFrame *child; RtDefer *_dmark;" + res + pfields + " " + fdj + " " + sdj + "};\nint o_poll_" + ce + "(RtFrame *_f, RtTask *task);\n")
    g.fbody = push(g.fbody, "int o_poll_" + ce + "(RtFrame *_f, RtTask *task) {\n    struct o_frm_" + ce + " *fr = (struct o_frm_" + ce + " *)_f;\n    RtScope *saved = tls_scope;\n    tls_scope = fr->cur_scope;\n    int _p;\n    switch (fr->state) { " + cases + " default: tls_scope = saved; return RT_READY; }\n    s0: ;\n" + bodytxt + "    fr->cur_scope = tls_scope; tls_scope = saved; return RT_READY;\n}\n")
    g.inframe = 0
}

fn gfunc(g: mut G, i: int) {
    if check.nk(g.its[i].node) != 24 {
        return
    }
    match g.its[i].node {
        parser.Node.Fn{name, recv, typarams} => {
            if typarams != nil {
                // generic defs emit only as mono instantiations
                return
            }
            gset_ctx(g, i)
            qn := check.fn_qname(g.ck, g.its[i].mod, recv, name)
            gemit_named_fn(g, i, qn, qn)
        }
        _ => {
        }
    }
}

// checker name resolution keys per-file import tables on cur_file —
// codegen must point both at the item being emitted (the seed rewrote
// names at load; here they resolve at emit, so a selective binding
// like `.{split}` needs its file's tables live)
fn gset_ctx(g: mut G, i: int) {
    g.ck.cur_mod = g.its[i].mod
    g.ck.cur_file = g.its[i].file
}

// emit one fn under `qn` — `base` is the fnsv/susp-set key (same as qn
// except for instantiations, where qn is the mangled name)
fn gemit_named_fn(g: mut G, i: int, qn: str, base: str) {
    match g.its[i].node {
        parser.Node.Fn{recv, params, ret, body} => {
            g.cur = qn
            g.retk = gretdk(g, ret)
            g.cret = gsub(g, gret1(g, ret))
            g.defers = nil
            if check.sl_has(g.ck.susp, base) {
                gframe(g, qn, recv, params, ret, body)
                if qn == "main" {
                    g.maink = 1
                }
                return
            }
            wln(g, gret_c(g, ret, qn, true) + " o_f_" + cname(qn) + "(" + gparams2(g, recv, params) + ") {")
            wln(g, "    RtDefer *_dmark = rt_defer_mark();")
            check.env_push(g.env)
            if recv != nil {
                match recv {
                    parser.Node.Param{name, ty} => {
                        check.env_bind(g.env, name, gty(g, ty))
                    }
                    _ => {
                    }
                }
            }
            pl := params
            for pl != nil {
                match pl.v {
                    parser.Node.Param{name, ty} => {
                        check.env_bind(g.env, name, gty(g, ty))
                    }
                    _ => {
                    }
                }
                pl = pl.next
            }
            gblk(g, body)
            gdefers(g)
            check.env_pop(g.env)
            wln(g, "}\n")
            if qn == "main" {
                g.maink = 2
            }
        }
        _ => {
        }
    }
}

// mono-instantiated generic fn — the body re-emits under the mangled
// name with `ibind` resolving its ty params (seed func_inst)
fn gfunc_inst(g: mut G, iq: str, im: str, ibind: own collections.Map) {
    fi := gfn_item(g, iq)
    if fi < 0 {
        return
    }
    gset_ctx(g, fi)
    // iq is already qualified — look it up directly; gfn's
    // resolve_named would re-prefix it (cur_mod "sort" + head "sort"
    // -> "sort.sort.sifto") and miss, leaving ty_scope unset so the
    // inst body's []T params parsed as []?.
    si := -1
    if collections.map_has(g.ck.fns, iq) {
        [si2, se] = collections.map_get(g.ck.fns, iq)
        if se == nil {
            si = si2
        }
    }
    if si >= 0 {
        g.ck.ty_scope = check.tp_names(g.ck.fnsv[si].typarams)
        g.ck.cur_ty_params = check.tp_clone(g.ck.fnsv[si].typarams)
    }
    g.subst = ibind
    gemit_named_fn(g, fi, im, iq)
    g.subst = nil
    g.ck.ty_scope = nil
    g.ck.cur_ty_params = nil
}

// enum decl: payload structs + the tagged union (seed generate pass 1)
fn gemit_enum(g: mut G, i: int) {
    if check.nk(g.its[i].node) != 29 {
        return
    }
    match g.its[i].node {
        parser.Node.Enum{name, vars} => {
            qn := check.qname(g.its[i].mod, name)
            members := ""
            vi := 0
            vl := vars
            for vl != nil {
                match vl.v {
                    parser.Node.Variant{name} => {
                        sn := qn + "." + name
                        if collections.map_has(g.ck.structs, sn) {
                            [si, err] = collections.map_get(g.ck.structs, sn)
                            if err == nil {
                                fields := g.ck.structsv[si].fields
                                if fields != nil {
                                    g.head = push(g.head, "struct o_s_" + cname(sn) + " {")
                                    fl := fields
                                    for fl != nil {
                                        g.head = push(g.head, "    " + gcty(g, fl.v.t) + " f_" + fl.v.n + ";")
                                        fl = fl.next
                                    }
                                    g.head = push(g.head, "};\n")
                                    members = members + " struct o_s_" + cname(sn) + " v" + itoa(vi) + ";"
                                }
                            }
                        }
                    }
                    _ => {
                    }
                }
                vi = vi + 1
                vl = vl.next
            }
            if len(members) == 0 {
                members = " char _pad;"
            }
            g.head = push(g.head, "struct o_en_" + cname(qn) + " { int tag; union {" + members + " } u; };\n")
        }
        _ => {
        }
    }
}

fn gemit_struct(g: mut G, i: int) {
    if check.nk(g.its[i].node) != 26 {
        return
    }
    match g.its[i].node {
        parser.Node.Struct{name, fields} => {
            gset_ctx(g, i)
            qn := check.qname(g.its[i].mod, name)
            g.head = push(g.head, "struct o_s_" + cname(qn) + " {")
            fl := fields
            for fl != nil {
                match fl.v {
                    parser.Node.FieldDef{name, ty} => {
                        g.head = push(g.head, "    " + gcty(g, gty(g, ty)) + " f_" + name + ";")
                    }
                    _ => {
                    }
                }
                fl = fl.next
            }
            g.head = push(g.head, "};\n")
        }
        _ => {
        }
    }
}

fn gemit_retstruct(g: mut G, i: int) {
    if check.nk(g.its[i].node) != 24 {
        return
    }
    match g.its[i].node {
        parser.Node.Fn{ex, name, recv, typarams, ret} => {
            if ex || typarams != nil {
                // pair-ret insts emit `o_ret_<mangled>` at queue time
                return
            }
            if gretdk(g, ret) != 2 {
                return
            }
            gset_ctx(g, i)
            qn := check.fn_qname(g.ck, g.its[i].mod, recv, name)
            g.head = push(g.head, "struct o_ret_" + cname(qn) + " { " + gcty(g, gret1(g, ret)) + " val; int64_t err; };")
        }
        _ => {
        }
    }
}

fn gemit_static(g: mut G, i: int) {
    if check.nk(g.its[i].node) != 10 {
        return
    }
    match g.its[i].node {
        parser.Node.Let{name, ty, init} => {
            gset_ctx(g, i)
            t := check.t_unk(g.ck)
            if ty != nil {
                t = gty(g, ty)
            }
            if ty == nil {
                t = xty(g, init)
            }
            g.head = push(g.head, "static " + gcty(g, t) + " o_g_" + cname(check.qname(g.ck.cur_mod, name)) + ";")
        }
        _ => {
        }
    }
}

fn gemit_proto(g: mut G, i: int) {
    if check.nk(g.its[i].node) != 24 {
        return
    }
    match g.its[i].node {
        parser.Node.Fn{ex, name, recv, typarams, params, ret} => {
            if !ex && typarams != nil {
                // generic fns only exist as instantiations (seed: no proto)
                return
            }
            gset_ctx(g, i)
            qn := check.fn_qname(g.ck, g.its[i].mod, recv, name)
            nm := name
            if !ex {
                nm = "o_f_" + cname(qn)
            }
            g.head = push(g.head, gret_c(g, ret, qn, !ex) + " " + nm + "(" + gparams2(g, recv, params) + ");\n")
        }
        _ => {
        }
    }
}

// `o_fnv_wrap_<qn>` — zero-env wrapper over a named fn (seed fnv_wraps pass)
fn gemit_fnv_one(g: mut G, n: str) {
    [fi, err] = collections.map_get(g.ck.fns, n)
    if err == nil {
        sig := g.ck.fnsv[fi]
        ret_c := "void"
        if sig.retk == 1 {
            ret_c = gcty(g, sig.ret1)
        }
        psig := ""
        argl := ""
        il := sig.params
        i := 0
        for il != nil {
            psig = psig + ", " + gcty(g, il.v) + " a" + itoa(i)
            if i > 0 {
                argl = argl + ", "
            }
            argl = argl + "a" + itoa(i)
            i = i + 1
            il = il.next
        }
        callee := n
        if sig.is_extern == 0 {
            callee = "o_f_" + cname(n)
        }
        ret_kw := "return "
        if ret_c == "void" {
            ret_kw = ""
        }
        g.clpro = push(g.clpro, "static " + ret_c + " o_fnv_wrap_" + cname(n) + "(void* _e" + psig + ") { " + ret_kw + callee + "(" + argl + "); }\n")
    }
}

// bind a generic impl method's ty params from the iface-declared
// method params (seed vtab_bind) — nil when the impl isn't generic
fn gvtab_bind(g: mut G, fi: int, m: ref check.IMethod) -> own collections.Map {
    sig := g.ck.fnsv[fi]
    if sig.typarams == nil {
        return nil
    }
    bind := collections.map_new()
    w := sig.params
    if w != nil {
        w = w.next // params[0] is the receiver; iface decls carry the rest
    }
    mp := m.params
    for w != nil && mp != nil {
        check.bind_vars(g.ck, w.v, mp.v, bind)
        w = w.next
        mp = mp.next
    }
    return bind
}

// queue insts for generic impl methods the recorded vtab pairs pin —
// returns nonzero when new work appeared (seed seed_vtab_insts)
fn gseed_vtab_insts(g: mut G) -> int {
    progress := 0
    vu := g.vtabs
    for vu != nil {
        impl := vu.impl
        if len(impl) > 6 && substr(impl, 0, 6) == "iface:" {
            vu = vu.next
        } else {
            ii := check.iface_ent(g.ck, vu.w)
            if ii >= 0 {
                ml := g.ck.ifacesv[ii].methods
                for ml != nil {
                    fname := impl + "." + ml.v.n
                    fi := gfn(g, fname)
                    if fi >= 0 && g.ck.fnsv[fi].typarams != nil {
                        b := gvtab_bind(g, fi, ml.v)
                        if b != nil {
                            m := ginst_name(g, fname, g.ck.fnsv[fi].typarams, b)
                            if !collections.map_has(g.inst_done, m) {
                                ginst_queue(g, fname, g.ck.fnsv[fi].typarams, b)
                                progress = 1
                            }
                        }
                    }
                    ml = ml.next
                }
            }
            vu = vu.next
        }
    }
    return progress
}

// concrete vtabs + receiver-normalizing thunks for every (iface, impl)
// pair a conversion site produced (seed emit_vtabs)
fn gemvtab_one(g: mut G, vu: ref GVU) {
    w := vu.w
    impl := vu.impl
    ii := check.iface_ent(g.ck, w)
    if ii >= 0 {
        ml := g.ck.ifacesv[ii].methods
        slots := ""
        i := 0
        for ml != nil {
            m := ml.v
            tname := "o_vtt_" + cname(w) + "_" + gvtkey(impl) + "_" + itoa(i)
            ret_c := "void"
            if m.retk == 1 {
                ret_c = gcty(g, m.ret1)
            }
            if m.retk == 2 {
                ret_c = "struct o_vret_" + cname(w) + "_" + cname(m.n)
            }
            psig := ""
            argl := ""
            il := m.params
            k := 0
            for il != nil {
                psig = psig + ", " + gcty(g, il.v) + " a" + itoa(k)
                argl = argl + ", a" + itoa(k)
                il = il.next
                k = k + 1
            }
            g.vout = push(g.vout, "static " + ret_c + " " + tname + "(void* _d" + psig + ") {")
            if len(impl) > 6 && substr(impl, 0, 6) == "iface:" {
                // iface->iface rewrap: forward through the source
                // pair's vtab (seed same-impl arm)
                w2 := substr(impl, 6, len(impl))
                j := gimidx(g, w2, m.n)
                vsig := "void*"
                il = m.params
                for il != nil {
                    vsig = vsig + ", " + gcty(g, il.v)
                    il = il.next
                }
                if m.retk == 0 {
                    g.vout = push(g.vout, "    RtIface *_iv = (RtIface*)_d;\n    ((void (*)(" + vsig + "))_iv->vtab[" + itoa(j) + "])(_iv->data" + argl + ");\n}\n")
                }
                if m.retk == 1 {
                    g.vout = push(g.vout, "    RtIface *_iv = (RtIface*)_d;\n    return ((" + ret_c + " (*)(" + vsig + "))_iv->vtab[" + itoa(j) + "])(_iv->data" + argl + ");\n}\n")
                }
                if m.retk == 2 {
                    src := "struct o_vret_" + cname(w2) + "_" + cname(m.n)
                    g.vout = push(g.vout, "    RtIface *_iv = (RtIface*)_d;\n    " + src + " _r = ((" + src + " (*)(" + vsig + "))_iv->vtab[" + itoa(j) + "])(_iv->data" + argl + ");\n    return (" + ret_c + "){ _r.val, _r.err };\n}\n")
                }
            } else {
                // concrete impl — normalize the erased receiver to
                // the method's declared receiver ty
                fname := impl + "." + m.n
                cn := "struct o_s_" + cname(impl)
                if collections.map_has(g.ck.enums, impl) {
                    cn = "struct o_en_" + cname(impl)
                }
                callee := "o_f_" + cname(fname)
                let bind: own collections.Map = nil
                mret := m.retk
                mfi := gfn(g, fname)
                if mfi >= 0 {
                    mret = g.ck.fnsv[mfi].retk
                    if g.ck.fnsv[mfi].typarams != nil {
                        bind = gvtab_bind(g, mfi, m)
                        if bind != nil {
                            callee = "o_f_" + cname(ginst_name(g, fname, g.ck.fnsv[mfi].typarams, bind))
                        }
                    }
                }
                recv := "((" + cn + "*)_d)"
                if mfi >= 0 && g.ck.fnsv[mfi].params != nil {
                    rty := g.ck.fnsv[mfi].params.v
                    if bind != nil {
                        rty = check.subst_ty(g.ck, rty, bind)
                    }
                    rk0 := tyk(g, rty)
                    if rk0 == check.k_struct() || rk0 == check.k_enum() {
                        recv = "(*(" + cn + "*)_d)"
                    }
                }
                cargs := recv + argl
                if mret == 0 {
                    g.vout = push(g.vout, "    " + callee + "(" + cargs + ");\n}\n")
                }
                if mret == 1 {
                    g.vout = push(g.vout, "    return " + callee + "(" + cargs + ");\n}\n")
                }
                if mret == 2 {
                    rtag := substr(callee, 4, len(callee))
                    g.vout = push(g.vout, "    struct o_ret_" + rtag + " _r = " + callee + "(" + cargs + ");\n    return (" + ret_c + "){ _r.val, _r.err };\n}\n")
                }
            }
            if len(slots) > 0 {
                slots = slots + ", "
            }
            slots = slots + "(void*)" + tname
            ml = ml.next
            i = i + 1
        }
        g.vout = push(g.vout, "static void* o_vt_" + cname(w) + "_" + gvtkey(impl) + "[] = { " + slots + " };\n")
    }
}

fn genall(g: mut G) -> str {
    // G1 — every decl lands in a `GUnit` carrying the C symbols it
    // defines; dead decls never reach the output. A unit's
    // reachability is decided by the emitted text itself: any `o_*`
    // (or extern) identifier token another unit spells is a use edge,
    // so call edges are the resolved callee names, conv-site `o_vt_*`
    // uses pin their vtab + its method thunks transitively, and types
    // are pulled by whatever `o_s_*`/`o_en_*`/`o_ret_*`/`o_vret_*`
    // name a live unit needs spelled — param/ret/field types survive
    // transitively for free since they are spelled in the live text
    // that needs them. (seed generate_mode.)
    g.units = mkslice(GUnit, 0)
    g.dpos = collections.map_new()
    g.dchain = mkslice(int, 0)
    uof := collections.map_new() // item idx (itoa) -> unit idx, globals
    // enum defs first: variant payload structs + the tagged union —
    // a user struct or another variant may embed an enum by value
    i := 0
    for i < len(g.its) {
        if check.nk(g.its[i].node) == 29 {
            match g.its[i].node {
                parser.Node.Enum{name, vars} => {
                    ui := gubegin(g)
                    s := gusnap(g)
                    gemit_enum(g, i)
                    gudrain(g, ui, s)
                    qn := check.qname(g.its[i].mod, name)
                    gdef(g, ui, "o_en_" + cname(qn))
                    vl := vars
                    for vl != nil {
                        match vl.v {
                            parser.Node.Variant{name} => {
                                gdef(g, ui, "o_s_" + cname(qn + "." + name))
                            }
                            _ => {
                            }
                        }
                        vl = vl.next
                    }
                }
                _ => {
                }
            }
        }
        i = i + 1
    }
    // struct defs
    i = 0
    for i < len(g.its) {
        if check.nk(g.its[i].node) == 26 {
            match g.its[i].node {
                parser.Node.Struct{name} => {
                    ui := gubegin(g)
                    s := gusnap(g)
                    gemit_struct(g, i)
                    gudrain(g, ui, s)
                    gdef(g, ui, "o_s_" + cname(check.qname(g.its[i].mod, name)))
                }
                _ => {
                }
            }
        }
        i = i + 1
    }
    // iface vtab call ret structs for `-> [T, err]` methods — one unit
    // per (iface, method) so unused ifaces drop theirs entirely
    i = 0
    for i < len(g.ck.ifacesv) {
        ml := g.ck.ifacesv[i].methods
        for ml != nil {
            if ml.v.retk == 2 {
                ui := gubegin(g)
                s := gusnap(g)
                g.head = push(g.head, "struct o_vret_" + cname(g.ck.ifacesv[i].n) + "_" + cname(ml.v.n) + " { " + gcty(g, ml.v.ret1) + " val; int64_t err; };\n")
                gudrain(g, ui, s)
                gdef(g, ui, "o_vret_" + cname(g.ck.ifacesv[i].n) + "_" + cname(ml.v.n))
            }
            ml = ml.next
        }
        i = i + 1
    }
    // file-scope globals — decl now, init expression after the bodies
    // (pre-G1 order: inits can queue insts + record vtab uses). Only
    // main's own package globals are reachability roots — their names
    // stay unqualified; imported ones need a spelled reference.
    i = 0
    for i < len(g.its) {
        if check.nk(g.its[i].node) == 10 {
            match g.its[i].node {
                parser.Node.Let{name} => {
                    ui := gubegin(g)
                    collections.map_set(uof, itoa(i), ui)
                    s := gusnap(g)
                    gemit_static(g, i)
                    gudrain(g, ui, s)
                    gdef(g, ui, "o_g_" + cname(check.qname(g.its[i].mod, name)))
                    g.units[ui].root = 1 - ghasdot(check.qname(g.its[i].mod, name))
                }
                _ => {
                }
            }
        }
        i = i + 1
    }
    // extern protos — one unit each so uncalled externs drop; the def
    // is the bare C name call sites spell
    i = 0
    for i < len(g.its) {
        if check.nk(g.its[i].node) == 24 {
            match g.its[i].node {
                parser.Node.Fn{ex, name} => {
                    if ex {
                        ui := gubegin(g)
                        s := gusnap(g)
                        gemit_proto(g, i)
                        gudrain(g, ui, s)
                        gdef(g, ui, name)
                    }
                }
                _ => {
                }
            }
        }
        i = i + 1
    }
    // fn units: pair-ret decl + proto in the head band, the body (or
    // suspend frame) spread over the later bands — generic decls
    // never become units at all (only instantiations do)
    g.w = mkslice(str, 0)
    i = 0
    for i < len(g.its) {
        if check.nk(g.its[i].node) == 24 {
            match g.its[i].node {
                parser.Node.Fn{ex, name, recv, typarams, ret} => {
                    if !ex && typarams == nil {
                        ui := gubegin(g)
                        s := gusnap(g)
                        gemit_retstruct(g, i)
                        gemit_proto(g, i)
                        gfunc(g, i)
                        gudrain(g, ui, s)
                        qn := check.fn_qname(g.ck, g.its[i].mod, recv, name)
                        gdef(g, ui, "o_f_" + cname(qn))
                        if gretdk(g, ret) == 2 {
                            gdef(g, ui, "o_ret_" + cname(qn))
                        }
                        if check.sl_has(g.ck.susp, qn) {
                            gdef(g, ui, "o_frm_" + cname(qn))
                            gdef(g, ui, "o_poll_" + cname(qn))
                        }
                    }
                }
                _ => {
                }
            }
        }
        i = i + 1
    }
    // global initializers — the assign line + eval stmts join the
    // global's unit, spliced into oxl_main after the mark; emission
    // order keeps the pre-G1 bodies-then-inits position, ahead of the
    // inst drain
    i = 0
    for i < len(g.its) {
        if check.nk(g.its[i].node) == 10 {
            match g.its[i].node {
                parser.Node.Let{name, ty, init} => {
                    gset_ctx(g, i)
                    t := check.t_unk(g.ck)
                    if ty != nil {
                        t = gty(g, ty)
                    }
                    if ty == nil {
                        t = xty(g, init)
                    }
                    [ui, uerr] = collections.map_get(uof, itoa(i))
                    if uerr == nil {
                        s := gusnap(g)
                        v := gx(g, init)
                        v = gconv_v(g, init, v, t)
                        g.ginit = push(g.ginit, "    o_g_" + cname(check.qname(g.its[i].mod, name)) + " = " + v + ";")
                        gudrain_init(g, ui, s)
                    }
                }
                _ => {
                }
            }
        }
        i = i + 1
    }
    // mono instantiations + vtab-seeded method insts — a co-fixpoint:
    // bodies create conv sites (vtab uses), vtab pairs pin generic
    // method insts, insts create more conv sites (seed insts loop)
    progress := true
    for progress {
        progress = false
        for g.insts != nil {
            in := g.insts
            g.insts = in.next
            progress = true
            ui := gubegin(g)
            s := gusnap(g)
            ginst_head(g, in.q, in.mangled, in.bind)
            gfunc_inst(g, in.q, in.mangled, in.bind)
            gudrain(g, ui, s)
            gdef(g, ui, "o_f_" + cname(in.mangled))
            gdef(g, ui, "o_ret_" + cname(in.mangled))
            gdef(g, ui, "o_frm_" + cname(in.mangled))
            gdef(g, ui, "o_poll_" + cname(in.mangled))
        }
        if gseed_vtab_insts(g) > 0 {
            progress = true
        }
    }
    // B4: zero-env wrappers giving named fns the (void* env, args...)
    // calling convention every fn value shares — a fn named anywhere
    // a value is expected is reachable through its wrapper
    fl := g.fnv
    for fl != nil {
        ui := gubegin(g)
        s := gusnap(g)
        gemit_fnv_one(g, fl.v)
        gudrain(g, ui, s)
        gdef(g, ui, "o_fnv_wrap_" + cname(fl.v))
        fl = fl.next
    }
    // concrete vtabs + receiver-normalizing thunks — one unit per
    // (iface, impl) pair a conversion site produced
    vu := g.vtabs
    for vu != nil {
        ui := gubegin(g)
        s := gusnap(g)
        gemvtab_one(g, vu)
        gudrain(g, ui, s)
        gdef(g, ui, "o_vt_" + cname(vu.w) + "_" + gvtkey(vu.impl))
        vu = vu.next
    }
    // oxl_main — the root unit. Its text spells `o_f_main` / the test
    // runner's `o_f_test_*` (+ `o_frm_*`/`o_poll_*` for susp entries)
    // so entries mark through ordinary use edges; the @@GLOBALS@@
    // hole is spliced with live global inits after the mark.
    ru := gubegin(g)
    g.units[ru].root = 1
    if g.testm == 1 {
        // test mode: scope-wrap each top-level test_ fn
        tb := "void oxl_main(void) {\n@@GLOBALS@@"
        i = 0
        id := 0
        for i < len(g.its) {
            if check.nk(g.its[i].node) == 24 {
                match g.its[i].node {
                    parser.Node.Fn{name} => {
                        if len(name) > 5 && substr(name, 0, 5) == "test_" {
                            qn := check.qname(g.its[i].mod, name)
                            cn := cname(qn)
                            sid := itoa(id)
                            tb = tb + "    { RtScope _t" + sid + "; rt_scope_enter(&_t" + sid + "); "
                            if check.sl_has(g.ck.susp, qn) {
                                tb = tb + "struct o_frm_" + cn + " *_fr = (struct o_frm_" + cn + " *)rt_task_new(o_poll_" + cn + ", (int64_t)sizeof(struct o_frm_" + cn + "));\n      rt_run_root((RtFrame *)_fr); "
                            } else {
                                tb = tb + "o_f_" + cn + "(); "
                            }
                            tb = tb + "int _e" + sid + " = rt_scope_try(&_t" + sid + ");\n      rt_print_str(rt_str(\"  " + name + " ... \")); rt_println_str(rt_str(_e" + sid + " ? \"FAIL\" : \"ok\")); }\n"
                            id = id + 1
                        }
                    }
                    _ => {
                    }
                }
            }
            i = i + 1
        }
        g.units[ru].ob = push(g.units[ru].ob, tb + "}\n")
    }
    if g.testm == 0 && g.maink == 1 {
        g.units[ru].ob = push(g.units[ru].ob, "void oxl_main(void) {\n@@GLOBALS@@    struct o_frm_main *_rt = (struct o_frm_main *)rt_task_new(o_poll_main, (int64_t)sizeof(struct o_frm_main));\n    rt_run_root((RtFrame *)_rt); }\n")
    }
    if g.testm == 0 && g.maink == 2 {
        g.units[ru].ob = push(g.units[ru].ob, "void oxl_main(void) {\n@@GLOBALS@@    o_f_main(); }\n")
    }
    gemit_drops(g, ru)
    // mark: from the root seeds over use edges until fixpoint
    g.live = mkslice(int, len(g.units))
    work := mkslice(int, 0)
    i = 0
    for i < len(g.units) {
        if g.units[i].root != 0 {
            g.live[i] = 1
            work = push(work, i)
        }
        i = i + 1
    }
    for len(work) > 0 {
        t := work[len(work) - 1]
        work = work[0:len(work) - 1]
        g.uhits = mkslice(int, 0)
        j := 0
        for j < len(g.units[t].hd) {
            gscan(g, g.units[t].hd[j])
            j = j + 1
        }
        j = 0
        for j < len(g.units[t].tp) {
            gscan(g, g.units[t].tp[j])
            j = j + 1
        }
        j = 0
        for j < len(g.units[t].fd) {
            gscan(g, g.units[t].fd[j])
            j = j + 1
        }
        j = 0
        for j < len(g.units[t].cp) {
            gscan(g, g.units[t].cp[j])
            j = j + 1
        }
        j = 0
        for j < len(g.units[t].vt) {
            gscan(g, g.units[t].vt[j])
            j = j + 1
        }
        j = 0
        for j < len(g.units[t].fb) {
            gscan(g, g.units[t].fb[j])
            j = j + 1
        }
        j = 0
        for j < len(g.units[t].ob) {
            gscan(g, g.units[t].ob[j])
            j = j + 1
        }
        j = 0
        for j < len(g.units[t].cb) {
            gscan(g, g.units[t].cb[j])
            j = j + 1
        }
        j = 0
        for j < len(g.units[t].gi) {
            gscan(g, g.units[t].gi[j])
            j = j + 1
        }
        j = 0
        for j < len(g.uhits) {
            h := g.uhits[j]
            if g.live[h] == 0 {
                g.live[h] = 1
                work = push(work, h)
            }
            j = j + 1
        }
    }
    // init lines of surviving globals, in unit order — spliced into
    // the oxl_main placeholder the root unit left
    ginits := ""
    i = 0
    for i < len(g.units) {
        if g.live[i] != 0 {
            ginits = ginits + wjoin(g.units[i].gi)
        }
        i = i + 1
    }
    // splice the hole only inside the synthesized oxl_main unit —
    // identical text elsewhere is string data, not a hole
    i = 0
    for i < len(g.units[ru].ob) {
        g.units[ru].ob[i] = gsplice(g.units[ru].ob[i], "@@GLOBALS@@", ginits)
        i = i + 1
    }
    // heads (decls, protos, frame decls, trampolines, vtab rows,
    // closure protos) precede every body; closure + defer-thunk
    // bodies go last since they only reference protos
    out := "#include \"rt.h\"\n\n"
    i = 0
    for i < len(g.units) {
        if g.live[i] != 0 {
            out = out + wjoin(g.units[i].hd)
        }
        i = i + 1
    }
    i = 0
    for i < len(g.units) {
        if g.live[i] != 0 {
            out = out + wjoin(g.units[i].tp)
        }
        i = i + 1
    }
    i = 0
    for i < len(g.units) {
        if g.live[i] != 0 {
            out = out + wjoin(g.units[i].fd)
        }
        i = i + 1
    }
    i = 0
    for i < len(g.units) {
        if g.live[i] != 0 {
            out = out + wjoin(g.units[i].cp)
        }
        i = i + 1
    }
    i = 0
    for i < len(g.units) {
        if g.live[i] != 0 {
            out = out + wjoin(g.units[i].vt)
        }
        i = i + 1
    }
    i = 0
    for i < len(g.units) {
        if g.live[i] != 0 {
            out = out + wjoin(g.units[i].fb)
        }
        i = i + 1
    }
    i = 0
    for i < len(g.units) {
        if g.live[i] != 0 {
            out = out + wjoin(g.units[i].ob)
        }
        i = i + 1
    }
    i = 0
    for i < len(g.units) {
        if g.live[i] != 0 {
            out = out + wjoin(g.units[i].cb)
        }
        i = i + 1
    }
    return out
}

// ---------- driver ----------
// emit is the library entry: consume a check_file result (diags are
// the caller's to report — emit assumes a clean check) and return the
// generated C text. testm mirrors codegen --test / `oxl test`.
fn emit(r: own check.CkRes, testm: int) -> str {
    g := new(G)
    g.ck = r.ck
    g.its = r.items
    g.fidx = collections.map_new()
    i := 0
    for i < len(g.its) {
        if check.nk(g.its[i].node) == 24 {
            match g.its[i].node {
                parser.Node.Fn{name, recv} => {
                    gset_ctx(g, i)
                    collections.map_set(g.fidx, check.fn_qname(g.ck, g.its[i].mod, recv, name), i)
                }
                _ => {
                }
            }
        }
        i = i + 1
    }
    g.env = check.env_new()
    g.benv = check.env_new()
    g.fsl = check.env_new()
    g.w = mkslice(str, 0)
    g.wst = nil
    g.wlast = mkslice(str, 0)
    g.head = mkslice(str, 0)
    g.out = mkslice(str, 0)
    g.tramp = mkslice(str, 0)
    g.fhead = mkslice(str, 0)
    g.fbody = mkslice(str, 0)
    g.clpro = mkslice(str, 0)
    g.clbod = mkslice(str, 0)
    g.ginit = mkslice(str, 0)
    g.defers = nil
    g.fnv = nil
    g.fdecls = mkslice(str, 0)
    g.sdecls = mkslice(str, 0)
    g.states = mkslice(int, 0)
    g.loops = mkslice(GLab, 0)
    g.sopen = mkslice(int, 0)
    g.tmpn = 0
    g.scopen = 0
    g.cln = 0
    g.staten = 0
    g.labeln = 0
    g.hoistn = 0
    g.retk = 0
    g.cret = -1
    g.subst = nil
    g.insts = nil
    g.inst_done = collections.map_new()
    g.vtabs = nil
    g.vtab_set = collections.map_new()
    g.vout = mkslice(str, 0)
    g.cur = ""
    g.inframe = 0
    g.maink = 0
    g.testm = testm
    g.units = mkslice(GUnit, 0)
    g.dpos = collections.map_new()
    g.dchain = mkslice(int, 0)
    g.uhits = mkslice(int, 0)
    g.live = mkslice(int, 0)
    return genall(g)
}

// run is the cmd/codegen entry point — arg parsing stays here so the
// thin main is a one-line call.
fn run() {
    testm := 0
    jsm := 0
    file := ""
    ai := 1
    for ai < argc() {
        a := argv(ai)
        if a == "--test" {
            testm = 1
        } else if a == "--js" {
            jsm = 1
        } else {
            file = a
        }
        ai = ai + 1
    }
    if len(file) == 0 {
        println("usage: codegen [--test] <file.oxl>")
        exit(1)
    }
    r := check.check_file(file, 1 - testm)
    if len(r.ck.diags) > 0 {
        i := 0
        for i < len(r.ck.diags) {
            d := r.ck.diags[i]
            println("error [" + d.kind + "] " + d.msg)
            i = i + 1
        }
        exit(1)
    }
    if jsm == 1 {
        print(emit_js(r, testm))
    } else {
        print(emit(r, testm))
    }
}
