package check

// bootstrap/check.oxl — the typechecker, written in .oxl.
// Third self-host component: ports oxl/src/check.rs over the bootstrap
// parser's `Node` AST. Types are interned ints into a pool (seed-style
// Ty handles); scopes are a Vec of std/collections maps.
//
//   oxl run bootstrap/check.oxl -- file.oxl      prints diags or "ok"
//
// AST-subset boundary: the bootstrap parser does not produce generics
// (fn f[T any]), interface decls, select arms, closures, import aliases,
// or float literals — files using them fail parse-side before checking.
import "oxl/bootstrap/lexlib"

import "oxl/bootstrap/parser"

import "std/collections"

import "std/strings"

// package loading needs portable dir probes (seed resolve_pkg mirrors)
extern fn rt_lsdir(path: str) -> []str

extern fn rt_isdir(path: str) -> int

extern fn rt_isfile(path: str) -> int

extern fn rt_islnk(path: str) -> int

// module resolution needs env (OXLMODCACHE) + file-exists (oxl.mod)
extern fn rt_getenv(name: str) -> str

extern fn rt_fexists(path: str) -> int

// canonical absolute path (`/`-separated); "" on failure — find_root and
// the internal rule compare real ancestors, not lexical ones
extern fn rt_fullpath(path: str) -> str

extern fn rt_is_windows() -> int

// ---------- interned types ----------
fn k_unk() -> int {
    return 0
}

fn k_void() -> int {
    return 1
}

fn k_int() -> int {
    return 2
}

fn k_str() -> int {
    return 3
}

fn k_bool() -> int {
    return 4
}

fn k_err() -> int {
    return 5
}

fn k_cstr() -> int {
    return 6
}

fn k_float() -> int {
    return 7
}

fn k_chan() -> int {
    return 8
}

fn k_own() -> int {
    return 9
}

fn k_ref() -> int {
    return 10
}

fn k_mut() -> int {
    return 11
}

fn k_slice() -> int {
    return 12
}

fn k_fn() -> int {
    return 13
}

fn k_var() -> int {
    return 14
}

fn k_struct() -> int {
    return 15
}

fn k_enum() -> int {
    return 16
}

fn k_shared() -> int {
    return 17
}

fn k_iface() -> int {
    return 18
}

fn k_byte() -> int {
    return 19
}

// one pool record; i/r are ty handles (-1 unused), args an int list
struct T { k: int, i: int, args: own IList, r: int, name: str }

struct IList { v: int, next: own IList }

fn icons(v: int, next: own IList) -> own IList {
    c := new(IList)
    c.v = v
    c.next = next
    return c
}

fn irev(l: own IList) -> own IList {
    let out: own IList = nil
    for l != nil {
        n := l.next
        l.next = out
        out = l
        l = n
    }
    return out
}

fn ilen(l: ref IList) -> int {
    n := 0
    for l != nil {
        n = n + 1
        l = l.next
    }
    return n
}

// ---------- tables ----------
struct FEnt { n: str, t: int } // (field/variant-arg name, ty)

struct FList { v: own FEnt, next: own FList }

fn fcons(n: str, t: int, next: own FList) -> own FList {
    c := new(FList)
    c.v = new(FEnt)
    c.v.n = n
    c.v.t = t
    c.next = next
    return c
}

// deep copy — the same field list is shared between the struct
// registry and the enum variant entry; each needs its own cells
fn fclone(l: ref FList) -> own FList {
    if l == nil {
        return nil
    }
    e := new(FEnt)
    e.n = l.v.n
    e.t = l.v.t
    c := new(FList)
    c.v = e
    c.next = fclone(l.next)
    return c
}

fn frev(l: own FList) -> own FList {
    let out: own FList = nil
    for l != nil {
        n := l.next
        l.next = out
        out = l
        l = n
    }
    return out
}

// ty of field `n`, or -1
fn ffind(l: ref FList, n: str) -> int {
    for l != nil {
        if l.v.n == n {
            return l.v.t
        }
        l = l.next
    }
    return -1
}

fn flen(l: ref FList) -> int {
    n := 0
    for l != nil {
        n = n + 1
        l = l.next
    }
    return n
}

fn fall_positional(l: ref FList) -> bool {
    // all fields named fN — positional-payload ctor
    for l != nil {
        w := l.v.n
        if len(w) < 2 || byteat(w, 0) != 102 {
            return false
        }
        i := 1
        for i < len(w) {
            c := byteat(w, i)
            if c < 48 || c > 57 {
                return false
            }
            i = i + 1
        }
        l = l.next
    }
    return true
}

struct SEnt { n: str, fields: own FList } // struct entry

struct EVar { n: str, fields: own FList } // one variant

struct VList { v: own EVar, next: own VList }

struct EEnt { n: str, vars: own VList } // enum entry

fn vcons(n: str, fields: own FList, next: own VList) -> own VList {
    c := new(VList)
    c.v = new(EVar)
    c.v.n = n
    c.v.fields = fields
    c.next = next
    return c
}

fn vrev(l: own VList) -> own VList {
    let out: own VList = nil
    for l != nil {
        n := l.next
        l.next = out
        out = l
        l = n
    }
    return out
}

// variant lookup is inlined at each call site — `vl` walks `vars` until
// `vl.v.n` matches (ref returns are banned, so this can't be a helper)
struct FnSig {
    params: own IList, // ty handles
    retk: int, // 0 void, 1 one, 2 pair
    ret1: int, // ty handle for retk 1/2
    is_extern: int,
    typarams: own TPList, // generic (T, constraint) decls — nil when plain
}

struct SList { v: str, next: own SList }

fn scons(v: str, next: own SList) -> own SList {
    c := new(SList)
    c.v = v
    c.next = next
    return c
}

fn sl_clone(l: ref SList) -> own SList {
    if l == nil {
        return nil
    }
    c := new(SList)
    c.v = l.v
    c.next = sl_clone(l.next)
    return c
}

fn sl_del(l: own SList, n: str) -> own SList {
    if l == nil {
        return nil
    }
    if l.v == n {
        return l.next
    }
    t := l.next
    l.next = sl_del(t, n)
    return l
}

// (T, constraint) pairs — generic fn params + the active check scope
struct TPEnt { n: str, c: str }

struct TPList { v: own TPEnt, next: own TPList }

fn tp_clone(l: ref TPList) -> own TPList {
    if l == nil {
        return nil
    }
    c := new(TPList)
    c.v = new(TPEnt)
    c.v.n = l.v.n
    c.v.c = l.v.c
    c.next = tp_clone(l.next)
    return c
}

// interface method sig + the registered decl
struct IMethod { n: str, params: own IList, retk: int, ret1: int }

struct IMList { v: own IMethod, next: own IMList }

struct IEnt { n: str, ops: own SList, methods: own IMList }

// per-scope move marks, snapshotted for branch merges — LL is a list
// of name lists, parallel to the scope stack
struct LL { names: own SList, next: own LL }

// select/match arm end-states awaiting the fall-through merge
struct ArmSt { mv: own LL, ft: int, next: own ArmSt }

// per-file import aliases (qualifier -> stem) and selective names
struct ModEnt { alias: str, stem: str, ver: str, next: own ModEnt }

struct SumEnt { path: str, ver: str, is_mod: int, h1: str, next: own SumEnt }

struct DirRes { dir: str, err: str }

struct SAcc { items: []str }

struct IB { v: []int }

// M3: one import's checkable bindings — `qual` = local qualifier the
// file must reference ("" when this bind is a selective name), `tgt` =
// resolved `bound.name` a selective import expects ("" for qualifiers).
// `used` marks at name resolution so the unused pass reads intent.
struct ImpBind { path: str, qual: str, tgt: str, used: int, next: own ImpBind }

struct FileAlias {
    file: str,
    aliases: own ModEnt,
    names: own ModEnt,
    binds: own ImpBind,
    next: own FileAlias,
}

fn sl_has(ll: ref SList, ss: str) -> bool {
    for ll != nil {
        if ll.v == ss {
            return true
        }
        ll = ll.next
    }
    return false
}

struct Edge { a: str, b: str, next: own Edge }

struct DBox { kind: str, msg: str, file: str, off: int }

// an open editor buffer standing in for its on-disk path — the LSP
// analyzes unsaved text (Rust `over` in load_pkg)
struct OverEnt { path: str, text: str, next: own OverEnt }

struct ClChk { callees: own SList, seeded: int, next: own ClChk }

struct It { node: own parser.Node, mod: str, file: str }

struct Scope {
    m: own collections.Map,
    moved: own SList,
    ds: own collections.Map,
}

struct Env { scopes: []Scope }

struct Loader { items: []It }

struct Ck {
    tyv: []T, // interned type records
    fns: own collections.Map, // name -> idx into fnsv
    fnsv: []FnSig,
    structs: own collections.Map, // name -> idx into structsv
    structsv: []SEnt,
    enums: own collections.Map, // name -> idx into enumsv
    enumsv: []EEnt,
    globals: own collections.Map, // name -> ty handle
    ifaces: own collections.Map, // name -> idx into ifacesv
    ifacesv: []IEnt,
    ty_scope: own SList, // type param names in scope (current generic fn)
    cur_ty_params: own TPList, // (name, constraint) of the fn being checked
    methods: own SList, // qualified `T.m` method names — for the susp ban
    file_aliases: []FileAlias, // per-file alias + selective tables
    diags: []DBox,
    edges: own Edge, // caller -> callee call graph
    susp: own SList, // suspend-capable fn names
    loaded: own SList, // resolved package dirs
    loaded_names: own ModEnt, // resolved dir -> package clause cache
    loading: own ModEnt, // in-flight pkg dir -> written imp (cycle detect)
    load_fail: int, // a load-time diag fired — unwind like the seed's None path
    mod_on: int, // an oxl.mod was found (module mode); 0 = std-only
    mod_path: str, // declared module path
    mod_root: str, // dir holding oxl.mod
    mod_floor: str, // `oxl` directive as written
    mod_reqs: own ModEnt, // require path -> version
    mod_reps: own ModEnt, // replace path(+ver) -> resolved local dir
    mod_sel: own ModEnt, // MVS build list: module path -> selected version
    modcache: str, // module cache root
    mod_sums: own SumEnt, // oxl.sum lines — cache lookups verify against them
    entry_dir: str, // root package dir — anchors the source-tree std walk
    root_pkg: str, // root package clause — the seed fires builtin-redefine only on main's bare decls
    fnvals: own SList, // named fns used as values
    cur_fn: str,
    cur_mod: str, // package clause while checking
    cur_file: str, // file path while checking (import tables key on it)
    retk: int, // current fn's return kind
    ret1: int,
    in_let2: int,
    in_cl: int, // inside `{ |..| }` — ret feeds cl_ret
    cl_ret: int, // inferred closure return ty (-1 none)
    clcks: own ClChk, // deferred closure susp checks
    loop_depth: int,
    nerr: int,
    usev: []UseRec, // index.uses — use-site records (E1 port)
    decls: own collections.Map, // decl key -> idx into declsv
    declsv: []DeclEnt,
    over: own OverEnt, // unsaved-buffer overrides (LSP only; nil in CLI use)
    dpos: int, // pending diag offset — set at expr/stmt entry, read by diag()
}

// E1/LSP index: a use-site record mapping (file, [lo,hi)) to the decl it
// resolves to (sig text for hover, def span for goto)
struct UseRec {
    file: str,
    lo: int,
    hi: int,
    sig: str,
    def_file: str,
    def_lo: int,
    def_hi: int,
}

struct DeclEnt { sig: str, file: str, lo: int, hi: int }

fn env_new() -> own Env {
    e := Env{scopes: mkslice(Scope, 0)}
    e.scopes = push(e.scopes, Scope{m: collections.map_new(), moved: nil, ds: collections.map_new()})
    return new(e)
}

fn env_push(e: mut Env) {
    e.scopes = push(e.scopes, Scope{m: collections.map_new(), moved: nil, ds: collections.map_new()})
}

fn env_pop(e: mut Env) {
    e.scopes = e.scopes[0:len(e.scopes) - 1]
}

fn env_set(e: mut Env, n: str, t: int, lo: int, hi: int) {
    i := len(e.scopes) - 1
    collections.map_set(e.scopes[i].m, n, t)
    // a (re)binding starts un-moved — clears any stale mark on shadow
    e.scopes[i].moved = sl_del(e.scopes[i].moved, n)
    // binding-site span for hover/goto on locals (E1 port)
    collections.map_set(e.scopes[i].ds, n, lo * 4294967296 + hi)
}

struct Span { lo: int, hi: int }

// no-span variant for scope maps that aren't index sources (codegen's
// emission scopes)
fn env_bind(e: mut Env, n: str, t: int) {
    env_set(e, n, t, 0, 0)
}

// span of the visible binding for `n` (innermost scope first), nil on miss
fn decl_span(e: ref Env, n: str) -> own Span {
    i := len(e.scopes) - 1
    for i >= 0 {
        if collections.map_has(e.scopes[i].ds, n) {
            [v, err] = collections.map_get(e.scopes[i].ds, n)
            if err == nil {
                return new(Span{lo: v / 4294967296, hi: v % 4294967296})
            }
        }
        i = i - 1
    }
    return nil
}

// ---------- LSP index (E1 port) ----------
// record a decl — keyed for use-site lookups, plus a self-use so the
// decl name itself hovers/jumps (smallest-span wins at query time)
fn rec_decl(ck: mut Ck, key: str, lo: int, hi: int, sig: str) {
    if collections.map_has(ck.decls, key) {
        [di, err] = collections.map_get(ck.decls, key)
        if err == nil {
            ck.declsv[di] = DeclEnt{sig: sig, file: ck.cur_file, lo: lo, hi: hi}
        }
    } else {
        collections.map_set(ck.decls, key, len(ck.declsv))
        ck.declsv = push(ck.declsv, DeclEnt{sig: sig, file: ck.cur_file, lo: lo, hi: hi})
    }
    ck.usev = push(ck.usev, UseRec{file: ck.cur_file, lo: lo, hi: hi, sig: sig, def_file: ck.cur_file, def_lo: lo, def_hi: hi})
}

// record a use-site -> its decl (no-op for builtins/locals — those
// aren't `decls` keys)
fn rec_use(ck: mut Ck, lo: int, hi: int, key: str) {
    if collections.map_has(ck.decls, key) {
        [di, err] = collections.map_get(ck.decls, key)
        if err == nil {
            d := ck.declsv[di]
            ck.usev = push(ck.usev, UseRec{file: ck.cur_file, lo: lo, hi: hi, sig: d.sig, def_file: d.file, def_lo: d.lo, def_hi: d.hi})
        }
    }
}

// record a local-binding use — sig is `name: ty`, def is the visible
// binding's span
fn rec_local(ck: mut Ck, lo: int, hi: int, n: str, t: int, env: ref Env) {
    dl := lo
    dh := hi
    ds := decl_span(env, n)
    if ds != nil {
        dl = ds.lo
        dh = ds.hi
    }
    ck.usev = push(ck.usev, UseRec{file: ck.cur_file, lo: lo, hi: hi, sig: n + ": " + ty_name(ck, t), def_file: ck.cur_file, def_lo: dl, def_hi: dh})
}

// the `.name` region of a callee/field expr (dotted uses point at the
// member, not the receiver): `x.m` -> m's span, `f` -> f's span
fn member_span(f: ref parser.Node) -> own Span {
    match f {
        parser.Node.Field{name, hi} => {
            return new(Span{lo: hi - len(name), hi: hi})
        }
        parser.Node.Name{n, lo, hi} => {
            d := last_dot(n)
            if d >= 0 {
                ml := lo + d + 1
                return new(Span{lo: ml, hi: ml + (len(n) - d - 1)})
            }
            return new(Span{lo: lo, hi: hi})
        }
        _ => {
            return new(Span{lo: parser.nlo(f), hi: parser.nhi(f)})
        }
    }
}

// a `Node.Ty` f0 that is a bare (possibly dotted) type name — no space
// (own/ref/mut/fn), no brackets, no parens
fn bare_ty_name(s: str) -> bool {
    if len(s) == 0 {
        return false
    }
    i := 0
    for i < len(s) {
        ch := byteat(s, i)
        ok := ch == 95 || ch == 46 || ch >= 97 && ch <= 122 || ch >= 65 && ch <= 90 || i > 0 && ch >= 48 && ch <= 57
        if !ok {
            return false
        }
        i = i + 1
    }
    return true
}

// ---------- move tracking (D2) ----------
// a binding is marked moved when its `own` value flows somewhere
// ownership transfers (own arg, own field store, return, chan send).
// moved marks live per-scope, parallel to `scopes`.
fn scope_of(e: ref Env, n: str) -> int {
    i := len(e.scopes) - 1
    for i >= 0 {
        if collections.map_has(e.scopes[i].m, n) {
            return i
        }
        i = i - 1
    }
    return -1
}

fn is_moved(e: ref Env, n: str) -> bool {
    i := scope_of(e, n)
    return i >= 0 && sl_has(e.scopes[i].moved, n)
}

fn mark_moved(e: mut Env, n: str) {
    i := scope_of(e, n)
    if i >= 0 && !sl_has(e.scopes[i].moved, n) {
        e.scopes[i].moved = scons(n, e.scopes[i].moved)
    }
}

fn clear_moved(e: mut Env, n: str) {
    i := scope_of(e, n)
    if i >= 0 {
        e.scopes[i].moved = sl_del(e.scopes[i].moved, n)
    }
}

// snapshot of every scope's moved list — outermost first
fn moved_save(e: ref Env) -> own LL {
    let out: own LL = nil
    i := len(e.scopes) - 1
    for i >= 0 {
        c := new(LL)
        c.names = sl_clone(e.scopes[i].moved)
        c.next = out
        out = c
        i = i - 1
    }
    return out
}

fn moved_restore(e: mut Env, s: own LL) {
    i := 0
    for i < len(e.scopes) && s != nil {
        e.scopes[i].moved = s.names
        s = s.next
        i = i + 1
    }
}

// branch merge: keep a binding marked if it moved on ANY path — the
// join can't prove which branch ran
fn moved_union(e: mut Env, other: ref LL) {
    i := 0
    o := other
    for i < len(e.scopes) && o != nil {
        l := o.names
        for l != nil {
            if !sl_has(e.scopes[i].moved, l.v) {
                e.scopes[i].moved = scons(l.v, e.scopes[i].moved)
            }
            l = l.next
        }
        o = o.next
        i = i + 1
    }
}

// does control reach the end of this block? A trailing return/break/
// continue can't have its moves observed at the join
fn falls_through(items: ref parser.NList) -> bool {
    if items == nil {
        return true
    }
    l := items
    for l.next != nil {
        l = l.next
    }
    return stmt_ft(l.v)
}

fn stmt_ft(s: ref parser.Node) -> bool {
    match s {
        parser.Node.Ret{vals} => {
            return false
        }
        parser.Node.Break => {
            return false
        }
        parser.Node.Continue => {
            return false
        }
        parser.Node.If{cond, then, els} => {
            if els == nil {
                return true
            }
            return node_ft(then) || node_ft(els)
        }
        parser.Node.Scope{body} => {
            return node_ft(body)
        }
        _ => {
            return true
        }
    }
    return true
}

fn node_ft(b: ref parser.Node) -> bool {
    if b == nil {
        return true
    }
    match b {
        parser.Node.List{items} => {
            return falls_through(items)
        }
        _ => {
            return stmt_ft(b)
        }
    }
    return true
}

// `e` consumes an `own` binding — mark it moved
fn move_own(ck: mut Ck, e: ref parser.Node, env: mut Env) {
    match e {
        parser.Node.Name{n} => {
            t := env_get(ck, env, n)
            if t >= 0 && ck.tyv[t].k == k_own() {
                mark_moved(env, n)
            }
        }
        _ => {
        }
    }
}

// move only when the destination wants ownership (param, field, ret) —
// an iface data ptr takes it too
fn move_for(ck: mut Ck, e: ref parser.Node, want: int, env: mut Env) {
    if want >= 0 && (ck.tyv[want].k == k_own() || ck.tyv[want].k == k_iface()) {
        move_own(ck, e, env)
    }
}

// deep copy of a moved snapshot — select/match arms each re-run from it
fn ll_clone(l: ref LL) -> own LL {
    if l == nil {
        return nil
    }
    c := new(LL)
    c.names = sl_clone(l.names)
    c.next = ll_clone(l.next)
    return c
}

// after an arm-merge: pre is restored then wiped — the union of the
// arms' end-states re-adds everything that survives
fn moved_clear_all(e: mut Env) {
    i := 0
    for i < len(e.scopes) {
        e.scopes[i].moved = nil
        i = i + 1
    }
}

// `for` post-pass: any binding newly marked inside the body would be
// read moved by the next iteration — unless re-assigned in place
fn for_moved_check(ck: mut Ck, e: ref Env, pre: ref LL) {
    i := 0
    p := pre
    for i < len(e.scopes) && p != nil {
        l := e.scopes[i].moved
        for l != nil {
            if !sl_has(p.names, l.v) {
                diag(ck, "own", "`" + l.v + "` moved inside `for` — re-assign it in the same iteration")
            }
            l = l.next
        }
        p = p.next
        i = i + 1
    }
}

// ---------- generics + interfaces (D1/D3) ----------

// ty param `v` declared on the fn being checked?
fn tp_found(l: ref TPList, v: str) -> bool {
    for l != nil {
        if l.v.n == v {
            return true
        }
        l = l.next
    }
    return false
}

// `v`'s declared constraint ("" when not a param of the current fn)
fn tp_get(l: ref TPList, v: str) -> str {
    for l != nil {
        if l.v.n == v {
            return l.v.c
        }
        l = l.next
    }
    return ""
}

// idx into ifacesv or -1 — `n` must already be qualified
fn iface_ent(ck: ref Ck, n: str) -> int {
    if collections.map_has(ck.ifaces, n) {
        [i, err] = collections.map_get(ck.ifaces, n)
        if err == nil {
            return i
        }
    }
    return -1
}

// Ret equality across (kind, ty) pairs — void carries no ty
fn ret_eq(ck: ref Ck, k1: int, r1: int, k2: int, r2: int) -> bool {
    if k1 != k2 {
        return false
    }
    if k1 == 0 {
        return true
    }
    return ty_eq(ck, r1, r2)
}

// the fixed op vocabulary — a Var operand passes any op (the declared
// constraint gates use sites, not this test)
fn op_ok(ck: ref Ck, op: str, t: int) -> bool {
    k := ck.tyv[t].k
    if op == "eq" {
        return k == k_int() || k == k_bool() || k == k_str() || k == k_chan() || k == k_var() || k == k_float() || k == k_byte() || k == k_err()
    }
    if op == "ordered" {
        return k == k_int() || k == k_float() || k == k_byte() || k == k_str() || k == k_var()
    }
    if op == "add" {
        return k == k_int() || k == k_str() || k == k_float() || k == k_byte() || k == k_var()
    }
    return false
}

// base type name behind own/ref/mut — the name methods key on
fn ty_base(ck: ref Ck, t: int) -> str {
    k := ck.tyv[t].k
    if k == k_struct() || k == k_enum() {
        return ck.tyv[t].name
    }
    if k == k_own() || k == k_ref() || k == k_mut() {
        i := ck.tyv[t].i
        if i >= 0 {
            return ty_base(ck, i)
        }
    }
    return ""
}

// iface `have` covers everything iface `want` declares
fn iface_covers(ck: ref Ck, have: str, want: str) -> bool {
    wi := iface_ent(ck, want)
    hi := iface_ent(ck, have)
    if wi < 0 || hi < 0 {
        return false
    }
    wo := ck.ifacesv[wi].ops
    for wo != nil {
        if !sl_has(ck.ifacesv[hi].ops, wo.v) {
            return false
        }
        wo = wo.next
    }
    wm := ck.ifacesv[wi].methods
    for wm != nil {
        hm := ck.ifacesv[hi].methods
        ok := false
        for hm != nil {
            if hm.v.n == wm.v.n && il_eq(ck, hm.v.params, wm.v.params) && ret_eq(ck, hm.v.retk, hm.v.ret1, wm.v.retk, wm.v.ret1) {
                ok = true
                break
            }
            hm = hm.next
        }
        if !ok {
            return false
        }
        wm = wm.next
    }
    return true
}

// copy an IList — interface method sigs are shared, callers need own
fn il_clone(l: ref IList) -> own IList {
    if l == nil {
        return nil
    }
    c := new(IList)
    c.v = l.v
    c.next = il_clone(l.next)
    return c
}

// record ty-param bindings by matching an expected param ty against
// the argument's ty — `own T` binds T to the whole own type
fn bind_vars(ck: mut Ck, want: int, got: int, bind: mut collections.Map) {
    wk := ck.tyv[want].k
    gk := ck.tyv[got].k
    if wk == k_var() {
        v := ck.tyv[want].name
        if !collections.map_has(bind, v) {
            collections.map_set(bind, v, got)
        }
        return
    }
    if wk == k_own() && gk == k_own() || wk == k_ref() && gk == k_ref() || wk == k_mut() && gk == k_mut() {
        if ck.tyv[want].i >= 0 && ck.tyv[got].i >= 0 {
            bind_vars(ck, ck.tyv[want].i, ck.tyv[got].i, bind)
        }
        return
    }
    // an own/ref/mut argument into a ref/mut param still binds the inner
    if (wk == k_ref() || wk == k_mut()) && (gk == k_own() || gk == k_mut() || gk == k_ref()) {
        if ck.tyv[want].i >= 0 && ck.tyv[got].i >= 0 {
            bind_vars(ck, ck.tyv[want].i, ck.tyv[got].i, bind)
        }
        return
    }
    if wk == k_slice() && gk == k_slice() {
        if ck.tyv[want].i >= 0 && ck.tyv[got].i >= 0 {
            bind_vars(ck, ck.tyv[want].i, ck.tyv[got].i, bind)
        }
        return
    }
    // own []T into []T param — binds the element through the borrow view
    if wk == k_slice() && gk == k_own() {
        gi := ck.tyv[got].i
        if gi >= 0 && ck.tyv[gi].k == k_slice() && ck.tyv[want].i >= 0 && ck.tyv[gi].i >= 0 {
            bind_vars(ck, ck.tyv[want].i, ck.tyv[gi].i, bind)
        }
        return
    }
    if wk == k_fn() && gk == k_fn() {
        wp := ck.tyv[want].args
        gp := ck.tyv[got].args
        for wp != nil && gp != nil {
            bind_vars(ck, wp.v, gp.v, bind)
            wp = wp.next
            gp = gp.next
        }
        if ck.tyv[want].r >= 0 && ck.tyv[got].r >= 0 {
            bind_vars(ck, ck.tyv[want].r, ck.tyv[got].r, bind)
        }
    }
}

// substitute bound ty params inside `t` — unbound Vars stay Vars
fn subst_ty(ck: mut Ck, t: int, bind: ref collections.Map) -> int {
    if t < 0 {
        return t
    }
    k := ck.tyv[t].k
    if k == k_var() {
        v := ck.tyv[t].name
        if collections.map_has(bind, v) {
            [bt, err] = collections.map_get(bind, v)
            if err == nil {
                return bt
            }
        }
        return t
    }
    if k == k_own() || k == k_ref() || k == k_mut() {
        return ti(ck, k, subst_ty(ck, ck.tyv[t].i, bind))
    }
    if k == k_slice() {
        return ti(ck, k, subst_ty(ck, ck.tyv[t].i, bind))
    }
    if k == k_fn() {
        let ps: own IList = nil
        l := ck.tyv[t].args
        for l != nil {
            ps = icons(subst_ty(ck, l.v, bind), ps)
            l = l.next
        }
        return tm(ck, k, -1, irev(ps), subst_ty(ck, ck.tyv[t].r, bind), "")
    }
    return t
}

// concrete `tname` carries every method iface `iname` declares — the
// `tname.m` fn must exist with the iface's sig behind a receiver slot
fn impl_satisfies(ck: mut Ck, tname: str, iname: str) -> bool {
    ii := iface_ent(ck, iname)
    if ii < 0 {
        return false
    }
    ml := ck.ifacesv[ii].methods
    for ml != nil {
        q := tname + "." + ml.v.n
        if !collections.map_has(ck.fns, q) {
            return false
        }
        [fi, err] = collections.map_get(ck.fns, q)
        if err != nil {
            return false
        }
        sig := ck.fnsv[fi]
        if sig.is_extern == 1 || ilen(sig.params) != ilen(ml.v.params) + 1 {
            return false
        }
        if sig.typarams == nil {
            w := sig.params.next
            m := ml.v.params
            for w != nil && m != nil {
                if !ty_eq(ck, w.v, m.v) {
                    return false
                }
                w = w.next
                m = m.next
            }
            if w != nil || m != nil || !ret_eq(ck, sig.retk, sig.ret1, ml.v.retk, ml.v.ret1) {
                return false
            }
        } else {
            // generic impl — the iface sig pins the ty params: bind
            // declared params onto the iface's, then compare post-subst
            bind := collections.map_new()
            w := sig.params.next
            m := ml.v.params
            for w != nil && m != nil {
                bind_vars(ck, w.v, m.v, bind)
                w = w.next
                m = m.next
            }
            tp := sig.typarams
            for tp != nil {
                if !collections.map_has(bind, tp.v.n) {
                    return false
                }
                tp = tp.next
            }
            w = sig.params.next
            m = ml.v.params
            for w != nil && m != nil {
                if !ty_eq(ck, subst_ty(ck, w.v, bind), m.v) {
                    return false
                }
                w = w.next
                m = m.next
            }
            if w != nil || m != nil {
                return false
            }
            ok := sig.retk == ml.v.retk
            if ok && sig.retk != 0 {
                ok = ty_eq(ck, subst_ty(ck, sig.ret1, bind), ml.v.ret1)
            }
            if !ok {
                return false
            }
        }
        ml = ml.next
    }
    return true
}

// does `t` satisfy constraint `c` (builtin word or interface name)? A
// method-declaring iface needs the type's method set; ops keep the
// fixed vocabulary
fn satisfies(ck: mut Ck, t: int, c: str) -> bool {
    tk := ck.tyv[t].k
    if tk == k_var() {
        v := ck.tyv[t].name
        if tp_found(ck.cur_ty_params, v) {
            vc := tp_get(ck.cur_ty_params, v)
            if vc == c {
                return true
            }
            if collections.map_has(ck.ifaces, vc) && collections.map_has(ck.ifaces, c) {
                return iface_covers(ck, vc, c)
            }
            ci := iface_ent(ck, c)
            if ci < 0 || ck.ifacesv[ci].methods != nil {
                return false
            }
            ol := ck.ifacesv[ci].ops
            for ol != nil {
                if !op_ok(ck, ol.v, t) {
                    return false
                }
                ol = ol.next
            }
            return true
        }
    }
    if tk == k_iface() {
        if collections.map_has(ck.ifaces, c) {
            return iface_covers(ck, ck.tyv[t].name, c)
        }
    }
    if len(c) == 0 || c == "any" {
        return true
    }
    if c == "eq" || c == "ordered" || c == "add" {
        return op_ok(ck, c, t)
    }
    ci := iface_ent(ck, c)
    if ci < 0 {
        return false
    }
    ol := ck.ifacesv[ci].ops
    for ol != nil {
        if !op_ok(ck, ol.v, t) {
            return false
        }
        ol = ol.next
    }
    if ck.ifacesv[ci].methods == nil {
        return true
    }
    b := ty_base(ck, t)
    if len(b) == 0 {
        return false
    }
    return impl_satisfies(ck, b, c)
}

// `got` flows into iface `want` — concrete impls need the method set,
// ifaces cover ifaces, constrained Vars forward their constraint, and
// nil is the empty pair
fn iface_ok(ck: mut Ck, want: int, got: int) -> bool {
    if ck.tyv[want].k != k_iface() {
        return false
    }
    w := ck.tyv[want].name
    gk := ck.tyv[got].k
    if gk == k_iface() {
        return iface_covers(ck, ck.tyv[got].name, w)
    }
    if gk == k_var() {
        v := ck.tyv[got].name
        if tp_found(ck.cur_ty_params, v) {
            c := tp_get(ck.cur_ty_params, v)
            return c == w || iface_covers(ck, c, w)
        }
        return false
    }
    if gk == k_err() {
        return true
    }
    b := ty_base(ck, got)
    if len(b) == 0 {
        return false
    }
    return impl_satisfies(ck, b, w)
}

// generic bodies may only use operators the constraint permits
fn req_op(ck: mut Ck, var: str, op: str, bop: str) {
    c := ""
    if tp_found(ck.cur_ty_params, var) {
        c = tp_get(ck.cur_ty_params, var)
    }
    has := false
    if c == "eq" {
        has = op == "eq"
    }
    if c == "ordered" {
        has = op == "ordered" || op == "eq"
    }
    if c == "add" {
        has = op == "add"
    }
    if len(c) > 0 && c != "any" && c != "eq" && c != "ordered" && c != "add" {
        ci := iface_ent(ck, c)
        if ci >= 0 {
            has = sl_has(ck.ifacesv[ci].ops, op)
        }
    }
    if !has {
        diag(ck, "type", "`" + bop + "` on `" + var + "` requires constraint `" + op + "` (has `" + c + "`)")
    }
}

// receiver base name behind `own `/`ref `/`mut ` prefixes — the
// method's `T` in its `T.m` key
fn recv_base_ty(s: str) -> str {
    r := strings.trim(s)
    i := find(r, " ")
    for i > 0 {
        q := substr(r, 0, i)
        if q != "own" && q != "ref" && q != "mut" {
            return r
        }
        r = strings.trim(substr(r, i + 1, len(r)))
        i = find(r, " ")
    }
    return r
}

// qualified decl key for a fn — methods are `T.m` on the receiver's
// resolved base name, everything else is `mod.name`
fn fn_qname(ck: mut Ck, mod: str, recv: ref parser.Node, name: str) -> str {
    if recv == nil {
        return qname(mod, name)
    }
    b := ""
    match recv {
        parser.Node.Param{ty} => {
            b = recv_base_ty(ty_str(ty))
        }
        _ => {
        }
    }
    if len(b) == 0 {
        return qname(mod, name)
    }
    return resolve_named(ck, b) + "." + name
}

// method-call resolution target: 1 = direct `T.m` fn, 2 = vtable slot,
// 0 = nothing
struct MT { k: int, q: str, ps: own IList, rk: int, r1: int }

fn method_target(ck: ref Ck, t: int, m: str) -> own MT {
    mt := new(MT{k: 0, q: "", ps: nil, rk: 0, r1: -1})
    tk := ck.tyv[t].k
    if tk == k_own() || tk == k_ref() || tk == k_mut() {
        i := ck.tyv[t].i
        if i >= 0 {
            return method_target(ck, i, m)
        }
        return mt
    }
    if tk == k_struct() || tk == k_enum() {
        q := ck.tyv[t].name + "." + m
        if collections.map_has(ck.fns, q) {
            mt.k = 1
            mt.q = q
        }
        return mt
    }
    if tk == k_iface() {
        ii := iface_ent(ck, ck.tyv[t].name)
        if ii >= 0 {
            ml := ck.ifacesv[ii].methods
            for ml != nil {
                if ml.v.n == m {
                    mt.k = 2
                    mt.q = ck.tyv[t].name + "." + m
                    mt.ps = il_clone(ml.v.params)
                    mt.rk = ml.v.retk
                    mt.r1 = ml.v.ret1
                    return mt
                }
                ml = ml.next
            }
        }
        return mt
    }
    if tk == k_var() {
        v := ck.tyv[t].name
        if tp_found(ck.cur_ty_params, v) {
            c := tp_get(ck.cur_ty_params, v)
            ii := iface_ent(ck, c)
            if ii >= 0 {
                ml := ck.ifacesv[ii].methods
                for ml != nil {
                    if ml.v.n == m {
                        mt.k = 2
                        mt.q = c + "." + m
                        mt.ps = il_clone(ml.v.params)
                        mt.rk = ml.v.retk
                        mt.r1 = ml.v.ret1
                        return mt
                    }
                    ml = ml.next
                }
            }
        }
        return mt
    }
    return mt
}

// `w.m(args)` through an iface vtable — the declared sig checks args
// (the receiver is the data ptr, not a visible arg)
fn call_iface(ck: mut Ck, ps: ref IList, retk: int, ret1: int, args: ref parser.NList, env: mut Env) -> int {
    if nl_len(args) != ilen(ps) {
        diag(ck, "check", "method takes " + itoa(ilen(ps)) + " args, got " + itoa(nl_len(args)))
    }
    wl := ps
    al := args
    for al != nil && wl != nil {
        gt := expr(ck, al.v, env)
        assignable(ck, wl.v, gt)
        move_for(ck, al.v, wl.v, env)
        wl = wl.next
        al = al.next
    }
    if retk == 0 {
        return t_void(ck)
    }
    if retk == 2 && ck.in_let2 == 0 {
        diag(ck, "check", "`[T, err]` result must be bound with `[v, err] =` or returned")
    }
    return ret1
}

// `want`/`got` where `got` is the receiver being adapted: value want
// derefs a pointer arg, pointer want refs a value arg
fn recv_adapt_ty(ck: ref Ck, want: int, got: int) -> int {
    wk := ck.tyv[want].k
    gk := ck.tyv[got].k
    if (wk == k_struct() || wk == k_enum()) && (gk == k_own() || gk == k_ref() || gk == k_mut()) {
        if ty_base(ck, got) == ck.tyv[want].name {
            return want
        }
    }
    if (wk == k_own() || wk == k_ref() || wk == k_mut()) && (gk == k_struct() || gk == k_enum()) {
        if ty_base(ck, want) == ck.tyv[got].name {
            return want
        }
    }
    return got
}

// field ty of `name` on a struct(-ish) `t` — -1 when absent
fn field_ty(ck: ref Ck, t: int, name: str) -> int {
    sn := ""
    k := ck.tyv[t].k
    if k == k_struct() {
        sn = ck.tyv[t].name
    }
    if k == k_own() || k == k_ref() || k == k_mut() {
        i := ck.tyv[t].i
        if i >= 0 && ck.tyv[i].k == k_struct() {
            sn = ck.tyv[i].name
        }
    }
    if len(sn) == 0 || !collections.map_has(ck.structs, sn) {
        return -1
    }
    [si, err] = collections.map_get(ck.structs, sn)
    if err != nil {
        return -1
    }
    return ffind(ck.structsv[si].fields, name)
}

// can `&e` be taken? idents always; field/index chains when their
// base is — anything else is an rvalue
fn is_lvalue(e: ref parser.Node) -> bool {
    if e == nil {
        return false
    }
    k := nk(e)
    if k == 2 {
        return true
    }
    if k == 9 || k == 38 {
        match e {
            parser.Node.Field{obj} => {
                return is_lvalue(obj)
            }
            parser.Node.Index{obj} => {
                return is_lvalue(obj)
            }
            _ => {
            }
        }
    }
    return false
}

// a `T.m` registered under some T ending `.m` — the susp scans have no
// env to type the receiver, so this only approximates (the methods-may-
// not-suspend ban makes wrong answers unreachable in valid code)
fn method_q(ck: ref Ck, m: str) -> str {
    suf := "." + m
    l := ck.methods
    for l != nil {
        if strings.endswith(l.v, suf) {
            return l.v
        }
        l = l.next
    }
    return ""
}

// return kind+ty of a call expr — resolves declared fns, method calls
// through the receiver's ty, and bare `m(x)` method sugar
struct CRet { rk: int, r1: int }

fn call_ret(ck: mut Ck, e: ref parser.Node, env: mut Env) -> own CRet {
    cr := new(CRet{rk: -1, r1: -1})
    if e == nil || nk(e) != 8 {
        return cr
    }
    match e {
        parser.Node.Call{f, args} => {
            n := callee_name(f)
            if len(n) == 0 {
                return cr
            }
            qn := resolve_named(ck, n)
            if collections.map_has(ck.fns, qn) {
                [fi, err] = collections.map_get(ck.fns, qn)
                if err == nil {
                    cr.rk = ck.fnsv[fi].retk
                    cr.r1 = ck.fnsv[fi].ret1
                }
                return cr
            }
            if nk(f) == 9 {
                match f {
                    parser.Node.Field{obj, name} => {
                        ot := expr(ck, obj, env)
                        mt := method_target(ck, ot, name)
                        if mt.k == 2 {
                            cr.rk = mt.rk
                            cr.r1 = mt.r1
                        }
                        if mt.k == 1 && collections.map_has(ck.fns, mt.q) {
                            [fi2, err2] = collections.map_get(ck.fns, mt.q)
                            if err2 == nil {
                                cr.rk = ck.fnsv[fi2].retk
                                cr.r1 = ck.fnsv[fi2].ret1
                            }
                        }
                    }
                    _ => {
                    }
                }
                return cr
            }
            // `m(x, ..)` — method sugar: receiver is args[0] already
            if !is_builtin(n) && args != nil {
                sv := moved_save(env)
                t0 := expr(ck, args.v, env)
                moved_restore(env, sv)
                mt := method_target(ck, t0, n)
                if mt.k == 1 && collections.map_has(ck.fns, mt.q) {
                    [fi3, err3] = collections.map_get(ck.fns, mt.q)
                    if err3 == nil {
                        cr.rk = ck.fnsv[fi3].retk
                        cr.r1 = ck.fnsv[fi3].ret1
                    }
                }
            }
        }
        _ => {
        }
    }
    return cr
}

// ty handle or -1
fn env_get(ck: ref Ck, e: ref Env, n: str) -> int {
    i := len(e.scopes) - 1
    for i >= 0 {
        if collections.map_has(e.scopes[i].m, n) {
            [v, err] = collections.map_get(e.scopes[i].m, n)
            if err == nil {
                return v
            }
        }
        i = i - 1
    }
    gn := qname(ck.cur_mod, n)
    if gn != n && collections.map_has(ck.globals, gn) {
        [v3, err3] = collections.map_get(ck.globals, gn)
        if err3 == nil {
            return v3
        }
    }
    if collections.map_has(ck.globals, n) {
        [v2, err2] = collections.map_get(ck.globals, n)
        if err2 == nil {
            return v2
        }
    }
    return -1
}

fn diag(ck: mut Ck, kind: str, msg: str) {
    ck.diags = push(ck.diags, DBox{kind: kind, msg: msg, file: ck.cur_file, off: ck.dpos})
    ck.nerr = ck.nerr + 1
}

// ---------- ty handles ----------
fn tm(ck: mut Ck, k: int, i: int, args: own IList, r: int, name: str) -> int {
    ck.tyv = push(ck.tyv, T{k: k, i: i, args: args, r: r, name: name})
    return len(ck.tyv) - 1
}

fn tk(ck: mut Ck, k: int) -> int {
    return tm(ck, k, -1, nil, -1, "")
}

fn tn(ck: mut Ck, k: int, name: str) -> int {
    return tm(ck, k, -1, nil, -1, name)
}

fn ti(ck: mut Ck, k: int, i: int) -> int {
    return tm(ck, k, i, nil, -1, "")
}

fn t_int(ck: mut Ck) -> int {
    return tk(ck, k_int())
}

fn t_str(ck: mut Ck) -> int {
    return tk(ck, k_str())
}

fn t_bool(ck: mut Ck) -> int {
    return tk(ck, k_bool())
}

fn t_err(ck: mut Ck) -> int {
    return tk(ck, k_err())
}

fn t_byte(ck: mut Ck) -> int {
    return tk(ck, k_byte())
}

fn t_void(ck: mut Ck) -> int {
    return tk(ck, k_void())
}

fn t_unk(ck: mut Ck) -> int {
    return tk(ck, k_unk())
}

fn il_eq(ck: ref Ck, a: ref IList, b: ref IList) -> bool {
    for a != nil && b != nil {
        if !ty_eq(ck, a.v, b.v) {
            return false
        }
        a = a.next
        b = b.next
    }
    return a == nil && b == nil
}

fn ty_eq(ck: ref Ck, a: int, b: int) -> bool {
    if a == b {
        return true
    }
    ta := ck.tyv[a]
    tb := ck.tyv[b]
    if ta.k != tb.k {
        return false
    }
    if ta.name != tb.name {
        return false
    }
    if ta.i >= 0 || tb.i >= 0 {
        if ta.i < 0 || tb.i < 0 {
            return false
        }
        if !ty_eq(ck, ta.i, tb.i) {
            return false
        }
    }
    if ta.r >= 0 || tb.r >= 0 {
        if ta.r < 0 || tb.r < 0 {
            return false
        }
        if !ty_eq(ck, ta.r, tb.r) {
            return false
        }
    }
    return il_eq(ck, ta.args, tb.args)
}

fn ty_name(ck: ref Ck, t: int) -> str {
    k := ck.tyv[t].k
    if k == k_unk() {
        return "?"
    }
    if k == k_int() {
        return "int"
    }
    if k == k_float() {
        return "float"
    }
    if k == k_bool() {
        return "bool"
    }
    if k == k_str() {
        return "str"
    }
    if k == k_cstr() {
        return "cstr"
    }
    if k == k_void() {
        return "void"
    }
    if k == k_err() {
        return "err"
    }
    if k == k_byte() {
        return "byte"
    }
    if k == k_chan() {
        return "chan"
    }
    if k == k_shared() {
        return "shared"
    }
    if k == k_var() || k == k_struct() || k == k_enum() || k == k_iface() {
        return ck.tyv[t].name
    }
    if k == k_own() {
        return "own " + ty_name(ck, ck.tyv[t].i)
    }
    if k == k_ref() {
        return "ref " + ty_name(ck, ck.tyv[t].i)
    }
    if k == k_mut() {
        return "mut " + ty_name(ck, ck.tyv[t].i)
    }
    if k == k_slice() {
        return "[]" + ty_name(ck, ck.tyv[t].i)
    }
    if k == k_fn() {
        s := "fn("
        l := ck.tyv[t].args
        first := true
        for l != nil {
            if !first {
                s = s + ", "
            }
            first = false
            s = s + ty_name(ck, l.v)
            l = l.next
        }
        s = s + ")"
        r := ck.tyv[t].r
        if r >= 0 && ck.tyv[r].k != k_void() {
            s = s + " -> " + ty_name(ck, r)
        }
        return s
    }
    return "?"
}

// `want := got` — ports Checker::assignable; reports on failure
fn assignable(ck: mut Ck, want: int, got: int) {
    wk := ck.tyv[want].k
    gk := ck.tyv[got].k
    if wk == k_unk() || gk == k_unk() {
        return
    }
    ok := ty_eq(ck, want, got)
    if !ok && wk == k_own() {
        // `own T` accepts `own ?` (untyped boxes like mkbuf)
        ok = gk == k_own() && ck.tyv[got].i >= 0 && ck.tyv[ck.tyv[got].i].k == k_unk()
    }
    if !ok && wk == k_cstr() {
        ok = gk == k_str()
    }
    if !ok && wk == k_err() {
        ok = gk == k_int()
    }
    if !ok && wk == k_int() {
        ok = gk == k_err()
    }
    // byte narrows/widens through int — uint8_t truncates on store, so
    // `b[i] = byteat(s, i)` compiles without a cast
    if !ok && wk == k_byte() {
        ok = gk == k_int()
    }
    if !ok && wk == k_int() {
        ok = gk == k_byte()
    }
    if !ok && gk == k_err() {
        // nil is the null pointer for owned/borrowed refs, chans, slices
        ok = wk == k_own() || wk == k_ref() || wk == k_mut() || wk == k_chan() || wk == k_slice() || wk == k_shared()
    }
    if !ok && wk == k_ref() {
        if gk == k_own() || gk == k_mut() || gk == k_ref() {
            ok = ty_eq(ck, ck.tyv[want].i, ck.tyv[got].i)
        }
    }
    if !ok && (wk == k_ref() || wk == k_mut()) {
        // `ref T`/`mut T` accept `own ?` (untyped boxes like mkbuf)
        ok = gk == k_own() && ck.tyv[got].i >= 0 && ck.tyv[ck.tyv[got].i].k == k_unk()
    }
    if !ok && wk == k_mut() {
        if gk == k_own() || gk == k_mut() {
            ok = ty_eq(ck, ck.tyv[want].i, ck.tyv[got].i)
        }
    }
    if !ok && wk == k_slice() && gk == k_own() {
        // own []T reads as a []T borrow — the view is scope-bounded
        // like every slice; the owner's heap backing outlives it
        gi := ck.tyv[got].i
        ok = gi >= 0 && ck.tyv[gi].k == k_slice() && ty_eq(ck, ck.tyv[want].i, ck.tyv[gi].i)
    }
    if !ok && wk == k_iface() {
        // interface want: method-set satisfaction, iface coverage, a
        // constrained Var, or nil
        ok = iface_ok(ck, want, got)
    }
    if !ok {
        diag(ck, "type", "expected `" + ty_name(ck, want) + "`, found `" + ty_name(ck, got) + "`")
    }
}

fn is_word(ck: ref Ck, t: int) -> bool {
    k := ck.tyv[t].k
    return k == k_int() || k == k_bool() || k == k_chan() || k == k_own() || k == k_shared()
}

// ---------- node helpers ----------

// node tag — one compiler-checked mapping for every `kind()` use site
fn nk(n: ref parser.Node) -> int {
    i := match n {
        parser.Node.JInt(_) => 0
        parser.Node.JFloat(_) => 42
        parser.Node.JStr(_) => 1
        parser.Node.Name{n} => 2
        parser.Node.Ty{f0} => 3
        parser.Node.NamedField{name} => 4
        parser.Node.Param{name} => 5
        parser.Node.FieldDef{name} => 6
        parser.Node.Lit{obj} => 7
        parser.Node.Call{f} => 8
        parser.Node.Field{obj} => 9
        parser.Node.Let{name} => 10
        parser.Node.Ret{vals} => 11
        parser.Node.Break => 12
        parser.Node.Continue => 13
        parser.Node.Scope{body} => 14
        parser.Node.Spawn{e} => 15
        parser.Node.SpawnBlocking{e} => 16
        parser.Node.Go{e} => 17
        parser.Node.Let2{names} => 18
        parser.Node.Bind{name} => 19
        parser.Node.ExprStmt{e} => 20
        parser.Node.If{cond} => 21
        parser.Node.For{cond} => 22
        parser.Node.List{items} => 23
        parser.Node.Fn{name} => 24
        parser.Node.Import{path} => 25
        parser.Node.Struct{name} => 26
        parser.Node.Skip{text} => 27
        parser.Node.Root{items} => 28
        parser.Node.Enum{name} => 29
        parser.Node.Variant{name} => 30
        parser.Node.As{e} => 31
        parser.Node.Match{e} => 32
        parser.Node.MArm{pat} => 33
        parser.Node.Pat{path} => 34
        parser.Node.PatWild => 35
        parser.Node.PatLit{v} => 36
        parser.Node.Assign{target} => 37
        parser.Node.Index{obj} => 38
        parser.Node.Slice{obj} => 39
        parser.Node.Defer{call} => 40
        parser.Node.Unsafe{body} => 41
        parser.Node.Select{arms} => 43
        parser.Node.SArm{kind} => 44
        parser.Node.Closure{params} => 45
        parser.Node.PatBind{name} => 46
        parser.Node.Interface{name} => 47
        parser.Node.TyParam{name} => 48
        parser.Node.Method{name} => 49
        parser.Node.Package{name} => 52
        _ => -1
    }
    return i
}

// `Node.Ty` payload string ("" when not a Ty node)
fn ty_str(n: ref parser.Node) -> str {
    if n == nil {
        return ""
    }
    s := match n {
        parser.Node.Ty{f0} => f0
        _ => ""
    }
    return s
}

// callee name for Call nodes: `f()` bare or `a.b()` field path
fn path_join(obj: ref parser.Node, name: str) -> str {
    b := callee_name(obj)
    if len(b) == 0 {
        return ""
    }
    return b + "." + name
}

fn callee_name(f: ref parser.Node) -> str {
    n := match f {
        parser.Node.Name{n} => n
        parser.Node.Field{obj, name} => path_join(obj, name)
        _ => ""
    }
    return n
}

fn nl_len(l: ref parser.NList) -> int {
    n := 0
    for l != nil {
        n = n + 1
        l = l.next
    }
    return n
}

fn last_dot(s: str) -> int {
    i := find(s, ".")
    last := -1
    for i >= 0 {
        last = i
        i = find(substr(s, last + 1, len(s)), ".")
        if i >= 0 {
            i = i + last + 1
        }
    }
    return last
}

fn last_slash(s: str) -> int {
    i := find(s, "/")
    last := -1
    for i >= 0 {
        last = i
        i = find(substr(s, last + 1, len(s)), "/")
        if i >= 0 {
            i = i + last + 1
        }
    }
    return last
}

fn qname(mod: str, n: str) -> str {
    if len(mod) == 0 {
        return n
    }
    return mod + "." + n
}

// per-file import tables: `import "x" as a` maps qualifier a -> stem,
// plain imports map stem -> stem; `import "x".{n}` maps n -> stem.n
fn file_alias_idx(ck: ref Ck, file: str) -> int {
    i := 0
    for i < len(ck.file_aliases) {
        if ck.file_aliases[i].file == file {
            return i
        }
        i = i + 1
    }
    return -1
}

// does a ModEnt list already bind local name `a`
fn modent_has(l: ref ModEnt, a: str) -> int {
    for l != nil {
        if l.alias == a {
            return 1
        }
        l = l.next
    }
    return 0
}

// qualifier -> stem for the current file's aliases ("" when unaliased)
fn alias_stem(ck: ref Ck, q: str) -> str {
    fi := file_alias_idx(ck, ck.cur_file)
    if fi < 0 {
        return ""
    }
    l := ck.file_aliases[fi].aliases
    for l != nil {
        if l.alias == q {
            // M3: every matching bind marks — same-qualified imports of
            // one package share the mark like the seed's used.quals set
            b := ck.file_aliases[fi].binds
            for b != nil {
                if b.qual == q {
                    b.used = 1
                }
                b = b.next
            }
            return l.stem
        }
        l = l.next
    }
    return ""
}

// bare name -> `stem.name` when the file selectively imported it
fn selective_name(ck: ref Ck, n: str) -> str {
    fi := file_alias_idx(ck, ck.cur_file)
    if fi < 0 {
        return ""
    }
    l := ck.file_aliases[fi].names
    for l != nil {
        if l.alias == n {
            b := ck.file_aliases[fi].binds
            for b != nil {
                if b.tgt == l.stem {
                    b.used = 1
                }
                b = b.next
            }
            return l.stem
        }
        l = l.next
    }
    return ""
}

// the seed driver qualifies decls `mod.name` at load; lookups here try
// `cur_mod.head` first for bare and dotted names alike. Import aliases
// rewrite the head of dotted names; selective imports rewrite bare ones.
fn resolve_named(ck: ref Ck, s: str) -> str {
    head := s
    i := find(s, ".")
    if i >= 0 {
        head = substr(s, 0, i)
        stem := alias_stem(ck, head)
        if len(stem) > 0 {
            return stem + substr(s, i, len(s))
        }
        // a selective import binds its head too: `E.V` -> `stem.E.V`
        sel := selective_name(ck, head)
        if len(sel) > 0 {
            return sel + substr(s, i, len(s))
        }
    } else {
        sel := selective_name(ck, s)
        if len(sel) > 0 {
            return sel
        }
    }
    if len(ck.cur_mod) == 0 {
        return s
    }
    cand := ck.cur_mod + "." + head
    if collections.map_has(ck.structs, cand) || collections.map_has(ck.enums, cand) || collections.map_has(ck.fns, cand) || collections.map_has(ck.ifaces, cand) {
        return ck.cur_mod + "." + s
    }
    return s
}

// parse a `Node.Ty` string into a ty handle
fn ty_parse(ck: mut Ck, s: str) -> int {
    if len(s) == 0 {
        return t_unk(ck)
    }
    i := find(s, " ")
    if i > 0 {
        q := substr(s, 0, i)
        rest := strings.trim(substr(s, i + 1, len(s)))
        if q == "own" {
            return ti(ck, k_own(), ty_parse(ck, rest))
        }
        if q == "ref" {
            return ti(ck, k_ref(), ty_parse(ck, rest))
        }
        if q == "mut" {
            return ti(ck, k_mut(), ty_parse(ck, rest))
        }
    }
    if len(s) > 2 && substr(s, 0, 2) == "[]" {
        return ti(ck, k_slice(), ty_parse(ck, substr(s, 2, len(s))))
    }
    if len(s) > 3 && substr(s, 0, 3) == "fn(" {
        // canonical `fn(a, b) -> r` produced by p_ty; find the `)`
        // that closes the arg list at paren depth 0 (args may nest fn(...))
        inner := substr(s, 3, len(s))
        d := 0
        close := -1
        j := 0
        for j < len(inner) {
            ch := byteat(inner, j)
            if ch == 40 {
                d = d + 1
            }
            if ch == 41 {
                if d == 0 {
                    close = j
                    break
                }
                d = d - 1
            }
            j = j + 1
        }
        if close < 0 {
            diag(ck, "check", "malformed fn type `" + s + "`")
            return t_unk(ck)
        }
        argtxt := substr(inner, 0, close)
        rest := strings.trim(substr(inner, close + 1, len(inner)))
        ret := -1
        if len(rest) > 2 && substr(rest, 0, 2) == "->" {
            ret = ty_parse(ck, strings.trim(substr(rest, 2, len(rest))))
        }
        let args: own IList = nil
        // split args on depth-0 commas
        if len(argtxt) > 0 {
            d = 0
            a := 0
            j = 0
            for j <= len(argtxt) {
                if j == len(argtxt) || byteat(argtxt, j) == 44 && d == 0 {
                    args = icons(ty_parse(ck, strings.trim(substr(argtxt, a, j))), args)
                    a = j + 1
                } else {
                    if byteat(argtxt, j) == 40 {
                        d = d + 1
                    }
                    if byteat(argtxt, j) == 41 {
                        d = d - 1
                    }
                }
                j = j + 1
            }
            args = irev(args)
        }
        if ret < 0 {
            ret = t_void(ck)
        }
        return tm(ck, k_fn(), -1, args, ret, "")
    }
    if s == "int" {
        return t_int(ck)
    }
    if s == "byte" {
        return t_byte(ck)
    }
    if s == "float" {
        return tk(ck, k_float())
    }
    if s == "bool" {
        return t_bool(ck)
    }
    if s == "str" {
        return t_str(ck)
    }
    if s == "cstr" {
        return tk(ck, k_cstr())
    }
    if s == "void" {
        return t_void(ck)
    }
    if s == "err" {
        return t_err(ck)
    }
    if s == "chan" {
        return tk(ck, k_chan())
    }
    if s == "shared" {
        return tk(ck, k_shared())
    }
    if sl_has(ck.ty_scope, s) {
        return tn(ck, k_var(), s)
    }
    n := resolve_named(ck, s)
    if collections.map_has(ck.structs, n) {
        return tn(ck, k_struct(), n)
    }
    if collections.map_has(ck.enums, n) {
        return tn(ck, k_enum(), n)
    }
    if collections.map_has(ck.ifaces, n) {
        return tn(ck, k_iface(), n)
    }
    diag(ck, "check", "unknown type `" + s + "`")
    return t_unk(ck)
}

// variant ctor lookup `E.V` — returns the enum-table idx or -1
fn enum_variant(ck: ref Ck, path: str) -> int {
    ld := last_dot(path)
    if ld < 0 {
        return -1
    }
    en := resolve_named(ck, substr(path, 0, ld))
    vn := substr(path, ld + 1, len(path))
    if !collections.map_has(ck.enums, en) {
        return -1
    }
    [ei, err] = collections.map_get(ck.enums, en)
    if err != nil {
        return -1
    }
    vl := ck.enumsv[ei].vars
    for vl != nil {
        if vl.v.n == vn {
            break
        }
        vl = vl.next
    }
    if vl == nil {
        return -1
    }
    return ei
}

// ---------- registration ----------
fn reg_tynames(ck: mut Ck, its: []It) {
    // pass 0: type names first so self-refs and forward use resolve
    i := 0
    for i < len(its) {
        ck.cur_file = its[i].file
        match its[i].node {
            parser.Node.Struct{name, fields, lo, hi} => {
                sn := qname(its[i].mod, name)
                if !collections.map_has(ck.structs, sn) {
                    collections.map_set(ck.structs, sn, len(ck.structsv))
                    ck.structsv = push(ck.structsv, SEnt{n: sn, fields: nil})
                }
                rec_decl(ck, sn, lo, hi, "struct " + sn)
            }
            parser.Node.Enum{name, vars, lo, hi} => {
                en := qname(its[i].mod, name)
                if !collections.map_has(ck.enums, en) {
                    collections.map_set(ck.enums, en, len(ck.enumsv))
                    ck.enumsv = push(ck.enumsv, EEnt{n: en, vars: nil})
                }
                rec_decl(ck, en, lo, hi, "enum " + en)
            }
            parser.Node.Interface{name, lo, hi} => {
                iname := qname(its[i].mod, name)
                if !collections.map_has(ck.ifaces, iname) {
                    collections.map_set(ck.ifaces, iname, len(ck.ifacesv))
                    ck.ifacesv = push(ck.ifacesv, IEnt{n: iname, ops: nil, methods: nil})
                }
                rec_decl(ck, iname, lo, hi, "interface " + iname)
            }
            _ => {
            }
        }
        i = i + 1
    }
}

fn reg_variant(ck: mut Ck, en: str, ei: int, vars: ref parser.NList) {
    // pass 1 enum: variants -> E.V payload structs + variant table
    let out: own VList = nil
    let seen: own SList = nil
    vl := vars
    for vl != nil {
        match vl.v {
            parser.Node.Variant{name, args, lo, hi} => {
                if sl_has(seen, name) {
                    diag(ck, "check", "duplicate variant `" + name + "`")
                } else {
                    seen = scons(name, seen)
                    let fields: own FList = nil
                    fi := 0
                    al := args
                    for al != nil {
                        if nk(al.v) == 5 {
                            match al.v {
                                parser.Node.Param{name, ty} => {
                                    fields = fcons(name, ty_parse(ck, ty_str(ty)), fields)
                                }
                                _ => {
                                }
                            }
                        } else {
                            fields = fcons("f" + itoa(fi), ty_parse(ck, ty_str(al.v)), fields)
                        }
                        fi = fi + 1
                        al = al.next
                    }
                    fields = frev(fields)
                    // the `as` payload resolves as a struct `E.V`
                    sn := en + "." + name
                    collections.map_set(ck.structs, sn, len(ck.structsv))
                    ck.structsv = push(ck.structsv, SEnt{n: sn, fields: fclone(fields)})
                    out = vcons(name, fields, out)
                    // decl sig: unit `E.V`, positional `E.V(t, ..)`, named `E.V { .. }`
                    vsig := sn
                    if args != nil {
                        if nk(args.v) == 5 {
                            vsig = sn + " { .. }"
                        } else {
                            ts := ""
                            al2 := args
                            for al2 != nil {
                                if len(ts) > 0 {
                                    ts = ts + ", "
                                }
                                ts = ts + ty_str(al2.v)
                                al2 = al2.next
                            }
                            vsig = sn + "(" + ts + ")"
                        }
                    }
                    rec_decl(ck, sn, lo, hi, vsig)
                }
            }
            _ => {
            }
        }
        vl = vl.next
    }
    ck.enumsv[ei].vars = vrev(out)
}

fn reg_struct(ck: mut Ck, sn: str, si: int, fields: ref parser.NList) {
    // pass 1 struct: fields resolve; borrowed refs rejected in heap
    let out: own FList = nil
    fl := fields
    for fl != nil {
        match fl.v {
            parser.Node.FieldDef{name, ty, lo, hi} => {
                t := ty_parse(ck, ty_str(ty))
                tk2 := ck.tyv[t].k
                if tk2 == k_ref() || tk2 == k_mut() {
                    diag(ck, "own", "borrowed refs may not be stored in heap objects (v0)")
                }
                out = fcons(name, t, out)
                rec_decl(ck, sn + "." + name, lo, hi, name + ": " + ty_str(ty))
            }
            _ => {
            }
        }
        fl = fl.next
    }
    ck.structsv[si].fields = frev(out)
}

// `-> t` / `-> [t, err]` ret text for hover sigs (mirrors the seed's
// RetTy arms in fn_sig_text)
fn ret_text(ret: ref parser.Node) -> str {
    if ret == nil {
        return ""
    }
    if nk(ret) == 3 {
        return " -> " + ty_str(ret)
    }
    if nk(ret) == 23 {
        match ret {
            parser.Node.List{items} => {
                if items != nil {
                    return " -> [" + ty_str(items.v) + ", err]"
                }
            }
            _ => {
            }
        }
    }
    return ""
}

// `fn name(params) -> ret` signature text (hover display)
fn fn_sig_text(ck: mut Ck, qn: str, recv: ref parser.Node, typarams: ref parser.NList, params: ref parser.NList, ret: ref parser.Node) -> str {
    s := "fn "
    if recv != nil {
        match recv {
            parser.Node.Param{name, ty} => {
                s = s + "(" + name + " " + ty_str(ty) + ") "
            }
            _ => {
            }
        }
    }
    s = s + qn
    if typarams != nil {
        tp := ""
        l := typarams
        for l != nil {
            match l.v {
                parser.Node.TyParam{name, constraint} => {
                    if len(tp) > 0 {
                        tp = tp + ", "
                    }
                    if len(constraint) > 0 {
                        tp = tp + name + " " + constraint
                    } else {
                        tp = tp + name
                    }
                }
                _ => {
                }
            }
            l = l.next
        }
        s = s + "[" + tp + "]"
    }
    ps := ""
    l2 := params
    for l2 != nil {
        match l2.v {
            parser.Node.Param{name, ty} => {
                if len(ps) > 0 {
                    ps = ps + ", "
                }
                ps = ps + name + ": " + ty_str(ty)
            }
            _ => {
            }
        }
        l2 = l2.next
    }
    s = s + "(" + ps + ")"
    return s + ret_text(ret)
}

// shared ret resolution for fns + iface method sigs: `-> t` is One,
// `-> [t, err]` is Pair; borrowed refs may not be returned
fn ret_sig(ck: mut Ck, ret: ref parser.Node) -> own CRet {
    cr := new(CRet{rk: 0, r1: -1})
    if ret != nil {
        if nk(ret) == 3 {
            cr.rk = 1
            cr.r1 = ty_parse(ck, ty_str(ret))
        }
        if nk(ret) == 23 { // [T, err]
            match ret {
                parser.Node.List{items} => {
                    cr.rk = 2
                    if items != nil {
                        cr.r1 = ty_parse(ck, ty_str(items.v))
                    }
                }
                _ => {
                }
            }
        }
    }
    if cr.r1 >= 0 {
        rk2 := ck.tyv[cr.r1].k
        if rk2 == k_ref() || rk2 == k_mut() {
            diag(ck, "own", "borrowed refs may not be returned (v0)")
        }
    }
    return cr
}

// (T, ..) param names as an SList — the ty_scope shape
fn tp_names(l: ref TPList) -> own SList {
    if l == nil {
        return nil
    }
    c := new(SList)
    c.v = l.v.n
    c.next = tp_names(l.next)
    return c
}

// pass 1 iface: ops are fixed-vocabulary words; methods resolve to
// receiver-less sigs (interfaces aren't generic — empty ty scope)
fn reg_iface(ck: mut Ck, ii: int, ops: ref parser.NList, methods: ref parser.NList) {
    let ol: own SList = nil
    l := ops
    for l != nil {
        match l.v {
            parser.Node.Name{n} => {
                ol = scons(n, ol)
            }
            _ => {
            }
        }
        l = l.next
    }
    ck.ifacesv[ii].ops = ol
    let ml: own IMList = nil
    l = methods
    for l != nil {
        match l.v {
            parser.Node.Method{name, params, ret, lo, hi} => {
                let ps: own IList = nil
                pst := ""
                pl := params
                for pl != nil {
                    match pl.v {
                        parser.Node.Param{name, ty} => {
                            ps = icons(ty_parse(ck, ty_str(ty)), ps)
                            if len(pst) > 0 {
                                pst = pst + ", "
                            }
                            pst = pst + name + ": " + ty_str(ty)
                        }
                        _ => {
                        }
                    }
                    pl = pl.next
                }
                cr := ret_sig(ck, ret)
                m := new(IMethod{n: name, params: irev(ps), retk: cr.rk, ret1: cr.r1})
                mc := new(IMList)
                mc.v = m
                mc.next = ml
                ml = mc
                rec_decl(ck, ck.ifacesv[ii].n + "." + name, lo, hi, "fn " + ck.ifacesv[ii].n + "." + name + "(" + pst + ")" + ret_text(ret))
            }
            _ => {
            }
        }
        l = l.next
    }
    ck.ifacesv[ii].methods = ml
}

fn reg_fields(ck: mut Ck, its: []It) {
    i := 0
    for i < len(its) {
        ck.cur_mod = its[i].mod
        ck.cur_file = its[i].file
        match its[i].node {
            parser.Node.Interface{name, ops, methods} => {
                iname := qname(its[i].mod, name)
                if collections.map_has(ck.ifaces, iname) {
                    [ii, err] = collections.map_get(ck.ifaces, iname)
                    if err == nil {
                        reg_iface(ck, ii, ops, methods)
                    }
                }
            }
            parser.Node.Enum{name, vars} => {
                en := qname(its[i].mod, name)
                if collections.map_has(ck.enums, en) {
                    [ei, err] = collections.map_get(ck.enums, en)
                    if err == nil {
                        reg_variant(ck, en, ei, vars)
                    }
                }
            }
            parser.Node.Struct{name, fields} => {
                sn := qname(its[i].mod, name)
                if collections.map_has(ck.structs, sn) {
                    [si, err] = collections.map_get(ck.structs, sn)
                    if err == nil {
                        reg_struct(ck, sn, si, fields)
                    }
                }
            }
            _ => {
            }
        }
        i = i + 1
    }
}

fn reg_fn(ck: mut Ck, mod: str, ex: bool, name: str, recv: ref parser.Node, typarams: ref parser.NList, params: ref parser.NList, ret: ref parser.Node, lo: int, hi: int) {
    // pass 2 fn: params + ret resolve into a signature; generic params
    // scope ty names, a receiver prefixes the sig and keys `T.m`
    let tp: own TPList = nil
    let tnames: own SList = nil
    tl := typarams
    for tl != nil {
        match tl.v {
            parser.Node.TyParam{name, constraint} => {
                // iface constraints store qualified — every later lookup
                // (satisfies/req_op/iface_ent) hits ck.ifaces directly;
                // builtins pass through resolve_named unchanged
                te := new(TPEnt{n: name, c: resolve_named(ck, constraint)})
                tc := new(TPList)
                tc.v = te
                tc.next = tp
                tp = tc
                tnames = scons(name, tnames)
            }
            _ => {
            }
        }
        tl = tl.next
    }
    ck.ty_scope = tnames
    qn := name
    if !ex {
        qn = fn_qname(ck, mod, recv, name)
    }
    let ps: own IList = nil
    if recv != nil {
        match recv {
            parser.Node.Param{ty} => {
                rt := ty_parse(ck, ty_str(ty))
                rk0 := ck.tyv[rt].k
                ok := rk0 == k_struct() || rk0 == k_enum()
                if !ok && (rk0 == k_own() || rk0 == k_ref() || rk0 == k_mut()) {
                    i0 := ck.tyv[rt].i
                    ok = i0 >= 0 && (ck.tyv[i0].k == k_struct() || ck.tyv[i0].k == k_enum())
                }
                if !ok {
                    diag(ck, "check", "method receiver must be a declared struct/enum type (optionally behind own/ref/mut)")
                }
                ps = icons(rt, ps)
            }
            _ => {
            }
        }
    }
    pl := params
    for pl != nil {
        match pl.v {
            parser.Node.Param{name, ty} => {
                ps = icons(ty_parse(ck, ty_str(ty)), ps)
            }
            _ => {
            }
        }
        pl = pl.next
    }
    ps = irev(ps)
    cr := ret_sig(ck, ret)
    ck.ty_scope = nil
    // the seed qualifies every non-main package — its BUILTINS probe only
    // ever sees bare names for `package main` decls. Root items stay
    // unqualified here (mod == ""), so gate on the root clause.
    if !ex && len(mod) == 0 && ck.root_pkg == "main" && is_builtin(name) {
        diag(ck, "check", "`" + name + "` is a builtin and cannot be redefined")
    }
    tl2 := tp
    for tl2 != nil {
        c := tl2.v.c
        if len(c) > 0 && c != "any" && c != "ordered" && c != "eq" && c != "add" {
            if iface_ent(ck, resolve_named(ck, c)) < 0 {
                diag(ck, "check", "unknown constraint `" + c + "` for `" + tl2.v.n + "`")
            }
        }
        tl2 = tl2.next
    }
    if recv != nil {
        ck.methods = scons(qn, ck.methods)
    }
    if !collections.map_has(ck.fns, qn) {
        collections.map_set(ck.fns, qn, len(ck.fnsv))
        ck.fnsv = push(ck.fnsv, FnSig{params: ps, retk: cr.rk, ret1: cr.r1, is_extern: 0, typarams: tp})
    }
    if ex {
        [idx, err2] = collections.map_get(ck.fns, qn)
        if err2 == nil {
            ck.fnsv[idx].is_extern = 1
        }
    }
    if !ex {
        rec_decl(ck, qn, lo, hi, fn_sig_text(ck, qn, recv, typarams, params, ret))
    }
}

fn reg_global(ck: mut Ck, name: str, ty: ref parser.Node, init: ref parser.Node, lo: int, hi: int) {
    // top-level `let` = a global; its init is checked against no env
    e := env_new()
    it := expr(ck, init, e)
    t := it
    if ty != nil {
        want := ty_parse(ck, ty_str(ty))
        assignable(ck, want, it)
        t = want
    }
    // package-qualified key — two packages can share a global name
    // (crypto/{md5,sha256} both keep P2/KT); the seed qualifies the decl
    // itself in qualify_item
    gq := qname(ck.cur_mod, name)
    collections.map_set(ck.globals, gq, t)
    rec_decl(ck, gq, lo, hi, name + ": " + ty_name(ck, t))
}

fn reg_sigs(ck: mut Ck, its: []It) {
    i := 0
    for i < len(its) {
        ck.cur_mod = its[i].mod
        ck.cur_file = its[i].file
        match its[i].node {
            parser.Node.Fn{ex, name, recv, typarams, params, ret, body, lo, hi} => {
                reg_fn(ck, its[i].mod, ex, name, recv, typarams, params, ret, lo, hi)
            }
            parser.Node.Let{name, ty, init, lo, hi} => {
                reg_global(ck, name, ty, init, lo, hi)
            }
            _ => {
            }
        }
        i = i + 1
    }
    ck.cur_mod = ""
    ck.cur_file = ""
}

fn register(ck: mut Ck, its: []It) {
    reg_tynames(ck, its)
    reg_fields(ck, its)
    reg_sigs(ck, its)
}

// ---------- builtins ----------
fn is_builtin(n: str) -> bool {
    return n == "print" || n == "println" || n == "mkchan" || n == "send" || n == "recv" || n == "close" || n == "sleep" || n == "msleep" || n == "new" || n == "mkslice" || n == "push" || n == "assert" || n == "itoa" || n == "argc" || n == "argv" || n == "len" || n == "byteat" || n == "substr" || n == "find" || n == "atoi" || n == "mkbuf" || n == "bufstr" || n == "poke8" || n == "poke16" || n == "poke32" || n == "htons" || n == "htonl" || n == "cstr" || n == "sqlite_open" || n == "str" || n == "sqlite_exec" || n == "sqlite_exec_bind" || n == "set_rcvtimo" || n == "set_rcvtimo_ms" || n == "set_sndtimo" || n == "sqlite_query" || n == "sqlite_close" || n == "readfile" || n == "writefile" || n == "exit" || n == "mkshared" || n == "sget" || n == "sset" || n == "scas" || n == "sadd" || n == "now" || n == "now_ms" || n == "usleep" || n == "ftoi" || n == "itof" || n == "atof" || n == "ftoa"
}

fn is_susp_builtin(n: str) -> bool {
    return n == "recv" || n == "send" || n == "sleep" || n == "msleep"
}

// ---------- expressions ----------
fn expr(ck: mut Ck, e: ref parser.Node, env: mut Env) -> int {
    if e == nil {
        return t_unk(ck)
    }
    elo := parser.nlo(e)
    if elo >= 0 {
        ck.dpos = elo
    }
    t := match e {
        parser.Node.JInt(_) => t_int(ck)
        parser.Node.JFloat(_) => tk(ck, k_float())
        parser.Node.JStr(_) => t_str(ck)
        parser.Node.Name{n, lo, hi} => ident(ck, n, lo, hi, env)
        parser.Node.Call{f, args} => call(ck, f, args, env)
        parser.Node.Field{obj, name, hi} => field_expr(ck, obj, name, hi, env)
        parser.Node.Un{op, e} => un_expr(ck, op, e, env)
        parser.Node.Bin{op, l, r} => bin_expr(ck, op, l, r, env)
        parser.Node.Lit{obj, fields} => lit_expr(ck, obj, fields, env)
        parser.Node.As{e, ty} => as_expr(ck, e, ty, env)
        parser.Node.Match{e, arms} => match_expr(ck, e, arms, env)
        parser.Node.Closure{params, body} => closure_expr(ck, params, body, env)
        parser.Node.Index{obj, idx} => index_expr(ck, obj, idx, env)
        parser.Node.Slice{obj, lo, hi} => slice_expr(ck, obj, lo, hi, env)
        parser.Node.Ty{f0} => tylit_bad(ck)
        _ => t_unk(ck)
    }
    return t
}

fn tylit_bad(ck: mut Ck) -> int {
    diag(ck, "type", "type literal only allowed as `mkslice` element type")
    return t_unk(ck)
}

fn ident(ck: mut Ck, n: str, lo: int, hi: int, env: mut Env) -> int {
    // `nil`/`true`/`false` parse as Name in the bootstrap AST
    if n == "nil" {
        return t_err(ck)
    }
    if n == "true" || n == "false" {
        return t_bool(ck)
    }
    t := env_get(ck, env, n)
    if t >= 0 {
        if scope_of(env, n) >= 0 {
            rec_local(ck, lo, hi, n, t, env)
        } else {
            rec_use(ck, lo, hi, resolve_named(ck, n))
        }
        if is_moved(env, n) {
            diag(ck, "own", "use of moved value `" + n + "`")
        }
        return t
    }
    qn := resolve_named(ck, n)
    if collections.map_has(ck.fns, qn) {
        rec_use(ck, lo, hi, qn)
        [fi, err] = collections.map_get(ck.fns, qn)
        if err == nil {
            sig := ck.fnsv[fi]
            // named fn as a value — generics need a call site, [T,err]
            // has no shared ret struct
            if sig.typarams != nil {
                diag(ck, "check", "generic fn `" + n + "` can't be a value — call it to instantiate")
            } else if sig.retk == 2 {
                diag(ck, "check", "`" + n + "` returns `[T, err]` — pair returns can't be fn values (v0.2)")
            } else {
                ck.fnvals = scons(qn, ck.fnvals)
                r1 := sig.ret1
                if sig.retk == 0 {
                    r1 = t_void(ck)
                }
                return tm(ck, k_fn(), -1, sig.params, r1, "")
            }
        }
        return t_unk(ck)
    }
    if is_builtin(n) {
        diag(ck, "check", "`" + n + "` is a function — call it")
    } else {
        diag(ck, "check", "undefined `" + n + "`")
    }
    return t_unk(ck)
}

fn field_expr(ck: mut Ck, obj: ref parser.Node, name: str, fhi: int, env: mut Env) -> int {
    // unit enum variant `E.V` — obj flattens to a path, not a value
    base := callee_name(obj)
    if len(base) > 0 {
        path := resolve_named(ck, base)
        if collections.map_has(ck.enums, path) {
            [ei, err] = collections.map_get(ck.enums, path)
            if err == nil {
                vl := ck.enumsv[ei].vars
                for vl != nil {
                    if vl.v.n == name {
                        break
                    }
                    vl = vl.next
                }
                if vl == nil {
                    diag(ck, "check", "enum `" + path + "` has no variant `" + name + "`")
                    return t_unk(ck)
                }
                if vl.v.fields != nil {
                    diag(ck, "check", "`" + path + "." + name + "` has a payload — construct it")
                    return t_unk(ck)
                }
                return tn(ck, k_enum(), path)
            }
        }
    }
    // `pkg.fn` in value position — the chain head names an import, so
    // the whole thing is a fn reference, not member access (fn values
    // take the ident path's typarams/[T,err] guards and fnvals mark)
    hd := base
    hi := find(base, ".")
    if hi >= 0 {
        hd = substr(base, 0, hi)
    }
    if len(base) > 0 && len(alias_stem(ck, hd)) > 0 {
        return ident(ck, base + "." + name, fhi - len(name), fhi, env)
    }
    t := expr(ck, obj, env)
    sn := ""
    tk2 := ck.tyv[t].k
    if tk2 == k_struct() {
        sn = ck.tyv[t].name
    }
    if tk2 == k_own() || tk2 == k_ref() || tk2 == k_mut() {
        inner := ck.tyv[t].i
        if inner >= 0 && ck.tyv[inner].k == k_struct() {
            sn = ck.tyv[inner].name
        }
    }
    if len(sn) == 0 {
        if tk2 != k_unk() {
            diag(ck, "type", "`." + name + "` on non-struct `" + ty_name(ck, t) + "`")
        }
        return t_unk(ck)
    }
    if !collections.map_has(ck.structs, sn) {
        return t_unk(ck)
    }
    [si, err] = collections.map_get(ck.structs, sn)
    if err != nil {
        return t_unk(ck)
    }
    ft := ffind(ck.structsv[si].fields, name)
    if ft < 0 {
        diag(ck, "type", "`" + sn + "` has no field `" + name + "`")
        return t_unk(ck)
    }
    mlo := fhi - len(name)
    rec_use(ck, mlo, mlo + len(name), sn + "." + name)
    return ft
}

// every `{name: expr}` literal field — shared by struct and enum paths
fn lit_fields(ck: mut Ck, path: str, want: ref FList, fields: ref parser.NList, env: mut Env) {
    fl := fields
    for fl != nil {
        match fl.v {
            parser.Node.NamedField{name, val} => {
                wt := ffind(want, name)
                if wt < 0 {
                    diag(ck, "type", "`" + path + "` has no field `" + name + "`")
                } else {
                    gt := expr(ck, val, env)
                    assignable(ck, wt, gt)
                    move_for(ck, val, wt, env)
                }
            }
            _ => {
            }
        }
        fl = fl.next
    }
    w := want
    for w != nil {
        found := false
        fl := fields
        for fl != nil {
            match fl.v {
                parser.Node.NamedField{name, val} => {
                    if name == w.v.n {
                        found = true
                    }
                }
                _ => {
                }
            }
            fl = fl.next
        }
        if !found {
            diag(ck, "type", "missing field `" + w.v.n + "` in `" + path + "` literal")
        }
        w = w.next
    }
}

fn lit_expr(ck: mut Ck, obj: ref parser.Node, fields: ref parser.NList, env: mut Env) -> int {
    name := callee_name(obj)
    path := resolve_named(ck, name)
    rec_use(ck, parser.nlo(obj), parser.nhi(obj), path)
    // named enum payload `E.V{f: x, ..}`
    ei := enum_variant(ck, path)
    if ei >= 0 {
        ld := last_dot(path)
        vn := substr(path, ld + 1, len(path))
        en := substr(path, 0, ld)
        vl := ck.enumsv[ei].vars
        for vl != nil {
            if vl.v.n == vn {
                break
            }
            vl = vl.next
        }
        want := vl.v.fields
        if want == nil || fall_positional(want) {
            diag(ck, "check", "`" + path + "` has positional payload — call it `" + path + "(...)`")
        } else {
            given := nl_len(fields)
            if given != flen(want) {
                diag(ck, "type", "`" + path + "` takes " + itoa(flen(want)) + " payload field(s), found " + itoa(given))
            } else {
                lit_fields(ck, path, want, fields, env)
            }
        }
        return tn(ck, k_enum(), en)
    }
    if !collections.map_has(ck.structs, path) {
        diag(ck, "type", "unknown struct `" + name + "`")
        return t_unk(ck)
    }
    [si, err] = collections.map_get(ck.structs, path)
    if err != nil {
        return t_unk(ck)
    }
    lit_fields(ck, path, ck.structsv[si].fields, fields, env)
    return tn(ck, k_struct(), path)
}

fn as_expr(ck: mut Ck, inner: ref parser.Node, ty: ref parser.Node, env: mut Env) -> int {
    ot := expr(ck, inner, env)
    match ty {
        parser.Node.Ty{f0, lo, hi} => {
            if bare_ty_name(f0) {
                rec_use(ck, lo, hi, resolve_named(ck, f0))
            }
        }
        _ => {
        }
    }
    wt := ty_parse(ck, ty_str(ty))
    ok := ck.tyv[ot].k
    oname := ""
    if ok == k_enum() {
        oname = ck.tyv[ot].name
    }
    if ok == k_own() {
        inner2 := ck.tyv[ot].i
        if inner2 >= 0 && ck.tyv[inner2].k == k_enum() {
            oname = ck.tyv[inner2].name
            ok = k_enum()
        }
    }
    wk := ck.tyv[wt].k
    // conversions — `as` also casts, not just extracts; `own T` unwraps
    // to its payload kind (the seed's `base`)
    bt := ot
    if ok == k_own() && ck.tyv[ot].i >= 0 {
        bt = ck.tyv[ot].i
    }
    bok := ck.tyv[bt].k
    if bok == k_str() && wk == k_slice() && ck.tyv[wt].i >= 0 && ck.tyv[ck.tyv[wt].i].k == k_byte() {
        return wt
    }
    if bok == k_slice() && ck.tyv[bt].i >= 0 && ck.tyv[ck.tyv[bt].i].k == k_byte() && wk == k_str() {
        return wt
    }
    if bok == k_int() && wk == k_byte() || bok == k_byte() && wk == k_int() || bok == k_byte() && wk == k_byte() {
        return wt
    }
    if ok == k_enum() && wk == k_struct() {
        // `E.V` payload struct — verify V belongs to the scrutinee's enum
        ei := enum_variant(ck, ck.tyv[wt].name)
        if ei >= 0 && ck.enumsv[ei].n == oname {
            return wt
        }
        diag(ck, "type", "`" + ck.tyv[wt].name + "` is not a variant of `" + oname + "`")
        return t_unk(ck)
    }
    if ok == k_unk() || wk == k_unk() {
        return t_unk(ck)
    }
    diag(ck, "type", "`as` casts enum values to variant payloads — `" + ty_name(ck, ot) + " as " + ty_name(ck, wt) + "` invalid")
    return t_unk(ck)
}

fn index_expr(ck: mut Ck, obj: ref parser.Node, idx: ref parser.Node, env: mut Env) -> int {
    ot := expr(ck, obj, env)
    it := expr(ck, idx, env)
    assignable(ck, t_int(ck), it)
    ok := ck.tyv[ot].k
    if ok == k_slice() {
        return ck.tyv[ot].i
    }
    if ok == k_own() || ok == k_ref() || ok == k_mut() {
        inner := ck.tyv[ot].i
        if inner >= 0 && ck.tyv[inner].k == k_slice() {
            return ck.tyv[inner].i
        }
    }
    if ok != k_unk() {
        diag(ck, "type", "`[]` on `" + ty_name(ck, ot) + "` — not a slice")
    }
    return t_unk(ck)
}

fn slice_expr(ck: mut Ck, obj: ref parser.Node, lo: ref parser.Node, hi: ref parser.Node, env: mut Env) -> int {
    ot := expr(ck, obj, env)
    if lo != nil {
        assignable(ck, t_int(ck), expr(ck, lo, env))
    }
    if hi != nil {
        assignable(ck, t_int(ck), expr(ck, hi, env))
    }
    ok := ck.tyv[ot].k
    if ok == k_slice() {
        return ot
    }
    if ok == k_own() || ok == k_ref() || ok == k_mut() {
        inner := ck.tyv[ot].i
        if inner >= 0 && ck.tyv[inner].k == k_slice() {
            return inner
        }
    }
    if ok != k_unk() {
        diag(ck, "type", "`[..]` on `" + ty_name(ck, ot) + "` — not a slice")
    }
    return t_unk(ck)
}

fn un_expr(ck: mut Ck, op: str, e: ref parser.Node, env: mut Env) -> int {
    t := expr(ck, e, env)
    if op == "!" {
        assignable(ck, t_bool(ck), t)
        return t_bool(ck)
    }
    if ck.tyv[t].k == k_float() {
        return t
    }
    assignable(ck, t_int(ck), t)
    return t_int(ck)
}

fn bin_expr(ck: mut Ck, op: str, l: ref parser.Node, r: ref parser.Node, env: mut Env) -> int {
    lt := expr(ck, l, env)
    rt := expr(ck, r, env)
    lk := ck.tyv[lt].k
    rk := ck.tyv[rt].k
    if op == "&&" || op == "||" {
        assignable(ck, t_bool(ck), lt)
        assignable(ck, t_bool(ck), rt)
        return t_bool(ck)
    }
    if op == "==" || op == "!=" {
        if lk == k_fn() || rk == k_fn() {
            diag(ck, "type", "fn values aren't comparable (v0.2)")
        } else if lk == k_iface() && rk != k_err() || rk == k_iface() && lk != k_err() {
            diag(ck, "type", "iface values aren't comparable except against nil (v0.2)")
        } else {
            assignable(ck, lt, rt)
        }
        return t_bool(ck)
    }
    if op == "<" || op == "<=" || op == ">" || op == ">=" {
        if lk == k_var() {
            b := "Lt"
            if op == "<=" {
                b = "Le"
            }
            if op == ">" {
                b = "Gt"
            }
            if op == ">=" {
                b = "Ge"
            }
            req_op(ck, ck.tyv[lt].name, "ordered", b)
        } else if lk == k_float() || rk == k_float() {
            assignable(ck, tk(ck, k_float()), lt)
            assignable(ck, tk(ck, k_float()), rt)
        } else if lk == k_str() && rk == k_str() {
            // str < str is byte-lex — codegen emits rt_str_cmp
        } else {
            assignable(ck, t_int(ck), lt)
            assignable(ck, t_int(ck), rt)
        }
        return t_bool(ck)
    }
    if op == "+" {
        if lk == k_var() {
            req_op(ck, ck.tyv[lt].name, "add", "Add")
            return tn(ck, k_var(), ck.tyv[lt].name)
        }
        if lk == k_str() && rk == k_str() {
            return t_str(ck)
        }
        if lk == k_float() || rk == k_float() {
            assignable(ck, tk(ck, k_float()), lt)
            assignable(ck, tk(ck, k_float()), rt)
            return tk(ck, k_float())
        }
        if lk == k_byte() && rk == k_byte() {
            // byte op byte stays byte — chained ops keep the mod-256
            // wrap the type promises
            return t_byte(ck)
        }
        assignable(ck, t_int(ck), lt)
        assignable(ck, t_int(ck), rt)
        return t_int(ck)
    }
    if op == "&" || op == "|" || op == "^" {
        if lk == k_byte() && rk == k_byte() {
            return t_byte(ck)
        }
        assignable(ck, t_int(ck), lt)
        assignable(ck, t_int(ck), rt)
        return t_int(ck)
    }
    // - * / % — numeric; float promotes
    if lk == k_float() || rk == k_float() {
        assignable(ck, tk(ck, k_float()), lt)
        assignable(ck, tk(ck, k_float()), rt)
        return tk(ck, k_float())
    }
    if lk == k_byte() && rk == k_byte() {
        return t_byte(ck)
    }
    assignable(ck, t_int(ck), lt)
    assignable(ck, t_int(ck), rt)
    return t_int(ck)
}

// ---------- match ----------
fn pat_lit(ck: mut Ck, v: ref parser.Node, st: int, env: mut Env, sk: int, saw: []int) {
    // literal pattern: `1`, `"x"`, true/false; saw[0]=saw_t, saw[1]=saw_f
    lt := expr(ck, v, env)
    if sk == k_bool() && ck.tyv[lt].k == k_bool() {
        match v {
            parser.Node.Name{n} => {
                if n == "true" {
                    saw[0] = 1
                }
                if n == "false" {
                    saw[1] = 1
                }
            }
            _ => {
            }
        }
        return
    }
    if sk != k_unk() && ck.tyv[lt].k != k_unk() {
        assignable(ck, st, lt)
    }
}

// alo/ahi are the arm's span — payload binds take the arm's span as
// their declaration, matching the seed's env.set(arm.span) behaviour
fn pat_variant(ck: mut Ck, path: str, binds: ref parser.NList, en: str, covered: mut SListBox, alo: int, ahi: int, env: mut Env) {
    qpath := resolve_named(ck, path)
    vei := enum_variant(ck, qpath)
    if vei < 0 {
        diag(ck, "check", "unknown variant `" + path + "`")
        return
    }
    ld := last_dot(qpath)
    vn := substr(qpath, ld + 1, len(qpath))
    ven := ck.enumsv[vei].n
    vl := ck.enumsv[vei].vars
    for vl != nil {
        if vl.v.n == vn {
            break
        }
        vl = vl.next
    }
    if len(en) == 0 || ven != en {
        se := en
        if len(se) == 0 {
            se = "non-enum"
        }
        diag(ck, "check", "`" + qpath + "` is a variant of `" + ven + "` — scrutinee is `" + se + "`")
        return
    }
    if vl.v.fields == nil {
        if binds != nil {
            diag(ck, "check", "`" + qpath + "` is a unit variant — drop the binds")
        }
        covered.l = scons(vn, covered.l)
        return
    }
    covered.l = scons(vn, covered.l)
    if fall_positional(vl.v.fields) {
        if binds == nil || nl_len(binds) != flen(vl.v.fields) {
            diag(ck, "check", "`" + qpath + "` takes " + itoa(flen(vl.v.fields)) + " binds, got " + itoa(nl_len(binds)))
            return
        }
        wl := vl.v.fields
        bl := binds
        for bl != nil && wl != nil {
            match bl.v {
                parser.Node.Name{n} => {
                    if n != "_" {
                        env_set(env, n, wl.v.t, alo, ahi)
                    }
                }
                _ => {
                }
            }
            wl = wl.next
            bl = bl.next
        }
        return
    }
    bl := binds
    for bl != nil {
        match bl.v {
            parser.Node.Name{n} => {
                if n != "_" {
                    ft := ffind(vl.v.fields, n)
                    if ft < 0 {
                        diag(ck, "check", "`" + qpath + "` has no field `" + n + "`")
                    } else {
                        env_set(env, n, ft, alo, ahi)
                    }
                }
            }
            _ => {
            }
        }
        bl = bl.next
    }
}

// a box so covered can be threaded through pat_variant
struct SListBox { l: own SList }

fn match_expr(ck: mut Ck, scrut: ref parser.Node, arms: ref parser.NList, env: mut Env) -> int {
    st := expr(ck, scrut, env)
    sk := ck.tyv[st].k
    en := ""
    if sk == k_enum() {
        en = ck.tyv[st].name
    }
    if sk == k_own() || sk == k_ref() || sk == k_mut() {
        inner := ck.tyv[st].i
        if inner >= 0 && ck.tyv[inner].k == k_enum() {
            en = ck.tyv[inner].name
        }
    }
    ei := -1
    if len(en) > 0 && collections.map_has(ck.enums, en) {
        [x, err] = collections.map_get(ck.enums, en)
        if err == nil {
            ei = x
        }
    }
    cov := new(SListBox{l: nil})
    wild := false
    saw := mkslice(int, 2)
    result := -1
    n_expr := 0
    n_block := 0
    // arms are alternative paths — merge `moved` like if/else
    pre := moved_save(env)
    let armst: own ArmSt = nil
    a := arms
    for a != nil {
        moved_restore(env, ll_clone(pre))
        match a.v {
            parser.Node.MArm{pat, body, lo, hi} => {
                env_push(env)
                pk := nk(pat)
                if pk == 35 {
                    wild = true
                }
                if pk == 46 {
                    // Pattern::Bind — matches everything, binds scrutinee
                    wild = true
                    match pat {
                        parser.Node.PatBind{name} => {
                            env_set(env, name, st, lo, hi)
                        }
                        _ => {
                        }
                    }
                    // binding an `own` scrutinee moves it into the var
                    move_own(ck, scrut, env)
                }
                if pk == 36 {
                    match pat {
                        parser.Node.PatLit{v} => {
                            pat_lit(ck, v, st, env, sk, saw)
                        }
                        _ => {
                        }
                    }
                }
                if pk == 34 {
                    match pat {
                        parser.Node.Pat{path, binds} => {
                            pat_variant(ck, path, binds, en, cov, lo, hi, env)
                        }
                        _ => {
                        }
                    }
                }
                if body != nil && nk(body) == 23 {
                    n_block = n_block + 1
                    match body {
                        parser.Node.List{items} => {
                            block(ck, items, env)
                        }
                        _ => {
                        }
                    }
                } else {
                    n_expr = n_expr + 1
                    bt := expr(ck, body, env)
                    if result < 0 {
                        result = bt
                    } else {
                        assignable(ck, result, bt)
                    }
                }
                env_pop(env)
            }
            _ => {
            }
        }
        a = a.next
    }
    if n_expr > 0 && n_block > 0 {
        diag(ck, "check", "match arms must be all expressions or all blocks — not mixed")
    }
    if !wild && sk != k_unk() {
        if ei >= 0 {
            missing := ""
            vl := ck.enumsv[ei].vars
            for vl != nil {
                if !sl_has(cov.l, vl.v.n) {
                    if len(missing) > 0 {
                        missing = missing + ", "
                    }
                    missing = missing + vl.v.n
                }
                vl = vl.next
            }
            if len(missing) > 0 {
                diag(ck, "check", "non-exhaustive match on `" + en + "` — missing " + missing)
            }
        } else if sk == k_bool() {
            if saw[0] == 0 || saw[1] == 0 {
                diag(ck, "check", "non-exhaustive match on `bool` — cover `true`/`false` or add `_`")
            }
        } else {
            diag(ck, "check", "`match` on `" + ty_name(ck, st) + "` needs a `_` arm")
        }
    }
    if n_expr > 0 {
        if result < 0 {
            return t_void(ck)
        }
        return result
    }
    return t_void(ck)
}

// ---------- calls ----------
fn call_kind(ck: mut Ck, f: ref parser.Node, args: ref parser.NList, env: mut Env) -> int {
    // `e.kind()` — enum tag accessor
    match f {
        parser.Node.Field{obj, name} => {
            ot := expr(ck, obj, env)
            ok := ck.tyv[ot].k
            if ok == k_enum() {
                return t_int(ck)
            }
            if ok == k_own() {
                inner := ck.tyv[ot].i
                if inner >= 0 && ck.tyv[inner].k == k_enum() {
                    return t_int(ck)
                }
            }
            if ok != k_unk() {
                diag(ck, "type", "`.kind()` on non-enum `" + ty_name(ck, ot) + "`")
            }
            return t_unk(ck)
        }
        _ => {
        }
    }
    return t_unk(ck)
}

fn call(ck: mut Ck, f: ref parser.Node, args: ref parser.NList, env: mut Env) -> int {
    name := callee_name(f)
    if len(name) > 0 {
        // enum variant ctor `E.V(...)`
        ei := enum_variant(ck, name)
        if ei >= 0 {
            ms := member_span(f)
            rec_use(ck, ms.lo, ms.hi, resolve_named(ck, name))
            ld := last_dot(name)
            vn := substr(name, ld + 1, len(name))
            en := ck.enumsv[ei].n
            vl := ck.enumsv[ei].vars
            for vl != nil {
                if vl.v.n == vn {
                    break
                }
                vl = vl.next
            }
            want := vl.v.fields
            if want != nil && !fall_positional(want) {
                diag(ck, "check", "`" + name + "` has named payload — use `" + name + "{...}`")
            } else {
                given := nl_len(args)
                wlen := flen(want)
                if given != wlen {
                    diag(ck, "type", "`" + name + "` takes " + itoa(wlen) + " payload field(s), found " + itoa(given))
                } else {
                    wl := want
                    al := args
                    for al != nil && wl != nil {
                        gt := expr(ck, al.v, env)
                        assignable(ck, wl.v.t, gt)
                        wl = wl.next
                        al = al.next
                    }
                }
            }
            return tn(ck, k_enum(), en)
        }
        // `e.kind()` — enum tag accessor
        if len(name) > 5 && substr(name, len(name) - 5, len(name)) == ".kind" {
            if args == nil {
                return call_kind(ck, f, args, env)
            }
        }
        // local fn value shadows a same-named fn or builtin
        lt := env_get(ck, env, name)
        if lt >= 0 && ck.tyv[lt].k == k_fn() {
            ms := member_span(f)
            rec_local(ck, ms.lo, ms.hi, name, lt, env)
            return call_fnvalue(ck, ck.tyv[lt].args, ck.tyv[lt].r, args, env)
        }
        qn := resolve_named(ck, name)
        // method dispatch (D3): `x.m(..)` resolves via the receiver's ty
        // to `T.m` (a fn-typed field wins); `w.m(..)` on an iface or a
        // generic constraint vtab-dispatches; a bare `m(x,..)` that isn't
        // a fn retries as a method on args[0]'s ty
        let recv: ref parser.Node = nil
        if !collections.map_has(ck.fns, qn) {
            if nk(f) == 9 {
                match f {
                    parser.Node.Field{obj, name} => {
                        ot := expr(ck, obj, env)
                        if ck.tyv[ot].k == k_unk() {
                            return t_unk(ck)
                        }
                        ft := field_ty(ck, ot, name)
                        if ft >= 0 {
                            if ck.tyv[ft].k == k_fn() {
                                return call_fnvalue(ck, ck.tyv[ft].args, ck.tyv[ft].r, args, env)
                            }
                            bn := ty_base(ck, ot)
                            if len(bn) == 0 {
                                bn = ty_name(ck, ot)
                            }
                            diag(ck, "type", "`" + bn + "." + name + "` is a field of `" + ty_name(ck, ot) + "`, not callable")
                            return t_unk(ck)
                        }
                        mt := method_target(ck, ot, name)
                        if mt.k == 2 {
                            ms := member_span(f)
                            rec_use(ck, ms.lo, ms.hi, mt.q)
                            return call_iface(ck, mt.ps, mt.rk, mt.r1, args, env)
                        }
                        if mt.k == 1 {
                            recv = obj
                            qn = mt.q
                        }
                        if mt.k == 0 {
                            diag(ck, "type", "no method `" + name + "` on `" + ty_name(ck, ot) + "`")
                            return t_unk(ck)
                        }
                    }
                    _ => {
                    }
                }
            } else if !is_builtin(name) && args != nil {
                // `m(x, ..)` — method sugar: receiver is args[0] already.
                // Skip builtins (`new(T)`'s arg is a type name); the probe
                // re-evaluates args[0] so its move marks must not leak
                sv := moved_save(env)
                t0 := expr(ck, args.v, env)
                moved_restore(env, sv)
                mt := method_target(ck, t0, name)
                if mt.k == 1 {
                    qn = mt.q
                }
            }
        }
        if collections.map_has(ck.fns, qn) {
            add_edge(ck, qn)
        }
        // ---------- builtin table ----------
        if qn == "print" || qn == "println" {
            if nl_len(args) != 1 {
                diag(ck, "check", "`" + name + "` takes 1 argument")
            } else {
                t := expr(ck, args.v, env)
                tk2 := ck.tyv[t].k
                if tk2 != k_str() && tk2 != k_int() && tk2 != k_bool() && tk2 != k_err() && tk2 != k_cstr() && tk2 != k_unk() {
                    diag(ck, "type", "cannot print `" + ty_name(ck, t) + "`")
                }
            }
            return t_void(ck)
        }
        if qn == "mkchan" {
            if nl_len(args) > 1 {
                diag(ck, "check", "`mkchan` takes at most one capacity arg")
            }
            if args != nil {
                assignable(ck, t_int(ck), expr(ck, args.v, env))
            }
            return tk(ck, k_chan())
        }
        if qn == "send" {
            if nl_len(args) != 2 {
                diag(ck, "check", "`send` takes (chan, value)")
            } else {
                assignable(ck, tk(ck, k_chan()), expr(ck, args.v, env))
                vt := expr(ck, args.next.v, env)
                if !is_word(ck, vt) {
                    diag(ck, "own", "channels carry word-sized owned values (v0), not `" + ty_name(ck, vt) + "`")
                }
            }
            return t_void(ck)
        }
        if qn == "recv" {
            return t_int(ck)
        }
        if qn == "close" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return t_void(ck)
        }
        if qn == "sleep" || qn == "msleep" {
            if args != nil {
                assignable(ck, t_int(ck), expr(ck, args.v, env))
            }
            return t_void(ck)
        }
        if qn == "new" {
            if args != nil {
                a := args.v
                // `new(T)` — the seed's arg is a flattened Ident, so a
                // qualified `pkg.T` arrives here as Node.Field; flatten
                // Name and Field chains to the dotted path alike
                an := callee_name(a)
                if len(an) > 0 {
                    sn := resolve_named(ck, an)
                    // `E.V` registers a struct for `as` payloads — but in
                    // `new(...)` a dotted arg naming a variant is a value
                    // expression, not a type name (the seed takes expr here)
                    if collections.map_has(ck.structs, sn) && enum_variant(ck, sn) < 0 {
                        rec_use(ck, parser.nlo(a), parser.nhi(a), sn)
                        return ti(ck, k_own(), tn(ck, k_struct(), sn))
                    }
                }
                t := expr(ck, a, env)
                return ti(ck, k_own(), t)
            }
            diag(ck, "type", "`new` needs a struct name or value")
            return t_unk(ck)
        }
        if qn == "itoa" {
            if args != nil {
                assignable(ck, t_int(ck), expr(ck, args.v, env))
            }
            return t_str(ck)
        }
        if qn == "assert" {
            if args != nil {
                assignable(ck, t_bool(ck), expr(ck, args.v, env))
            }
            return t_void(ck)
        }
        if qn == "argc" {
            return t_int(ck)
        }
        if qn == "argv" {
            return t_str(ck)
        }
        if qn == "len" {
            if args != nil {
                t := expr(ck, args.v, env)
                ok := ck.tyv[t].k
                good := ok == k_str() || ok == k_slice() || ok == k_unk()
                if !good && (ok == k_own() || ok == k_ref() || ok == k_mut()) {
                    inner := ck.tyv[t].i
                    good = inner >= 0 && ck.tyv[inner].k == k_slice()
                }
                if !good {
                    diag(ck, "type", "`len` takes str or slice — got `" + ty_name(ck, t) + "`")
                }
            }
            return t_int(ck)
        }
        if qn == "mkslice" {
            et := t_unk(ck)
            if args != nil {
                a := args.v
                // Name or Field (`pkg.T`) — the seed's flattened Ident
                // covers both; ty_parse resolves the qualified path
                if nk(a) == 2 || nk(a) == 9 {
                    an := callee_name(a)
                    if len(an) == 0 {
                        diag(ck, "check", "`mkslice` takes a type name — mkslice(int, 8)")
                    } else {
                        rec_use(ck, parser.nlo(a), parser.nhi(a), resolve_named(ck, an))
                        et = ty_parse(ck, an)
                    }
                } else if nk(a) == 3 {
                    match a {
                        parser.Node.Ty{f0, lo, hi} => {
                            if bare_ty_name(f0) {
                                rec_use(ck, lo, hi, resolve_named(ck, f0))
                            }
                        }
                        _ => {
                        }
                    }
                    et = ty_parse(ck, ty_str(a))
                } else {
                    diag(ck, "check", "`mkslice` takes a type name — mkslice(int, 8)")
                }
            } else {
                diag(ck, "check", "`mkslice` takes (T, n)")
            }
            if args != nil && args.next != nil {
                assignable(ck, t_int(ck), expr(ck, args.next.v, env))
            } else {
                diag(ck, "check", "`mkslice` takes (T, n)")
            }
            return ti(ck, k_slice(), et)
        }
        if qn == "push" {
            if args == nil {
                return t_unk(ck)
            }
            st := expr(ck, args.v, env)
            if ck.tyv[st].k == k_slice() {
                if args.next != nil {
                    vt := expr(ck, args.next.v, env)
                    assignable(ck, ck.tyv[st].i, vt)
                } else {
                    diag(ck, "check", "`push` takes (slice, value)")
                }
                return st
            }
            if ck.tyv[st].k == k_unk() {
                return st
            }
            diag(ck, "type", "`push` on `" + ty_name(ck, st) + "` — not a slice")
            return t_unk(ck)
        }
        if qn == "byteat" || qn == "find" || qn == "atoi" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return t_int(ck)
        }
        if qn == "ftoi" {
            if args != nil {
                assignable(ck, tk(ck, k_float()), expr(ck, args.v, env))
            }
            return t_int(ck)
        }
        if qn == "itof" {
            if args != nil {
                assignable(ck, t_int(ck), expr(ck, args.v, env))
            }
            return tk(ck, k_float())
        }
        if qn == "atof" {
            if args != nil {
                assignable(ck, t_str(ck), expr(ck, args.v, env))
            }
            return tk(ck, k_float())
        }
        if qn == "ftoa" {
            if args != nil {
                assignable(ck, tk(ck, k_float()), expr(ck, args.v, env))
            }
            return t_str(ck)
        }
        if qn == "substr" || qn == "bufstr" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return t_str(ck)
        }
        if qn == "mkbuf" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return ti(ck, k_own(), t_unk(ck))
        }
        if qn == "poke8" || qn == "poke16" || qn == "poke32" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return t_void(ck)
        }
        if qn == "htons" || qn == "htonl" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return t_int(ck)
        }
        if qn == "cstr" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return tk(ck, k_cstr())
        }
        if qn == "sqlite_open" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return ti(ck, k_own(), t_unk(ck))
        }
        if qn == "str" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return t_str(ck)
        }
        if qn == "sqlite_exec" || qn == "sqlite_exec_bind" || qn == "set_rcvtimo" || qn == "set_rcvtimo_ms" || qn == "set_sndtimo" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return t_int(ck)
        }
        if qn == "sqlite_query" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return t_str(ck)
        }
        if qn == "sqlite_close" || qn == "exit" || qn == "sset" || qn == "writefile" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            if qn == "writefile" {
                return t_int(ck)
            }
            return t_void(ck)
        }
        if qn == "readfile" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return t_str(ck)
        }
        if qn == "sget" || qn == "scas" || qn == "sadd" || qn == "now" || qn == "now_ms" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return t_int(ck)
        }
        if qn == "usleep" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return t_void(ck)
        }
        if qn == "mkshared" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return tk(ck, k_shared())
        }
        // ---------- declared fns ----------
        if !collections.map_has(ck.fns, qn) {
            diag(ck, "check", "undefined `" + name + "`")
            return t_unk(ck)
        }
        [fi, err] = collections.map_get(ck.fns, qn)
        if err != nil {
            return t_unk(ck)
        }
        ms := member_span(f)
        rec_use(ck, ms.lo, ms.hi, qn)
        sig := ck.fnsv[fi]
        if sig.is_extern == 1 {
            al := args
            for al != nil {
                t := expr(ck, al.v, env)
                tk2 := ck.tyv[t].k
                if tk2 != k_int() && tk2 != k_float() && tk2 != k_byte() && tk2 != k_err() && tk2 != k_bool() && tk2 != k_cstr() && tk2 != k_str() && tk2 != k_slice() && tk2 != k_own() && tk2 != k_ref() && tk2 != k_mut() && tk2 != k_chan() && tk2 != k_shared() && tk2 != k_fn() && tk2 != k_unk() {
                    diag(ck, "ffi", "`" + ty_name(ck, t) + "` cannot cross the FFI boundary")
                }
                al = al.next
            }
        }
        have := nl_len(args)
        if recv != nil {
            have = have + 1
        }
        if have != ilen(sig.params) {
            diag(ck, "check", "`" + qn + "` takes " + itoa(ilen(sig.params)) + " args, got " + itoa(have))
        }
        // generic: bind ty params from argument tys, check constraints
        bind := collections.map_new()
        if sig.typarams != nil {
            wl0 := sig.params
            if recv != nil && wl0 != nil {
                bind_vars(ck, wl0.v, expr(ck, recv, env), bind)
                wl0 = wl0.next
            }
            al0 := args
            for al0 != nil && wl0 != nil {
                bind_vars(ck, wl0.v, expr(ck, al0.v, env), bind)
                wl0 = wl0.next
                al0 = al0.next
            }
            tl := sig.typarams
            for tl != nil {
                tv := tl.v.n
                if collections.map_has(bind, tv) {
                    [bt, err3] = collections.map_get(bind, tv)
                    if err3 == nil && !satisfies(ck, bt, tl.v.c) {
                        diag(ck, "type", "`" + ty_name(ck, bt) + "` does not satisfy constraint `" + tl.v.c + "`")
                    }
                } else {
                    diag(ck, "type", "cannot infer type parameter `" + tv + "`")
                }
                tl = tl.next
            }
        }
        wl := sig.params
        al := args
        if recv != nil && wl != nil {
            // receiver slot: `*x`/`&x` adapt — `&` needs an lvalue
            want := subst_ty(ck, wl.v, bind)
            got := expr(ck, recv, env)
            wk2 := ck.tyv[want].k
            gk2 := ck.tyv[got].k
            if (wk2 == k_own() || wk2 == k_ref() || wk2 == k_mut()) && (gk2 == k_struct() || gk2 == k_enum()) && !is_lvalue(recv) {
                diag(ck, "type", "pointer receiver on an rvalue — bind it first")
            }
            got = recv_adapt_ty(ck, want, got)
            assignable(ck, want, got)
            move_for(ck, recv, want, env)
            wl = wl.next
        }
        for al != nil && wl != nil {
            want := subst_ty(ck, wl.v, bind)
            gt := expr(ck, al.v, env)
            assignable(ck, want, gt)
            move_for(ck, al.v, want, env)
            wl = wl.next
            al = al.next
        }
        if sig.retk == 0 {
            return t_void(ck)
        }
        r1 := sig.ret1
        if sig.typarams != nil {
            r1 = subst_ty(ck, r1, bind)
        }
        if sig.retk == 1 {
            return r1
        }
        if ck.in_let2 == 0 {
            diag(ck, "check", "`[T, err]` result must be bound with `[v, err] =` or returned")
        }
        return r1
    }
    // non-name callee — indirect call through a fn value
    ft := expr(ck, f, env)
    if ck.tyv[ft].k == k_fn() {
        return call_fnvalue(ck, ck.tyv[ft].args, ck.tyv[ft].r, args, env)
    }
    if ck.tyv[ft].k != k_unk() {
        diag(ck, "type", "call of non-function `" + ty_name(ck, ft) + "`")
    }
    return t_unk(ck)
}

fn call_fnvalue(ck: mut Ck, ps: ref IList, r: int, args: ref parser.NList, env: mut Env) -> int {
    if nl_len(args) != ilen(ps) {
        diag(ck, "check", "fn value takes " + itoa(ilen(ps)) + " args, got " + itoa(nl_len(args)))
    }
    wl := ps
    al := args
    for al != nil && wl != nil {
        gt := expr(ck, al.v, env)
        assignable(ck, wl.v, gt)
        wl = wl.next
        al = al.next
    }
    return r
}

// ret kind for the `[T, err]` binding rules (-1 = not a declared call)
fn call_retk(ck: mut Ck, e: ref parser.Node, env: mut Env) -> int {
    cr := call_ret(ck, e, env)
    return cr.rk
}

// ret1 for a Call node known to hit a pair-returning fn
fn call_ret1(ck: mut Ck, e: ref parser.Node, env: mut Env) -> int {
    cr := call_ret(ck, e, env)
    return cr.r1
}

// ---------- statements ----------
fn block(ck: mut Ck, items: ref parser.NList, env: mut Env) {
    env_push(env)
    l := items
    for l != nil {
        stmt(ck, l.v, env)
        l = l.next
    }
    env_pop(env)
}

fn block_node(ck: mut Ck, body: ref parser.Node, env: mut Env) {
    if body == nil {
        return
    }
    match body {
        parser.Node.List{items} => {
            block(ck, items, env)
        }
        _ => {
        }
    }
}

fn stmt(ck: mut Ck, s: ref parser.Node, env: mut Env) {
    if s != nil {
        slo := parser.nlo(s)
        if slo >= 0 {
            ck.dpos = slo
        }
    }
    match s {
        parser.Node.Let{name, ty, init, lo, hi} => {
            it := expr(ck, init, env)
            t := it
            if ty != nil {
                want := ty_parse(ck, ty_str(ty))
                assignable(ck, want, it)
                t = want
            }
            env_set(env, name, t, lo, hi)
        }
        parser.Node.Let2{names, call, lo, hi} => {
            ck.in_let2 = 1
            expr(ck, call, env)
            ck.in_let2 = 0
            val_ty := t_unk(ck)
            if call_retk(ck, call, env) == 2 {
                val_ty = call_ret1(ck, call, env)
            } else {
                diag(ck, "check", "`[v, err] = f()` requires a call to a `[T, err]` function")
            }
            i := find(names, ",")
            an := names
            bn := ""
            if i >= 0 {
                an = substr(names, 0, i)
                bn = substr(names, i + 1, len(names))
            }
            if an != "_" {
                env_set(env, an, val_ty, lo, hi)
            }
            if bn == "_" {
                diag(ck, "check", "cannot discard `err` — handle it or pass it up")
            } else if len(bn) > 0 {
                env_set(env, bn, t_err(ck), lo, hi)
            }
        }
        parser.Node.Assign{target, val} => {
            // a bare-ident target is a write, not a use — assignment to
            // a moved-from binding re-initializes it
            idn := ""
            tt := t_unk(ck)
            match target {
                parser.Node.Name{n} => {
                    idn = n
                    tt = env_get(ck, env, n)
                    if tt < 0 {
                        tt = expr(ck, target, env)
                    }
                }
                _ => {
                    tt = expr(ck, target, env)
                }
            }
            vt := expr(ck, val, env)
            assignable(ck, tt, vt)
            // `x = y` re-initializes (aliasing walks like `s = s.next`
            // stay legal); `s.f = y`/`s[i] = y` hand the value away
            if len(idn) == 0 {
                move_for(ck, val, tt, env)
            } else {
                clear_moved(env, idn)
            }
        }
        parser.Node.ExprStmt{e} => {
            if call_retk(ck, e, env) == 2 {
                diag(ck, "check", "call returns `[T, err]` — bind it with `[v, err] =`")
            }
            expr(ck, e, env)
        }
        parser.Node.Defer{call} => {
            expr(ck, call, env)
        }
        parser.Node.Ret{vals} => {
            if ck.in_cl == 1 {
                n0 := nl_len(vals)
                if n0 > 1 {
                    diag(ck, "check", "`[T, err]` returns aren't supported in closures")
                } else {
                    t0 := t_void(ck)
                    if n0 == 1 {
                        t0 = expr(ck, vals.v, env)
                    }
                    if ck.cl_ret < 0 {
                        ck.cl_ret = t0
                    } else {
                        assignable(ck, ck.cl_ret, t0)
                    }
                }
                return
            }
            n := nl_len(vals)
            if ck.retk == 0 {
                if n > 0 {
                    diag(ck, "check", "function returns void")
                }
            } else if ck.retk == 1 {
                if n != 1 {
                    diag(ck, "check", "expected one return value")
                } else {
                    t := expr(ck, vals.v, env)
                    assignable(ck, ck.ret1, t)
                }
            } else if n == 2 {
                t := expr(ck, vals.v, env)
                assignable(ck, ck.ret1, t)
                e2 := expr(ck, vals.next.v, env)
                assignable(ck, t_err(ck), e2)
            } else if n == 1 {
                ck.in_let2 = 1
                expr(ck, vals.v, env)
                ck.in_let2 = 0
                if call_retk(ck, vals.v, env) == 2 {
                    rt1 := call_ret1(ck, vals.v, env)
                    if rt1 >= 0 {
                        assignable(ck, ck.ret1, rt1)
                    }
                } else {
                    diag(ck, "check", "`[T, err]` function must `return v, err` or forward a `[T, err]` call")
                }
            } else {
                diag(ck, "check", "expected `return v, err`")
            }
        }
        parser.Node.If{cond, then, els} => {
            t := expr(ck, cond, env)
            assignable(ck, t_bool(ck), t)
            // a move on either branch is possible after the join — union
            // the exits; only exits that can reach the join contribute
            pre := moved_save(env)
            block_node(ck, then, env)
            thmv := moved_save(env)
            moved_restore(env, pre)
            tft := node_ft(then)
            eft := els == nil
            if els != nil {
                eft = node_ft(els)
                if nk(els) == 23 {
                    block_node(ck, els, env)
                } else {
                    stmt(ck, els, env)
                }
            }
            if els != nil && !eft && tft {
                moved_restore(env, thmv)
            } else if tft && (els == nil || eft) {
                moved_union(env, thmv)
            }
        }
        parser.Node.For{cond, body} => {
            // a move inside the body is read moved by the next iteration
            // unless re-assigned there — flag newly-moved bindings, then
            // restore the pre-loop state (check.rs: Stmt::For)
            pre := moved_save(env)
            t := expr(ck, cond, env)
            assignable(ck, t_bool(ck), t)
            ck.loop_depth = ck.loop_depth + 1
            block_node(ck, body, env)
            ck.loop_depth = ck.loop_depth - 1
            for_moved_check(ck, env, pre)
            moved_restore(env, pre)
        }
        parser.Node.Break => {
            if ck.loop_depth == 0 {
                diag(ck, "check", "break/continue outside loop")
            }
        }
        parser.Node.Continue => {
            if ck.loop_depth == 0 {
                diag(ck, "check", "break/continue outside loop")
            }
        }
        parser.Node.Scope{body} => {
            block_node(ck, body, env)
        }
        parser.Node.Spawn{e} => {
            spawn_stmt(ck, e, env)
        }
        parser.Node.SpawnBlocking{e} => {
            spawn_stmt(ck, e, env)
        }
        parser.Node.Go{e} => {
            spawn_stmt(ck, e, env)
        }
        parser.Node.Bind{name, init, lo, hi} => {
            t := expr(ck, init, env)
            env_set(env, name, t, lo, hi)
        }
        parser.Node.Unsafe{body} => {
            block_node(ck, body, env)
        }
        parser.Node.Select{arms} => {
            sel_stmt(ck, arms, env)
        }
        parser.Node.List{items} => {
            block(ck, items, env)
        }
        parser.Node.Skip{text} => {
            diag(ck, "parse", "unparsed `" + text + "`")
        }
        _ => {
            expr(ck, s, env)
        }
    }
}

fn spawn_stmt(ck: mut Ck, e: ref parser.Node, env: mut Env) {
    if e != nil && nk(e) == 8 {
        match e {
            parser.Node.Call{f, args} => {
                n := callee_name(f)
                if len(n) > 0 {
                    add_edge(ck, resolve_named(ck, n))
                }
            }
            _ => {
            }
        }
        expr(ck, e, env)
        return
    }
    diag(ck, "check", "`spawn` requires a call")
}

fn add_edge(ck: mut Ck, callee: str) {
    e := new(Edge)
    e.a = ck.cur_fn
    e.b = callee
    e.next = ck.edges
    ck.edges = e
}

// ---------- suspend analysis ----------

// args-walk shared by both susp scans
fn args_susp(ck: ref Ck, args: ref parser.NList) -> bool {
    al := args
    for al != nil {
        if expr_susp(ck, al.v) {
            return true
        }
        al = al.next
    }
    return false
}

fn lit_susp(ck: ref Ck, fields: ref parser.NList) -> bool {
    fl := fields
    for fl != nil {
        match fl.v {
            parser.Node.NamedField{val} => {
                if expr_susp(ck, val) {
                    return true
                }
            }
            _ => {
            }
        }
        fl = fl.next
    }
    return false
}

fn match_susp(ck: ref Ck, scrut: ref parser.Node, arms: ref parser.NList) -> bool {
    if expr_susp(ck, scrut) {
        return true
    }
    a := arms
    for a != nil {
        match a.v {
            parser.Node.MArm{pat, body} => {
                if pat != nil && nk(pat) == 36 {
                    match pat {
                        parser.Node.PatLit{v} => {
                            if expr_susp(ck, v) {
                                return true
                            }
                        }
                        _ => {
                        }
                    }
                }
                if body != nil {
                    if nk(body) == 23 {
                        match body {
                            parser.Node.List{items} => {
                                if block_susp(ck, items) {
                                    return true
                                }
                            }
                            _ => {
                            }
                        }
                    } else if expr_susp(ck, body) {
                        return true
                    }
                }
            }
            _ => {
            }
        }
        a = a.next
    }
    return false
}

// structural seeds — scope sites and susp builtins in bodies
fn expr_susp(ck: ref Ck, e: ref parser.Node) -> bool {
    if e == nil {
        return false
    }
    s := match e {
        parser.Node.Call{f, args} => call_seeds(ck, f, args)
        parser.Node.Bin{l, r} => expr_susp(ck, l) || expr_susp(ck, r)
        parser.Node.Un{e} => expr_susp(ck, e)
        parser.Node.Field{obj} => expr_susp(ck, obj)
        parser.Node.As{e} => expr_susp(ck, e)
        parser.Node.Lit{fields} => lit_susp(ck, fields)
        parser.Node.Match{e, arms} => match_susp(ck, e, arms)
        parser.Node.Index{obj, idx} => expr_susp(ck, obj) || expr_susp(ck, idx)
        parser.Node.Slice{obj, lo, hi} => expr_susp(ck, obj) || expr_susp(ck, lo) || expr_susp(ck, hi)
        _ => false
    }
    return s
}

fn call_seeds(ck: ref Ck, f: ref parser.Node, args: ref parser.NList) -> bool {
    n := callee_name(f)
    if is_susp_builtin(resolve_named(ck, n)) {
        return true
    }
    // the callee itself can't suspend: fn values may not be susp (B4),
    // iface impls are methods (D3), and a `T.m` edge propagates real
    // susp via `calls`. The callee's *object* still can — `mksusp().m()`.
    if expr_susp(ck, f) {
        return true
    }
    return args_susp(ck, args)
}

fn block_susp(ck: ref Ck, items: ref parser.NList) -> bool {
    l := items
    for l != nil {
        if stmt_susp(ck, l.v) {
            return true
        }
        l = l.next
    }
    return false
}

fn block_susp_node(ck: ref Ck, body: ref parser.Node) -> bool {
    if body == nil {
        return false
    }
    b := match body {
        parser.Node.List{items} => block_susp(ck, items)
        _ => false
    }
    return b
}

fn if_susp(ck: ref Ck, cond: ref parser.Node, then: ref parser.Node, els: ref parser.Node) -> bool {
    if expr_susp(ck, cond) {
        return true
    }
    if block_susp_node(ck, then) {
        return true
    }
    if els != nil {
        if nk(els) == 23 {
            return block_susp_node(ck, els)
        }
        return stmt_susp(ck, els)
    }
    return false
}

fn ret_susp(ck: ref Ck, vals: ref parser.NList) -> bool {
    vl := vals
    for vl != nil {
        if expr_susp(ck, vl.v) {
            return true
        }
        vl = vl.next
    }
    return false
}

// ---------- closures ----------
// port of `ExprKind::Closure` in oxl/src/check.rs (B4). Return type is
// inferred from `return` stmts via ck.cl_ret; susp checks are deferred to
// check_closures because the susp set only exists post-fixpoint.
fn closure_expr(ck: mut Ck, params: ref parser.NList, body: ref parser.Node, env: mut Env) -> int {
    // deferred susp scan — collect callees + seeded before checking body
    cc := new(ClChk{callees: nil, seeded: 0, next: nil})
    cl_scan_node(ck, body, cc)
    cc.next = ck.clcks
    ck.clcks = cc
    let ps: own IList = nil
    pl := params
    for pl != nil {
        match pl.v {
            parser.Node.Param{name, ty} => {
                ps = icons(ty_parse(ck, ty_str(ty)), ps)
            }
            _ => {
            }
        }
        pl = pl.next
    }
    ps = irev(ps)
    s_in := ck.in_cl
    s_ret := ck.cl_ret
    ck.in_cl = 1
    ck.cl_ret = -1
    env_push(env)
    pl = params
    wl := ps
    for pl != nil && wl != nil {
        match pl.v {
            parser.Node.Param{name, ty, lo, hi} => {
                env_set(env, name, wl.v, lo, hi)
            }
            _ => {
            }
        }
        wl = wl.next
        pl = pl.next
    }
    block_node(ck, body, env)
    env_pop(env)
    r := ck.cl_ret
    ck.in_cl = s_in
    ck.cl_ret = s_ret
    if r < 0 {
        r = t_void(ck)
    }
    return tm(ck, k_fn(), -1, ps, r, "")
}

// BodyScan port: callee names + seeded (scope/select/spawn/go/defer or a
// susp-builtin call) for the deferred no-susp rule.
fn cl_scan_expr(ck: mut Ck, e: ref parser.Node, cc: mut ClChk) {
    if e == nil {
        return
    }
    match e {
        parser.Node.Call{f, args} => {
            bn := callee_name(f)
            if len(bn) > 0 {
                qn := resolve_named(ck, bn)
                cc.callees = scons(qn, cc.callees)
                if is_susp_builtin(qn) {
                    cc.seeded = 1
                }
            } else {
                cl_scan_expr(ck, f, cc)
            }
            al := args
            for al != nil {
                cl_scan_expr(ck, al.v, cc)
                al = al.next
            }
        }
        parser.Node.Bin{l, r} => {
            cl_scan_expr(ck, l, cc)
            cl_scan_expr(ck, r, cc)
        }
        parser.Node.Un{e} => {
            cl_scan_expr(ck, e, cc)
        }
        parser.Node.As{e} => {
            cl_scan_expr(ck, e, cc)
        }
        parser.Node.Field{obj} => {
            cl_scan_expr(ck, obj, cc)
        }
        parser.Node.Index{obj, idx} => {
            cl_scan_expr(ck, obj, cc)
            cl_scan_expr(ck, idx, cc)
        }
        parser.Node.Slice{obj, lo, hi} => {
            cl_scan_expr(ck, obj, cc)
            if lo != nil {
                cl_scan_expr(ck, lo, cc)
            }
            if hi != nil {
                cl_scan_expr(ck, hi, cc)
            }
        }
        parser.Node.Lit{fields} => {
            fl := fields
            for fl != nil {
                match fl.v {
                    parser.Node.NamedField{val} => {
                        cl_scan_expr(ck, val, cc)
                    }
                    _ => {
                    }
                }
                fl = fl.next
            }
        }
        parser.Node.Match{e, arms} => {
            cl_scan_expr(ck, e, cc)
            a := arms
            for a != nil {
                match a.v {
                    parser.Node.MArm{body} => {
                        cl_scan_node(ck, body, cc)
                    }
                    _ => {
                    }
                }
                a = a.next
            }
        }
        parser.Node.Closure{body} => {
            cl_scan_node(ck, body, cc)
        }
        _ => {
        }
    }
}

fn cl_scan_node(ck: mut Ck, body: ref parser.Node, cc: mut ClChk) {
    if body == nil {
        return
    }
    match body {
        parser.Node.List{items} => {
            l := items
            for l != nil {
                cl_scan_stmt(ck, l.v, cc)
                l = l.next
            }
        }
        _ => {
            cl_scan_expr(ck, body, cc)
        }
    }
}

fn cl_scan_stmt(ck: mut Ck, s: ref parser.Node, cc: mut ClChk) {
    match s {
        parser.Node.Let{init} => {
            cl_scan_expr(ck, init, cc)
        }
        parser.Node.Bind{init} => {
            cl_scan_expr(ck, init, cc)
        }
        parser.Node.Assign{target, val} => {
            cl_scan_expr(ck, target, cc)
            cl_scan_expr(ck, val, cc)
        }
        parser.Node.ExprStmt{e} => {
            cl_scan_expr(ck, e, cc)
        }
        parser.Node.Let2{call} => {
            cl_scan_expr(ck, call, cc)
        }
        parser.Node.Ret{vals} => {
            vl := vals
            for vl != nil {
                cl_scan_expr(ck, vl.v, cc)
                vl = vl.next
            }
        }
        parser.Node.If{cond, then, els} => {
            cl_scan_expr(ck, cond, cc)
            cl_scan_node(ck, then, cc)
            cl_scan_node(ck, els, cc)
        }
        parser.Node.For{cond, body} => {
            cl_scan_expr(ck, cond, cc)
            cl_scan_node(ck, body, cc)
        }
        parser.Node.Scope{body} => {
            cc.seeded = 1
            cl_scan_node(ck, body, cc)
        }
        parser.Node.Unsafe{body} => {
            cl_scan_node(ck, body, cc)
        }
        parser.Node.Defer{call} => {
            cc.seeded = 1
            cl_scan_expr(ck, call, cc)
        }
        parser.Node.Spawn{e} => {
            cc.seeded = 1
            cl_scan_expr(ck, e, cc)
        }
        parser.Node.SpawnBlocking{e} => {
            cc.seeded = 1
            cl_scan_expr(ck, e, cc)
        }
        parser.Node.Go{e} => {
            cc.seeded = 1
            cl_scan_expr(ck, e, cc)
        }
        parser.Node.Select{arms} => {
            cc.seeded = 1
            a := arms
            for a != nil {
                match a.v {
                    parser.Node.SArm{ch, ms, body} => {
                        cl_scan_expr(ck, ch, cc)
                        cl_scan_expr(ck, ms, cc)
                        cl_scan_node(ck, body, cc)
                    }
                    _ => {
                    }
                }
                a = a.next
            }
        }
        _ => {
        }
    }
}

fn clchk_bad(ck: ref Ck, c: ref ClChk) -> bool {
    if c.seeded == 1 {
        return true
    }
    l := c.callees
    for l != nil {
        if sl_has(ck.susp, l.v) {
            return true
        }
        l = l.next
    }
    return false
}

// runs after susp_fixpoint so ck.susp is final (port of closure_checks)
fn check_closures(ck: mut Ck) {
    l := ck.clcks
    for l != nil {
        if clchk_bad(ck, l) {
            diag(ck, "check", "closures may not suspend — spawn/scope/select/recv/send/sleep inside `{ |..| }`")
        }
        l = l.next
    }
}

// ---------- select ----------
// port of `Stmt::Select` in oxl/src/check.rs
fn sel_stmt(ck: mut Ck, arms: ref parser.NList, env: mut Env) {
    if arms == nil {
        diag(ck, "check", "`select` needs at least one arm")
        return
    }
    has_else := false
    tmo := 0
    l := arms
    for l != nil {
        env_push(env)
        match l.v {
            parser.Node.SArm{kind, ch, bind, ms, body} => {
                if kind == "recv" {
                    if ch == nil {
                        diag(ck, "check", "select arm must be `recv(ch)`, `timeout(ms)`, or `else`")
                    } else {
                        assignable(ck, tk(ck, k_chan()), expr(ck, ch, env))
                        if len(bind) > 0 {
                            blo := parser.nhi(ch) + 1
                            env_set(env, bind, t_int(ck), blo, blo + len(bind))
                        }
                    }
                }
                if kind == "timeout" {
                    tmo = tmo + 1
                    if ms == nil {
                        diag(ck, "check", "select arm must be `recv(ch)`, `timeout(ms)`, or `else`")
                    } else {
                        assignable(ck, t_int(ck), expr(ck, ms, env))
                        // a negative wait can never fire —
                        // rt_select_poll reads tmo < 0 as "no timer"
                        neg := false
                        match ms {
                            parser.Node.JInt(v) => {
                                neg = v < 0
                            }
                            parser.Node.Un{op, e} => {
                                if op == "-" {
                                    match e {
                                        parser.Node.JInt(v) => {
                                            neg = v > 0
                                        }
                                        _ => {
                                        }
                                    }
                                }
                            }
                            _ => {
                            }
                        }
                        if neg {
                            diag(ck, "check", "timeout(ms): a negative duration never fires")
                        }
                    }
                }
                if kind == "send" {
                    diag(ck, "check", "select `send` arms are not in v0.2")
                }
                if kind == "else" {
                    has_else = true
                }
                if len(kind) == 0 {
                    diag(ck, "check", "select arm must be `recv(ch)`, `timeout(ms)`, or `else`")
                }
                block_node(ck, body, env)
            }
            _ => {
            }
        }
        env_pop(env)
        l = l.next
    }
    if has_else && tmo > 0 {
        diag(ck, "check", "`else` makes `timeout` unreachable — drop one")
    }
    if tmo > 1 {
        diag(ck, "check", "at most one `timeout` arm")
    }
}

fn stmt_susp(ck: ref Ck, s: ref parser.Node) -> bool {
    r := match s {
        parser.Node.Scope{body} => true
        parser.Node.Spawn{e} => expr_susp(ck, e)
        parser.Node.SpawnBlocking{e} => expr_susp(ck, e)
        parser.Node.Go{e} => expr_susp(ck, e)
        parser.Node.Defer{call} => expr_susp(ck, call)
        parser.Node.ExprStmt{e} => expr_susp(ck, e)
        parser.Node.Assign{val} => expr_susp(ck, val)
        parser.Node.Let{init} => expr_susp(ck, init)
        parser.Node.Bind{init} => expr_susp(ck, init)
        parser.Node.Let2{call} => expr_susp(ck, call)
        parser.Node.Ret{vals} => ret_susp(ck, vals)
        parser.Node.If{cond, then, els} => if_susp(ck, cond, then, els)
        parser.Node.For{cond, body} => expr_susp(ck, cond) || block_susp_node(ck, body)
        parser.Node.Unsafe{body} => block_susp_node(ck, body)
        parser.Node.Select{arms} => true
        parser.Node.List{items} => block_susp(ck, items)
        parser.Node.Match{e} => expr_susp(ck, s)
        _ => false
    }
    return r
}

// seeds: fns whose bodies structurally suspend
fn susp_seeds(ck: mut Ck, its: []It) {
    i := 0
    for i < len(its) {
        if nk(its[i].node) == 24 {
            match its[i].node {
                parser.Node.Fn{ex, name, recv, body} => {
                    if !ex && body != nil && block_susp_node(ck, body) {
                        ck.susp = scons(fn_qname(ck, its[i].mod, recv, name), ck.susp)
                    }
                }
                _ => {
                }
            }
        }
        i = i + 1
    }
}

// fixpoint: callers of susp fns suspend
fn susp_fixpoint(ck: mut Ck) {
    grew := true
    for grew {
        grew = false
        e := ck.edges
        for e != nil {
            if !sl_has(ck.susp, e.a) && sl_has(ck.susp, e.b) {
                ck.susp = scons(e.a, ck.susp)
                grew = true
            }
            e = e.next
        }
    }
}

// susp-set aware walk (check_suspend_rules' expr_has_susp)
fn args_has_susp(ck: mut Ck, args: ref parser.NList) -> bool {
    al := args
    for al != nil {
        if expr_has_susp(ck, al.v) {
            return true
        }
        al = al.next
    }
    return false
}

fn lit_has_susp(ck: mut Ck, fields: ref parser.NList) -> bool {
    fl := fields
    for fl != nil {
        match fl.v {
            parser.Node.NamedField{val} => {
                if expr_has_susp(ck, val) {
                    return true
                }
            }
            _ => {
            }
        }
        fl = fl.next
    }
    return false
}

fn match_has_susp(ck: mut Ck, scrut: ref parser.Node, arms: ref parser.NList) -> bool {
    if expr_has_susp(ck, scrut) {
        return true
    }
    a := arms
    for a != nil {
        match a.v {
            parser.Node.MArm{pat, body} => {
                if pat != nil && nk(pat) == 36 {
                    match pat {
                        parser.Node.PatLit{v} => {
                            if expr_has_susp(ck, v) {
                                return true
                            }
                        }
                        _ => {
                        }
                    }
                }
                if body != nil {
                    if nk(body) == 23 {
                        match body {
                            parser.Node.List{items} => {
                                if blk_has_susp(ck, items) {
                                    return true
                                }
                            }
                            _ => {
                            }
                        }
                    } else if expr_has_susp(ck, body) {
                        return true
                    }
                }
            }
            _ => {
            }
        }
        a = a.next
    }
    return false
}

fn call_has_susp(ck: mut Ck, f: ref parser.Node, args: ref parser.NList) -> bool {
    n := callee_name(f)
    qn := resolve_named(ck, n)
    if is_susp_builtin(qn) || len(n) > 0 && sl_has(ck.susp, qn) {
        return true
    }
    // callee can't suspend (B4/D3) — scan its object instead
    if expr_has_susp(ck, f) {
        return true
    }
    return args_has_susp(ck, args)
}

fn expr_has_susp(ck: mut Ck, e: ref parser.Node) -> bool {
    if e == nil {
        return false
    }
    s := match e {
        parser.Node.Call{f, args} => call_has_susp(ck, f, args)
        parser.Node.Bin{l, r} => expr_has_susp(ck, l) || expr_has_susp(ck, r)
        parser.Node.Un{e} => expr_has_susp(ck, e)
        parser.Node.Field{obj} => expr_has_susp(ck, obj)
        parser.Node.As{e} => expr_has_susp(ck, e)
        parser.Node.Lit{fields} => lit_has_susp(ck, fields)
        parser.Node.Match{e, arms} => match_has_susp(ck, e, arms)
        parser.Node.Index{obj, idx} => expr_has_susp(ck, obj) || expr_has_susp(ck, idx)
        parser.Node.Slice{obj, lo, hi} => expr_has_susp(ck, obj) || expr_has_susp(ck, lo) || expr_has_susp(ck, hi)
        _ => false
    }
    return s
}

fn blk_has_susp(ck: mut Ck, items: ref parser.NList) -> bool {
    l := items
    for l != nil {
        if stmt_has_susp(ck, l.v) {
            return true
        }
        l = l.next
    }
    return false
}

fn blk_susp_node(ck: mut Ck, body: ref parser.Node) -> bool {
    if body == nil {
        return false
    }
    b := match body {
        parser.Node.List{items} => blk_has_susp(ck, items)
        _ => false
    }
    return b
}

fn if_has_susp(ck: mut Ck, cond: ref parser.Node, then: ref parser.Node, els: ref parser.Node) -> bool {
    if expr_has_susp(ck, cond) {
        return true
    }
    if blk_susp_node(ck, then) {
        return true
    }
    if els != nil {
        if nk(els) == 23 {
            return blk_susp_node(ck, els)
        }
        return stmt_has_susp(ck, els)
    }
    return false
}

fn ret_has_susp(ck: mut Ck, vals: ref parser.NList) -> bool {
    vl := vals
    for vl != nil {
        if expr_has_susp(ck, vl.v) {
            return true
        }
        vl = vl.next
    }
    return false
}

fn stmt_has_susp(ck: mut Ck, s: ref parser.Node) -> bool {
    r := match s {
        parser.Node.Scope{body} => true
        parser.Node.Defer{call} => expr_has_susp(ck, call)
        parser.Node.Spawn{e} => expr_has_susp(ck, e)
        parser.Node.SpawnBlocking{e} => expr_has_susp(ck, e)
        parser.Node.Go{e} => expr_has_susp(ck, e)
        parser.Node.ExprStmt{e} => expr_has_susp(ck, e)
        parser.Node.Assign{val} => expr_has_susp(ck, val)
        parser.Node.Let{init} => expr_has_susp(ck, init)
        parser.Node.Bind{init} => expr_has_susp(ck, init)
        parser.Node.Let2{call} => expr_has_susp(ck, call)
        parser.Node.Ret{vals} => ret_has_susp(ck, vals)
        parser.Node.If{cond, then, els} => if_has_susp(ck, cond, then, els)
        parser.Node.For{cond, body} => expr_has_susp(ck, cond) || blk_susp_node(ck, body)
        parser.Node.Unsafe{body} => blk_susp_node(ck, body)
        parser.Node.Select{arms} => true
        parser.Node.List{items} => blk_has_susp(ck, items)
        parser.Node.Match{e} => expr_has_susp(ck, s)
        _ => false
    }
    return r
}

// match-position rules (port of scan_match)
fn scan_arm(ck: mut Ck, body: ref parser.Node, stmt_pos: bool) {
    if body == nil {
        return
    }
    if nk(body) == 23 {
        match body {
            parser.Node.List{items} => {
                if !stmt_pos && blk_has_susp(ck, items) {
                    diag(ck, "check", "suspending call inside a value-position match — use `match` as a statement or hoist the call")
                }
                walk_block(ck, items)
            }
            _ => {
            }
        }
        return
    }
    if expr_has_susp(ck, body) {
        top := false
        if nk(body) == 8 {
            match body {
                parser.Node.Call{f, args} => {
                    bn := callee_name(f)
                    if is_susp_builtin(resolve_named(ck, bn)) || len(bn) > 0 && sl_has(ck.susp, resolve_named(ck, bn)) {
                        top = true
                    }
                }
                _ => {
                }
            }
        }
        if !(stmt_pos && top) {
            diag(ck, "check", "suspending call inside a match arm must be the whole arm body of a statement-level match — use a block arm or hoist the call")
        }
    }
    scan_match(ck, body, stmt_pos && nk(body) == 32)
}

fn scan_match(ck: mut Ck, e: ref parser.Node, stmt_pos: bool) {
    if e == nil {
        return
    }
    if nk(e) == 32 {
        match e {
            parser.Node.Match{e, arms} => {
                scan_match(ck, e, false)
                a := arms
                for a != nil {
                    match a.v {
                        parser.Node.MArm{pat, body} => {
                            scan_arm(ck, body, stmt_pos)
                        }
                        _ => {
                        }
                    }
                    a = a.next
                }
            }
            _ => {
            }
        }
        return
    }
    match e {
        parser.Node.Call{f, args} => {
            scan_match(ck, f, false)
            al := args
            for al != nil {
                scan_match(ck, al.v, false)
                al = al.next
            }
        }
        parser.Node.Bin{l, r} => {
            scan_match(ck, l, false)
            scan_match(ck, r, false)
        }
        parser.Node.Un{e} => {
            scan_match(ck, e, false)
        }
        parser.Node.As{e} => {
            scan_match(ck, e, false)
        }
        parser.Node.Field{obj} => {
            scan_match(ck, obj, false)
        }
        parser.Node.Index{obj, idx} => {
            scan_match(ck, obj, false)
            scan_match(ck, idx, false)
        }
        parser.Node.Slice{obj, lo, hi} => {
            scan_match(ck, obj, false)
            if lo != nil {
                scan_match(ck, lo, false)
            }
            if hi != nil {
                scan_match(ck, hi, false)
            }
        }
        parser.Node.Lit{fields} => {
            fl := fields
            for fl != nil {
                match fl.v {
                    parser.Node.NamedField{val} => {
                        scan_match(ck, val, false)
                    }
                    _ => {
                    }
                }
                fl = fl.next
            }
        }
        _ => {
        }
    }
}

fn walk_block(ck: mut Ck, items: ref parser.NList) {
    l := items
    for l != nil {
        s := l.v
        match s {
            parser.Node.Defer{call} => {
                if expr_has_susp(ck, call) {
                    diag(ck, "check", "`defer` cannot capture a suspending call — it runs during unwind")
                }
                scan_match(ck, call, false)
            }
            parser.Node.ExprStmt{e} => {
                scan_match(ck, e, true)
            }
            parser.Node.Let{init} => {
                scan_match(ck, init, false)
            }
            parser.Node.Bind{init} => {
                scan_match(ck, init, false)
            }
            parser.Node.Assign{val} => {
                scan_match(ck, val, false)
            }
            parser.Node.Let2{call} => {
                scan_match(ck, call, false)
            }
            parser.Node.Spawn{e} => {
                scan_match(ck, e, false)
            }
            parser.Node.SpawnBlocking{e} => {
                scan_match(ck, e, false)
            }
            parser.Node.Go{e} => {
                scan_match(ck, e, false)
            }
            parser.Node.Ret{vals} => {
                vl := vals
                for vl != nil {
                    scan_match(ck, vl.v, false)
                    vl = vl.next
                }
            }
            parser.Node.If{cond, then, els} => {
                scan_match(ck, cond, false)
                walk_block_node(ck, then)
                walk_else(ck, els)
            }
            parser.Node.For{cond, body} => {
                scan_match(ck, cond, false)
                walk_block_node(ck, body)
            }
            parser.Node.Scope{body} => {
                walk_block_node(ck, body)
            }
            parser.Node.Unsafe{body} => {
                walk_block_node(ck, body)
            }
            parser.Node.Select{arms} => {
                sa := arms
                for sa != nil {
                    match sa.v {
                        parser.Node.SArm{ch, ms, body} => {
                            if ch != nil {
                                scan_match(ck, ch, false)
                            }
                            if ms != nil {
                                scan_match(ck, ms, false)
                            }
                            walk_block_node(ck, body)
                        }
                        _ => {
                        }
                    }
                    sa = sa.next
                }
            }
            _ => {
            }
        }
        l = l.next
    }
}

fn walk_else(ck: mut Ck, els: ref parser.Node) {
    if els == nil {
        return
    }
    if nk(els) == 23 {
        walk_block_node(ck, els)
    }
    if nk(els) == 21 {
        walk_if(ck, els)
    }
}

fn walk_if(ck: mut Ck, s: ref parser.Node) {
    // else-if — descend like a block
    match s {
        parser.Node.If{cond, then, els} => {
            scan_match(ck, cond, false)
            walk_block_node(ck, then)
            walk_else(ck, els)
        }
        _ => {
        }
    }
}

fn walk_block_node(ck: mut Ck, body: ref parser.Node) {
    if body == nil {
        return
    }
    match body {
        parser.Node.List{items} => {
            walk_block(ck, items)
        }
        _ => {
        }
    }
}

// ---------- per-fn checking ----------
fn check_fn(ck: mut Ck, mod: str, name: str, recv: ref parser.Node, params: ref parser.NList, body: ref parser.Node) {
    qn := fn_qname(ck, mod, recv, name)
    ck.cur_fn = qn
    ck.retk = 0
    ck.ret1 = -1
    ck.ty_scope = nil
    ck.cur_ty_params = nil
    if collections.map_has(ck.fns, qn) {
        [fi, err] = collections.map_get(ck.fns, qn)
        if err == nil {
            ck.retk = ck.fnsv[fi].retk
            ck.ret1 = ck.fnsv[fi].ret1
            ck.cur_ty_params = tp_clone(ck.fnsv[fi].typarams)
            ck.ty_scope = tp_names(ck.fnsv[fi].typarams)
        }
    }
    ck.loop_depth = 0
    env := env_new()
    if collections.map_has(ck.fns, qn) {
        [fi, err] = collections.map_get(ck.fns, qn)
        if err == nil {
            wl := ck.fnsv[fi].params
            if recv != nil && wl != nil {
                match recv {
                    parser.Node.Param{name, lo, hi} => {
                        env_set(env, name, wl.v, lo, hi)
                    }
                    _ => {
                    }
                }
                wl = wl.next
            }
            pl := params
            for pl != nil && wl != nil {
                match pl.v {
                    parser.Node.Param{name, ty, lo, hi} => {
                        env_set(env, name, wl.v, lo, hi)
                    }
                    _ => {
                    }
                }
                wl = wl.next
                pl = pl.next
            }
        }
    }
    if body != nil {
        match body {
            parser.Node.List{items} => {
                block(ck, items, env)
            }
            _ => {
            }
        }
    }
}

fn check_items(ck: mut Ck, its: []It) {
    i := 0
    for i < len(its) {
        if nk(its[i].node) == 24 {
            match its[i].node {
                parser.Node.Fn{ex, name, recv, params, body} => {
                    if !ex {
                        ck.cur_mod = its[i].mod
                        ck.cur_file = its[i].file
                        check_fn(ck, its[i].mod, name, recv, params, body)
                    }
                }
                _ => {
                }
            }
        }
        i = i + 1
    }
    ck.cur_mod = ""
    ck.cur_file = ""
}

// item-level Skip nodes — surfaced as parse diagnostics
fn check_skips(ck: mut Ck, its: []It) {
    i := 0
    for i < len(its) {
        match its[i].node {
            parser.Node.Skip{text} => {
                diag(ck, "parse", "unparsed `" + text + "`")
            }
            _ => {
            }
        }
        i = i + 1
    }
}

// susp rules that need the full set: defer + global inits + match pos
fn check_suspend_rules(ck: mut Ck, its: []It) {
    i := 0
    for i < len(its) {
        ck.cur_mod = its[i].mod
        ck.cur_file = its[i].file
        match its[i].node {
            parser.Node.Fn{ex, body} => {
                if !ex && body != nil {
                    walk_block_node(ck, body)
                }
            }
            parser.Node.Let{init} => {
                if expr_has_susp(ck, init) {
                    diag(ck, "check", "global initializer cannot suspend — move it into fn main")
                }
            }
            _ => {
            }
        }
        i = i + 1
    }
    ck.cur_mod = ""
    ck.cur_file = ""
}

// B4 deferred: fn values may not be suspend-capable
fn check_fnvals(ck: mut Ck) {
    l := ck.fnvals
    for l != nil {
        if sl_has(ck.susp, l.v) {
            diag(ck, "type", "suspendable fn `" + l.v + "` can't be a value (v0.2)")
        }
        l = l.next
    }
}

// ---------- driver: load + import resolution ----------
fn dir_of(path: str) -> str {
    ls := last_slash(path)
    if ls < 0 {
        return "."
    }
    if ls == 0 {
        return "/"
    }
    return substr(path, 0, ls)
}

// last path component, trailing slashes ignored — mirrors path_base
fn base_name(path: str) -> str {
    p := path
    for len(p) > 0 && strings.endswith(p, "/") {
        p = substr(p, 0, len(p) - 1)
    }
    ls := last_slash(p)
    if ls < 0 {
        return p
    }
    return substr(p, ls + 1, len(p))
}

// clause name cached per resolved dir — re-imports of an already-loaded
// (or mid-cycle) package still bind their package name
fn clause_of(ck: ref Ck, dir: str) -> str {
    l := ck.loaded_names
    for l != nil {
        if l.alias == dir {
            return l.stem
        }
        l = l.next
    }
    return ""
}

// ---------- module system (mirrors the seed mod_ctx/resolve_pkg) ----------

// language version this self-hosted toolchain implements — kept in
// lock-step with the seed OXL_VERSION (Cargo.toml major.minor)
fn tool_ver() -> str {
    return "0.3"
}

// resolve result: dir non-empty = found; missing non-empty = declared
// require with neither replace nor a cache copy; both = cannot find
struct RRes { dir: str, missing: str, tampered: str }

fn all_digits(s: str) -> bool {
    i := 0
    for i < len(s) {
        c := byteat(s, i)
        if c < 48 || c > 57 {
            return false
        }
        i = i + 1
    }
    return true
}

// `X.Y[.Z]` -> maj*1000000+min*1000+patch for ordering; -1 malformed
fn ver_tuple(v: str) -> int {
    if strings.startswith(v, "v") {
        v = substr(v, 1, len(v))
    }
    parts := strings.split(v, ".")
    nums := mkslice(int, 0)
    for parts != nil {
        if len(parts.v) == 0 || all_digits(parts.v) == false {
            return -1
        }
        nums = push(nums, atoi(parts.v))
        parts = parts.next
    }
    if len(nums) < 2 || len(nums) > 3 {
        return -1
    }
    patch := 0
    if len(nums) == 3 {
        patch = nums[2]
    }
    return nums[0] * 1000000 + nums[1] * 1000 + patch
}

// `vX.Y.Z` or a pseudo-version (`vX.Y.Z-<anything>`)
fn mod_ver_ok(v: str) -> bool {
    core := v
    h := find(v, "-")
    if h >= 0 {
        core = substr(v, 0, h)
    }
    if strings.startswith(core, "v") == false {
        return false
    }
    parts := strings.split(substr(core, 1, len(core)), ".")
    n := 0
    for parts != nil {
        if len(parts.v) == 0 || all_digits(parts.v) == false {
            return false
        }
        n = n + 1
        parts = parts.next
    }
    return n == 3
}

// ---------- V1 semver: parse, compare, /vN rule, MVS ----------
struct SVer { ok: int, maj: int, min: int, pat: int, pre: str }

fn num_field(s: str) -> int {
    // digits only, no leading zeros (mirrors seed num_field); -1 bad
    if len(s) == 0 || all_digits(s) == false {
        return -1
    }
    if len(s) > 1 && byteat(s, 0) == 48 {
        return -1
    }
    return atoi(s)
}

fn ident_ok(s: str) -> bool {
    if len(s) == 0 {
        return false
    }
    i := 0
    for i < len(s) {
        c := byteat(s, i)
        if (c < 48 || c > 57) && (c < 65 || c > 90) && (c < 97 || c > 122) && c != 45 {
            return false
        }
        i = i + 1
    }
    return true
}

fn pre_idents(s: str) -> int {
    // every dot-separated prerelease ident well-formed; numeric ones
    // carry no leading zeros — mirrors seed pre_idents
    parts := strings.split(s, ".")
    for parts != nil {
        i := parts.v
        if ident_ok(i) == false {
            return 0
        }
        if all_digits(i) && len(i) > 1 && byteat(i, 0) == 48 {
            return 0
        }
        parts = parts.next
    }
    return 1
}

// `vX.Y.Z[-pre][+build]`; leading v and full triplet required — the
// require/replace version shape (mirrors seed semver::parse)
fn sver_parse(v: str) -> SVer {
    r := SVer{ok: 0, maj: 0, min: 0, pat: 0, pre: ""}
    if strings.startswith(v, "v") == false {
        return r
    }
    s := substr(v, 1, len(v))
    build := ""
    bi := find(s, "+")
    if bi >= 0 {
        build = substr(s, bi + 1, len(s))
        s = substr(s, 0, bi)
    }
    pre := ""
    has_pre := 0
    hi := find(s, "-")
    if hi >= 0 {
        has_pre = 1
        pre = substr(s, hi + 1, len(s))
        s = substr(s, 0, hi)
    }
    parts := strings.split(s, ".")
    nums := mkslice(int, 0)
    for parts != nil {
        n := num_field(parts.v)
        if n < 0 {
            return r
        }
        nums = push(nums, n)
        parts = parts.next
    }
    if len(nums) != 3 {
        return r
    }
    if has_pre == 1 && pre_idents(pre) == 0 {
        return r
    }
    if len(build) > 0 {
        bp := strings.split(build, ".")
        for bp != nil {
            if ident_ok(bp.v) == false {
                return r
            }
            bp = bp.next
        }
    } else if bi >= 0 {
        return r // `v1.2.3+` — empty build is malformed
    }
    r.ok = 1
    r.maj = nums[0]
    r.min = nums[1]
    r.pat = nums[2]
    if has_pre == 1 {
        r.pre = pre
    }
    return r
}

// bytewise lexical order for ASCII version idents — str has no <
// operator here, so spell it out
fn str_cmp(a: str, b: str) -> int {
    n := len(a)
    if len(b) < n {
        n = len(b)
    }
    i := 0
    for i < n {
        ca := byteat(a, i)
        cb := byteat(b, i)
        if ca != cb {
            if ca < cb {
                return -1
            }
            return 1
        }
        i = i + 1
    }
    if len(a) != len(b) {
        if len(a) < len(b) {
            return -1
        }
        return 1
    }
    return 0
}

fn ident_num(s: str) -> int {
    if all_digits(s) {
        return 1
    }
    return 0
}

// prerelease precedence: no pre > any pre; per-ident numeric<alpha,
// numeric numerically, alpha lexically; prefix sorts shorter.
// returns -1/0/1 (mirrors seed cmp_pre)
fn pre_cmp(a: str, b: str) -> int {
    if len(a) == 0 && len(b) == 0 {
        return 0
    }
    if len(a) == 0 {
        return 1
    }
    if len(b) == 0 {
        return -1
    }
    pa := strings.split(a, ".")
    pb := strings.split(b, ".")
    for pa != nil && pb != nil {
        x := pa.v
        y := pb.v
        xn := ident_num(x)
        yn := ident_num(y)
        if xn == 1 && yn == 1 {
            xv := atoi(x)
            yv := atoi(y)
            if xv != yv {
                if xv < yv {
                    return -1
                }
                return 1
            }
            if len(x) != len(y) {
                if len(x) < len(y) {
                    return -1
                }
                return 1
            }
        } else if xn == 1 {
            return -1
        } else if yn == 1 {
            return 1
        } else {
            c := str_cmp(x, y)
            if c != 0 {
                return c
            }
        }
        pa = pa.next
        pb = pb.next
    }
    if pa != nil {
        return 1
    }
    if pb != nil {
        return -1
    }
    return 0
}

// -1/0/1 — mirrors seed semver::compare (build metadata ignored)
fn sver_cmp(a: SVer, b: SVer) -> int {
    if a.maj != b.maj {
        if a.maj < b.maj {
            return -1
        }
        return 1
    }
    if a.min != b.min {
        if a.min < b.min {
            return -1
        }
        return 1
    }
    if a.pat != b.pat {
        if a.pat < b.pat {
            return -1
        }
        return 1
    }
    return pre_cmp(a.pre, b.pre)
}

// trailing `/vN` suffix, N >= 2 (semantic import versioning) — 0 none
fn path_major(path: str) -> int {
    last := base_name(path)
    if len(last) < 2 || strings.startswith(last, "v") == false {
        return 0
    }
    n := num_field(substr(last, 1, len(last)))
    if n < 2 {
        return 0
    }
    return n
}

// the require rule — the version's major must match the path's /vN
// suffix; "" = ok (mirrors seed semver::require_ok)
fn require_ok_s(path: str, raw: str, maj: int) -> str {
    pm := path_major(path)
    if pm > 0 {
        if pm == maj {
            return ""
        }
        return "version \"" + raw + "\" invalid: should be v" + itoa(pm) + ", not v" + itoa(maj)
    }
    if maj <= 1 {
        return ""
    }
    return "version \"" + raw + "\" invalid: should be v0 or v1, not v" + itoa(maj)
}

// first path segment carrying a `.` reads as a remote module path —
// drives the `oxl get` hint on `cannot find package`
fn remoteish(imp: str) -> bool {
    seg := imp
    i := find(imp, "/")
    if i >= 0 {
        seg = substr(imp, 0, i)
    }
    return find(seg, ".") >= 0
}

fn sl_len(l: ref SList) -> int {
    n := 0
    for l != nil {
        n = n + 1
        l = l.next
    }
    return n
}

fn sl_at(l: ref SList, i: int) -> str {
    for l != nil {
        if i == 0 {
            return l.v
        }
        i = i - 1
        l = l.next
    }
    return ""
}

// whitespace tokenizer for oxl.mod lines (space/tab — manifests don't
// quote), returned as an ordered list
fn split_ws(s: str) -> own SList {
    let rev: own SList = nil
    cur := ""
    i := 0
    for i < len(s) {
        c := byteat(s, i)
        if c == 32 || c == 9 {
            if len(cur) > 0 {
                rev = scons(cur, rev)
                cur = ""
            }
        } else {
            cur = cur + substr(s, i, i + 1)
        }
        i = i + 1
    }
    if len(cur) > 0 {
        rev = scons(cur, rev)
    }
    let out: own SList = nil
    for rev != nil {
        out = scons(rev.v, out)
        rev = rev.next
    }
    return out
}

// lexical `.`/`..` normalization — the internal-package rule compares
// path prefixes, so `a/../b` must read as `b` (no symlink chasing; the
// resolver never emits them)
fn norm_path(p: str) -> str {
    abs := strings.startswith(p, "/")
    parts := strings.split(p, "/")
    let stack: own SList = nil
    for parts != nil {
        s := parts.v
        if s == ".." {
            if stack != nil && stack.v != ".." {
                stack = stack.next
            } else if abs == false {
                stack = scons("..", stack)
            }
        } else if len(s) > 0 && s != "." {
            stack = scons(s, stack)
        }
        parts = parts.next
    }
    out := ""
    for stack != nil {
        if len(out) == 0 {
            out = stack.v
        } else {
            out = stack.v + "/" + out
        }
        stack = stack.next
    }
    if abs {
        return "/" + out
    }
    if len(out) == 0 {
        return "."
    }
    return out
}

// canonical absolute path or the input when it doesn't resolve —
// mirrors the seed canonicalize-fallback
fn canon_or(p: str) -> str {
    c := rt_fullpath(p)
    if len(c) == 0 {
        return p
    }
    return c
}

// a canonical path rendered the way Rust's display spells
// canonicalize() — verbatim \\?\ UNC form on Windows, unchanged
// elsewhere. The canonical form resolves "." segments; ".." never
// survives canonicalize so only "." needs dropping. mod list's
// `=> dir` suffix is the only consumer.
fn verbatim_path(p: str) -> str {
    if rt_is_windows() == 0 || len(p) < 3 || byteat(p, 1) != 58 {
        return p
    }
    out := "\\\\?\\" + substr(p, 0, 2)
    i := 2
    seg := ""
    for i <= len(p) {
        if i == len(p) || byteat(p, i) == 47 || byteat(p, i) == 92 {
            if len(seg) > 0 && seg != "." {
                out = out + "\\" + seg
            }
            seg = ""
        } else {
            seg = seg + substr(p, i, i + 1)
        }
        i = i + 1
    }
    if byteat(out, len(out) - 1) == 58 {
        out = out + "\\"
    }
    return out
}

// a canonical path rendered the way the OS spells it — Rust's
// Path::display() shows native separators, so error text that echoes
// a cwd/dir needs '\\'-joins on Windows. POSIX is unchanged.
fn native_path(p: str) -> str {
    if rt_is_windows() == 0 {
        return p
    }
    out := ""
    i := 0
    for i < len(p) {
        if byteat(p, i) == 47 {
            out = out + "\\"
        } else {
            out = out + substr(p, i, i + 1)
        }
        i = i + 1
    }
    return out
}

// nearest ancestor dir holding oxl.mod — "" when none (module-off)
fn find_root(d: str) -> str {
    // canonicalize the start: a lexical walk stalls at "."/"" and never
    // reaches the cwd's real ancestors (mirrors the seed find_root)
    c := canon_or(d)
    if len(c) == 0 {
        c = canon_or(".")
    }
    if len(c) > 0 {
        d = c
    }
    for len(d) > 0 {
        if rt_isfile(d + "/oxl.mod") == 1 {
            return d
        }
        if d == "." || d == "/" {
            break
        }
        d = dir_of(d)
    }
    if rt_isfile("/oxl.mod") == 1 {
        return "/"
    }
    return ""
}

// OXLMODCACHE wins, else ~/.oxl/mod — mirrors modcache_dir
fn modcache_dir() -> str {
    v := rt_getenv("OXLMODCACHE")
    if len(v) > 0 {
        return v
    }
    h := rt_getenv("HOME")
    if len(h) == 0 {
        h = rt_getenv("USERPROFILE")
    }
    if len(h) > 0 {
        return h + "/.oxl/mod"
    }
    return ".oxl/mod"
}

// manifest diagnostic — `oxl.mod:<line>: <msg>` (the file is always AT
// the module root, so the bare name locates it)
fn merr(ck: mut Ck, lineno: int, msg: str) {
    diag(ck, "check", "oxl.mod:" + itoa(lineno) + ": " + msg)
}

// replace RHS is a local dir — absolute when `/` or `X:`-rooted,
// else anchored at the module root
fn is_abs(p: str) -> bool {
    if strings.startswith(p, "/") {
        return true
    }
    if len(p) >= 3 && substr(p, 1, 2) == ":" && substr(p, 2, 3) == "/" {
        return true
    }
    return false
}

// one require/replace entry (inline or inside a ( ) block); `rest` is
// the text after the keyword
fn manifest_entry(ck: mut Ck, kw: str, rest: str, lineno: int) -> int {
    toks := split_ws(rest)
    n := sl_len(toks)
    if kw == "require" {
        if n != 2 {
            merr(ck, lineno, "expected `path version`")
            return 0
        }
        p := sl_at(toks, 0)
        v := sl_at(toks, 1)
        sv := sver_parse(v)
        if sv.ok == 0 {
            merr(ck, lineno, "bad version \"" + v + "\"")
            return 0
        }
        ve := require_ok_s(p, v, sv.maj)
        if len(ve) > 0 {
            merr(ck, lineno, ve)
            return 0
        }
        l := ck.mod_reqs
        for l != nil {
            if l.alias == p {
                merr(ck, lineno, "duplicate require \"" + p + "\"")
                return 0
            }
            l = l.next
        }
        ck.mod_reqs = new(ModEnt{alias: p, stem: v, ver: "", next: ck.mod_reqs})
        return 1
    }
    // replace <path> [ver] => <dir>
    arrow := -1
    i := 0
    for i < n {
        if sl_at(toks, i) == "=>" {
            arrow = i
            break
        }
        i = i + 1
    }
    if arrow < 0 {
        merr(ck, lineno, "expected `=>`")
        return 0
    }
    if arrow == 0 || arrow > 2 || arrow + 1 != n - 1 {
        merr(ck, lineno, "expected `path [version] => dir`")
        return 0
    }
    lver := ""
    if arrow == 2 {
        if sver_parse(sl_at(toks, 1)).ok == 0 {
            merr(ck, lineno, "bad version \"" + sl_at(toks, 1) + "\"")
            return 0
        }
        lver = sl_at(toks, 1)
    }
    dir := sl_at(toks, arrow + 1)
    if is_abs(dir) == false {
        dir = ck.mod_root + "/" + dir
    }
    ck.mod_reps = new(ModEnt{alias: sl_at(toks, 0), stem: dir, ver: lver, next: ck.mod_reps})
    return 1
}

// parse oxl.mod into ck's module fields — mirrors parse_manifest:
// `//` comments, ( ) blocks, identical diagnostics incl. the oxl floor
fn parse_manifest(ck: mut Ck, text: str) -> int {
    lines := strings.split(text, "\n")
    lineno := 0
    block := ""
    block_line := 0
    for lines != nil {
        lineno = lineno + 1
        t := strip_comment(lines.v)
        lines = lines.next
        t = strings.trim(t)
        if len(t) == 0 {
            continue
        }
        if len(block) > 0 {
            if t == ")" {
                block = ""
            } else if manifest_entry(ck, block, t, lineno) == 0 {
                return 0
            }
            continue
        }
        toks := split_ws(t)
        kw := sl_at(toks, 0)
        n := sl_len(toks)
        if kw == "module" {
            if len(ck.mod_path) > 0 {
                merr(ck, lineno, "duplicate directive \"module\"")
                return 0
            }
            if n != 2 {
                merr(ck, lineno, "expected module path")
                return 0
            }
            ck.mod_path = sl_at(toks, 1)
        } else if kw == "oxl" {
            if len(ck.mod_floor) > 0 {
                merr(ck, lineno, "duplicate directive \"oxl\"")
                return 0
            }
            if n != 2 || ver_tuple(sl_at(toks, 1)) < 0 {
                merr(ck, lineno, "expected version")
                return 0
            }
            ck.mod_floor = sl_at(toks, 1)
        } else if kw == "require" || kw == "replace" {
            if n == 2 && sl_at(toks, 1) == "(" {
                block = kw
                block_line = lineno
            } else if manifest_entry(ck, kw, substr(t, len(kw), len(t)), lineno) == 0 {
                return 0
            }
        } else {
            merr(ck, lineno, "unknown directive \"" + kw + "\"")
            return 0
        }
    }
    if len(block) > 0 {
        merr(ck, block_line, "unterminated " + block + " block")
        return 0
    }
    if len(ck.mod_path) == 0 {
        diag(ck, "check", "oxl.mod: missing module directive")
        return 0
    }
    if len(ck.mod_floor) > 0 && ver_tuple(ck.mod_floor) > ver_tuple(tool_ver()) {
        diag(ck, "check", "oxl.mod: requires oxl " + ck.mod_floor + ", toolchain is " + tool_ver())
        return 0
    }
    return 1
}

// find + parse the nearest oxl.mod into ck's module fields — 0 on
// manifest error (diags emitted), 1 ok including module-off (no
// oxl.mod anywhere: mod_on stays 0 and only `std/` imports resolve)
// a dep manifest's require edges — silent strict scan; nil on ANY
// malformed directive (mirrors seed build_list's parse_manifest gate:
// a bad dep manifest contributes no edges)
// returns a fresh unlinked ModEnt for a require; nil for a valid
// replace; err on any malformed line — the caller dup-checks + links
fn dep_entry(kw: str, rest: str) -> [own ModEnt, err] {
    toks := split_ws(rest)
    n := sl_len(toks)
    if kw == "require" {
        if n != 2 {
            return nil, 1
        }
        p := sl_at(toks, 0)
        v := sl_at(toks, 1)
        sv := sver_parse(v)
        if sv.ok == 0 || len(require_ok_s(p, v, sv.maj)) > 0 {
            return nil, 1
        }
        return new(ModEnt{alias: p, stem: v, ver: "", next: nil}), nil
    }
    // replace <path> [ver] => <dir> — validated, edges not needed
    arrow := -1
    i := 0
    for i < n {
        if sl_at(toks, i) == "=>" {
            arrow = i
            break
        }
        i = i + 1
    }
    if arrow <= 0 || arrow > 2 || arrow + 1 != n - 1 {
        return nil, 1
    }
    if arrow == 2 && sver_parse(sl_at(toks, 1)).ok == 0 {
        return nil, 1
    }
    return nil, nil
}

fn dep_manifest_reqs(text: str) -> own ModEnt {
    // pass 1: tokenize into (kw, rest) directive lines — block entries
    // flatten to the same shape so pass 2 needs one destructure site
    // (each [v, err] site emits a fixed C `err` decl — two collide)
    let kwl: own ModEnt = nil
    have_module := 0
    have_oxl := 0
    bad := 0
    lines := strings.split(text, "\n")
    block := ""
    for lines != nil && bad == 0 {
        t := strip_comment(lines.v)
        lines = lines.next
        t = strings.trim(t)
        if len(t) == 0 {
            continue
        }
        if len(block) > 0 {
            if t == ")" {
                block = ""
            } else {
                kwl = new(ModEnt{alias: block, stem: t, ver: "", next: kwl})
            }
            continue
        }
        toks := split_ws(t)
        kw := sl_at(toks, 0)
        n := sl_len(toks)
        if kw == "module" {
            if have_module == 1 || n != 2 {
                bad = 1
            } else {
                have_module = 1
            }
        } else if kw == "oxl" {
            if have_oxl == 1 || n != 2 || ver_tuple(sl_at(toks, 1)) < 0 {
                bad = 1
            } else {
                have_oxl = 1
            }
        } else if kw == "require" || kw == "replace" {
            if n == 2 && sl_at(toks, 1) == "(" {
                block = kw
            } else {
                kwl = new(ModEnt{alias: kw, stem: substr(t, len(kw), len(t)), ver: "", next: kwl})
            }
        } else {
            bad = 1
        }
    }
    if len(block) > 0 || have_module == 0 || bad == 1 {
        return nil
    }
    // pass 2: validate + collect require edges
    let reqs: own ModEnt = nil
    for kwl != nil {
        [n, err] = dep_entry(kwl.alias, kwl.stem)
        if err != nil {
            return nil
        }
        if n != nil {
            if modent_has(reqs, n.alias) == 1 {
                return nil // duplicate require
            }
            n.next = reqs
            reqs = n
        }
        kwl = kwl.next
    }
    return reqs
}

// the dir a required module version occupies: version-specific
// replace beats a blanket one, else the `path@ver` cache slot —
// "" = not fetched (mirrors seed module_dir)
fn module_dir(ck: ref Ck, mp: str, ver: str) -> DirRes {
    blanket := ""
    rl := ck.mod_reps
    for rl != nil {
        if rl.alias == mp {
            if len(rl.ver) > 0 {
                if rl.ver == ver {
                    return DirRes{dir: rl.stem, err: ""}
                }
            } else {
                blanket = rl.stem
            }
        }
        rl = rl.next
    }
    if len(blanket) > 0 {
        return DirRes{dir: blanket, err: ""}
    }
    d := ck.modcache + "/" + escape_path(mp) + "@" + escape_path(ver)
    if rt_isdir(d) == 0 {
        return DirRes{dir: "", err: ""}
    }
    e := verify_slot(ck, d, mp, ver)
    if len(e) > 0 {
        return DirRes{dir: "", err: e}
    }
    return DirRes{dir: d, err: ""}
}

// minimal version selection: BFS the requirement graph from the main
// module's requires; each (module, version) node's manifest adds
// edges; per path keep the MAX version seen — MVS, mirrored
// from build_list. Fills ck.mod_sel.
fn mod_build_list(ck: mut Ck) {
    seen := collections.map_new()
    selidx := collections.map_new()
    selpaths := mkslice(str, 0)
    selvers := mkslice(str, 0)
    queue := mkslice(str, 0) // "path|ver" — | can't appear in either
    l := ck.mod_reqs
    for l != nil {
        queue = push(queue, l.alias + "|" + l.stem)
        l = l.next
    }
    qi := 0
    for qi < len(queue) {
        ent := queue[qi]
        qi = qi + 1
        sep := find(ent, "|")
        mp := substr(ent, 0, sep)
        mv := substr(ent, sep + 1, len(ent))
        sv := sver_parse(mv)
        if sv.ok == 0 {
            continue
        }
        // selection: keep the max version offered for this path
        [si, err] = collections.map_get(selidx, mp)
        if err != nil {
            selpaths = push(selpaths, mp)
            selvers = push(selvers, mv)
            collections.map_set(selidx, mp, len(selpaths) - 1)
        } else {
            cur := sver_parse(selvers[si])
            if cur.ok == 1 && sver_cmp(sv, cur) > 0 {
                selvers[si] = mv
            }
        }
        // dedup nodes: each (path, version) manifest read once
        if collections.map_has(seen, ent) {
            continue
        }
        collections.map_set(seen, ent, 1)
        dr := module_dir(ck, mp, mv)
        if len(dr.dir) == 0 {
            continue
        }
        mf := dr.dir + "/oxl.mod"
        if rt_isfile(mf) == 0 {
            continue
        }
        reqs := dep_manifest_reqs(readfile(mf))
        for reqs != nil {
            queue = push(queue, reqs.alias + "|" + reqs.stem)
            reqs = reqs.next
        }
    }
    // fold the selected set into the ModEnt list resolve_imp reads
    i := 0
    for i < len(selpaths) {
        ck.mod_sel = new(ModEnt{alias: selpaths[i], stem: selvers[i], ver: "", next: ck.mod_sel})
        i = i + 1
    }
}

// the version selection assigns to a required module path — the
// build list's entry when present, else the require's own floor
// (mirrors seed selected_ver)
fn selected_ver(ck: ref Ck, mp: str) -> str {
    l := ck.mod_sel
    for l != nil {
        if l.alias == mp {
            return l.stem
        }
        l = l.next
    }
    l = ck.mod_reqs
    for l != nil {
        if l.alias == mp {
            return l.stem
        }
        l = l.next
    }
    return ""
}

fn mod_ctx_load(ck: mut Ck, start: str) -> int {
    root := find_root(start)
    if len(root) == 0 {
        return 1
    }
    ck.mod_root = root
    ck.modcache = modcache_dir()
    text := readfile(root + "/oxl.mod")
    if parse_manifest(ck, text) == 0 {
        return 0
    }
    if rt_isfile(root + "/oxl.sum") == 1 {
        if parse_sums(ck, readfile(root + "/oxl.sum")) == 0 {
            return 0
        }
    }
    mod_build_list(ck)
    ck.mod_on = 1
    return 1
}

// `<base>`-anchored ancestor walk for `std/<rest>` — the exe and the
// entry dir each get one pass inside resolve_imp
fn std_at(base: str, rest: str) -> str {
    d := base
    for len(d) > 0 {
        p := d + "/std/" + rest
        if rt_isdir(p) == 1 {
            return p
        }
        if d == "." || d == "/" {
            break
        }
        d = dir_of(d)
    }
    return ""
}

// mirrors resolve_pkg under the module rules: `std/` beside the
// toolchain exe, then the main module's own path, then the longest
// require-prefix through replace or the cache
// ---------- module cache verification (V2) --------------------------
// Mirrors modcache.rs: `!`-escaped slot names, oxl.sum parsing, and the
// h1 dirhash — sha256 + base64 over sorted "<hex>  <name>\n" lines —
// verified on every load with identical diagnostics. `oxl get` itself
// stays driver-side (the compiler doesn't fetch either).
//
// ints are wrapping i64, so all u32 math masks with & 4294967295; the
// language has no shift ops — x >> n is x / 2^n and x << n is x * 2^n,
// which stays exact because every operand is masked to < 2^32 first.

// `//` opens a manifest comment at line start or after whitespace —
// glued inside a token (file://) it is part of the path
fn strip_comment(t: str) -> str {
    i := 0
    for i + 1 < len(t) {
        if byteat(t, i) == 47 && byteat(t, i + 1) == 47 {
            if i == 0 {
                return substr(t, 0, i)
            }
            b := byteat(t, i - 1)
            if b == 32 || b == 9 || b == 10 || b == 12 || b == 13 {
                return substr(t, 0, i)
            }
        }
        i = i + 1
    }
    return t
}

// the established escape scheme — every uppercase letter becomes `!`+lower so
// case-insensitive filesystems can't collide slots
fn escape_path(s: str) -> str {
    lc := "abcdefghijklmnopqrstuvwxyz"
    out := ""
    i := 0
    for i < len(s) {
        b := byteat(s, i)
        if b >= 65 && b <= 90 {
            out = out + "!" + substr(lc, b - 65, b - 64)
        } else {
            out = out + substr(s, i, i + 1)
        }
        i = i + 1
    }
    return out
}

fn p2(n: int) -> int {
    r := 1
    i := 0
    for i < n {
        r = r * 2
        i = i + 1
    }
    return r
}

fn rotr(x: int, n: int) -> int {
    p := p2(n)
    return x / p | x % p * p2(32 - n)
}

fn sha2_k(out: mut IB) {
    out.v = mkslice(int, 64)
    ks := "1116352408,1899447441,3049323471,3921009573,961987163,1508970993,2453635748,2870763221,3624381080,310598401,607225278,1426881987,1925078388,2162078206,2614888103,3248222580,3835390401,4022224774,264347078,604807628,770255983,1249150122,1555081692,1996064986,2554220882,2821834349,2952996808,3210313671,3336571891,3584528711,113926993,338241895,666307205,773529912,1294757372,1396182291,1695183700,1986661051,2177026350,2456956037,2730485921,2820302411,3259730800,3345764771,3516065817,3600352804,4094571909,275423344,430227734,506948616,659060556,883997877,958139571,1322822218,1537002063,1747873779,1955562222,2024104815,2227730452,2361852424,2428436474,2756734187,3204031479,3329325298"
    i := 0
    for i < 64 {
        j := find(ks, ",")
        tk := ks
        if j >= 0 {
            tk = substr(ks, 0, j)
            ks = substr(ks, j + 1, len(ks))
        }
        out.v[i] = atoi(tk)
        i = i + 1
    }
}

// padded-message byte at index i: s, 0x80, zeros, 8-byte BE bitlen —
// the pad is virtual, the message is never materialized
fn mbyte(s: str, l: int, total: int, i: int) -> int {
    if i < l {
        return byteat(s, i)
    }
    if i == l {
        return 128
    }
    if i >= total - 8 {
        b := l * 8
        return b / p2((total - 1 - i) * 8) % 256
    }
    return 0
}

// FIPS 180-4 over the string's bytes; returns the 32-byte digest as an
// int slice (all values < 2^32 throughout, so i64 math never wraps)
fn sha256(s: str) -> own IB {
    h := mkslice(int, 8)
    h[0] = 1779033703
    h[1] = 3144134277
    h[2] = 1013904242
    h[3] = 2773480762
    h[4] = 1359893119
    h[5] = 2600822924
    h[6] = 528734635
    h[7] = 1541459225
    kb := new(IB)
    sha2_k(kb)
    k := kb.v
    l := len(s)
    total := (l + 9 + 63) / 64 * 64
    w := mkslice(int, 64)
    b0 := 0
    for b0 < total {
        i := 0
        for i < 16 {
            j := b0 + i * 4
            w[i] = mbyte(s, l, total, j) * 16777216 + mbyte(s, l, total, j + 1) * 65536 + mbyte(s, l, total, j + 2) * 256 + mbyte(s, l, total, j + 3)
            i = i + 1
        }
        i = 16
        for i < 64 {
            x := w[i - 15]
            s0 := rotr(x, 7) ^ rotr(x, 18) ^ x / 8
            y := w[i - 2]
            s1 := rotr(y, 17) ^ rotr(y, 19) ^ y / 1024
            w[i] = w[i - 16] + s0 + w[i - 7] + s1 & 4294967295
            i = i + 1
        }
        a := h[0]
        b := h[1]
        c := h[2]
        d := h[3]
        e := h[4]
        f := h[5]
        g := h[6]
        hh := h[7]
        i = 0
        for i < 64 {
            s1 := rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
            ch := e & f ^ (e ^ 4294967295) & g
            t1 := hh + s1 + ch + k[i] + w[i] & 4294967295
            s0 := rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
            maj := a & b ^ a & c ^ b & c
            t2 := s0 + maj & 4294967295
            hh = g
            g = f
            f = e
            e = d + t1 & 4294967295
            d = c
            c = b
            b = a
            a = t1 + t2 & 4294967295
            i = i + 1
        }
        h[0] = h[0] + a & 4294967295
        h[1] = h[1] + b & 4294967295
        h[2] = h[2] + c & 4294967295
        h[3] = h[3] + d & 4294967295
        h[4] = h[4] + e & 4294967295
        h[5] = h[5] + f & 4294967295
        h[6] = h[6] + g & 4294967295
        h[7] = h[7] + hh & 4294967295
        b0 = b0 + 64
    }
    d := new(IB)
    d.v = mkslice(int, 32)
    i := 0
    for i < 8 {
        x := h[i]
        d.v[i * 4] = x / 16777216 % 256
        d.v[i * 4 + 1] = x / 65536 % 256
        d.v[i * 4 + 2] = x / 256 % 256
        d.v[i * 4 + 3] = x % 256
        i = i + 1
    }
    return d
}

fn hex_of(b: []int) -> str {
    t := "0123456789abcdef"
    out := ""
    i := 0
    for i < len(b) {
        v := b[i] & 255
        out = out + substr(t, v / 16, v / 16 + 1) + substr(t, v % 16, v % 16 + 1)
        i = i + 1
    }
    return out
}

fn b64_of(b: []int) -> str {
    t := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    out := ""
    i := 0
    for i < len(b) {
        c0 := b[i]
        c1 := 0
        c2 := 0
        cl := 1
        if i + 1 < len(b) {
            c1 = b[i + 1]
            cl = 2
        }
        if i + 2 < len(b) {
            c2 = b[i + 2]
            cl = 3
        }
        // pack only the cl real bytes, THEN shift — the window is
        // big-endian-packed over cl bytes, not always three
        n := c0
        if cl > 1 {
            n = n * 256 + c1
        }
        if cl > 2 {
            n = n * 256 + c2
        }
        n = n * p2(8 * (3 - cl))
        j := 0
        for j < 4 {
            if j <= cl {
                v := n / p2(18 - j * 6) % 64
                out = out + substr(t, v, v + 1)
            } else {
                out = out + "="
            }
            j = j + 1
        }
        i = i + 3
    }
    return out
}

// "rel|hex" entries for every regular file under dir — `|` can't be a
// filename char here (fetch's component check bans it)
fn dir_walk(base: str, dir: str, acc: mut SAcc) {
    ents := rt_lsdir(dir)
    i := 0
    for i < len(ents) {
        nm := ents[i]
        p := dir + "/" + nm
        if rt_islnk(p) == 1 {
            continue
        }
        if rt_isdir(p) == 1 {
            dir_walk(base, p, acc)
        } else if rt_isfile(p) == 1 {
            rel := substr(p, len(base) + 1, len(p))
            acc.items = push(acc.items, rel + "|" + hex_of(sha256(readfile(p)).v))
        }
        i = i + 1
    }
}

// h1 dirhash: sort rel paths, hash "<hex>  <name>\n" lines, base64 it
fn dir_h1(dir: str) -> str {
    acc := new(SAcc)
    acc.items = mkslice(str, 0)
    dir_walk(dir, dir, acc)
    ent := acc.items
    i := 0
    for i < len(ent) {
        j := i + 1
        for j < len(ent) {
            // compare the name portion only — sorting the joined
            // "name|hex" reverses prefix pairs (README vs README.md,
            // `|` > `.`) and diverges from the seed's tuple sort
            nj := substr(ent[j], 0, find(ent[j], "|"))
            ni := substr(ent[i], 0, find(ent[i], "|"))
            if str_cmp(nj, ni) < 0 {
                t := ent[i]
                ent[i] = ent[j]
                ent[j] = t
            }
            j = j + 1
        }
        i = i + 1
    }
    text := ""
    i = 0
    for i < len(ent) {
        e := ent[i]
        b := find(e, "|")
        text = text + substr(e, b + 1, len(e)) + "  " + substr(e, 0, b) + "\n"
        i = i + 1
    }
    return "h1:" + b64_of(sha256(text).v)
}

// manifest hash — single synthetic "<esc-path>@<esc-ver>.mod" entry
fn mod_h1(path: str, ver: str, bytes: str) -> str {
    nm := escape_path(path) + "@" + escape_path(ver) + ".mod"
    return "h1:" + b64_of(sha256(hex_of(sha256(bytes).v) + "  " + nm + "\n").v)
}

// parse oxl.sum into ck.mod_sums — malformed lines are a hard error,
// never silently skipped (mirrors parse_sums; 0 = error, diags emitted)
fn parse_sums(ck: mut Ck, text: str) -> int {
    lines := strings.split(text, "\n")
    i := 0
    for lines != nil {
        i = i + 1
        t := strings.trim(lines.v)
        lines = lines.next
        if len(t) == 0 {
            continue
        }
        toks := split_ws(t)
        if sl_len(toks) != 3 || strings.startswith(sl_at(toks, 2), "h1:") == false {
            diag(ck, "check", "oxl.sum:" + itoa(i) + ": malformed line")
            return 0
        }
        ver := sl_at(toks, 1)
        ism := 0
        if strings.endswith(ver, "/mod") {
            ver = substr(ver, 0, len(ver) - 4)
            ism = 1
        }
        ck.mod_sums = new(SumEnt{path: sl_at(toks, 0), ver: ver, is_mod: ism, h1: sl_at(toks, 2), next: ck.mod_sums})
    }
    return 1
}

fn sum_for(ck: ref Ck, path: str, ver: str, is_mod: int) -> str {
    l := ck.mod_sums
    for l != nil {
        if l.path == path && l.ver == ver && l.is_mod == is_mod {
            return l.h1
        }
        l = l.next
    }
    return ""
}

// verify a cached slot against the sums: both lines must exist and
// match — the two-entry rule. "" = verified
fn verify_slot(ck: ref Ck, dir: str, path: str, ver: str) -> str {
    t := sum_for(ck, path, ver, 0)
    if len(t) == 0 {
        return "missing oxl.sum entry for module " + path
    }
    m := sum_for(ck, path, ver, 1)
    if len(m) == 0 {
        return "missing oxl.sum entry for oxl.mod file for module " + path
    }
    if dir_h1(dir) != t {
        return "verifying " + path + "@" + ver + ": checksum mismatch"
    }
    mp := dir + "/oxl.mod"
    if rt_isfile(mp) == 0 {
        return mp + ": No such file or directory (os error 2)"
    }
    if mod_h1(path, ver, readfile(mp)) != m {
        return "verifying " + path + "@" + ver + ": checksum mismatch"
    }
    return ""
}

// ---------- import resolution ----------------------------------------
fn resolve_imp(ck: mut Ck, imp: str) -> RRes {
    r := RRes{dir: "", missing: "", tampered: ""}
    if strings.startswith(imp, "std/") {
        rest := substr(imp, 4, len(imp))
        // exe ancestors first (shipped-tree std beside the binary),
        // then the entry's ancestors — a self-hosted checker compiled
        // into a scratch dir still finds the SOURCE tree's std
        r.dir = std_at(canon_or(dir_of(argv(0))), rest)
        if len(r.dir) == 0 {
            r.dir = std_at(ck.entry_dir, rest)
        }
        return r
    }
    if ck.mod_on == 0 {
        return r
    }
    if imp == ck.mod_path || strings.startswith(imp, ck.mod_path + "/") {
        rest := ""
        if len(imp) > len(ck.mod_path) {
            rest = substr(imp, len(ck.mod_path) + 1, len(imp))
        }
        p := ck.mod_root
        if len(rest) > 0 {
            p = p + "/" + rest
        }
        if rt_isdir(p) == 1 {
            r.dir = p
        }
        return r
    }
    // requires — longest path prefix wins; the build list's
    // selection decides which version dir resolves
    best_alias := ""
    l := ck.mod_reqs
    for l != nil {
        if (imp == l.alias || strings.startswith(imp, l.alias + "/")) && len(l.alias) > len(best_alias) {
            best_alias = l.alias
        }
        l = l.next
    }
    if len(best_alias) > 0 {
        rest := ""
        if len(imp) > len(best_alias) {
            rest = substr(imp, len(best_alias) + 1, len(imp))
        }
        best_ver := selected_ver(ck, best_alias)
        dr := module_dir(ck, best_alias, best_ver)
        if len(dr.err) > 0 {
            r.tampered = dr.err
            return r
        }
        if len(dr.dir) == 0 {
            r.missing = best_alias + "@" + best_ver
            return r
        }
        p := dr.dir
        if len(rest) > 0 {
            p = p + "/" + rest
        }
        if rt_isdir(p) == 1 {
            r.dir = p
        }
        return r
    }
    return r
}

// internal rule: the importing package's dir must sit under EVERY
// `internal` segment's parent — mirrors the seed component scan over
// normalized paths
fn internal_ok(resolved: str, importer_dir: str) -> bool {
    rd := norm_path(canon_or(resolved))
    id := norm_path(canon_or(importer_dir))
    abs := strings.startswith(rd, "/")
    segs := strings.split(rd, "/")
    prefix := ""
    for segs != nil {
        s := segs.v
        if s == "internal" && len(prefix) > 0 {
            // the split drops the leading "/" — restore it for absolute
            // resolved paths so the importer's canonical prefix matches
            p := prefix
            if abs {
                p = "/" + p
            }
            if id != p && strings.startswith(id, p + "/") == false {
                return false
            }
        }
        if len(s) > 0 {
            if len(prefix) == 0 {
                prefix = s
            } else {
                prefix = prefix + "/" + s
            }
        }
        segs = segs.next
    }
    return true
}

// the written-imp chain from the in-flight load of `dir` to the stack
// top, oldest first — "" when `dir` isn't mid-load
fn cycle_chain(ck: mut Ck, dir: str) -> str {
    rev := ""
    l := ck.loading
    for l != nil {
        if len(rev) == 0 {
            rev = l.stem
        } else {
            rev = l.stem + " → " + rev
        }
        if l.alias == dir {
            return rev
        }
        l = l.next
    }
    return ""
}

// one parsed package file: clause + ast
struct PFile { path: str, clause: str, ast: own parser.Node }

// read + parse a file, report failures; "" clause when unparseable
fn parse_pfile(ck: mut Ck, path: str) -> PFile {
    src := over_src(ck, path)
    if len(src) == 0 {
        diag(ck, "check", "cannot read `" + path + "`")
        ck.load_fail = 1
        return PFile{path: path, clause: "", ast: nil}
    }
    hush := 0
    if ck.over != nil {
        hush = 1 // LSP: lex errors print to stdout — keep the wire clean
    }
    ast := parser.parse2(lexlib.lex(src), hush)
    if ast == nil {
        diag(ck, "lex", "lexical error — see lex output above")
        ck.load_fail = 1
        return PFile{path: path, clause: "", ast: nil}
    }
    clause := ""
    match ast {
        parser.Node.Root{items} => {
            if items != nil && nk(items.v) == 52 {
                match items.v {
                    parser.Node.Package{name} => {
                        clause = name
                    }
                    _ => {
                    }
                }
            }
        }
        _ => {
        }
    }
    return PFile{path: path, clause: clause, ast: ast}
}

// collect one file's items + its own import bindings: names shared
// package-wide through `mod`, import tables stay per-file like the established model
fn pfile_items(ck: mut Ck, ld: mut Loader, fpath: str, ast: own parser.Node, itemmod: str) {
    match ast {
        parser.Node.Root{items} => {
            let al: own ModEnt = nil
            let nm: own ModEnt = nil
            let binds: own ImpBind = nil
            l := items
            for l != nil {
                match l.v {
                    parser.Node.Import{path, alias, names} => {
                        if ck.load_fail == 1 {
                            break
                        }
                        rr := resolve_imp(ck, path)
                        if len(rr.missing) > 0 {
                            diag(ck, "check", "missing module `" + rr.missing + "` — oxl get it or replace it")
                            ck.load_fail = 1
                        } else if len(rr.tampered) > 0 {
                            diag(ck, "check", rr.tampered)
                            ck.load_fail = 1
                        } else if len(rr.dir) == 0 {
                            if remoteish(path) {
                                diag(ck, "check", "cannot find package `" + path + "` (missing module — oxl get it or add a require)")
                            } else {
                                diag(ck, "check", "cannot find package `" + path + "`")
                            }
                            ck.load_fail = 1
                        } else if internal_ok(rr.dir, dir_of(fpath)) == false {
                            diag(ck, "check", "use of internal package `" + path + "` not allowed")
                            ck.load_fail = 1
                        } else {
                            bound := load_pkg(ck, ld, rr.dir, path, 1, 0)
                            // `as _` — explicit side-effect import: the
                            // package loads, nothing binds, exempt (M3)
                            if len(bound) > 0 && alias != "_" {
                                qual := bound
                                if len(alias) > 0 {
                                    qual = alias
                                }
                                // a second binding of the same local name is
                                // an error (redeclared in this block)
                                if modent_has(al, qual) == 1 || modent_has(nm, qual) == 1 {
                                    diag(ck, "check", "`" + qual + "` redeclared as imported package name")
                                    ck.load_fail = 1
                                } else {
                                    al = new(ModEnt{alias: qual, stem: bound, ver: "", next: al})
                                    binds = new(ImpBind{path: path, qual: qual, tgt: "", used: 0, next: binds})
                                    nl := names
                                    for nl != nil {
                                        match nl.v {
                                            parser.Node.Name{n} => {
                                                if modent_has(al, n) == 1 || modent_has(nm, n) == 1 {
                                                    diag(ck, "check", "`" + n + "` redeclared as imported name")
                                                    ck.load_fail = 1
                                                    break
                                                }
                                                nm = new(ModEnt{alias: n, stem: bound + "." + n, ver: "", next: nm})
                                                binds = new(ImpBind{path: path, qual: "", tgt: bound + "." + n, used: 0, next: binds})
                                            }
                                            _ => {
                                            }
                                        }
                                        nl = nl.next
                                    }
                                }
                            }
                        }
                    }
                    _ => {
                    }
                }
                l = l.next
            }
            // the seed's loader extends the item list with every
            // import's items before pushing this file's own decls —
            // imports-first order is what the emitter's decl ordering
            // relies on (a struct's by-value fields must be defined
            // before the struct that embeds them)
            l = items
            for l != nil {
                k := nk(l.v)
                if k != 25 && k != 52 {
                    ld.items = push(ld.items, It{node: l.v, mod: itemmod, file: fpath})
                }
                l = l.next
            }
            // binds built by prepend — flip so unused diags emit in
            // the file's import order like the seed report
            let rb: own ImpBind = nil
            for binds != nil {
                bn := binds.next
                binds.next = rb
                rb = binds
                binds = bn
            }
            binds = rb
            ck.file_aliases = push(ck.file_aliases, FileAlias{file: fpath, aliases: al, names: nm, binds: binds, next: nil})
        }
        _ => {
        }
    }
}

// load every .oxl in a package dir; returns the clause ("" on failure —
// diagnostics already emitted). Mirrors the seed load_pkg checks:
// mixed clauses, clause-vs-dirname, `main` isn't importable.
fn load_pkg(ck: mut Ck, ld: mut Loader, dir: str, imp: str, as_import: int, is_root: int) -> str {
    if ck.load_fail == 1 {
        return ""
    }
    cc := cycle_chain(ck, dir)
    if len(cc) > 0 {
        diag(ck, "check", "import cycle not allowed: " + cc + " → " + imp)
        ck.load_fail = 1
        return ""
    }
    if sl_has(ck.loaded, dir) {
        return clause_of(ck, dir)
    }
    ck.loaded = scons(dir, ck.loaded)
    ck.loading = new(ModEnt{alias: dir, stem: imp, ver: "", next: ck.loading})
    r := load_pkg_inner(ck, ld, dir, imp, as_import, is_root)
    ck.loading = ck.loading.next
    return r
}

fn load_pkg_inner(ck: mut Ck, ld: mut Loader, dir: str, imp: str, as_import: int, is_root: int) -> str {
    // .oxl entries of the dir — rt_lsdir presorts so the load order
    // (and diagnostics) match the seed loader deterministically
    fs := mkslice(str, 0)
    ents := rt_lsdir(dir)
    ei := 0
    for ei < len(ents) {
        if strings.endswith(ents[ei], ".oxl") {
            fs = push(fs, ents[ei])
        }
        ei = ei + 1
    }
    if len(fs) == 0 {
        diag(ck, "check", "no .oxl source files in `" + dir + "`")
        return ""
    }
    // parse all files first — clause validation precedes item collection
    pfs := mkslice(PFile, 0)
    i := 0
    for i < len(fs) {
        pfs = push(pfs, parse_pfile(ck, dir + "/" + fs[i]))
        i = i + 1
    }
    clause0 := pfs[0].clause
    i = 1
    for i < len(pfs) {
        if pfs[i].clause != clause0 {
            diag(ck, "check", "found packages `" + clause0 + "` (`" + fs[0] + "`) and `" + pfs[i].clause + "` (`" + fs[i] + "`) in `" + dir + "`")
            return ""
        }
        i = i + 1
    }
    if as_import == 1 && clause0 == "main" {
        diag(ck, "check", "`" + imp + "` is a program, not an importable package")
        return ""
    }
    if clause0 != "main" && clause0 != base_name(dir) {
        diag(ck, "check", "package name `" + clause0 + "` does not match directory `" + base_name(dir) + "`")
        return ""
    }
    ck.loaded_names = new(ModEnt{alias: dir, stem: clause0, ver: "", next: ck.loaded_names})
    itemmod := clause0
    if is_root == 1 {
        itemmod = ""
    }
    i = 0
    for i < len(pfs) {
        pfile_items(ck, ld, pfs[i].path, pfs[i].ast, itemmod)
        i = i + 1
    }
    return clause0
}

// file-mode root: one file is a one-file package — no dir-name or
// mixed-clause checks, items stay unqualified; imports still resolve
// to package directories (mirrors the seed PkgSrc::Files path)
fn load_file_root(ck: mut Ck, ld: mut Loader, path: str) -> str {
    pf := parse_pfile(ck, path)
    if pf.ast == nil {
        return ""
    }
    pfile_items(ck, ld, pf.path, pf.ast, "")
    return pf.clause
}

// result of the whole check pipeline — codegen consumes it too
struct CkRes { ck: own Ck, items: []It }

// fresh checker state — every check_* entry shares the init
fn ck_new() -> own Ck {
    ck := new(Ck)
    ck.tyv = mkslice(T, 0)
    ck.fns = collections.map_new()
    ck.fnsv = mkslice(FnSig, 0)
    ck.structs = collections.map_new()
    ck.structsv = mkslice(SEnt, 0)
    ck.enums = collections.map_new()
    ck.enumsv = mkslice(EEnt, 0)
    ck.globals = collections.map_new()
    ck.ifaces = collections.map_new()
    ck.ifacesv = mkslice(IEnt, 0)
    ck.ty_scope = nil
    ck.cur_ty_params = nil
    ck.methods = nil
    ck.file_aliases = mkslice(FileAlias, 0)
    ck.diags = mkslice(DBox, 0)
    ck.edges = nil
    ck.susp = nil
    ck.loaded = nil
    ck.loaded_names = nil
    ck.fnvals = nil
    ck.cur_fn = ""
    ck.cur_mod = ""
    ck.cur_file = ""
    ck.retk = 0
    ck.ret1 = -1
    ck.in_let2 = 0
    ck.in_cl = 0
    ck.cl_ret = -1
    ck.clcks = nil
    ck.loop_depth = 0
    ck.nerr = 0
    ck.usev = mkslice(UseRec, 0)
    ck.decls = collections.map_new()
    ck.declsv = mkslice(DeclEnt, 0)
    ck.dpos = -1
    ck.loading = nil
    ck.load_fail = 0
    ck.mod_on = 0
    ck.mod_path = ""
    ck.mod_root = ""
    ck.mod_floor = ""
    ck.mod_reqs = nil
    ck.mod_reps = nil
    ck.modcache = ""
    ck.entry_dir = ""
    return ck
}

// shared post-load pipeline: register + typecheck + susp analysis +
// the dead-import sweep; the CkRes wraps ck + the loaded items either
// way (diags distinguish ok from failed)
fn check_run_tail(ck: own Ck, ld: own Loader, root_pkg: str, need_main: int) -> own CkRes {
    if ck.load_fail == 1 {
        r := new(CkRes)
        r.ck = ck
        r.items = ld.items
        return r
    }
    ck.root_pkg = root_pkg
    if need_main == 1 && len(root_pkg) > 0 && root_pkg != "main" {
        diag(ck, "check", "package `" + root_pkg + "` is not a main package")
        r := new(CkRes)
        r.ck = ck
        r.items = ld.items
        return r
    }
    register(ck, ld.items)
    check_skips(ck, ld.items)
    check_items(ck, ld.items)
    susp_seeds(ck, ld.items)
    susp_fixpoint(ck)
    // D3: methods may not suspend — vtable/indirect calls carry no task
    ml := ck.methods
    for ml != nil {
        if sl_has(ck.susp, ml.v) {
            diag(ck, "check", "suspendable method `" + ml.v + "` — methods may not suspend (v0.2)")
        }
        ml = ml.next
    }
    check_closures(ck)
    check_fnvals(ck)
    check_suspend_rules(ck, ld.items)
    // M3: each file's imports judged against its decls — one diag per
    // dead binding in import order (seed emits these mid-load)
    if ck.load_fail == 0 {
        fi2 := 0
        for fi2 < len(ck.file_aliases) {
            b := ck.file_aliases[fi2].binds
            for b != nil {
                if b.used == 0 {
                    if len(b.qual) > 0 {
                        diag(ck, "check", "imported and not used: \"" + b.path + "\"")
                    } else {
                        sn := substr(b.tgt, find(b.tgt, ".") + 1, len(b.tgt))
                        diag(ck, "check", "imported and not used: \"" + b.path + "\".{" + sn + "}")
                    }
                }
                b = b.next
            }
            fi2 = fi2 + 1
        }
    }
    r := new(CkRes)
    r.ck = ck
    r.items = ld.items
    return r
}

// load + register + typecheck + susp analysis for `path`.
// `path` may name a file (file-list mode) or a package directory.
// `need_main` mirrors compile_mode: building requires `package main`
// (test mode's generated driver exempts it).
fn check_file(path: str, need_main: int) -> own CkRes {
    return check_file_over(path, need_main, nil)
}

// readfile with unsaved-buffer substitution — the LSP seeds ck.over so a
// didChange analyzes the wire text, not the stale disk copy
fn over_src(ck: ref Ck, path: str) -> str {
    o := ck.over
    want := canon_or(path)
    for o != nil {
        if o.path == path || canon_or(o.path) == want {
            return o.text
        }
        o = o.next
    }
    return readfile(path)
}

// LSP entry: analyze the package containing `path` (dir mode like the
// seed's analyze), honoring open-buffer overrides; need_main is always 0
// — editors check libraries too
fn lsp_analyze(path: str, over: own OverEnt) -> own CkRes {
    d := path
    if rt_isdir(d) == 0 {
        d = dir_of(d)
    }
    if len(d) == 0 {
        d = "."
    }
    return check_file_over(d, 0, over)
}

fn check_file_over(path: str, need_main: int, over: own OverEnt) -> own CkRes {
    ck := ck_new()
    ck.over = over
    ld := new(Loader)
    ld.items = mkslice(It, 0)
    // module ctx from the entry — dir args directly, file args' parent
    start := path
    if rt_isdir(path) == 0 {
        start = dir_of(path)
    }
    ck.entry_dir = start
    if mod_ctx_load(ck, start) == 0 {
        ck.load_fail = 1
    }
    root_pkg := ""
    if ck.load_fail == 0 {
        if rt_isdir(path) == 1 {
            root_pkg = load_pkg(ck, ld, path, path, 0, 1)
        } else {
            root_pkg = load_file_root(ck, ld, path)
        }
    }
    return check_run_tail(ck, ld, root_pkg, need_main)
}

// fs[0].parent() as the seed's Path::parent displays it — "" for bare
// names, "." for "./x", "/" for "/x"; trailing slashes normalize away
fn parent_disp(p: str) -> str {
    for len(p) > 1 && strings.endswith(p, "/") {
        p = substr(p, 0, len(p) - 1)
    }
    ls := last_slash(p)
    if ls < 0 {
        return ""
    }
    if ls == 0 {
        return "/"
    }
    return substr(p, 0, ls)
}

// file-list root: the explicit `a.oxl b.oxl` command-line form — one
// shared decl namespace, no dir-name clause check, and the seed's
// file-list rule (all named files in one directory). Mirrors
// load_pkg_inner's PkgSrc::Files path.
fn check_files(paths: []str, need_main: int) -> own CkRes {
    ck := ck_new()
    ld := new(Loader)
    ld.items = mkslice(It, 0)
    if len(paths) == 0 {
        r := new(CkRes)
        r.ck = ck
        r.items = ld.items
        return r
    }
    // module ctx anchors at the first file's parent, like check_file
    start := dir_of(paths[0])
    ck.entry_dir = start
    if mod_ctx_load(ck, start) == 0 {
        ck.load_fail = 1
    }
    root_pkg := ""
    if ck.load_fail == 0 {
        // parse all files first — clause validation precedes items,
        // and the first parse failure aborts the whole list
        pfs := mkslice(PFile, 0)
        i := 0
        for i < len(paths) && ck.load_fail == 0 {
            pfs = push(pfs, parse_pfile(ck, paths[i]))
            i = i + 1
        }
        if ck.load_fail == 0 {
            disp := parent_disp(paths[0])
            clause0 := pfs[0].clause
            i = 1
            for i < len(pfs) {
                if pfs[i].clause != clause0 {
                    diag(ck, "check", "found packages `" + clause0 + "` (`" + base_name(paths[0]) + "`) and `" + pfs[i].clause + "` (`" + base_name(paths[i]) + "`) in `" + disp + "`")
                    ck.load_fail = 1
                    break
                }
                i = i + 1
            }
            i = 1
            for i < len(paths) && ck.load_fail == 0 {
                if parent_disp(paths[i]) != disp {
                    diag(ck, "check", "named files must all be in one directory; have `" + disp + "` and `" + parent_disp(paths[i]) + "`")
                    ck.load_fail = 1
                }
                i = i + 1
            }
            if ck.load_fail == 0 {
                root_pkg = clause0
                i = 0
                for i < len(pfs) {
                    pfile_items(ck, ld, pfs[i].path, pfs[i].ast, "")
                    i = i + 1
                }
            }
        }
    }
    return check_run_tail(ck, ld, root_pkg, need_main)
}
