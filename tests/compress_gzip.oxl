package main

// compress acceptance: std/compress/gzip — header field parse
// (FNAME/MTIME/OS), crc32+isize trailer verification, multi-member
// concatenation, and failure surfaces (bad magic, corrupt trailer,
// truncated stream).
import "std/io"

import "std/compress/gzip"

import "std/encoding/hex"

import "std/errors"

import "std/testing"

fn ck(e: err, m: str) {
    testing.expect(e == nil, m + ": " + errors.msg(e))
}

fn hx(s: str) -> own []byte {
    [b, e] = hex.decode(s)
    ck(e, "hex decode")
    return b
}

fn hx_b(s: str) -> str {
    return hx(s) as str
}

struct slicereader { b: []byte, i: int }

fn (s mut slicereader) read(b: []byte) -> [int, err] {
    if s.i >= len(s.b) {
        return 0, io.eof()
    }
    n := len(s.b) - s.i
    if n > len(b) {
        n = len(b)
    }
    j := 0
    for j < n {
        b[j] = s.b[s.i + j]
        j = j + 1
    }
    s.i = s.i + n
    return n, nil
}

fn (s mut slicereader) asreader() -> io.Reader {
    return s
}

fn drain_all(r: io.Reader, chunk: int) -> [str, err] {
    out := mkslice(byte, 0)
    tmp := mkslice(byte, chunk)
    for true {
        [n, e] = r.read(tmp)
        j := 0
        for j < n {
            out = push(out, tmp[j])
            j = j + 1
        }
        if e == io.eof() {
            return out as str, nil
        }
        if e != nil {
            return out as str, e
        }
    }
    return out as str, nil
}

// python: gzip.compress(b"hello gzip", compresslevel=9, mtime=0)
fn test_basic() {
    [out, e] = gzip.decompress(hx_b("1f8b08000000000002ffcb48cdc9c95748afca2c0000196ad2df0a000000") as []byte)
    ck(e, "gzip decompress")
    testing.expect_streq(out as str, "hello gzip", "gzip payload")
}

fn test_header_fields() {
    // gzip.compress with FNAME + MTIME set (python gzip.GzipFile)
    blob := hx_b("1f8b080800f1536500ff68656c6c6f2e74787400cb48cdc9c95748afca2c5028cf2fca4901006b7de8b710000000") as []byte
    sr := slicereader{b: blob, i: 0}
    [g, e] = gzip.newreader(sr.asreader())
    ck(e, "gzip newreader")
    testing.expect_streq(g.name, "hello.txt", "FNAME parsed")
    testing.expect_eq(g.mtime, 1700000000, "MTIME parsed")
    testing.expect_eq(g.os, 255, "OS byte parsed")
    [s, e2] = drain_all(g.asreader(), 4)
    ck(e2, "gzip read")
    testing.expect_streq(s, "hello gzip world", "gzip streamed payload")
}

// python: gzip.compress(b"part1-") + gzip.compress(b"part2!")
fn test_multimember() {
    [out, e] = gzip.decompress(hx_b("1f8b08000000000002ff2b482c2a31d40500c301fe0f060000001f8b08000000000002ff2b482c2a315204002b1e652d06000000") as []byte)
    ck(e, "multi decompress")
    testing.expect_streq(out as str, "part1-part2!", "concatenated payload")
}

fn test_badcrc() {
    // trailer crc32 byte flipped
    [_o, e] = gzip.decompress(hx_b("1f8b08000000000002ff4bce484dcece4d05001d00dded07000000") as []byte)
    testing.expect(e != nil, "bad trailer crc errors")
    testing.expect_streq(errors.msg(e), "gzip: crc32 mismatch", "crc mismatch message")
}

fn test_badmagic() {
    [_o, e] = gzip.decompress(hx_b("1f8c08000000000002ffcb48cdc9c95748afca2c0000196ad2df0a000000") as []byte)
    testing.expect(e != nil, "bad magic errors")
    testing.expect_streq(errors.msg(e), "gzip: bad magic", "bad magic message")
}

fn test_truncated() {
    // valid header, payload cut short
    [_o, e] = gzip.decompress(hx_b("1f8b08000000000002ffcb48cdc9c9") as []byte)
    testing.expect(e != nil, "truncated payload errors")
}

fn main() {}
