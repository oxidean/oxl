package errors

// std/errors — message-carrying err values. `err` stays an int64 code
// (the [v, err] ABI is unchanged); payloads live in an interned
// registry so a sentinel is stable: errors.new("EOF") called anywhere
// returns the same code and `e == io.eof()` is a plain int compare.
// Registry entries are never freed — one per distinct message text.
extern fn rt_err_new(msg: str) -> err

extern fn rt_err_msg(code: err) -> str

/// new returns a messaged err. Interned by text: identical messages
/// share one code, which is what makes sentinels comparable.
fn new(msg: str) -> err {
    return rt_err_new(msg)
}

/// msg returns the registered message; "" for nil and foreign codes.
fn msg(e: err) -> str {
    return rt_err_msg(e)
}

/// code returns the raw int64 code.
fn code(e: err) -> int {
    return e
}

extern fn rt_err_wrap(msg: str, cause: err) -> err

extern fn rt_err_cause(code: err) -> err

/// wrap returns a new messaged err carrying e as its cause. Unlike
/// new() the result is never interned — two wraps of the same text
/// stay distinct so each keeps its own chain.
fn wrap(msg: str, e: err) -> err {
    return rt_err_wrap(msg, e)
}

/// unwrap returns the cause of e, or nil at the end of the chain.
fn unwrap(e: err) -> err {
    return rt_err_cause(e)
}

/// is reports whether target appears in e's cause chain — a plain
/// code compare at each link, so interned sentinels match. Boxes are
/// distinct codes per mint so `is` finds a box only by identity —
/// typed lookup is `as`'s job.
fn is(e: err, target: err) -> bool {
    for e != nil {
        if e == target {
            return true
        }
        e = rt_err_cause(e)
    }
    return false
}

/// box[T any](v: T) is a global compiler builtin (the
/// value_of/mkslice family — no extern signature can carry a generic
/// T/own payload into an int slot), not an errors member; call it
/// bare as `box(v)`. It consumes v, mints a fresh int64 code backed
/// by the rt err registry, and records the payload pointer against
/// v's descriptor. A box IS an err end to end — wrap/unwrap/is all
/// work on it — and errors.msg yields the boxed type's name. A bare
/// `own` binding moves its handle into the entry; other own exprs
/// and value/ref/mut args heap-copy into an own-lane sizeof(T)
/// block the registry adopts. A nil `own` payload mints an
// entry with no pdata that can never match `as` — box nil only to
// reserve a code. See docs/semantics/errors.md.

/// as reports whether a box in e's unwrap chain stores out's exact
/// descriptor — first match wins; an iface-typed out matches only a
/// box of that same iface descriptor, no implementability walk. On a
/// match the payload copies into *out (moving the handle for `own`-
/// bound outs), the registry slot clears — a given box answers
/// exactly once — and walking continues past consumed boxes. as is a
/// declared generic so `mut T` binds T from out, but the call site
/// folds to rt_err_as like box does — a `mut T` param's C pointer is
/// already the writable *out address the extern needs. The body is
/// unreachable; it exists to keep the signature real.
fn as[T any](e: err, out: mut T) -> bool {
    return false
}
