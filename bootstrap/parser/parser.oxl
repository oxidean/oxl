package parser

// bootstrap/parser.oxl — a parser for .oxl, written in .oxl.
// Second self-host component: consumes lexlib's token list and emits
// the AST as JSON via std/encoding/json. With the lexer, the entire compiler
// frontend now exists in-language.
//
// Internals are a typed `Node` enum (B1) — every variant maps to one
// `{tag: ...}` Json object; `to_json` walks the tree at the end, so
// the emitted output is unchanged.
//
//   oxl run bootstrap/parser.oxl -- examples/hello.oxl
import "oxl/bootstrap/lexlib"

import "std/encoding/json"

// readfile signals failure as "" — the same result a legitimately
// empty file produces — so probe readability first to tell them apart
struct PCur {
    t: own lexlib.Tok,
    nolit: int, // 1 while parsing if/for conditions — `{` is a block, not a literal
    pln: int, // line of the last consumed token — `x[i]` only binds when adjacent
    plo: int, // byte offset of the last consumed token
    phi: int, // byte offset just past it — node `hi` marks
    lex_err: int, // 1 once an err token was consumed — parse() returns nil
    hush: int, // 1 to silence lex/parse error printlns (stdio-protocol callers)
}

// ---------- typed AST ----------
//
// One variant per `{tag: ...}` node the parser emits. Child lists are
// `own NList` cons cells; optional children are `own Node` = nil.
struct NList { v: own Node, next: own NList }

// Nodes carrying a source span append `lo`/`hi` byte offsets ([lo, hi)
// of the tokens that formed them) — the checker's LSP index resolves
// hover/definition positions through them. Spans never enter to_json.
enum Node {
    JInt(int), // {"int": i}
    JFloat(str), // {"float": s}
    JStr(str), // {"str": s}
    Name { n: str, lo: int, hi: int }, // {"name": s}
    Ty { f0: str, lo: int, hi: int }, // {"ty": s}
    NamedField { name: str, val: own Node }, // {"name": s, "val": <v>}
    Param { name: str, ty: own Node, lo: int, hi: int }, // {"name": s} (+"ty")
    FieldDef { name: str, ty: own Node, lo: int, hi: int }, // {"name": s} (+"ty")
    Lit { obj: own Node, fields: own NList, lo: int, hi: int }, // {"lit": <o>, "fields": [...]}
    Call { f: own Node, args: own NList }, // {"call": <f>, "args": [...]}
    Field { obj: own Node, name: str, lo: int, hi: int }, // {"field": <o>, "name": s}
    Un { op: str, e: own Node }, // {"un": s, "e": <e>}
    Bin { op: str, l: own Node, r: own Node }, // {"bin": s, "l": <l>, "r": <r>}
    Let { name: str, ty: own Node, init: own Node, lo: int, hi: int }, // {"let": s} (+"ty","init")
    Ret { vals: own NList }, // {"return": [...]}
    Break, // {"break": null}
    Continue, // {"continue": null}
    Scope { body: own Node }, // {"scope": <body>}
    Spawn { e: own Node }, // {"spawn": <e>}
    SpawnBlocking { e: own Node }, // {"spawnBlocking": <e>}
    Go { e: own Node }, // {"go": <e>}
    Let2 { names: str, call: own Node, lo: int, hi: int }, // {"let2": s} (+"call")
    Bind { name: str, init: own Node, lo: int, hi: int }, // {"bind": s, "init": <init>}
    ExprStmt { e: own Node }, // {"expr": <e>}
    If { cond: own Node, then: own Node, els: own Node }, // {"if","then",(+"else")}
    For { cond: own Node, body: own Node }, // {"for": <cond>, "body": <body>}
    List { items: own NList }, // bare [...] array node
    Fn { ex: bool, name: str, recv: own Node, typarams: own NList, params: own NList, ret: own Node, body: own Node, lo: int, hi: int },
    TyParam { name: str, constraint: str }, // {"typaram": s, "constraint": s}
    Import { path: str, alias: str, names: own NList }, // {"import": s} (+"as","names")
    Struct { name: str, fields: own NList, lo: int, hi: int }, // {"struct": s, "fields": [...]}
    Interface { name: str, ops: own NList, methods: own NList, lo: int, hi: int }, // {"interface": s}
    Method { name: str, params: own NList, ret: own Node, lo: int, hi: int }, // {"method": s}
    Skip { text: str }, // {"skip": s}
    Root { items: own NList }, // {"items": [...]}
    Enum { name: str, vars: own NList, lo: int, hi: int }, // {"enum": s, "variants": [...]}
    Variant { name: str, args: own NList, lo: int, hi: int }, // {"variant": s, "args": [...]}
    As { e: own Node, ty: own Node }, // {"as": <e>, "ty": <t>}
    Match { e: own Node, arms: own NList }, // {"match": <e>, "arms": [...]}
    MArm { pat: own Node, body: own Node, lo: int, hi: int }, // {"pat": <p>, "body": <b>}
    Pat { path: str, binds: own NList }, // {"pat": s} (+"binds")
    PatWild, // {"pat": "_"}
    PatLit { v: own Node }, // {"patlit": <v>}
    PatBind { name: str }, // {"patbind": s} — bare ident binds
    Assign { target: own Node, val: own Node }, // {"assign": <t>, "val": <v>}
    Select { arms: own NList, lo: int, hi: int }, // {"select": [...]}
    SArm { kind: str, ch: own Node, bind: str, ms: own Node, body: own Node },
    Closure { params: own NList, body: own Node }, // {"closure": [...], "body": <list>}
    Index { obj: own Node, idx: own Node }, // {"index": <o>, "idx": <i>}
    Slice { obj: own Node, lo: own Node, hi: own Node }, // {"slice","lo","hi"}
    Defer { call: own Node }, // {"defer": <call>}
    Unsafe { body: own Node }, // {"unsafe": <body>}
    Package { name: str }, // {"package": s} — mandatory first item
}

fn ncons(v: own Node, next: own NList) -> own NList {
    c := new(NList)
    c.v = v
    c.next = next
    return c
}

fn nrev(l: own NList) -> own NList {
    let out: own NList = nil
    for l != nil {
        n := l.next
        l.next = out
        out = l
        l = n
    }
    return out
}

// box a Node value into `own Node` — constructions are by-value; the
// AST is all `own` handles
fn b(n: Node) -> own Node {
    return new(n)
}

fn jl_items(l: own NList) -> own json.Json {
    a := json.jarr()
    cur := l
    for cur != nil {
        json.jadd(a, "", to_json(cur.v))
        cur = cur.next
    }
    return a
}

fn to_json(n: own Node) -> own json.Json {
    // List is a bare array — emit it directly, not as a tagged object
    match n {
        Node.List{items} => {
            return jl_items(items)
        }
        _ => {
        }
    }
    o := json.jobj()
    match n {
        Node.JInt(v) => {
            json.jadd(o, "int", json.jint(v))
        }
        Node.JFloat(s) => {
            json.jadd(o, "float", json.jstr(s))
        }
        Node.JStr(s) => {
            json.jadd(o, "str", json.jstr(s))
        }
        Node.Name{n} => {
            json.jadd(o, "name", json.jstr(n))
        }
        Node.Ty{f0} => {
            json.jadd(o, "ty", json.jstr(f0))
        }
        Node.NamedField{name, val} => {
            json.jadd(o, "name", json.jstr(name))
            json.jadd(o, "val", to_json(val))
        }
        Node.Param{name, ty} => {
            json.jadd(o, "name", json.jstr(name))
            if ty != nil {
                json.jadd(o, "ty", to_json(ty))
            }
        }
        Node.FieldDef{name, ty} => {
            json.jadd(o, "name", json.jstr(name))
            if ty != nil {
                json.jadd(o, "ty", to_json(ty))
            }
        }
        Node.Lit{obj, fields} => {
            json.jadd(o, "lit", to_json(obj))
            json.jadd(o, "fields", jl_items(fields))
        }
        Node.Call{f, args} => {
            json.jadd(o, "call", to_json(f))
            json.jadd(o, "args", jl_items(args))
        }
        Node.Field{obj, name} => {
            json.jadd(o, "field", to_json(obj))
            json.jadd(o, "name", json.jstr(name))
        }
        Node.Un{op, e} => {
            json.jadd(o, "un", json.jstr(op))
            json.jadd(o, "e", to_json(e))
        }
        Node.Bin{op, l, r} => {
            json.jadd(o, "bin", json.jstr(op))
            json.jadd(o, "l", to_json(l))
            json.jadd(o, "r", to_json(r))
        }
        Node.Let{name, ty, init} => {
            json.jadd(o, "let", json.jstr(name))
            if ty != nil {
                json.jadd(o, "ty", to_json(ty))
            }
            if init != nil {
                json.jadd(o, "init", to_json(init))
            }
        }
        Node.Ret{vals} => {
            json.jadd(o, "return", jl_items(vals))
        }
        Node.Break => {
            json.jadd(o, "break", json.jnull())
        }
        Node.Continue => {
            json.jadd(o, "continue", json.jnull())
        }
        Node.Scope{body} => {
            json.jadd(o, "scope", to_json(body))
        }
        Node.Spawn{e} => {
            json.jadd(o, "spawn", to_json(e))
        }
        Node.SpawnBlocking{e} => {
            json.jadd(o, "spawnBlocking", to_json(e))
        }
        Node.Go{e} => {
            json.jadd(o, "go", to_json(e))
        }
        Node.Let2{names, call} => {
            json.jadd(o, "let2", json.jstr(names))
            if call != nil {
                json.jadd(o, "call", to_json(call))
            }
        }
        Node.Bind{name, init} => {
            json.jadd(o, "bind", json.jstr(name))
            json.jadd(o, "init", to_json(init))
        }
        Node.ExprStmt{e} => {
            json.jadd(o, "expr", to_json(e))
        }
        Node.If{cond, then, els} => {
            json.jadd(o, "if", to_json(cond))
            json.jadd(o, "then", to_json(then))
            if els != nil {
                json.jadd(o, "else", to_json(els))
            }
        }
        Node.For{cond, body} => {
            json.jadd(o, "for", to_json(cond))
            json.jadd(o, "body", to_json(body))
        }
        Node.List{items} => {
            json.jadd(o, "items", jl_items(items))
        }
        Node.Fn{ex, name, recv, typarams, params, ret, body} => {
            if ex {
                json.jadd(o, "extern", json.jbool(true))
            }
            json.jadd(o, "fn", json.jstr(name))
            if recv != nil {
                json.jadd(o, "recv", to_json(recv))
            }
            if typarams != nil {
                json.jadd(o, "typarams", jl_items(typarams))
            }
            json.jadd(o, "params", jl_items(params))
            if ret != nil {
                json.jadd(o, "ret", to_json(ret))
            }
            if body != nil {
                json.jadd(o, "body", to_json(body))
            }
        }
        Node.TyParam{name, constraint} => {
            json.jadd(o, "typaram", json.jstr(name))
            json.jadd(o, "constraint", json.jstr(constraint))
        }
        Node.Import{path, alias, names} => {
            json.jadd(o, "import", json.jstr(path))
            if len(alias) > 0 {
                json.jadd(o, "as", json.jstr(alias))
            }
            if names != nil {
                json.jadd(o, "names", jl_items(names))
            }
        }
        Node.Struct{name, fields} => {
            json.jadd(o, "struct", json.jstr(name))
            json.jadd(o, "fields", jl_items(fields))
        }
        Node.Interface{name, ops, methods} => {
            json.jadd(o, "interface", json.jstr(name))
            json.jadd(o, "ops", jl_items(ops))
            json.jadd(o, "methods", jl_items(methods))
        }
        Node.Method{name, params, ret} => {
            json.jadd(o, "method", json.jstr(name))
            json.jadd(o, "params", jl_items(params))
            if ret != nil {
                json.jadd(o, "ret", to_json(ret))
            }
        }
        Node.Package{name} => {
            json.jadd(o, "package", json.jstr(name))
        }
        Node.Skip{text} => {
            json.jadd(o, "skip", json.jstr(text))
        }
        Node.Root{items} => {
            json.jadd(o, "items", jl_items(items))
        }
        Node.Enum{name, vars} => {
            json.jadd(o, "enum", json.jstr(name))
            json.jadd(o, "variants", jl_items(vars))
        }
        Node.Variant{name, args} => {
            json.jadd(o, "variant", json.jstr(name))
            json.jadd(o, "args", jl_items(args))
        }
        Node.As{e, ty} => {
            json.jadd(o, "as", to_json(e))
            json.jadd(o, "ty", to_json(ty))
        }
        Node.Match{e, arms} => {
            json.jadd(o, "match", to_json(e))
            json.jadd(o, "arms", jl_items(arms))
        }
        Node.MArm{pat, body} => {
            json.jadd(o, "pat", to_json(pat))
            json.jadd(o, "body", to_json(body))
        }
        Node.Pat{path, binds} => {
            json.jadd(o, "pat", json.jstr(path))
            if binds != nil {
                json.jadd(o, "binds", jl_items(binds))
            }
        }
        Node.PatWild => {
            json.jadd(o, "pat", json.jstr("_"))
        }
        Node.PatLit{v} => {
            json.jadd(o, "patlit", to_json(v))
        }
        Node.PatBind{name} => {
            json.jadd(o, "patbind", json.jstr(name))
        }
        Node.Assign{target, val} => {
            json.jadd(o, "assign", to_json(target))
            json.jadd(o, "val", to_json(val))
        }
        Node.Index{obj, idx} => {
            json.jadd(o, "index", to_json(obj))
            json.jadd(o, "idx", to_json(idx))
        }
        Node.Slice{obj, lo, hi} => {
            json.jadd(o, "slice", to_json(obj))
            if lo != nil {
                json.jadd(o, "lo", to_json(lo))
            }
            if hi != nil {
                json.jadd(o, "hi", to_json(hi))
            }
        }
        Node.Defer{call} => {
            json.jadd(o, "defer", to_json(call))
        }
        Node.Unsafe{body} => {
            json.jadd(o, "unsafe", to_json(body))
        }
        Node.Select{arms} => {
            json.jadd(o, "select", jl_items(arms))
        }
        Node.SArm{kind, ch, bind, ms, body} => {
            json.jadd(o, "sarm", json.jstr(kind))
            if ch != nil {
                json.jadd(o, "chan", to_json(ch))
            }
            if len(bind) > 0 {
                json.jadd(o, "bind", json.jstr(bind))
            }
            if ms != nil {
                json.jadd(o, "ms", to_json(ms))
            }
            json.jadd(o, "body", to_json(body))
        }
        Node.Closure{params, body} => {
            json.jadd(o, "closure", jl_items(params))
            json.jadd(o, "body", to_json(body))
        }
    }
    return o
}

// ---------- cursor ----------
fn peek(c: mut PCur) -> str {
    if c.t == nil {
        return ""
    }
    return c.t.text
}

fn pkind(c: mut PCur) -> int {
    if c.t == nil {
        return 0
    }
    return c.t.kind
}

// byte offset of the current token — a node's `lo` is captured here
// before its first token is consumed
fn coff(c: mut PCur) -> int {
    if c.t == nil {
        return 0
    }
    return c.t.off
}

// a name node's byte span — node `lo`/`hi` accessors used when a
// node's own span is needed after the cursor has moved on
fn nlo(n: ref Node) -> int {
    i := match n {
        Node.Name{lo} => lo
        Node.Ty{lo} => lo
        Node.Param{lo} => lo
        Node.FieldDef{lo} => lo
        Node.Lit{lo} => lo
        Node.Field{lo} => lo
        Node.Let{lo} => lo
        Node.Let2{lo} => lo
        Node.Bind{lo} => lo
        Node.Fn{lo} => lo
        Node.Struct{lo} => lo
        Node.Interface{lo} => lo
        Node.Method{lo} => lo
        Node.Enum{lo} => lo
        Node.Variant{lo} => lo
        Node.MArm{lo} => lo
        Node.Select{lo} => lo
        _ => -1
    }
    return i
}

fn nhi(n: ref Node) -> int {
    i := match n {
        Node.Name{hi} => hi
        Node.Ty{hi} => hi
        Node.Param{hi} => hi
        Node.FieldDef{hi} => hi
        Node.Lit{hi} => hi
        Node.Field{hi} => hi
        Node.Let{hi} => hi
        Node.Let2{hi} => hi
        Node.Bind{hi} => hi
        Node.Fn{hi} => hi
        Node.Struct{hi} => hi
        Node.Interface{hi} => hi
        Node.Method{hi} => hi
        Node.Enum{hi} => hi
        Node.Variant{hi} => hi
        Node.MArm{hi} => hi
        Node.Select{hi} => hi
        _ => -1
    }
    return i
}

// consume one token as a Name node — shared by import-name lists and
// pattern binds
fn p_name(c: mut PCur) -> own Node {
    m := coff(c)
    nm := peek(c)
    next(c)
    return b(Node.Name{n: nm, lo: m, hi: c.phi})
}

fn next(c: mut PCur) {
    if c.t != nil {
        c.pln = c.t.ln
        c.plo = c.t.off
        c.phi = c.t.eoff
        c.t = c.t.next
        // lexical errors arrive as err tokens (kind 7) — report once and
        // truncate the stream: parsing a truncated tail as real tokens
        // silently mis-shapes the AST (kind-agnostic token reads)
        if c.t != nil && c.t.kind == lexlib.k_err() {
            if c.lex_err == 0 && c.hush == 0 {
                println("lex: " + c.t.text + " (line " + itoa(c.t.ln) + ")")
            }
            c.lex_err = 1
            c.t = nil
        }
    }
}

fn at(c: mut PCur, w: str) -> bool {
    if len(w) == 0 {
        return false
    } // "" is a real string token, not EOF
    // str/int literal texts must never match punct/keyword checks —
    // a ")" literal is a string, not a close paren
    if pkind(c) == 3 || pkind(c) == 4 {
        return false
    }
    return peek(c) == w
}

fn eof(c: mut PCur) -> bool {
    return pkind(c) == 0
}

fn eat(c: mut PCur, w: str) -> bool {
    if at(c, w) {
        next(c)
        return true
    }
    return false
}

// ---------- expressions ----------
fn p_primary(c: mut PCur) -> own Node {
    if at(c, "match") {
        return p_match(c)
    }
    if at(c, "{") {
        return p_closure(c)
    }
    // `fn(T, ...) -> R` type literal — only meaningful as mkslice's elem ty
    if at(c, "fn") && c.t.next != nil && c.t.next.text == "(" {
        return p_ty(c)
    }
    k := pkind(c)
    if k == 3 {
        e := b(Node.JInt(atoi(peek(c))))
        next(c)
        return e
    }
    if k == 6 {
        e := b(Node.JFloat(peek(c)))
        next(c)
        return e
    }
    if k == 4 {
        e := b(Node.JStr(peek(c)))
        next(c)
        return e
    }
    if eat(c, "(") {
        e := p_expr(c)
        eat(c, ")")
        return e
    }
    // ident / keyword literals
    nm := peek(c)
    m := coff(c)
    next(c)
    e := b(Node.Name{n: nm, lo: m, hi: c.phi})
    // struct literal: Name { f: v, ... } — suppressed in cond position
    if at(c, "{") && c.nolit == 0 {
        next(c)
        let fields: own NList = nil
        for !at(c, "}") && !eof(c) {
            fname := peek(c)
            next(c)
            eat(c, ":")
            fields = ncons(b(Node.NamedField{name: fname, val: p_expr(c)}), fields)
            eat(c, ",")
        }
        eat(c, "}")
        return b(Node.Lit{obj: e, fields: nrev(fields), lo: m, hi: c.phi})
    }
    return e
}

// match e { pat => body, ... } — `=>` lexes as `=` `>` in the bootstrap lexer
fn p_match(c: mut PCur) -> own Node {
    next(c)
    c.nolit = 1
    e := p_expr(c)
    c.nolit = 0
    eat(c, "{")
    let arms: own NList = nil
    for !at(c, "}") && !eof(c) {
        am := coff(c)
        pat := p_pat(c)
        eat(c, "=")
        eat(c, ">")
        let body: own Node = nil
        if at(c, "{") {
            body = p_block(c)
        } else {
            body = p_expr(c)
        }
        arms = ncons(b(Node.MArm{pat: pat, body: body, lo: am, hi: c.phi}), arms)
        eat(c, ",")
    }
    eat(c, "}")
    return b(Node.Match{e: e, arms: nrev(arms)})
}

// select { [v :=] recv(ch) => {...} | timeout(ms) => {...} | else => {...} }
fn p_select(c: mut PCur) -> own Node {
    m := coff(c)
    next(c)
    eat(c, "{")
    let arms: own NList = nil
    for !at(c, "}") && !eof(c) {
        if eat(c, "else") {
            bdy := p_arm_body(c)
            arms = ncons(b(Node.SArm{kind: "else", ch: nil, bind: "", ms: nil, body: bdy}), arms)
            eat(c, ",")
            continue
        }
        // optional `v :=` recv bind
        bind := ""
        if pkind(c) == 1 {
            save := c.t
            splo := c.plo
            sphi := c.phi
            spln := c.pln
            nm := peek(c)
            next(c)
            if eat(c, ":=") {
                bind = nm
            } else {
                c.t = save
                c.plo = splo
                c.phi = sphi
                c.pln = spln
            }
        }
        e := p_expr(c)
        kind := ""
        let ch: own Node = nil
        let ms: own Node = nil
        match e {
            Node.Call{f, args} => {
                head := match f {
                    Node.Name{n} => n
                    _ => ""
                }
                if head == "recv" {
                    kind = "recv"
                    if args != nil {
                        ch = args.v
                    }
                }
                if head == "timeout" {
                    kind = "timeout"
                    if args != nil {
                        ms = args.v
                    }
                }
                if head == "send" {
                    kind = "send"
                }
            }
            _ => {
            }
        }
        bdy := p_arm_body(c)
        arms = ncons(b(Node.SArm{kind: kind, ch: ch, bind: bind, ms: ms, body: bdy}), arms)
        eat(c, ",")
    }
    eat(c, "}")
    return b(Node.Select{arms: nrev(arms), lo: m, hi: c.phi})
}

// arm body: `{...}` block or a single stmt (wrapped in a List, like the seed)
fn p_arm_body(c: mut PCur) -> own Node {
    if !eat(c, "=") {
        return b(Node.List{items: nil})
    }
    eat(c, ">")
    if at(c, "{") {
        return p_block(c)
    }
    return b(Node.List{items: ncons(p_stmt(c), nil)})
}

// `{ |a: int, b: int| stmts }` — closure (B4); ret inferred from `return`s
fn p_closure(c: mut PCur) -> own Node {
    next(c) // {
    empty := eat(c, "||")
    if !empty {
        eat(c, "|")
    }
    let ps: own NList = nil
    for !empty && !at(c, "|") && !eof(c) {
        pm := coff(c)
        nm := peek(c)
        next(c)
        eat(c, ":")
        ps = ncons(b(Node.Param{name: nm, ty: p_ty(c), lo: pm, hi: c.phi}), ps)
        if !eat(c, ",") {
            break
        }
    }
    if !empty {
        eat(c, "|")
    }
    let items: own NList = nil
    for !at(c, "}") && !eof(c) {
        items = ncons(p_stmt(c), items)
        eat(c, ";")
    }
    eat(c, "}")
    return b(Node.Closure{params: nrev(ps), body: b(Node.List{items: nrev(items)})})
}

fn p_pat(c: mut PCur) -> own Node {
    if eat(c, "_") {
        return b(Node.PatWild)
    }
    k := pkind(c)
    if k == 3 || k == 4 {
        return b(Node.PatLit{v: p_primary(c)})
    }
    // true/false/nil literal patterns
    if peek(c) == "true" || peek(c) == "false" || peek(c) == "nil" {
        nm := peek(c)
        nmoff := coff(c)
        next(c)
        return b(Node.PatLit{v: b(Node.Name{n: nm, lo: nmoff, hi: c.phi})})
    }
    path := peek(c)
    next(c)
    for at(c, ".") {
        next(c)
        path = path + "." + peek(c)
        next(c)
    }
    if at(c, "(") || at(c, "{") {
        open := peek(c)
        close := ")"
        if open == "{" {
            close = "}"
        }
        next(c)
        let binds: own NList = nil
        for !at(c, close) && !eof(c) {
            binds = ncons(p_name(c), binds)
            eat(c, ",")
        }
        eat(c, close)
        return b(Node.Pat{path: path, binds: nrev(binds)})
    }
    // bare ident (no dots, no payload) binds the scrutinee value
    ld := find(path, ".")
    if ld < 0 {
        return b(Node.PatBind{name: path})
    }
    return b(Node.Pat{path: path, binds: nil})
}

fn p_postfix(c: mut PCur) -> own Node {
    e := p_primary(c)
    for true {
        if at(c, "(") {
            next(c)
            let args: own NList = nil
            for !at(c, ")") && !eof(c) {
                args = ncons(p_expr(c), args)
                eat(c, ",")
            }
            eat(c, ")")
            e = b(Node.Call{f: e, args: nrev(args)})
            continue
        }
        if at(c, ".") {
            next(c)
            fname := peek(c)
            next(c)
            elo := nlo(e)
            e = b(Node.Field{obj: e, name: fname, lo: elo, hi: c.phi})
            continue
        }
        // `E.V{...}`/`a.b{...}` — lit on a postfix expr (bare `Name{...}`
        // is handled in p_primary)
        if at(c, "{") && c.nolit == 0 {
            elo := nlo(e)
            next(c)
            let fields: own NList = nil
            for !at(c, "}") && !eof(c) {
                fname := peek(c)
                next(c)
                eat(c, ":")
                fields = ncons(b(Node.NamedField{name: fname, val: p_expr(c)}), fields)
                eat(c, ",")
            }
            eat(c, "}")
            e = b(Node.Lit{obj: e, fields: nrev(fields), lo: elo, hi: c.phi})
            continue
        }
        // `e[i]` / `e[a:b]` — only when `[` sits on the same line as e's
        // last token, else `[v, err] = f()` on the next line misattaches
        if at(c, "[") && c.t != nil && c.t.ln == c.pln {
            next(c)
            let lo: own Node = nil
            if !at(c, ":") && !at(c, "]") {
                lo = p_expr(c)
            }
            if eat(c, ":") {
                let hi: own Node = nil
                if !at(c, "]") {
                    hi = p_expr(c)
                }
                eat(c, "]")
                e = b(Node.Slice{obj: e, lo: lo, hi: hi})
                continue
            }
            eat(c, "]")
            e = b(Node.Index{obj: e, idx: lo})
            continue
        }
        // `e as T` — enum payload extraction / type assertion
        if at(c, "as") {
            next(c)
            e = b(Node.As{e: e, ty: p_ty(c)})
            continue
        }
        break
    }
    return e
}

fn p_unary(c: mut PCur) -> own Node {
    if at(c, "!") || at(c, "-") {
        op := peek(c)
        next(c)
        return b(Node.Un{op: op, e: p_unary(c)})
    }
    return p_postfix(c)
}

fn p_mul(c: mut PCur) -> own Node {
    l := p_unary(c)
    for at(c, "*") || at(c, "/") || at(c, "%") {
        op := peek(c)
        next(c)
        l = b(Node.Bin{op: op, l: l, r: p_unary(c)})
    }
    return l
}

fn p_add(c: mut PCur) -> own Node {
    l := p_mul(c)
    for at(c, "+") || at(c, "-") {
        op := peek(c)
        next(c)
        l = b(Node.Bin{op: op, l: l, r: p_mul(c)})
    }
    return l
}

fn p_cmp(c: mut PCur) -> own Node {
    l := p_add(c)
    for at(c, "==") || at(c, "!=") || at(c, "<") || at(c, ">") || at(c, "<=") || at(c, ">=") {
        op := peek(c)
        next(c)
        l = b(Node.Bin{op: op, l: l, r: p_add(c)})
    }
    return l
}

fn p_bitand(c: mut PCur) -> own Node {
    l := p_cmp(c)
    for at(c, "&") {
        next(c)
        l = b(Node.Bin{op: "&", l: l, r: p_cmp(c)})
    }
    return l
}

fn p_bitxor(c: mut PCur) -> own Node {
    l := p_bitand(c)
    for at(c, "^") {
        next(c)
        l = b(Node.Bin{op: "^", l: l, r: p_bitand(c)})
    }
    return l
}

fn p_bitor(c: mut PCur) -> own Node {
    l := p_bitxor(c)
    for at(c, "|") {
        next(c)
        l = b(Node.Bin{op: "|", l: l, r: p_bitxor(c)})
    }
    return l
}

fn p_and(c: mut PCur) -> own Node {
    l := p_bitor(c)
    for at(c, "&&") {
        next(c)
        l = b(Node.Bin{op: "&&", l: l, r: p_bitor(c)})
    }
    return l
}

fn p_expr(c: mut PCur) -> own Node {
    l := p_and(c)
    for at(c, "||") {
        next(c)
        l = b(Node.Bin{op: "||", l: l, r: p_and(c)})
    }
    return l
}

// ---------- statements ----------
fn p_stmt(c: mut PCur) -> own Node {
    m := coff(c)
    if eat(c, "let") {
        name := peek(c)
        next(c)
        let ty: own Node = nil
        if eat(c, ":") {
            ty = p_ty(c)
        }
        let init: own Node = nil
        if eat(c, "=") {
            init = p_expr(c)
        }
        return b(Node.Let{name: name, ty: ty, init: init, lo: m, hi: c.phi})
    }
    if eat(c, "return") {
        let vals: own NList = nil
        for !at(c, "}") && !eof(c) {
            vals = ncons(p_expr(c), vals)
            if !eat(c, ",") {
                break
            }
        }
        return b(Node.Ret{vals: nrev(vals)})
    }
    if eat(c, "break") {
        return b(Node.Break)
    }
    if eat(c, "continue") {
        return b(Node.Continue)
    }
    if at(c, "if") {
        return p_if(c)
    }
    if at(c, "for") {
        return p_for(c)
    }
    if eat(c, "scope") {
        return b(Node.Scope{body: p_block(c)})
    }
    if eat(c, "spawn") {
        return b(Node.Spawn{e: p_expr(c)})
    }
    if eat(c, "spawnBlocking") {
        return b(Node.SpawnBlocking{e: p_expr(c)})
    }
    if eat(c, "go") {
        return b(Node.Go{e: p_expr(c)})
    }
    if at(c, "defer") {
        next(c)
        return b(Node.Defer{call: p_expr(c)})
    }
    if eat(c, "unsafe") {
        return b(Node.Unsafe{body: p_block(c)})
    }
    if at(c, "select") {
        return p_select(c)
    }
    // [a, b] = call
    if at(c, "[") {
        next(c)
        n1 := peek(c)
        next(c)
        eat(c, ",")
        n2 := peek(c)
        next(c)
        eat(c, "]")
        let call: own Node = nil
        if eat(c, "=") {
            call = p_expr(c)
        }
        return b(Node.Let2{names: n1 + "," + n2, call: call, lo: m, hi: c.phi})
    }
    // ident := expr | target = expr | call/field stmt
    name := peek(c)
    e := p_postfix(c)
    if eat(c, ":=") {
        return b(Node.Bind{name: name, init: p_expr(c), lo: m, hi: c.phi})
    }
    if eat(c, "=") {
        return b(Node.Assign{target: e, val: p_expr(c)})
    }
    return b(Node.ExprStmt{e: e})
}

fn p_if(c: mut PCur) -> own Node {
    eat(c, "if")
    c.nolit = 1
    cond := p_expr(c)
    c.nolit = 0
    then := p_block(c)
    let els: own Node = nil
    if eat(c, "else") {
        if at(c, "if") {
            els = p_if(c)
        } else {
            els = p_block(c)
        }
    }
    return b(Node.If{cond: cond, then: then, els: els})
}

fn p_for(c: mut PCur) -> own Node {
    eat(c, "for")
    c.nolit = 1
    cond := p_expr(c)
    c.nolit = 0
    return b(Node.For{cond: cond, body: p_block(c)})
}

fn p_block(c: mut PCur) -> own Node {
    let items: own NList = nil
    if eat(c, "{") {
        for !at(c, "}") && !eof(c) {
            items = ncons(p_stmt(c), items)
            eat(c, ";")
        }
        eat(c, "}")
    }
    return b(Node.List{items: nrev(items)})
}

// ---------- types + items ----------
fn p_dotted(c: mut PCur) -> str {
    n := peek(c)
    next(c)
    for at(c, ".") {
        next(c)
        n = n + "." + peek(c)
        next(c)
    }
    return n
}

fn p_ty(c: mut PCur) -> own Node {
    m := coff(c)
    txt := peek(c)
    // []T — the inner Ty node carries its own text
    if at(c, "[") {
        next(c)
        eat(c, "]")
        inner := p_ty(c) as Node.Ty
        return b(Node.Ty{f0: "[]" + inner.f0, lo: m, hi: c.phi})
    }
    // fn(a, b) -> r — kept as a canonical string for the checker
    if at(c, "fn") {
        next(c)
        eat(c, "(")
        s := "fn("
        first := true
        for !at(c, ")") && !eof(c) {
            if !first {
                s = s + ", "
            }
            first = false
            // optional param name — `fn(a: int)` documents like the seed's
            // parser does; the name is not part of the type
            if pkind(c) == lexlib.k_ident() && c.t.next != nil && c.t.next.text == ":" {
                next(c)
                next(c)
            }
            pt := p_ty(c) as Node.Ty
            s = s + pt.f0
            if !eat(c, ",") {
                break
            }
        }
        eat(c, ")")
        s = s + ")"
        if eat(c, "->") {
            rt := p_ty(c) as Node.Ty
            s = s + " -> " + rt.f0
        }
        return b(Node.Ty{f0: s, lo: m, hi: c.phi})
    }
    // own/ref/mut [own/ref/mut] dotted.name
    if txt == "own" || txt == "ref" || txt == "mut" {
        next(c)
        // bare `own`/`ref`/`mut` = pointer to void (seed parity: inner is
        // parsed only when the next token starts a type)
        inner := "void"
        if pkind(c) == 1 || at(c, "[") || at(c, "own") || at(c, "ref") || at(c, "mut") || at(c, "chan") {
            it := p_ty(c) as Node.Ty
            inner = it.f0
        }
        return b(Node.Ty{f0: txt + " " + inner, lo: m, hi: c.phi})
    }
    return b(Node.Ty{f0: p_dotted(c), lo: m, hi: c.phi})
}

fn p_params(c: mut PCur) -> own NList {
    let items: own NList = nil
    eat(c, "(")
    for !at(c, ")") && !eof(c) {
        pm := coff(c)
        name := peek(c)
        next(c)
        let ty: own Node = nil
        if eat(c, ":") {
            ty = p_ty(c)
        }
        items = ncons(b(Node.Param{name: name, ty: ty, lo: pm, hi: c.phi}), items)
        eat(c, ",")
    }
    eat(c, ")")
    return nrev(items)
}

// `-> t` / `-> [t, err]` / `-> []T` / nothing — shared by fns and
// interface method sigs
fn p_ret(c: mut PCur) -> own Node {
    let ret: own Node = nil
    rm := coff(c)
    if eat(c, "->") {
        if eat(c, "[") { // multi-return [v, err] — or `[]T` slice ret
            if eat(c, "]") {
                inner := p_ty(c) as Node.Ty
                ret = b(Node.Ty{f0: "[]" + inner.f0, lo: rm, hi: c.phi})
            } else {
                let tys: own NList = nil
                for !at(c, "]") && !eof(c) {
                    tys = ncons(p_ty(c), tys)
                    eat(c, ",")
                }
                eat(c, "]")
                ret = b(Node.List{items: nrev(tys)})
            }
        } else {
            ret = p_ty(c)
        }
    }
    return ret
}

// m0 marks the item's leading keyword (`fn` or `extern`) — the Fn
// node's span starts there; -1 falls back to the current token
fn p_fn(c: mut PCur, ex: bool, m0: int) -> own Node {
    m := m0
    if m < 0 {
        m = coff(c)
    }
    eat(c, "fn")
    // method receiver: `fn (r T) m(..)` — `fn (r: T)` also accepted
    let recv: own Node = nil
    if at(c, "(") {
        next(c)
        rm := coff(c)
        rname := peek(c)
        next(c)
        eat(c, ":")
        rty := p_ty(c)
        eat(c, ")")
        recv = b(Node.Param{name: rname, ty: rty, lo: rm, hi: c.phi})
    }
    name := peek(c)
    next(c)
    // generic params `[T any, U ordered]` — constraint defaults to `any`
    let typs: own NList = nil
    if eat(c, "[") {
        for !at(c, "]") && !eof(c) {
            tn := peek(c)
            next(c)
            ct := "any"
            if pkind(c) == 1 {
                ct = peek(c)
                next(c)
                // `pkg.Constraint` — dotted decl path (seed: same loop)
                for at(c, ".") {
                    next(c)
                    ct = ct + "." + peek(c)
                    next(c)
                }
            }
            typs = ncons(b(Node.TyParam{name: tn, constraint: ct}), typs)
            eat(c, ",")
        }
        eat(c, "]")
    }
    params := p_params(c)
    ret := p_ret(c)
    let body: own Node = nil
    if at(c, "{") {
        body = p_block(c)
    }
    return b(Node.Fn{ex: ex, name: name, recv: recv, typarams: typs, params: params, ret: ret, body: body, lo: m, hi: c.phi})
}

// enum variant: `V`, `V(t, ..)`, `V { n: t, .. }`
fn p_variant(c: mut PCur) -> own Node {
    m := coff(c)
    name := peek(c)
    next(c)
    let args: own NList = nil
    if eat(c, "(") {
        for !at(c, ")") && !eof(c) {
            args = ncons(p_ty(c), args)
            eat(c, ",")
        }
        eat(c, ")")
    }
    if eat(c, "{") {
        for !at(c, "}") && !eof(c) {
            pm := coff(c)
            fname := peek(c)
            next(c)
            let ty: own Node = nil
            if eat(c, ":") {
                ty = p_ty(c)
            }
            args = ncons(b(Node.Param{name: fname, ty: ty, lo: pm, hi: c.phi}), args)
            eat(c, ",")
        }
        eat(c, "}")
    }
    return b(Node.Variant{name: name, args: nrev(args), lo: m, hi: c.phi})
}

fn p_item(c: mut PCur) -> own Node {
    m := coff(c)
    if eat(c, "import") {
        path := peek(c)
        next(c)
        alias := ""
        if at(c, "as") {
            next(c)
            alias = peek(c)
            next(c)
        }
        let names: own NList = nil
        if eat(c, ".") && eat(c, "{") {
            for !at(c, "}") && !eof(c) {
                names = ncons(p_name(c), names)
                eat(c, ",")
            }
            eat(c, "}")
        }
        eat(c, ";")
        return b(Node.Import{path: path, alias: alias, names: names})
    }
    // interface Name { eq, ordered, m(p: t) -> t, .. } — bare idents are
    // operator constraints, `m(..) -> t` are method sigs
    if eat(c, "interface") {
        name := peek(c)
        next(c)
        eat(c, "{")
        let ops: own NList = nil
        let methods: own NList = nil
        for !at(c, "}") && !eof(c) {
            mm := coff(c)
            mname := peek(c)
            next(c)
            if at(c, "(") {
                mparams := p_params(c)
                mret := p_ret(c)
                methods = ncons(b(Node.Method{name: mname, params: mparams, ret: mret, lo: mm, hi: c.phi}), methods)
            } else {
                ops = ncons(b(Node.Name{n: mname, lo: mm, hi: c.phi}), ops)
            }
            eat(c, ",")
            eat(c, ";")
        }
        eat(c, "}")
        return b(Node.Interface{name: name, ops: nrev(ops), methods: nrev(methods), lo: m, hi: c.phi})
    }
    if eat(c, "struct") {
        name := peek(c)
        next(c)
        let fields: own NList = nil
        if eat(c, "{") {
            for !at(c, "}") && !eof(c) {
                fm := coff(c)
                fname := peek(c)
                next(c)
                let ty: own Node = nil
                if eat(c, ":") {
                    ty = p_ty(c)
                }
                fields = ncons(b(Node.FieldDef{name: fname, ty: ty, lo: fm, hi: c.phi}), fields)
                eat(c, ",")
            }
            eat(c, "}")
        }
        return b(Node.Struct{name: name, fields: nrev(fields), lo: m, hi: c.phi})
    }
    if eat(c, "enum") {
        name := peek(c)
        next(c)
        let vars: own NList = nil
        if eat(c, "{") {
            for !at(c, "}") && !eof(c) {
                vars = ncons(p_variant(c), vars)
                eat(c, ",")
            }
            eat(c, "}")
        }
        return b(Node.Enum{name: name, vars: nrev(vars), lo: m, hi: c.phi})
    }
    if eat(c, "extern") {
        f := p_fn(c, true, m)
        eat(c, ";")
        return f
    }
    if at(c, "fn") {
        return p_fn(c, false, m)
    }
    if at(c, "let") {
        return p_stmt(c)
    }
    // unknown item — skip the token so we always progress
    text := peek(c)
    next(c)
    return b(Node.Skip{text: text})
}

fn parse(toks: own lexlib.Tok) -> own Node {
    return parse2(toks, 0)
}

// parse with the error printlns silenced — the LSP feeds unsaved
// buffers through here and must keep stdout protocol-clean
fn parse2(toks: own lexlib.Tok, hush: int) -> own Node {
    c := new(PCur)
    c.t = toks
    c.nolit = 0
    c.pln = 0
    c.plo = 0
    c.phi = 0
    c.lex_err = 0
    c.hush = hush
    // an err token in FIRST position is never reached by next()'s check
    // (that fires on c.t.next) — a file starting with a lex error would
    // silently parse as a Skip node and exit 0
    if c.t != nil && c.t.kind == lexlib.k_err() {
        if c.hush == 0 {
            println("lex: " + c.t.text + " (line " + itoa(c.t.ln) + ")")
        }
        return nil
    }
    // the package clause is the mandatory first item of every file —
    // the seed parser emits `expected package clause` when it's absent
    if !eat(c, "package") {
        if c.hush == 0 {
            println("parse: expected package clause")
        }
        return nil
    }
    let items: own NList = ncons(b(Node.Package{name: peek(c)}), nil)
    next(c)
    eat(c, ";")
    for pkind(c) != 0 {
        items = ncons(p_item(c), items)
    }
    if c.lex_err != 0 {
        return nil
    }
    return b(Node.Root{items: nrev(items)})
}
