package main

// gui-todo — todo list through extra/gui + the GTK4 backend
// (milestone G2, re-expressing the F1 pilot).
//
// All GTK access stays on the root task inside gui.run's pump; the
// app only talks to the gui layer: mutators post Cmds, reads take a
// reply chan, events arrive on `chan own gui.Event`.
//
// Build: ./build.sh   (needs pkg-config gtk4)
// Run:   ./todo            interactive (needs a display)
//        ./todo --selftest emits real GTK signals on the GUI thread,
//             asserts through the read path, then stops the backend
import "github.com/oxidean/oxl/extra/gui"

import "github.com/oxidean/oxl/extra/gui/gtk"

import "std/errors"

import "std/time"

import "std/sync"

// selftest hooks — real GTK signals deferred onto the GUI thread
extern fn gx_emit(h: int, sig: cstr)

extern fn gx_emit_row(list: int, idx: int)

// row registry: a row's x button handle -> its container hbox handle,
// so a clicked event can name the subtree gui.remove destroys
struct RN { del: int, box: int, next: own RN }

let g_rows: own RN = nil

let g_rows_mu: shared = sync.mutex()

fn row_put(del: int, box: int) {
    r := new(RN)
    r.del = del
    r.box = box
    sync.mlock(g_rows_mu)
    r.next = g_rows
    g_rows = r
    sync.munlock(g_rows_mu)
}

fn row_take(del: int) -> int {
    let out: own RN = nil
    found := 0
    sync.mlock(g_rows_mu)
    l := g_rows
    g_rows = nil
    for l != nil {
        n := l.next
        if l.del == del {
            found = l.box
            l.next = nil
        } else {
            l.next = out
            out = l
        }
        l = n
    }
    g_rows = out
    sync.munlock(g_rows_mu)
    return found
}

// add one row: [label] [x] — returned del-button handle keys the row
fn add_row(lb: gui.List, text: str) -> int {
    [row, e1] = gui.hbox()
    [lab, e2] = gui.label(text)
    [del, e3] = gui.button("x")
    if e1 != nil || e2 != nil || e3 != nil {
        println("row create failed")
        return 0
    }
    gui.append(row, lab)
    gui.append(row, del)
    gui.append(lb, row)
    row_put(del.handle(), row.handle())
    return del.handle()
}

// shared ui handles the selftest driver polls
let g_lb: gui.List = gui.List{h: 0}

let g_en: gui.Entry = gui.Entry{h: 0}

let g_add: gui.Button = gui.Button{h: 0}

let g_selftest = 0

let g_hb = sync.counter()

let g_rm = sync.counter()

fn wait_rows(want: int) -> int {
    i := 0
    for i < 4000 {
        [n, e] = g_lb.rows()
        if e == nil && n == want {
            return 1
        }
        time.sleep_ms(5)
        i = i + 1
    }
    println("selftest: rows never reached hb=" + itoa(sync.cval(g_hb)) + " rm=" + itoa(sync.cval(g_rm)) + " dropped=" + itoa(gui.events_dropped()))
    return 0
}

// drive the real signal path: emit on the GUI thread, assert through
// the read path, then stop the backend
fn selftest_drive() {
    g_en.set_text("one")
    gx_emit(g_add.handle(), "clicked")
    if wait_rows(1) == 0 {
        gui.stop()
        return
    }
    g_en.set_text("two")
    gx_emit(g_add.handle(), "clicked")
    if wait_rows(2) == 0 {
        gui.stop()
        return
    }
    d := add_row(g_lb, "doomed")
    if wait_rows(3) == 0 {
        gui.stop()
        return
    }
    gx_emit(d, "clicked")
    if wait_rows(2) == 0 {
        gui.stop()
        return
    }
    churn := 200
    if argc() > 2 {
        churn = atoi(argv(2))
    }
    i := 0
    for i < churn {
        dd := add_row(g_lb, "churn")
        gx_emit(dd, "clicked")
        i = i + 1
    }
    if wait_rows(2) == 0 {
        gui.stop()
        return
    }
    println("selftest rows=2 churn=" + itoa(churn) + " ok")
    gui.stop()
}

fn app(events: chan own gui.Event) {
    spawn ui(events)
}

fn ui(events: chan own gui.Event) {
    [w, e1] = gui.window("oxl todo")
    [root, e2] = gui.vbox()
    [en, e3] = gui.entry("")
    [add, e4] = gui.button("add")
    [lb, e5] = gui.list()
    [sc, e6] = gui.scrolled()
    if e1 != nil || e2 != nil || e3 != nil || e4 != nil || e5 != nil || e6 != nil {
        println("ui create failed")
        gui.stop()
        return
    }
    g_lb = lb
    g_en = en
    g_add = add
    gui.append(sc, lb)
    gui.append(root, en)
    gui.append(root, add)
    gui.append(root, sc)
    gui.append(w, root)
    if g_selftest == 1 {
        spawn selftest_drive()
    }
    for 1 == 1 {
        ev := recv(events)
        if ev == nil {
            break
        }
        sync.cinc(g_hb)
        if ev.kind == gui.EventKind.clicked {
            if ev.target == add.handle() {
                [t, e] = en.text()
                if e == nil && len(t) > 0 {
                    add_row(lb, t)
                    en.set_text("")
                }
            } else {
                rh := row_take(ev.target)
                if rh != 0 {
                    sync.cinc(g_rm)
                    gui.remove(gui.HBox{h: rh})
                }
            }
        }
        if ev.kind == gui.EventKind.activated && ev.target == en.handle() {
            [t, e] = en.text()
            if e == nil && len(t) > 0 {
                add_row(lb, t)
                en.set_text("")
            }
        }
        if ev.kind == gui.EventKind.close_requested && ev.target == w.handle() {
            gui.stop()
        }
    }
}

fn main() {
    if argc() > 1 && argv(1) == "--selftest" {
        g_selftest = 1
    }
    e := gui.run(gtk.backend(), app)
    if e != nil {
        println("run: " + errors.msg(e))
        exit(1)
    }
    println("gui done")
}
