package lexlib

// bootstrap/lexlib.oxl — the lexer as a library (no main).
// Shared by bootstrap/lexer.oxl (token dump) and
// bootstrap/parser.oxl (AST → JSON). See docs/self-hosting.md.

// token kinds (ints — the compact encoding the emit table indexes)
fn k_ident() -> int {
    return 1
}

fn k_kw() -> int {
    return 2
}

fn k_int() -> int {
    return 3
}

fn k_str() -> int {
    return 4
}

fn k_punct() -> int {
    return 5
}

fn k_float() -> int {
    return 6
}

fn k_eof() -> int {
    return 0
}

fn k_err() -> int {
    return 7
}

// off/eoff are the token's byte span in src — [off, eoff). The LSP's
// position index needs byte offsets; text alone can't supply them
// (char literals decode, strings drop their quotes).
struct Tok { kind: int, text: str, ln: int, off: int, eoff: int, next: own Tok }

fn is_alpha(c: int) -> bool {
    return c >= 97 && c <= 122 || c >= 65 && c <= 90 || c == 95
}

fn is_digit(c: int) -> bool {
    return c >= 48 && c <= 57
}

fn is_space(c: int) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13
}

fn is_kw(w: str) -> bool {
    return w == "fn" || w == "struct" || w == "extern" || w == "return" || w == "if" || w == "else" || w == "for" || w == "let" || w == "scope" || w == "spawn" || w == "go" || w == "own" || w == "ref" || w == "mut" || w == "unsafe" || w == "nil" || w == "true" || w == "false" || w == "import" || w == "package" || w == "chan" || w == "break" || w == "continue" || w == "interface" || w == "spawnBlocking" || w == "goin"
}

fn push(tail: own Tok, kind: int, text: str, ln: int, off: int, eoff: int) -> own Tok {
    tail.next = new(Tok)
    tail = tail.next
    tail.kind = kind
    tail.text = text
    tail.ln = ln
    tail.off = off
    tail.eoff = eoff
    tail.next = nil
    return tail
}

fn lex(src: str) -> own Tok {
    head := new(Tok)
    head.kind = 0
    head.text = ""
    head.ln = 0
    head.off = 0
    head.eoff = 0
    head.next = nil
    tail := head
    i := 0
    ln := 1
    for i < len(src) {
        c := byteat(src, i)
        if is_space(c) {
            if c == 10 {
                ln = ln + 1
            }
            i = i + 1
            continue
        }
        if c == 47 && byteat(src, i + 1) == 47 { // // comment
            for i < len(src) && byteat(src, i) != 10 {
                i = i + 1
            }
            continue
        }
        if c == 47 && byteat(src, i + 1) == 42 { // /* ... */ comment
            i = i + 2
            for i + 1 < len(src) && !(byteat(src, i) == 42 && byteat(src, i + 1) == 47) {
                if byteat(src, i) == 10 {
                    ln = ln + 1
                }
                i = i + 1
            }
            // unterminated comments end the scan without walking past
            // the source — same clamp as the seed lexer — but surface
            // as an err token so the parser/checker fail instead of
            // silently parsing a truncated stream
            if i + 1 >= len(src) {
                tail = push(tail, k_err(), "unterminated block comment", ln, i, len(src))
                i = len(src)
            } else {
                i = i + 2
            }
            continue
        }
        if is_alpha(c) {
            a := i
            for i < len(src) && (is_alpha(byteat(src, i)) || is_digit(byteat(src, i))) {
                i = i + 1
            }
            w := substr(src, a, i)
            k := k_ident()
            if is_kw(w) {
                k = k_kw()
            }
            tail = push(tail, k, w, ln, a, i)
            continue
        }
        if is_digit(c) {
            a := i
            for i < len(src) && is_digit(byteat(src, i)) {
                i = i + 1
            }
            // float: <digits>.<digits> — `.` must be followed by a digit
            // so field/index access like `x.0`/`a.b` stays punct
            if byteat(src, i) == 46 && is_digit(byteat(src, i + 1)) {
                i = i + 1
                for i < len(src) && is_digit(byteat(src, i)) {
                    i = i + 1
                }
                tail = push(tail, k_float(), substr(src, a, i), ln, a, i)
                continue
            }
            tail = push(tail, k_int(), substr(src, a, i), ln, a, i)
            continue
        }
        if c == 39 { // 'c' — char literal: sugar for its scalar value;
            // emits an int token so parsers/codegens see no new node.
            // One char exactly (after escape decoding); escapes mirror
            // strings. Multi-byte chars decode as their UTF-8 scalar.
            a := i
            i = i + 1
            v := 0
            count := 0
            closed := false
            for i < len(src) {
                cb := byteat(src, i)
                if cb == 39 {
                    i = i + 1
                    closed = true
                    break
                }
                if cb == 92 && i + 1 < len(src) {
                    x := byteat(src, i + 1)
                    if x == 110 {
                        v = 10
                        i = i + 2
                    }
                    if x == 116 {
                        v = 9
                        i = i + 2
                    }
                    if x == 114 {
                        v = 13
                        i = i + 2
                    }
                    if x == 48 {
                        v = 0
                        i = i + 2
                    }
                    if x != 110 && x != 116 && x != 114 && x != 48 {
                        v = utf8_val(src, i + 1)
                        i = i + 1 + utf8_len(byteat(src, i + 1))
                    }
                    count = count + 1
                    continue
                }
                v = utf8_val(src, i)
                i = i + utf8_len(cb)
                count = count + 1
            }
            if !closed {
                tail = push(tail, k_err(), "unterminated char literal", ln, a, i)
            }
            if closed && count != 1 {
                tail = push(tail, k_err(), "char literal must hold exactly one character", ln, a, i)
            }
            if closed && count == 1 {
                tail = push(tail, k_int(), itoa(v), ln, a, i)
            }
            continue
        }
        if c == 34 { // "..."
            a := i
            i = i + 1
            for i < len(src) && byteat(src, i) != 34 {
                if byteat(src, i) == 92 {
                    i = i + 1
                } // escape
                i = i + 1
            }
            if i >= len(src) {
                tail = push(tail, k_err(), "unterminated string", ln, a, i)
            } else {
                tail = push(tail, k_str(), substr(src, a + 1, i), ln, a, i + 1)
                i = i + 1
            }
            continue
        }
        // two-char punct first (:= == != <= >= && || ->)
        n := byteat(src, i + 1)
        if c == 58 && n == 61 || c == 61 && n == 61 || c == 33 && n == 61 || c == 60 && n == 61 || c == 62 && n == 61 || c == 38 && n == 38 || c == 124 && n == 124 || c == 45 && n == 62 {
            tail = push(tail, k_punct(), substr(src, i, i + 2), ln, i, i + 2)
            i = i + 2
            continue
        }
        // single-char punct
        tail = push(tail, k_punct(), substr(src, i, i + 1), ln, i, i + 1)
        i = i + 1
    }
    tail = push(tail, k_eof(), "", ln, len(src), len(src))
    return head.next
}

// bytes of the UTF-8 char starting at b0 — mirroring len_utf8()
fn utf8_len(b0: int) -> int {
    if b0 < 128 {
        return 1
    }
    if b0 < 224 {
        return 2
    }
    if b0 < 240 {
        return 3
    }
    return 4
}

// scalar value of the UTF-8 char at src[i] — no shifts, so *64/*4096
fn utf8_val(src: str, i: int) -> int {
    b0 := byteat(src, i)
    if b0 < 128 {
        return b0
    }
    if b0 < 224 {
        return (b0 - 192) * 64 + (byteat(src, i + 1) - 128)
    }
    if b0 < 240 {
        return (b0 - 224) * 4096 + (byteat(src, i + 1) - 128) * 64 + (byteat(src, i + 2) - 128)
    }
    return (b0 - 240) * 262144 + (byteat(src, i + 1) - 128) * 4096 + (byteat(src, i + 2) - 128) * 64 + (byteat(src, i + 3) - 128)
}

fn kind_name(k: int) -> str {
    if k == 1 {
        return "ident"
    }
    if k == 2 {
        return "kw"
    }
    if k == 3 {
        return "int"
    }
    if k == 4 {
        return "str"
    }
    if k == 5 {
        return "punct"
    }
    if k == 6 {
        return "float"
    }
    if k == 7 {
        return "err"
    }
    return "eof"
}
