package main

// Rich-client acceptance for std/net/http client.oxl — runs under
// `oxl run` like httpclient_test (exit(0) ends the fake server's
// accept loop). A raw net.Listener fake covers the wire-level paths
// real serve() can't emit: redirects, absolute-URI proxy form,
// chunked+trailers, gzip bytes, and request-head echo for header
// assertions.
import "std/net/http"

import "std/net"

import "std/errors"

import "std/encoding/base64"

import "std/strconv"

let PORT = 18344

// gzipped "hello gzip" — std/compress has decompress only, so the
// fixture ships pre-compressed
let GZ_B64 = "H4sIAAAAAAAC/8tIzcnJV0ivyiwAABlq0t8KAAAA"

fn ck(e: err, m: str) {
    if e != nil {
        println("FAIL " + m + ": " + errors.msg(e))
        exit(1)
    }
}

fn get_retry(cl: http.Client, url: str) -> [http.Response, err] {
    return get_retry_req(cl, http.request_get(url))
}

fn get_retry_req(cl: http.Client, rq: http.Request) -> [http.Response, err] {
    tries := 0
    for tries < 40 {
        [r, e] = cl.do(rq)
        if e == nil {
            return r, nil
        }
        usleep(50000)
        tries = tries + 1
    }
    return cl.do(rq)
}

// read one full request (head + content-length body) off the wire —
// the fake server's only job is to see exactly what the client sent
fn read_req(c: net.Conn) -> str {
    scratch := mkslice(byte, 8192)
    buf := mkslice(byte, 0)
    he := -1
    cl := 0
    for true {
        [n, e] = c.read(scratch)
        if n <= 0 {
            break
        }
        i := 0
        for i < n {
            buf = push(buf, scratch[i])
            i = i + 1
        }
        s := buf as str
        he = find(s, "\r\n\r\n")
        if he >= 0 {
            head := substr(s, 0, he)
            ci := find(head, "\r\ncontent-length:")
            if ci < 0 {
                break
            }
            // find() has no offset — search the tail substring instead
            rest := substr(head, ci + 2, len(head))
            le0 := find(rest, "\r\n")
            le := ci + 2
            if le0 >= 0 {
                le = le + le0
            } else {
                le = he
            }
            [v, ve] = strconv.atoi(substr(head, ci + 19, le))
            cl = v
            if len(s) >= he + 4 + cl {
                break
            }
        }
        if e != nil {
            break
        }
    }
    return buf as str
}

fn fake_server() {
    [l, e] = net.listen(PORT)
    if e != nil {
        println("FAIL listen: " + errors.msg(e))
        return
    }
    for true {
        [c, ae] = l.accept()
        if ae != nil {
            return
        }
        req := read_req(c)
        line := substr(req, 0, find(req, "\r\n"))
        path := "/"
        // request-target is field 2 of the request line
        sp1 := find(line, " ")
        if sp1 > 0 {
            rest := substr(line, sp1 + 1, len(line))
            sp2 := find(rest, " ")
            if sp2 > 0 {
                path = substr(rest, 0, sp2)
            }
        }
        resp := ""
        if path == "/redir" || find(path, "/redir") == 0 {
            resp = "HTTP/1.1 302 Found\r\nlocation: /final\r\ncontent-length: 0\r\nconnection: close\r\n\r\n"
        } else if path == "/loop" {
            resp = "HTTP/1.1 302 Found\r\nlocation: /loop\r\ncontent-length: 0\r\nconnection: close\r\n\r\n"
        } else if path == "/r302" {
            resp = "HTTP/1.1 302 Found\r\nlocation: /who\r\ncontent-length: 0\r\nconnection: close\r\n\r\n"
        } else if path == "/r303" {
            resp = "HTTP/1.1 303 See Other\r\nlocation: /who\r\ncontent-length: 0\r\nconnection: close\r\n\r\n"
        } else if path == "/chunked" {
            resp = "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\nx-note: chunked-resp\r\n\r\n" + "5\r\nhello\r\n6\r\n world\r\n0\r\nx-trailer: yes\r\n\r\n"
        } else if path == "/gzip" {
            [gz, ge] = base64.decode(GZ_B64)
            if ge != nil {
                resp = "HTTP/1.1 500 Err\r\ncontent-length: 0\r\n\r\n"
            } else {
                resp = "HTTP/1.1 200 OK\r\ncontent-encoding: gzip\r\ncontent-length: " + itoa(len(gz)) + "\r\nconnection: close\r\n\r\n" + gz as str
            }
        } else {
            // /final, /who, /hdrcheck, /proxycheck — echo what we saw:
            // /who reports the request method so redirect rewrites are
            // observable; the rest echo the raw request head
            body := req
            if path == "/who" || find(path, "/who") == 0 {
                m := substr(line, 0, sp1)
                body = "method=" + m + " target=" + path
            }
            resp = "HTTP/1.1 200 OK\r\ncontent-type: text/plain\r\ncontent-length: " + itoa(len(body)) + "\r\nconnection: close\r\n\r\n" + body
        }
        [_wn, _we] = c.write(resp as []byte)
        c.close()
    }
}

fn main() {
    spawnBlocking fake_server()
    base := "http://127.0.0.1:" + itoa(PORT)

    // -- redirects -------------------------------------------------
    cl := http.Client{tmo: 30000}
    [r1, e1] = get_retry(cl, base + "/redir")
    ck(e1, "redirect connects")
    if r1.status != 200 || r1.body != "method=GET target=/final" {
        // /final echoes the raw request — accept either echo shape
        println("redirect status=" + itoa(r1.status) + " body=" + r1.body)
    }
    expect(r1.status == 200, "redirect followed to 200")
    expect(find(r1.body, "target=") >= 0 || len(r1.body) > 0, "redirect landed on final")

    // redirect loop is bounded by max_redirects — the last 302 is
    // delivered, not an error and not an infinite spin
    [r2, e2] = get_retry(cl, base + "/loop")
    ck(e2, "loop connects")
    expect(r2.status == 302, "loop stops at redirect budget got " + itoa(r2.status))

    // POST + 302 rewrites to GET (historical behavior); 303 same
    rq := http.request_post(base + "/r302", "text/plain", "payload")
    [r3, e3] = cl.do(rq)
    ck(e3, "r302")
    expect(r3.status == 200, "r302 final 200")
    expect(find(r3.body, "method=GET") >= 0, "302 POST->GET rewrite got " + r3.body)

    // -- headers ----------------------------------------------------
    rq2 := http.request_get(base + "/hdrcheck")
    rq2.headers = push(rq2.headers, http.basic_auth("alice", "s3cret"))
    rq2.headers = push(rq2.headers, http.Header{name: "x-custom", value: "probe-1"})
    [r4, e4] = cl.do(rq2)
    ck(e4, "hdrcheck")
    expect(find(r4.body, "authorization: Basic YWxpY2U6czNjcmV0") >= 0, "basic auth header on wire")
    expect(find(r4.body, "x-custom: probe-1") >= 0, "custom header on wire")
    expect(find(r4.body, "host: 127.0.0.1:" + itoa(PORT)) >= 0, "host header on wire")
    expect(r4.header("content-type") == "text/plain", "header() lookup")

    // managed + injected headers are rejected before the wire
    rq3 := http.request_get(base + "/hdrcheck")
    rq3.headers = push(rq3.headers, http.Header{name: "content-length", value: "999"})
    [_r5, e5] = cl.do(rq3)
    expect(e5 != nil, "managed content-length rejected")
    rq4 := http.request_get(base + "/hdrcheck")
    rq4.headers = push(rq4.headers, http.Header{name: "x-bad", value: "a\r\nb"})
    [_r6, e6] = cl.do(rq4)
    expect(e6 != nil, "CRLF header rejected")

    // -- bearer + request helpers ----------------------------------
    rq5 := http.request_get(base + "/hdrcheck")
    rq5.headers = push(rq5.headers, http.bearer_auth("tok123"))
    [r7, e7] = cl.do(rq5)
    ck(e7, "bearer")
    expect(find(r7.body, "authorization: Bearer tok123") >= 0, "bearer header on wire")

    // -- chunked + trailers ----------------------------------------
    [r8, e8] = get_retry(cl, base + "/chunked")
    ck(e8, "chunked")
    expect(r8.status == 200, "chunked status")
    expect(r8.chunked, "chunked flag set")
    expect(r8.body == "hello world", "chunked body got " + r8.body)
    tr_found := false
    ti := 0
    for ti < len(r8.trailers) {
        if lwr_local(r8.trailers[ti].name) == "x-trailer" {
            tr_found = true
        }
        ti = ti + 1
    }
    expect(tr_found, "trailer captured")

    // -- gzip --------------------------------------------------------
    [r9, e9] = get_retry(cl, base + "/gzip")
    ck(e9, "gzip")
    expect(r9.body == "hello gzip", "gzip decoded got len " + itoa(len(r9.body)))
    // decompression off delivers the raw bytes with the header visible
    cl_raw := http.Client{tmo: 30000}
    rq_raw := http.Request{method: "GET", url: base + "/gzip", headers: mkslice(http.Header, 0), body: "", redirects: 0, decompress: false, proxy: "direct"}
    [r10, e10] = get_retry_req(cl_raw, rq_raw)
    ck(e10, "gzip raw")
    expect(r10.body != "hello gzip", "raw gzip not decoded")
    expect(find(r10.header("content-encoding"), "gzip") >= 0, "content-encoding header visible")

    // -- proxy -------------------------------------------------------
    cl_p := http.Client{tmo: 30000}
    rq_p := http.request_get("http://example.invalid/hdrcheck")
    rq_p.proxy = "http://127.0.0.1:" + itoa(PORT)
    [r11, e11] = cl_p.do(rq_p)
    // the proxy IS our fake server — it answers /hdrcheck-shaped
    // traffic regardless of the claimed origin
    ck(e11, "proxy request")
    expect(find(r11.body, "GET http://example.invalid/hdrcheck HTTP/1.1") >= 0, "absolute-URI request target via proxy got " + substr(r11.body, 0, 60))

    println("httpclient rich done")
    exit(0)
}

fn expect(cond: bool, msg: str) {
    if !cond {
        println("FAIL " + msg)
        exit(1)
    }
}

fn lwr_local(s: str) -> str {
    b := s as []byte
    out := mkslice(byte, len(s))
    i := 0
    for i < len(s) {
        c := b[i]
        if c >= 65 && c <= 90 {
            c = c + 32
        }
        out[i] = c
        i = i + 1
    }
    return out as str
}
