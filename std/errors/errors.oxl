package errors

// std/errors — message-carrying err values. `err` stays an int64 code
// (the [v, err] ABI is unchanged); payloads live in an interned
// registry so a sentinel is stable: errors.new("EOF") called anywhere
// returns the same code and `e == io.eof()` is a plain int compare.
// Registry entries are never freed — one per distinct message text.
extern fn rt_err_new(msg: str) -> err

extern fn rt_err_msg(code: err) -> str

/// new returns a messaged err. Interned by text: identical messages
/// share one code, which is what makes sentinels comparable.
fn new(msg: str) -> err {
    return rt_err_new(msg)
}

/// msg returns the registered message; "" for nil and foreign codes.
fn msg(e: err) -> str {
    return rt_err_msg(e)
}

/// code returns the raw int64 code.
fn code(e: err) -> int {
    return e
}

extern fn rt_err_wrap(msg: str, cause: err) -> err

extern fn rt_err_cause(code: err) -> err

/// wrap returns a new messaged err carrying e as its cause. Unlike
/// new() the result is never interned — two wraps of the same text
/// stay distinct so each keeps its own chain.
fn wrap(msg: str, e: err) -> err {
    return rt_err_wrap(msg, e)
}

/// unwrap returns the cause of e, or nil at the end of the chain.
fn unwrap(e: err) -> err {
    return rt_err_cause(e)
}

/// is reports whether target appears in e's cause chain — a plain
/// code compare at each link, so interned sentinels match. A typed
/// `as` stays parked: err is an int64 code and no runtime type
/// descriptors exist to bind a target to.
fn is(e: err, target: err) -> bool {
    for e != nil {
        if e == target {
            return true
        }
        e = rt_err_cause(e)
    }
    return false
}
