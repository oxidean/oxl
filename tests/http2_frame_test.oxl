package main

import "std/net/http2"

import "std/bytes"

import "std/testing"

import "std/errors"

fn test_http2_frame_header_roundtrip() {
    h := http2.FrameHeader{length: 74565, kind: 1, flags: 5, stream_id: 16909060}
    [raw, e] = http2.encode_frame_header(h)
    testing.expect(e == nil, "encode valid frame header")
    want := mkslice(byte, 9)
    want[0] = 1
    want[1] = 35
    want[2] = 69
    want[3] = 1
    want[4] = 5
    want[5] = 1
    want[6] = 2
    want[7] = 3
    want[8] = 4
    testing.expect(len(raw) == 9, "frame header width")
    i := 0
    for i < 9 {
        testing.expect(raw[i] == want[i], "network-order frame header byte")
        i = i + 1
    }
    [got, de] = http2.decode_frame_header(raw, 100000)
    testing.expect(de == nil, "decode valid frame header")
    testing.expect(got.length == h.length && got.kind == h.kind && got.flags == h.flags && got.stream_id == h.stream_id, "frame header fields round-trip")
}

fn test_http2_frame_header_rejects_invalid_input() {
    too_short := mkslice(byte, 8)
    [_, e1] = http2.decode_frame_header(too_short, 16384)
    testing.expect(e1 != nil, "reject truncated frame header")
    [_, e2] = http2.decode_frame_header(mkslice(byte, 9), 0)
    testing.expect(e2 != nil, "reject invalid max frame size")
    [large, le] = http2.encode_frame_header(http2.FrameHeader{length: 16385, kind: 0, flags: 0, stream_id: 0})
    testing.expect(le == nil, "encode frame above default size")
    [_, e3] = http2.decode_frame_header(large, 16384)
    testing.expect(e3 != nil, "reject frame larger than configured maximum")
    [_, e4] = http2.encode_frame_header(http2.FrameHeader{length: 1, kind: 0, flags: 0, stream_id: 2147483648})
    testing.expect(e4 != nil, "reject reserved stream-id bit")
    [_, e5] = http2.encode_frame_header(http2.FrameHeader{length: 16777216, kind: 0, flags: 0, stream_id: 0})
    testing.expect(e5 != nil, "reject unrepresentable frame length")
    [reserved, re] = http2.encode_frame_header(http2.FrameHeader{length: 0, kind: 0, flags: 0, stream_id: 1})
    testing.expect(re == nil, "encode header for reserved-bit test")
    reserved[5] = reserved[5] + 128
    [_, e6] = http2.decode_frame_header(reserved, 16384)
    testing.expect(e6 != nil, "reject reserved bit on input")
}

fn test_http2_frame_payload() {
    h := http2.FrameHeader{length: 3, kind: 0, flags: 1, stream_id: 1}
    [raw, e] = http2.encode_frame(h, "abc" as []byte)
    testing.expect(e == nil, "encode frame with payload")
    testing.expect(len(raw) == 12, "frame includes header and payload")
    testing.expect(raw[9] == 97 && raw[10] == 98 && raw[11] == 99, "frame payload follows header")
    [_, me] = http2.encode_frame(h, "x" as []byte)
    testing.expect(me != nil, "reject frame payload length mismatch")
}

fn test_http2_frame_io_roundtrip() {
    h := http2.FrameHeader{length: 3, kind: 0, flags: 1, stream_id: 1}
    out := bytes.newbuffer()
    writer := out.aswriter()
    we := http2.write_frame(writer, h, "abc" as []byte)
    testing.expect(we == nil, "write frame")
    raw := out.str() as []byte
    testing.expect(len(raw) == 12, "frame writer emitted all bytes")
    input := bytes.Buffer{buf: raw, rd: 0}
    reader := input.asreader()
    [frame, re] = http2.read_frame(reader, 16384)
    testing.expect(re == nil, "read frame: " + errors.msg(re))
    testing.expect(frame.header.length == 3 && frame.header.flags == 1 && frame.header.stream_id == 1, "read frame header")
    testing.expect(frame.payload as str == "abc", "read frame payload")
    truncated := bytes.Buffer{buf: raw[0:11], rd: 0}
    tr := truncated.asreader()
    [_, te] = http2.read_frame(tr, 16384)
    testing.expect(te != nil, "reject truncated frame payload")
}

fn test_http2_frame_type_validation() {
    ping := http2.Frame{header: http2.FrameHeader{length: 8, kind: 6, flags: 0, stream_id: 0}, payload: mkslice(byte, 8)}
    testing.expect(http2.validate_frame(ping) == nil, "accept valid PING")
    ping.header.length = 7
    ping.payload = mkslice(byte, 7)
    testing.expect(http2.validate_frame(ping) != nil, "reject short PING")
    settings := http2.Frame{header: http2.FrameHeader{length: 6, kind: 4, flags: 0, stream_id: 1}, payload: mkslice(byte, 6)}
    testing.expect(http2.validate_frame(settings) != nil, "reject SETTINGS on stream")
    settings.header.stream_id = 0
    settings.header.flags = 1
    testing.expect(http2.validate_frame(settings) != nil, "reject non-empty SETTINGS ack")
    update := http2.Frame{header: http2.FrameHeader{length: 4, kind: 8, flags: 0, stream_id: 1}, payload: mkslice(byte, 4)}
    testing.expect(http2.validate_frame(update) != nil, "reject zero window increment")
    reset := http2.Frame{header: http2.FrameHeader{length: 4, kind: 3, flags: 0, stream_id: 0}, payload: mkslice(byte, 4)}
    testing.expect(http2.validate_frame(reset) != nil, "reject RST_STREAM on connection")
}
