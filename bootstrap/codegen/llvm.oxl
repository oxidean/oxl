    }
    if name == "rt_slice_push" {
        d = "void @rt_slice_push(ptr sret(%RtSlice), ptr byval(%RtSlice), i64, ptr)"
    }
    if name == "rt_slice_own" {
        d = "ptr @rt_slice_own(ptr, i64)"
    }
    if name == "rt_mkbuf" {
        d = "ptr @rt_mkbuf(i64)"
    }
    if name == "rt_bufstr" {
        d = "%OxlStr @rt_bufstr(ptr, i64)"
    }
    if name == "rt_poke8" {
        d = "void @rt_poke8(ptr, i64, i64)"
    }
    if name == "rt_poke16" {
        d = "void @rt_poke16(ptr, i64, i64)"
    }
    if name == "rt_poke32" {
        d = "void @rt_poke32(ptr, i64, i64)"
    }
