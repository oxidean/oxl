package main

// X2: std/crypto/aes + std/crypto/aesgcm — FIPS-197 block vectors,
// SP 800-38A ECB, NIST GCM vectors across key sizes and IV lengths
// (incl. the GHASH-J0 path for non-96-bit IVs), tampered-tag reject,
// and the 4 MiB seal/open perf gate.
import "std/crypto/aes"

import "std/crypto/aesgcm"

import "std/encoding/hex"

import "std/testing"

import "std/time"

fn test_aes_block() {
    // FIPS-197 appendix B/C — one block per key size
    [k128, _e1] = hex.decode("000102030405060708090a0b0c0d0e0f")
    [pt, _e2] = hex.decode("00112233445566778899aabbccddeeff")
    ct := mkslice(byte, 16)
    [a1, e1] = aes.new(k128)
    testing.expect(e1 == nil, "aes128 new")
    a1.encrypt_block(ct, pt)
    testing.expect_streq(hex.encode(ct), "69c4e0d86a7b0430d8cdb78070b4c55a", "aes128 block")
    [k192, _e3] = hex.decode("000102030405060708090a0b0c0d0e0f1011121314151617")
    [a2, e2] = aes.new(k192)
    testing.expect(e2 == nil, "aes192 new")
    a2.encrypt_block(ct, pt)
    testing.expect_streq(hex.encode(ct), "dda97ca4864cdfe06eaf70a0ec0d7191", "aes192 block")
    [k256, _e4] = hex.decode("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
    [a3, e3] = aes.new(k256)
    testing.expect(e3 == nil, "aes256 new")
    a3.encrypt_block(ct, pt)
    testing.expect_streq(hex.encode(ct), "8ea2b7ca516745bfeafc49904b496089", "aes256 block")
    // SP 800-38A F.1.1 — 4-block AES-128 ECB chain
    [k38a, _e5] = hex.decode("2b7e151628aed2a6abf7158809cf4f3c")
    [a4, e4] = aes.new(k38a)
    testing.expect(e4 == nil, "38a new")
    [in2, _e6] = hex.decode("6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e51")
    want := "3ad77bb40d7a3660a89ecaf32466ef97f5d3d58503b9699de785895a96fdbaaf"
    out := mkslice(byte, 32)
    i := 0
    for i < 2 {
        a4.encrypt_block(out[16 * i:], in2[16 * i:])
        i = i + 1
    }
    testing.expect_streq(hex.encode(out), want, "38a ecb chain")
    // bad key sizes are errs, not traps
    [_bad, e5] = aes.new(mkslice(byte, 15))
    testing.expect(e5 != nil, "aes 15-byte key rejected")
    [_bad2, e6] = aes.new(mkslice(byte, 0))
    testing.expect(e6 != nil, "aes empty key rejected")
}

fn test_gcm() {
    // NIST zero vector: K=0, IV=0 (12B), P=0^128, no AAD
    key := mkslice(byte, 16)
    iv := mkslice(byte, 12)
    pt := mkslice(byte, 16)
    [out, e1] = aesgcm.seal(key, iv, mkslice(byte, 0), pt)
    testing.expect(e1 == nil, "gcm zero seal")
    testing.expect_streq(hex.encode(out), "0388dace60b6a392f328c2b971b2fe78ab6e47d42cec13bdf53a67b21257bddf", "gcm zero ct+tag")
    // NIST feffe992 vector with AAD (60-byte pt)
    [k2, _f1] = hex.decode("feffe9928665731c6d6a8f9467308308")
    [iv2, _f2] = hex.decode("cafebabefacedbaddecaf888")
    [pt2, _f3] = hex.decode("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39")
    [aad2, _f4] = hex.decode("feedfacedeadbeeffeedfacedeadbeefabaddad2")
    [out2, e2] = aesgcm.seal(k2, iv2, aad2, pt2)
    testing.expect(e2 == nil, "gcm aad seal")
    testing.expect_streq(hex.encode(out2), "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e0915bc94fbc3221a5db94fae95ae7121a47", "gcm aad ct+tag")
    [back2, e3] = aesgcm.open(k2, iv2, aad2, out2)
    testing.expect(e3 == nil, "gcm aad open")
    testing.expect(hex.encode(back2) == hex.encode(pt2), "gcm aad round-trip")
    // non-96-bit IV exercises the GHASH-derived J0 path
    [iv8, _f5] = hex.decode("cafebabefacedbad")
    [out8, e8] = aesgcm.seal(k2, iv8, aad2, pt2)
    testing.expect(e8 == nil, "gcm 8-byte-iv seal")
    testing.expect_streq(hex.encode(out8), "61353b4c2806934a777ff51fa22a4755699b2a714fcdc6f83766e5f97b6c742373806900e49f24b22b097544d4896b424989b5e1ebac0f07c23f45983612d2e79e3b0785561be14aaca2fccb", "gcm 8-byte-iv ct+tag")
    [back8, e9] = aesgcm.open(k2, iv8, aad2, out8)
    testing.expect(e9 == nil, "gcm 8-byte-iv open")
    testing.expect(hex.encode(back8) == hex.encode(pt2), "gcm 8-byte-iv round-trip")
    // AES-256 GCM over a 64-byte message
    k256 := mkslice(byte, 32)
    i := 0
    for i < 32 {
        k256[i] = i
        i = i + 1
    }
    pt3 := mkslice(byte, 64)
    i = 0
    for i < 64 {
        pt3[i] = i
        i = i + 1
    }
    [iv3, _f6] = hex.decode("010203040506070809101112")
    [out3, e4] = aesgcm.seal(k256, iv3, mkslice(byte, 0), pt3)
    testing.expect(e4 == nil, "gcm256 seal")
    testing.expect_streq(hex.encode(out3), "3918c7b2c99265a05dee8d31ab8f899be9ae84815fcd2df526a7b17488306b400deee5687c0fc592987a9844953325ff4ee649520d10cb5f400ef66d57c6f5777f80618bf9523c005448981101cae1fe", "gcm256 ct+tag")
    // tampered tag rejects and yields no plaintext
    [bad, _f7] = hex.decode("42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e0915bc94fbc3221a5db94fae95ae7121a48")
    [_p, e5] = aesgcm.open(k2, iv2, aad2, bad)
    testing.expect(e5 != nil, "gcm tampered tag rejected")
    // tampered ciphertext rejects too
    badct := mkslice(byte, len(out2))
    i = 0
    for i < len(out2) {
        badct[i] = out2[i]
        i = i + 1
    }
    badct[0] = badct[0] ^ 1
    [_p2, e6] = aesgcm.open(k2, iv2, aad2, badct)
    testing.expect(e6 != nil, "gcm tampered ct rejected")
    // empty plaintext: tag over aad+lens only
    [oute, ee] = aesgcm.seal(k2, iv2, aad2, mkslice(byte, 0))
    testing.expect(ee == nil && len(oute) == 16, "gcm empty seal")
    [_pe, eee] = aesgcm.open(k2, iv2, aad2, oute)
    testing.expect(eee == nil, "gcm empty open")
}

fn test_aead_perf() {
    // 4 MiB seal+open must sustain >= 5 MiB/s (spec gate)
    n := 4194304
    key := mkslice(byte, 16)
    iv := mkslice(byte, 12)
    pt := mkslice(byte, n)
    t0 := time.unix_ms()
    [ct, e1] = aesgcm.seal(key, iv, mkslice(byte, 0), pt)
    t1 := time.unix_ms()
    testing.expect(e1 == nil, "perf seal")
    testing.expect((t1 - t0) * 5242880 <= n * 1000, "gcm seal >= 5 MiB/s")
    t0 = time.unix_ms()
    [_p, e2] = aesgcm.open(key, iv, mkslice(byte, 0), ct)
    t1 = time.unix_ms()
    testing.expect(e2 == nil, "perf open")
    testing.expect((t1 - t0) * 5242880 <= n * 1000, "gcm open >= 5 MiB/s")
}
