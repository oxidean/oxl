package main

// S4 acceptance: refused dial returns err, dotted-literal short-
// circuit, lookup resolve + NXDOMAIN err, bad-host dial err — the
// socket-free half of the net coverage (runs in the js lane too;
// socket tests live in net_sock_test.oxl).
import "std/net"

import "std/testing"

import "std/errors"

fn ck(e: err, m: str) {
    testing.expect(e == nil, m + ": " + errors.msg(e))
}

fn test_refused() {
    [c, e] = net.dial_timeout("127.0.0.1", 1, 500)
    testing.expect(e != nil, "dial refused gives err")
}

fn test_lookup() {
    // e6 #29 — dotted literals short-circuit; names resolve through
    // getaddrinfo on the blocking pool (localhost via /etc/hosts is
    // offline-safe; .invalid is a guaranteed NXDOMAIN per RFC 2606)
    [ip, e] = net.lookup_ipv4("localhost", 2000)
    testing.expect(e == nil, "localhost resolves")
    testing.expect(ip / 16777216 == 127, "localhost is in 127.0.0.0/8")
    [ip2, e2] = net.lookup_ipv4("127.0.0.1", 2000)
    testing.expect(e2 == nil && ip2 == 2130706433, "dotted literal short-circuits")
    [ip3, e3] = net.lookup_ipv4("no-such-host.invalid.", 2000)
    testing.expect(e3 != nil, "bogus host errors")
}

fn test_badip() {
    [c, e] = net.dial("not-an-ip", 80)
    testing.expect(e != nil, "dial bad host gives err")
}

fn main() {
    exit(0)
}
