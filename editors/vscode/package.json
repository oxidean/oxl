{
  "name": "oxl-language",
  "displayName": "OXL Language",
  "description": "Syntax highlighting and full language-server support (via `oxl lsp`) for the oxl language.",
  "version": "0.1.0",
  "publisher": "oxidean",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oxidean/oxl"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:oxl"
  ],
  "scripts": {
    "build": "node build.mjs",
    "package": "npm run build && npx --yes @vscode/vsce@4.1.0 package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.91.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vscode-languageclient": "^10.1.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "oxl",
        "aliases": [
          "OXL",
          "oxl"
        ],
        "extensions": [
          ".oxl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "oxl",
        "scopeName": "source.oxl",
        "path": "./syntaxes/oxl.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "OXL",
      "properties": {
        "oxl.lsp.path": {
          "type": "string",
          "default": "oxl",
          "description": "Path to the oxl binary used for the language server."
        }
      }
    }
  }
}
