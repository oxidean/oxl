package chacha20poly1305

// std/crypto/chacha20poly1305 — RFC 8439's AEAD: ChaCha20 keystream
// (20-round block function, 96-bit nonce, 32-bit block counter) and
// Poly1305 over five 26-bit limbs in int64 — products of limbs stay
// under 2^53 so schoolbook accumulation never reaches the sign bit.
// seal returns ct||tag; open authenticates before decrypting and
// yields no plaintext on a tag mismatch.
import "std/encoding/binary"

import "std/errors"

import "std/slices"

let M32: int = 4294967295

let M26: int = 67108863

// rotl32 rotates a u32-in-i64 left by n bits
fn rotl(x: int, n: int) -> int {
    hi := x * P2L[n] & M32
    return hi | x / P2L[32 - n]
}

let P2L: own []int = nil

fn p2l() -> own []int {
    if P2L == nil {
        t := mkslice(int, 33)
        v := 1
        i := 0
        for i < 33 {
            t[i] = v
            v = v * 2
            i = i + 1
        }
        P2L = slices.clone(t)
    }
    return P2L
}

// quarterround is the ChaCha QR on four state words in place
fn qr(s: []int, a: int, b: int, c: int, d: int) {
    p := p2l()
    s[a] = s[a] + s[b] & M32
    s[d] = rotl(s[d] ^ s[a], 16)
    s[c] = s[c] + s[d] & M32
    s[b] = rotl(s[b] ^ s[c], 12)
    s[a] = s[a] + s[b] & M32
    s[d] = rotl(s[d] ^ s[a], 8)
    s[c] = s[c] + s[d] & M32
    s[b] = rotl(s[b] ^ s[c], 7)
}

// block returns the 64-byte ChaCha20 block for key/counter/nonce —
// state layout per RFC 8439 §2.3: constants, 8 key words, counter,
// 3 nonce words, all little-endian.
fn block(key: []byte, counter: int, nonce: []byte) -> own []byte {
    s := mkslice(int, 16)
    s[0] = 1634760805
    s[1] = 857760878
    s[2] = 2036477234
    s[3] = 1797285236
    i := 0
    for i < 8 {
        s[4 + i] = binary.le_u32(key, 4 * i)
        i = i + 1
    }
    s[12] = counter
    s[13] = binary.le_u32(nonce, 0)
    s[14] = binary.le_u32(nonce, 4)
    s[15] = binary.le_u32(nonce, 8)
    w := mkslice(int, 16)
    i = 0
    for i < 16 {
        w[i] = s[i]
        i = i + 1
    }
    i = 0
    for i < 10 {
        qr(w, 0, 4, 8, 12)
        qr(w, 1, 5, 9, 13)
        qr(w, 2, 6, 10, 14)
        qr(w, 3, 7, 11, 15)
        qr(w, 0, 5, 10, 15)
        qr(w, 1, 6, 11, 12)
        qr(w, 2, 7, 8, 13)
        qr(w, 3, 4, 9, 14)
        i = i + 1
    }
    out := mkslice(byte, 64)
    i = 0
    for i < 16 {
        binary.put_le_u32(out, 4 * i, w[i] + s[i] & M32)
        i = i + 1
    }
    return slices.clone(out)
}

fn need(b: []byte, n: int) {
    if len(b) < n {
        assert(false)
    }
}

// xkey applies the keystream from counter 1 — the RFC 8439 §2.4
// cipher; counter 0's block is reserved for the poly key.
fn xkey(key: []byte, nonce: []byte, in: []byte, out: []byte) {
    ctr := 1
    off := 0
    for off < len(in) {
        ks := block(key, ctr, nonce)
        n := len(in) - off
        if n > 64 {
            n = 64
        }
        i := 0
        for i < n {
            out[off + i] = in[off + i] ^ ks[i]
            i = i + 1
        }
        off = off + n
        ctr = ctr + 1
    }
}

// poly1305 MAC — RFC 8439 §2.5 over five 26-bit limbs. r carries
// the pre-clamped limbs; h the accumulator; tag is appended at
// finalization via the s half of the one-time key.
struct Poly { r: []int, h: []int, s: []int, buf: []byte }

// mkpoly splits the 32-byte one-time key into clamped r limbs
// (bytes 0..16) and the s addend (bytes 16..32)
fn mkpoly(otk: []byte) -> Poly {
    need(otk, 32)
    r := mkslice(int, 5)
    r[0] = binary.le_u32(otk, 0) & M26
    r[1] = binary.le_u32(otk, 3) / 4 & 67108611
    r[2] = binary.le_u32(otk, 6) / 16 & 67092735
    r[3] = binary.le_u32(otk, 9) / 64 & 66076671
    r[4] = binary.le_u32(otk, 12) / 256 & 1048575
    s := mkslice(int, 4)
    i := 0
    for i < 4 {
        s[i] = binary.le_u32(otk, 16 + 4 * i)
        i = i + 1
    }
    h := mkslice(int, 5)
    return Poly{r: slices.clone(r), h: slices.clone(h), s: slices.clone(s), buf: slices.clone(mkslice(byte, 0))}
}

// fold absorbs one <=16-byte block; hibit is the 2^128 term —
// set for every full block, clear for the final short one.
fn (p ref Poly) fold(b: []byte, n: int, hibit: int) {
    pad := mkslice(byte, 16)
    i := 0
    for i < n {
        pad[i] = b[i]
        i = i + 1
    }
    t0 := binary.le_u32(pad, 0)
    t1 := binary.le_u32(pad, 3)
    t2 := binary.le_u32(pad, 6)
    h := p.h
    r := p.r
    h[0] = h[0] + (t0 & M26)
    h[1] = h[1] + (t1 / 4 & M26)
    h[2] = h[2] + (t2 / 16 & M26)
    h[3] = h[3] + (binary.le_u32(pad, 9) / 64 & M26)
    h[4] = h[4] + (binary.le_u32(pad, 12) / 256 & 16777215) + hibit
    s1 := r[1] * 5
    s2 := r[2] * 5
    s3 := r[3] * 5
    s4 := r[4] * 5
    d0 := h[0] * r[0] + h[1] * s4 + h[2] * s3 + h[3] * s2 + h[4] * s1
    d1 := h[0] * r[1] + h[1] * r[0] + h[2] * s4 + h[3] * s3 + h[4] * s2
    d2 := h[0] * r[2] + h[1] * r[1] + h[2] * r[0] + h[3] * s4 + h[4] * s3
    d3 := h[0] * r[3] + h[1] * r[2] + h[2] * r[1] + h[3] * r[0] + h[4] * s4
    d4 := h[0] * r[4] + h[1] * r[3] + h[2] * r[2] + h[3] * r[1] + h[4] * r[0]
    c := d0 / 67108864
    h[0] = d0 & M26
    d1 = d1 + c
    c = d1 / 67108864
    h[1] = d1 & M26
    d2 = d2 + c
    c = d2 / 67108864
    h[2] = d2 & M26
    d3 = d3 + c
    c = d3 / 67108864
    h[3] = d3 & M26
    d4 = d4 + c
    c = d4 / 67108864
    h[4] = d4 & M26
    h[0] = h[0] + c * 5
    c = h[0] / 67108864
    h[0] = h[0] & M26
    h[1] = h[1] + c
}

// absorb feeds msg into the accumulator in 16-byte blocks, keeping
// a partial tail for finish — callers stream aad then ct then the
// length block through here and rely on absorb's own buffering.
fn (p mut Poly) absorb(msg: []byte) {
    data := slices.concat(p.buf, msg)
    off := 0
    for off + 16 <= len(data) {
        p.fold(data[off:off + 16], 16, 16777216)
        off = off + 16
    }
    p.buf = slices.clone(data[off:])
}

// finish flushes the partial tail (if any), reduces mod 2^130-5,
// adds s, and returns the 16-byte tag.
fn (p mut Poly) finish() -> own []byte {
    if len(p.buf) > 0 {
        // the short tail is padded with a 1 byte at position len —
        // that is the block's message terminator, distinct from the
        // 2^128 hibit full blocks carry
        blk := mkslice(byte, 16)
        i := 0
        for i < len(p.buf) {
            blk[i] = p.buf[i]
            i = i + 1
        }
        blk[len(p.buf)] = 1
        p.fold(blk, 16, 0)
        p.buf = slices.clone(mkslice(byte, 0))
    }
    h := p.h
    c := h[1] / 67108864
    h[1] = h[1] & M26
    h[2] = h[2] + c
    c = h[2] / 67108864
    h[2] = h[2] & M26
    h[3] = h[3] + c
    c = h[3] / 67108864
    h[3] = h[3] & M26
    h[4] = h[4] + c
    // h + 5 - 2^130 >= 0 means h >= p — select g = h - p, else h
    g := mkslice(int, 5)
    g[0] = h[0] + 5
    c = g[0] / 67108864
    g[0] = g[0] & M26
    g[1] = h[1] + c
    c = g[1] / 67108864
    g[1] = g[1] & M26
    g[2] = h[2] + c
    c = g[2] / 67108864
    g[2] = g[2] & M26
    g[3] = h[3] + c
    c = g[3] / 67108864
    g[3] = g[3] & M26
    g[4] = h[4] + c - 67108864
    if g[4] >= 0 {
        i := 0
        for i < 5 {
            h[i] = g[i]
            i = i + 1
        }
    }
    // serialize the 130-bit h little-endian, then add s mod 2^128
    t0 := h[0] | h[1] * 67108864 & M32
    t1 := h[1] / 64 | h[2] * 1048576 & M32
    t2 := h[2] / 4096 | h[3] * 16384 & M32
    t3 := h[3] / 262144 | h[4] * 256 & M32
    s := p.s
    out := mkslice(byte, 16)
    w0 := t0 + s[0]
    binary.put_le_u32(out, 0, w0 & M32)
    w1 := t1 + s[1] + w0 / 4294967296
    binary.put_le_u32(out, 4, w1 & M32)
    w2 := t2 + s[2] + w1 / 4294967296
    binary.put_le_u32(out, 8, w2 & M32)
    w3 := t3 + s[3] + w2 / 4294967296
    binary.put_le_u32(out, 12, w3 & M32)
    return slices.clone(out)
}

// mac computes the RFC 8439 §2.8.1 tag: poly1305 over
// aad || pad16 || ct || pad16 || le64(len aad) || le64(len ct).
fn mac(otk: []byte, aad: []byte, ct: []byte) -> own []byte {
    p := mkpoly(otk)
    p.absorb(aad)
    if len(aad) % 16 != 0 {
        p.absorb(mkslice(byte, 16 - len(aad) % 16))
    }
    p.absorb(ct)
    if len(ct) % 16 != 0 {
        p.absorb(mkslice(byte, 16 - len(ct) % 16))
    }
    lens := mkslice(byte, 16)
    binary.put_le_u64(lens, 0, len(aad))
    binary.put_le_u64(lens, 8, len(ct))
    p.absorb(lens)
    return p.finish()
}

/// sum is the bare RFC 8439 §2.5 Poly1305 MAC — otk is the 32-byte
/// one-time key (r || s). Exposed for the published-vectors test;
/// AEAD callers use seal/open which derive otk internally.
fn sum(otk: []byte, msg: []byte) -> own []byte {
    p := mkpoly(otk)
    p.absorb(msg)
    return p.finish()
}

fn checkinputs(key: []byte, nonce: []byte) -> err {
    if len(key) != 32 {
        return errors.new("chacha20poly1305: key must be 32 bytes")
    }
    if len(nonce) != 12 {
        return errors.new("chacha20poly1305: nonce must be 12 bytes")
    }
    return nil
}

/// seal encrypts pt and returns ct||tag (16-byte tag appended) —
/// the RFC 8439 §2.8 AEAD with a 32-byte key and 12-byte nonce.
fn seal(key: []byte, nonce: []byte, aad: []byte, pt: []byte) -> [own []byte, err] {
    e := checkinputs(key, nonce)
    if e != nil {
        return nil, e
    }
    ks0 := block(key, 0, nonce)
    ct := mkslice(byte, len(pt))
    xkey(key, nonce, pt, ct)
    tag := mac(ks0[:32], aad, ct)
    out := mkslice(byte, len(pt) + 16)
    i := 0
    for i < len(pt) {
        out[i] = ct[i]
        i = i + 1
    }
    i = 0
    for i < 16 {
        out[len(pt) + i] = tag[i]
        i = i + 1
    }
    return slices.clone(out), nil
}

/// open verifies ct||tag's tag and returns the plaintext — a short
/// input or a tag mismatch is an err and yields no plaintext.
fn open(key: []byte, nonce: []byte, aad: []byte, ct: []byte) -> [own []byte, err] {
    e := checkinputs(key, nonce)
    if e != nil {
        return nil, e
    }
    if len(ct) < 16 {
        return nil, errors.new("chacha20poly1305: ciphertext shorter than tag")
    }
    n := len(ct) - 16
    ks0 := block(key, 0, nonce)
    tag := mac(ks0[:32], aad, ct[:n])
    diff := 0
    i := 0
    for i < 16 {
        diff = diff | ct[n + i] ^ tag[i]
        i = i + 1
    }
    if diff != 0 {
        return nil, errors.new("chacha20poly1305: tag mismatch")
    }
    pt := mkslice(byte, n)
    xkey(key, nonce, ct[:n], pt)
    return slices.clone(pt), nil
}
