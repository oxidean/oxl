package main

// R4 fixture — std/encoding/gob's descriptor-driven round-trip:
// scalars, strings, slices (incl. []byte and []own T), nested structs,
// enums with payload slots, own-pointer fields, skip-zero emission,
// tag overrides, and decode-under-missing-field tolerance. All pairs
// land through marshal/unmarshal; nothing here spells an rt_* extern.
import "std/encoding/gob"

import "std/errors"

struct Inner { v: int }

struct S {
    n: int,
    f: float,
    b: bool,
    s: str,
    y: byte,
    inner: Inner,
    p: own Inner,
    xs: []int,
    bs: []byte,
    ox: []own Inner,
    e: E,
}

enum E { A(int), B { x: int, s: str }, C, }

// a wider/narrower pair for the missing-field tolerance checks
struct Wide { a: int, b: str, c: int, deep: Inner }

struct Narrow { a: int, c: int }

struct Extra { a: int, b: str, c: int, deep: Inner, d: int }

struct Shuf { c: int, a: int, b: str, deep: Inner }

// tag overrides: `gob:-` hides a field, `gob:name` renames it
struct Tagged { keep: int, drop: int tag "gob:-", ren: str tag "gob:wire" }

struct Renamed { keep: int, wire: str }

// nested own-presence shapes: an `own` to an all-zero struct inside
// an inline struct field, and `own` enum payload slots on variant 0
// and on a non-0 variant
struct Box { p: own Inner }

struct Wrap { w: Box }

enum OE { A(own Inner), B { p: own Inner, n: int }, C, }

struct HasOE { e: OE, k: int }

// []own byte rides the presence-coded element lane, not the []byte
// fast path
struct Bytes { bs: []own byte }

// decode target for the hand-rolled malformed wires
struct Sc { b: bool, y: byte, n: int }

// szero is the all-zero S — struct literals are exhaustive, so the
// zero/sparse cases spell every field once here and reuse it.
fn szero() -> S {
    return S{n: 0, f: 0.0, b: false, s: "", y: 0, inner: Inner{v: 0}, p: nil, xs: mkslice(int, 0), bs: mkslice(byte, 0), ox: mkslice(own Inner, 0), e: E.A(0)}
}

fn fails(msg: str) {
    println("FAIL " + msg)
    exit(1)
}

fn want_ok(e: err, msg: str) {
    if e != nil {
        fails(msg + " — unexpected err: " + errors.msg(e))
    }
}

fn want_err(e: err, sentinel: err, msg: str) {
    if e == nil {
        fails(msg + " — expected err, got nil")
    }
    if !errors.is(e, sentinel) {
        fails(msg + " — wrong sentinel: " + errors.msg(e))
    }
}

// gob's sentinels are unexported, but errors.new interns by message
// text — re-spelling the same text yields the same code, so
// errors.is distinguishes malformed/type/unsupported here.
fn g_malformed() -> err {
    return errors.new("gob: malformed input")
}

fn g_type() -> err {
    return errors.new("gob: type mismatch")
}

fn g_unsupported() -> err {
    return errors.new("gob: unsupported shape")
}

// w1 appends one byte to a hand-rolled wire
fn w1(b: []byte, x: int) -> []byte {
    return push(b, x as byte)
}

// sc_wire is a hand-rolled preamble binding Sc{b:bool, y:byte,
// n:int} — record 0 is the root; callers append a delta-coded body.
fn sc_wire() -> []byte {
    b := mkslice(byte, 0)
    b = w1(b, 1)
    b = w1(b, 2)
    b = w1(b, 83)
    b = w1(b, 99)
    b = w1(b, 7)
    b = w1(b, 3)
    b = w1(b, 1)
    b = w1(b, 98)
    b = w1(b, 2)
    b = w1(b, 0)
    b = w1(b, 0)
    b = w1(b, 1)
    b = w1(b, 121)
    b = w1(b, 4)
    b = w1(b, 0)
    b = w1(b, 0)
    b = w1(b, 1)
    b = w1(b, 110)
    b = w1(b, 0)
    b = w1(b, 0)
    b = w1(b, 0)
    return b
}

fn main() {
    i1 := new(Inner)
    i1.v = 77
    i2 := new(Inner)
    i2.v = 88
    ox := mkslice(own Inner, 0)
    ox = push(ox, i2)
    ox = push(ox, nil)
    s := S{n: -12345, f: 3.14159, b: true, s: "hello", y: 255, inner: Inner{v: 42}, p: i1, xs: mkslice(int, 0), bs: mkslice(byte, 0), ox: ox, e: E.B{x: 4, s: "hi"}}
    s.xs = push(s.xs, -1)
    s.xs = push(s.xs, 0)
    s.xs = push(s.xs, 70000)
    s.bs = push(s.bs, 0)
    s.bs = push(s.bs, 200)
    s.bs = push(s.bs, 55)
    [bs, me] = gob.marshal(s)
    want_ok(me, "marshal")
    o := new(S)
    ue := gob.unmarshal(bs, o)
    want_ok(ue, "unmarshal")
    // scalars
    if o.n != -12345 {
        fails("n " + itoa(o.n))
    }
    if o.f != 3.14159 {
        fails("f")
    }
    if !o.b || o.s != "hello" || o.y != 255 {
        fails("bool/str/byte")
    }
    // nested inline struct
    if o.inner.v != 42 {
        fails("inner " + itoa(o.inner.v))
    }
    // own-pointer field minted through alloc_field
    if o.p == nil || o.p.v != 77 {
        fails("own field")
    }
    // slices
    if len(o.xs) != 3 || o.xs[0] != -1 || o.xs[1] != 0 || o.xs[2] != 70000 {
        fails("xs")
    }
    if len(o.bs) != 3 || o.bs[0] != 0 || o.bs[1] != 200 || o.bs[2] != 55 {
        fails("bs")
    }
    // []own T — element minted, nil preserved
    if len(o.ox) != 2 {
        fails("ox len")
    }
    if o.ox[0] == nil || o.ox[0].v != 88 {
        fails("ox[0]")
    }
    if o.ox[1] != nil {
        fails("ox[1] nil")
    }
    // enum: tag + named payload slots
    if o.e.kind() != 1 {
        fails("enum tag")
    }
    eb := o.e as E.B
    if eb.x != 4 || eb.s != "hi" {
        fails("enum payload")
    }
    // skip-zero: an all-zero struct emits no field records past the
    // preamble — decode a zero message into a pre-set target and the
    // zero fields stay zero-valued via absence (o2 is fresh here, so
    // the assertion is structural: re-decode must produce zero fields)
    z := szero()
    [zb, ze] = gob.marshal(z)
    want_ok(ze, "marshal zero")
    o2 := new(S)
    e2 := gob.unmarshal(zb, o2)
    want_ok(e2, "unmarshal zero")
    if o2.n != 0 || o2.p != nil || len(o2.xs) != 0 || o2.e.kind() != 0 {
        fails("zero round-trip")
    }
    // a mostly-zero struct: only n set — the wire carries just its
    // delta, and decode must not need the other fields
    m := szero()
    m.n = 9
    m.p = new(Inner)
    m.p.v = 77
    [mb, me2] = gob.marshal(m)
    want_ok(me2, "marshal sparse")
    om := new(S)
    e3 := gob.unmarshal(mb, om)
    want_ok(e3, "unmarshal sparse")
    if om.n != 9 || om.p == nil || om.p.v != 77 || om.s != "" {
        fails("sparse round-trip")
    }
    // a non-nil own whose pointee is all-zero still round-trips as
    // present — nil-ness is what absence means, not zero-ness
    zown := szero()
    zown.p = new(Inner)
    [zz, ze2] = gob.marshal(zown)
    want_ok(ze2, "marshal zero own")
    oz := new(S)
    ezown := gob.unmarshal(zz, oz)
    want_ok(ezown, "unmarshal zero own")
    if oz.p == nil || oz.p.v != 0 {
        fails("non-nil own zero pointee lost")
    }
    // positional + unit variants
    u := szero()
    u.e = E.A(7)
    [ub, ue2] = gob.marshal(u)
    want_ok(ue2, "marshal enum A")
    ou := new(S)
    e4 := gob.unmarshal(ub, ou)
    want_ok(e4, "unmarshal enum A")
    ua := ou.e as E.A
    if ua.f0 != 7 {
        fails("enum positional payload")
    }
    c0 := szero()
    c0.e = E.C
    [cb, ce] = gob.marshal(c0)
    want_ok(ce, "marshal enum C")
    oc := new(S)
    e5 := gob.unmarshal(cb, oc)
    want_ok(e5, "unmarshal enum C")
    // enum root
    [rb, re] = gob.marshal(E.B{x: 1, s: "r"})
    want_ok(re, "marshal enum root")
    er := new(E.C)
    e6 := gob.unmarshal(rb, er)
    want_ok(e6, "unmarshal enum root")
    erb := er as E.B
    if erb.x != 1 || erb.s != "r" {
        fails("enum root payload")
    }
    // missing-field tolerance: Wide -> Narrow drops b/deep; -> Extra
    // leaves d zero; -> Shuf matches by name across decl order
    w := Wide{a: 1, b: "bee", c: 3, deep: Inner{v: 5}}
    [wb, we] = gob.marshal(w)
    want_ok(we, "marshal wide")
    nw := new(Narrow)
    e7 := gob.unmarshal(wb, nw)
    want_ok(e7, "unmarshal narrow")
    if nw.a != 1 || nw.c != 3 {
        fails("narrow " + itoa(nw.a) + "/" + itoa(nw.c))
    }
    ex := new(Extra)
    e8 := gob.unmarshal(wb, ex)
    want_ok(e8, "unmarshal extra")
    if ex.a != 1 || ex.b != "bee" || ex.c != 3 || ex.deep.v != 5 || ex.d != 0 {
        fails("extra")
    }
    sh := new(Shuf)
    e9 := gob.unmarshal(wb, sh)
    want_ok(e9, "unmarshal shuf")
    if sh.a != 1 || sh.b != "bee" || sh.c != 3 || sh.deep.v != 5 {
        fails("shuf")
    }
    // tags: dropped fields never reach the wire, renames match by the
    // override spelling
    tg := Tagged{keep: 1, drop: 99, ren: "rn"}
    [tb, te2] = gob.marshal(tg)
    want_ok(te2, "marshal tagged")
    t2 := new(Tagged)
    e10 := gob.unmarshal(tb, t2)
    want_ok(e10, "unmarshal tagged")
    if t2.keep != 1 || t2.drop != 0 || t2.ren != "rn" {
        fails("tagged round-trip")
    }
    rn := new(Renamed)
    e11 := gob.unmarshal(tb, rn)
    want_ok(e11, "unmarshal renamed")
    if rn.wire != "rn" {
        fails("gob: rename")
    }
    // truncated input and a wrong-kind root both report, never panic
    if len(bs) > 4 {
        e12 := gob.unmarshal(bs[0:4], o)
        want_err(e12, g_malformed(), "truncated")
    }
    want_err(gob.unmarshal(wb, new(0)), g_type(), "wrong-kind root")
    // --- own-presence in nested containers: a non-nil `own` slot
    // whose pointee reads all-zero is PRESENT, never zero — one
    // level down from the zown case.
    // own-to-zero-struct nested inside an inline struct field.
    wr := Wrap{w: Box{p: new(Inner)}}
    [wrb, wrme] = gob.marshal(wr)
    want_ok(wrme, "marshal wrap")
    owr := new(Wrap)
    wrue := gob.unmarshal(wrb, owr)
    want_ok(wrue, "unmarshal wrap")
    if owr.w.p == nil || owr.w.p.v != 0 {
        fails("nested own pointee lost")
    }
    // `own` payload slots on variant 0 and on a non-0 variant ride
    // the wire even with all-zero pointees. Decode can't mint an
    // `own` payload slot on a nil local slot — the documented
    // err_unsupported limit — so a fresh target reports while a
    // pre-minted slot fills in place and keeps its pointee.
    oea := OE.A(new(Inner))
    [oab, oame] = gob.marshal(oea)
    want_ok(oame, "marshal OE.A own")
    want_err(gob.unmarshal(oab, new(OE.A(nil))), g_unsupported(), "OE.A own payload fresh")
    oap := new(OE.A(new(Inner)))
    oaue := gob.unmarshal(oab, oap)
    want_ok(oaue, "unmarshal OE.A pre-minted")
    oav := oap as OE.A
    if oav.f0 == nil || oav.f0.v != 0 {
        fails("OE.A own payload lost")
    }
    oeb := OE.B{p: new(Inner), n: 0}
    [obb, obme] = gob.marshal(oeb)
    want_ok(obme, "marshal OE.B own")
    want_err(gob.unmarshal(obb, new(OE.A(nil))), g_unsupported(), "OE.B own payload fresh")
    obp := new(OE.B{p: new(Inner), n: 0})
    obue := gob.unmarshal(obb, obp)
    want_ok(obue, "unmarshal OE.B pre-minted")
    obv := obp as OE.B
    if obv.p == nil || obv.p.v != 0 {
        fails("OE.B own payload lost")
    }
    // an enum FIELD at tag 0 with a non-nil `own` payload slot is
    // present even when the pointee is all-zero — the nested iszero
    // judges the slot, not just the pointee.
    hoe := HasOE{e: OE.A(new(Inner)), k: 0}
    [hob, home] = gob.marshal(hoe)
    want_ok(home, "marshal HasOE")
    want_err(gob.unmarshal(hob, new(HasOE)), g_unsupported(), "HasOE own payload fresh")
    hop := new(HasOE{e: OE.A(new(Inner)), k: 0})
    houe := gob.unmarshal(hob, hop)
    want_ok(houe, "unmarshal HasOE pre-minted")
    hov := hop.e as OE.A
    if hov.f0 == nil {
        fails("HasOE enum payload lost")
    }
    // []own byte rides the presence-coded element lane — nils
    // survive and decode re-mints through alloc_elem.
    by := Bytes{bs: mkslice(own byte, 0)}
    by.bs = push(by.bs, new(9 as byte))
    by.bs = push(by.bs, nil)
    by.bs = push(by.bs, new(250 as byte))
    [byb, byme] = gob.marshal(by)
    want_ok(byme, "marshal []own byte")
    oby := new(Bytes)
    byue := gob.unmarshal(byb, oby)
    want_ok(byue, "unmarshal []own byte")
    if len(oby.bs) != 3 || oby.bs[0] == nil || oby.bs[1] != nil || oby.bs[2] == nil {
        fails("[]own byte presence")
    }
    [byb2, byre] = gob.marshal(oby)
    want_ok(byre, "remarshal []own byte")
    if len(byb2) != len(byb) {
        fails("[]own byte remarshal len")
    }
    bi := 0
    for bi < len(byb) {
        if byb2[bi] != byb[bi] {
            fails("[]own byte remarshal bytes")
        }
        bi = bi + 1
    }
    // --- malformed wire shapes report, never panic: scalar range
    // checks, negative deltas, out-of-bounds tids and tags, and
    // giant field/type counts that must hit end-of-input.
    badb := sc_wire()
    badb = w1(badb, 1)
    badb = w1(badb, 2)
    badb = w1(badb, 0)
    want_err(gob.unmarshal(badb, new(Sc)), g_malformed(), "bool slot 2")
    bady := sc_wire()
    bady = w1(bady, 2)
    bady = w1(bady, 253)
    bady = w1(bady, 1)
    bady = w1(bady, 44)
    bady = w1(bady, 0)
    want_err(gob.unmarshal(bady, new(Sc)), g_malformed(), "byte slot 300")
    // a negative field delta — the 9-byte uvarint carrying -1
    neg := sc_wire()
    neg = w1(neg, 247)
    nj := 0
    for nj < 8 {
        neg = w1(neg, 255)
        nj = nj + 1
    }
    want_err(gob.unmarshal(neg, new(Sc)), g_malformed(), "negative delta")
    // a struct slot tid past the preamble record count — an
    // unmatched name hits the check through dskip
    oob := mkslice(byte, 0)
    oob = w1(oob, 1)
    oob = w1(oob, 2)
    oob = w1(oob, 83)
    oob = w1(oob, 99)
    oob = w1(oob, 7)
    oob = w1(oob, 1)
    oob = w1(oob, 1)
    oob = w1(oob, 122)
    oob = w1(oob, 7)
    oob = w1(oob, 0)
    oob = w1(oob, 7)
    oob = w1(oob, 1)
    want_err(gob.unmarshal(oob, new(Sc)), g_malformed(), "oob tid")
    // giant nf/nt counts — the record loops hit end-of-input rather
    // than looping on a fabricated length
    gnf := mkslice(byte, 0)
    gnf = w1(gnf, 1)
    gnf = w1(gnf, 2)
    gnf = w1(gnf, 83)
    gnf = w1(gnf, 99)
    gnf = w1(gnf, 7)
    gnf = w1(gnf, 253)
    gnf = w1(gnf, 255)
    gnf = w1(gnf, 255)
    want_err(gob.unmarshal(gnf, new(Sc)), g_malformed(), "giant nf")
    gnt := mkslice(byte, 0)
    gnt = w1(gnt, 253)
    gnt = w1(gnt, 255)
    gnt = w1(gnt, 255)
    want_err(gob.unmarshal(gnt, new(Sc)), g_malformed(), "giant nt")
    // an enum tag past the wire variant list
    oet := mkslice(byte, 0)
    oet = w1(oet, 1)
    oet = w1(oet, 1)
    oet = w1(oet, 69)
    oet = w1(oet, 13)
    oet = w1(oet, 1)
    oet = w1(oet, 1)
    oet = w1(oet, 65)
    oet = w1(oet, 0)
    oet = w1(oet, 5)
    want_err(gob.unmarshal(oet, new(E.C)), g_malformed(), "oob enum tag")
    println("enc_gob ok")
}
