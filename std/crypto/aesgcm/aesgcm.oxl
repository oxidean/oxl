package aesgcm

// std/crypto/aesgcm — AES-GCM AEAD per NIST SP 800-38D. GHASH runs
// over GF(2^128) held in i64 hi/lo halves: the language has no u128
// and no shifts, so each half is a full two's-complement int64 —
// bitwise ops are bit-exact across the sign bit and the carries are
// handled explicitly (lsr1 for logical >>1, MIN64 to set bit 63).
// seal returns ct||tag; open authenticates before decrypting and
// yields no plaintext on a tag mismatch.
import "std/crypto/aes"

import "std/encoding/binary"

import "std/errors"

import "std/slices"

let M63: int = 9223372036854775807

let M62: int = 4611686018427387904

// 0x8000000000000000 — bit 63 set, written as an expression because
// the positive literal would not fit an int64
let MIN64: int = 0 - 9223372036854775807 - 1

// 0xE100000000000000 — the GF(2^128) reduction polynomial R, again
// a two's-complement literal of the top word
let GCMR: int = 0 - 2233785415175766016

// Hl is one 128-bit value as i64 hi/lo halves — multi-return is
// [T, err] only, so the halves ride a struct.
struct Hl { h: int, l: int }

// lsr1 is the logical right shift by one over a two's-complement
// i64 — plain / is arithmetic, so a set bit 63 is reinstated at
// bit 62 after masking it away.
fn lsr1(x: int) -> int {
    if x < 0 {
        return (x & M63) / 2 + M62
    }
    return x / 2
}

// gmul returns X·Y in GF(2^128) as hi/lo halves — SP 800-38D §6.3
// Algorithm 1, iterating X's bits MSB first.
fn gmul(xh: int, xl: int, yh: int, yl: int) -> Hl {
    p2()
    zh := 0
    zl := 0
    vh := yh
    vl := yl
    i := 0
    for i < 128 {
        on := 0
        if i == 0 {
            if xh < 0 {
                on = 1
            }
        } else if i < 64 {
            if (xh & P2[i]) != 0 {
                on = 1
            }
        } else if i == 64 {
            if xl < 0 {
                on = 1
            }
        } else if (xl & P2[i - 64]) != 0 {
            on = 1
        }
        if on == 1 {
            zh = zh ^ vh
            zl = zl ^ vl
        }
        lsb := vl & 1
        vl = lsr1(vl)
        if (vh & 1) == 1 {
            vl = vl ^ MIN64
        }
        vh = lsr1(vh)
        if lsb == 1 {
            vh = vh ^ GCMR
        }
        i = i + 1
    }
    return Hl{h: zh, l: zl}
}

// P2[i] = 2^(63-i) — the bit mask for "bit i counting MSB-first"
// within one 64-bit half. P2[0] is unused (bit 63 is the sign test).
let P2: own []int = nil

fn p2() -> own []int {
    if P2 == nil {
        t := mkslice(int, 64)
        t[0] = 0
        v := M62
        i := 1
        for i < 64 {
            t[i] = v
            v = v / 2
            i = i + 1
        }
        P2 = slices.clone(t)
    }
    return P2
}

// blk loads a 16-byte big-endian block as hi/lo i64 halves — be_u64
// already yields the two's-complement pattern for set top bits.
fn blk_hi(b: []byte, off: int) -> int {
    return binary.be_u64(b, off)
}

fn blk_lo(b: []byte, off: int) -> int {
    return binary.be_u64(b, off + 8)
}

// ghash_fold runs one 16-byte block into the running hash state.
fn ghash_fold(yh: []int, yl: []int, hh: int, hl: int, b: []byte, off: int) {
    xh := yh[0] ^ blk_hi(b, off)
    xl := yl[0] ^ blk_lo(b, off)
    z := gmul(xh, xl, hh, hl)
    yh[0] = z.h
    yl[0] = z.l
}

// ghash_padded GHASHes data with a zero pad to the 16-byte boundary
// (SP 800-38D's len(A)||0^v padding), starting from the given state.
fn ghash_padded(yh: []int, yl: []int, hh: int, hl: int, data: []byte) {
    off := 0
    for off + 16 <= len(data) {
        ghash_fold(yh, yl, hh, hl, data, off)
        off = off + 16
    }
    if off < len(data) {
        pad := mkslice(byte, 16)
        i := off
        for i < len(data) {
            pad[i - off] = data[i]
            i = i + 1
        }
        ghash_fold(yh, yl, hh, hl, pad, 0)
    }
}

// ghash computes the full SP 800-38D §6.4 hash: GHASH_H(A || 0^v ||
// C || 0^u || [len(A)]64 || [len(C)]64) as hi/lo halves.
fn ghash(hh: int, hl: int, aad: []byte, ct: []byte) -> Hl {
    yh := mkslice(int, 1)
    yl := mkslice(int, 1)
    yh[0] = 0
    yl[0] = 0
    ghash_padded(yh, yl, hh, hl, aad)
    ghash_padded(yh, yl, hh, hl, ct)
    lens := mkslice(byte, 16)
    binary.put_be_u64(lens, 0, len(aad) * 8)
    binary.put_be_u64(lens, 8, len(ct) * 8)
    ghash_fold(yh, yl, hh, hl, lens, 0)
    return Hl{h: yh[0], l: yl[0]}
}

// inc32 bumps the rightmost 32 bits of a counter block, mod 2^32 —
// SP 800-38D §6.2's inc_32.
fn inc32(ctr: []byte) {
    i := 15
    for i >= 12 {
        // test the int value before byte-store wraps — storing first
        // would read back 0 and drop the carry at every 256-block
        v := ctr[i] + 1
        ctr[i] = v % 256
        if v < 256 {
            return
        }
        i = i - 1
    }
}

// gctr applies GCTR over whole blocks plus a partial tail: out =
// in ^ AES_K(inc32(icb)) | AES_K(inc32^2(icb)) | … — SP 800-38D
// §6.5 counts from inc32 of the supplied counter block, so the tag
// mask E_K(J0) does not come through here (it is J0 un-incremented).
fn gctr(a: aes.Aes, icb: []byte, in: []byte, out: []byte) {
    ctr := slices.clone(icb)
    inc32(ctr)
    ks := mkslice(byte, 16)
    off := 0
    for off + 16 <= len(in) {
        a.encrypt_block(ks, ctr)
        i := 0
        for i < 16 {
            out[off + i] = in[off + i] ^ ks[i]
            i = i + 1
        }
        inc32(ctr)
        off = off + 16
    }
    if off < len(in) {
        a.encrypt_block(ks, ctr)
        i := off
        for i < len(in) {
            out[i] = in[i] ^ ks[i - off]
            i = i + 1
        }
    }
}

// j0 derives the pre-counter block — the 96-bit-iv fast path or the
// GHASH fallback for other lengths (SP 800-38D §7.1).
fn j0(a: aes.Aes, hh: int, hl: int, iv: []byte) -> own []byte {
    out := mkslice(byte, 16)
    if len(iv) == 12 {
        i := 0
        for i < 12 {
            out[i] = iv[i]
            i = i + 1
        }
        out[15] = 1
        return slices.clone(out)
    }
    yh := mkslice(int, 1)
    yl := mkslice(int, 1)
    yh[0] = 0
    yl[0] = 0
    ghash_padded(yh, yl, hh, hl, iv)
    lens := mkslice(byte, 16)
    binary.put_be_u64(lens, 0, 0)
    binary.put_be_u64(lens, 8, len(iv) * 8)
    ghash_fold(yh, yl, hh, hl, lens, 0)
    binary.put_be_u64(out, 0, yh[0])
    binary.put_be_u64(out, 8, yl[0])
    return slices.clone(out)
}

// hkey computes H = E_K(0^128) as hi/lo halves.
fn hkey(a: aes.Aes) -> Hl {
    z := mkslice(byte, 16)
    h := mkslice(byte, 16)
    a.encrypt_block(h, z)
    return Hl{h: binary.be_u64(h, 0), l: binary.be_u64(h, 8)}
}

/// seal encrypts pt and returns ct||tag (16-byte tag appended).
/// key is 16/24/32 bytes; iv is arbitrary length (12 recommended).
fn seal(key: []byte, iv: []byte, aad: []byte, pt: []byte) -> [own []byte, err] {
    [a, e] = aes.new(key)
    if e != nil {
        return nil, e
    }
    hk := hkey(a)
    j := j0(a, hk.h, hk.l, iv)
    ct := mkslice(byte, len(pt))
    gctr(a, j, pt, ct)
    gs := ghash(hk.h, hk.l, aad, ct)
    s := mkslice(byte, 16)
    binary.put_be_u64(s, 0, gs.h)
    binary.put_be_u64(s, 8, gs.l)
    mask := mkslice(byte, 16)
    a.encrypt_block(mask, j)
    out := mkslice(byte, len(pt) + 16)
    i := 0
    for i < len(pt) {
        out[i] = ct[i]
        i = i + 1
    }
    i = 0
    for i < 16 {
        out[len(pt) + i] = s[i] ^ mask[i]
        i = i + 1
    }
    return slices.clone(out), nil
}

/// open verifies ct||tag's tag and returns the plaintext. A short
/// input or a tag mismatch is an err — no plaintext escapes either
/// way.
fn open(key: []byte, iv: []byte, aad: []byte, ct: []byte) -> [own []byte, err] {
    if len(ct) < 16 {
        return nil, errors.new("aesgcm: ciphertext shorter than tag")
    }
    [a, e] = aes.new(key)
    if e != nil {
        return nil, e
    }
    n := len(ct) - 16
    hk := hkey(a)
    j := j0(a, hk.h, hk.l, iv)
    gs := ghash(hk.h, hk.l, aad, ct[:n])
    s := mkslice(byte, 16)
    binary.put_be_u64(s, 0, gs.h)
    binary.put_be_u64(s, 8, gs.l)
    mask := mkslice(byte, 16)
    a.encrypt_block(mask, j)
    // accumulate the difference across all 16 bytes — no early exit,
    // the compare cost doesn't depend on where a forgery diverges
    diff := 0
    i := 0
    for i < 16 {
        diff = diff | ct[n + i] ^ s[i] ^ mask[i]
        i = i + 1
    }
    if diff != 0 {
        return nil, errors.new("aesgcm: tag mismatch")
    }
    pt := mkslice(byte, n)
    gctr(a, j, ct[:n], pt)
    return slices.clone(pt), nil
}
