package main

import "std/bytes"

import "std/io"

fn leak() -> int {
    a := bytes.newbuffer()
    [wa, wea] = a.write("a" as []byte)
    r := a.asreader()
    q := a.asreader()
    if true {
        b := bytes.newbuffer()
        [wb, web] = b.write("b" as []byte)
        i := 0
        for i < 2 {
            r = q
            q = b.asreader()
            i = i + 1
        }
        q = a.asreader()
    }
    bb := mkslice(byte, 8)
    [n, err] = r.read(bb)
    return n
}

fn main() {}
