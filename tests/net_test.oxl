package main

// S4 acceptance, socket-free half: dotted-literal short-circuit and
// the pre-socket port validation — every path here resolves without
// a socket/lookup extern, so the js lane (where those natives trap)
// exercises real coverage. Socket-dependent tests live in
// net_sock_test.oxl.
import "std/net"

import "std/testing"

import "std/errors"

fn ck(e: err, m: str) {
    testing.expect(e == nil, m + ": " + errors.msg(e))
}

fn test_badport() {
    // port validation precedes any socket extern — this err is
    // reachable in the js lane where socket natives trap
    [c, e] = net.dial_timeout("127.0.0.1", 70000, 500)
    testing.expect(e != nil, "port >65535 gives err")
    [c2, e2] = net.dial("127.0.0.1", 0)
    testing.expect(e2 != nil, "port 0 gives err")
}

fn test_lookup() {
    // e6 #29 — dotted literals short-circuit the resolver entirely,
    // so these paths never touch the lookup extern (the js lane runs
    // this file; resolver+socket coverage lives in net_sock_test)
    [ip, e] = net.lookup_ipv4("127.0.0.1", 2000)
    testing.expect(e == nil && ip == 2130706433, "dotted literal short-circuits")
    [ip2, e2] = net.lookup_ipv4("0.0.0.0", 2000)
    testing.expect(e2 == nil && ip2 == 0, "zero literal")
    [ip3, e3] = net.lookup_ipv4("1.2.3.4", 2000)
    testing.expect(e3 == nil && ip3 == 16909060, "dotted quad value")
}

fn main() {
    exit(0)
}
