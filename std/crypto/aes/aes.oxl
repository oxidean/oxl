let RCON: own []int = nil

// key-schedule round constants rcon[i] for i in 1..14 — index 0 is
// a padding zero so the table is subscripted directly by i/Nk
fn rcon() -> own []int {
    if RCON == nil {
        t := mkslice(int, 15)
        t[0] = 0
        t[1] = 1
        t[2] = 2
        t[3] = 4
        t[4] = 8
        t[5] = 16
        t[6] = 32
        t[7] = 64
        t[8] = 128
        t[9] = 27
        t[10] = 54
        t[11] = 108
        t[12] = 216
        t[13] = 171
        t[14] = 77
        RCON = slices.clone(t)
    }
    return RCON
}

// xtime is the GF(2^8) doubling map x -> 02·x used by MixColumns
// and the key schedule's implicit field work
fn xtime(x: int) -> int {
    y := x * 2
    if y >= 256 {
        y = y ^ 283
    }
    return y
}

// subword applies the sbox to all four bytes of a word; a word's
// byte 0 is its most significant byte (FIPS-197 §5.2 convention)
fn subword(sb: []int, w: int) -> int {
    return sb[w / 16777216] * 16777216 | sb[w / 65536 % 256] * 65536 | sb[w / 256 % 256] * 256 | sb[w % 256]
}

// rotword is the cyclic byte rotation [a0,a1,a2,a3] -> [a1,a2,a3,a0]
fn rotword(w: int) -> int {
    return (w & M24) * 256 | w / 16777216
}

/// new expands a 16/24/32-byte key into an Aes context.
fn new(key: []byte) -> [Aes, err] {
    nk := len(key) / 4
    if nk != 4 && nk != 6 && nk != 8 {
        return Aes{rk: nil, nr: 0}, errors.new("aes: key must be 16, 24, or 32 bytes")
    }
    nr := nk + 6
    nw := 4 * (nr + 1)
    sb := sbox()
    rc := rcon()
    w := mkslice(int, nw)
    i := 0
    for i < nk {
        w[i] = key[4 * i] * 16777216 | key[4 * i + 1] * 65536 | key[4 * i + 2] * 256 | key[4 * i + 3]
        i = i + 1
    }
    for i < nw {
        temp := w[i - 1]
        if i % nk == 0 {
            temp = subword(sb, rotword(temp)) ^ rc[i / nk] * 16777216
        } else if nk == 8 && i % nk == 4 {
            temp = subword(sb, temp)
        }
        w[i] = w[i - nk] ^ temp & M32
        i = i + 1
    }
    // unpack to bytes — the round loop xors a flat 16-byte state
    rk := mkslice(int, 16 * (nr + 1))
    i = 0
    for i < nw {
        rk[4 * i] = w[i] / 16777216
        rk[4 * i + 1] = w[i] / 65536 % 256
        rk[4 * i + 2] = w[i] / 256 % 256
        rk[4 * i + 3] = w[i] % 256
        i = i + 1
    }
    // heap-backed: Aes escapes into callers' structs (aesgcm keeps it
    // across seal/open calls) — an arena slice would dangle.
    return Aes{rk: slices.clone(rk), nr: nr}, nil
}

fn need(b: []byte, n: int) {
    if len(b) < n {
        assert(false)
    }
}

// mixcolumns runs the fixed matrix over one 4-byte column in place
fn mixcol(s: []int, c: int) {
    a0 := s[c]
    a1 := s[c + 1]
    a2 := s[c + 2]
    a3 := s[c + 3]
    x0 := xtime(a0)
    x1 := xtime(a1)
    x2 := xtime(a2)
    x3 := xtime(a3)
    s[c] = x0 ^ x1 ^ a1 ^ a2 ^ a3
    s[c + 1] = a0 ^ x1 ^ x2 ^ a2 ^ a3
    s[c + 2] = a0 ^ a1 ^ x2 ^ x3 ^ a3
    s[c + 3] = x0 ^ a0 ^ a1 ^ a2 ^ x3
}

/// encrypt_block writes the 16-byte encryption of src[0:16] to
/// dst[0:16] — AES has no decrypt path here (see package doc).
/// Aliased dst == src is not supported; aesgcm never aliases.
fn (a ref Aes) encrypt_block(dst: []byte, src: []byte) {
    need(dst, 16)
    need(src, 16)
    sb := sbox()
    s := mkslice(int, 16)
    i := 0
    for i < 16 {
        s[i] = src[i] ^ a.rk[i]
        i = i + 1
    }
    r := 1
    for r < a.nr {
        ko := 16 * r
        i = 0
        for i < 16 {
            s[i] = sb[s[i]]
            i = i + 1
        }
        // ShiftRows: s[4*col+row] -> s[4*((col+row)%4)+row]; the
        // write set is a permutation so staging is per-row.
        r1 := s[1]
        s[1] = s[5]
        s[5] = s[9]
        s[9] = s[13]
        s[13] = r1
        r2 := s[2]
        r6 := s[6]
        s[2] = s[10]
        s[6] = s[14]
        s[10] = r2
        s[14] = r6
        r3 := s[3]
        s[3] = s[15]
        s[15] = s[11]
        s[11] = s[7]
        s[7] = r3
        mixcol(s, 0)
        mixcol(s, 4)
        mixcol(s, 8)
        mixcol(s, 12)
        i = 0
        for i < 16 {
            s[i] = s[i] ^ a.rk[ko + i]
            i = i + 1
        }
        r = r + 1
    }
    ko := 16 * a.nr
    i = 0
    for i < 16 {
        s[i] = sb[s[i]]
        i = i + 1
    }
    r1 := s[1]
    s[1] = s[5]
    s[5] = s[9]
    s[9] = s[13]
    s[13] = r1
    r2 := s[2]
    r6 := s[6]
    s[2] = s[10]
    s[6] = s[14]
    s[10] = r2
    s[14] = r6
    r3 := s[3]
    s[3] = s[15]
    s[15] = s[11]
    s[11] = s[7]
    s[7] = r3
    i = 0
    for i < 16 {
        dst[i] = s[i] ^ a.rk[ko + i]
        i = i + 1
    }
}
