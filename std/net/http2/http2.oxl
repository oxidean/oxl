struct Header { name: str, value: str }

struct Decoder {
    dynamic: []Header,
    dynamic_size: int,
    limit: int,
    max_size: int,
    max_header_list: int,
}

fn new_decoder(max_table_size: int, max_header_list: int) -> [own Decoder, err] {
    if max_table_size < 0 || max_table_size > 1048576 || max_header_list <= 0 || max_header_list > 1048576 {
        return new(Decoder{dynamic: mkslice(Header, 0), dynamic_size: 0, limit: 0, max_size: 0, max_header_list: 0}), errors.new("http2: invalid HPACK decoder limits")
    }
    return new(Decoder{dynamic: mkslice(Header, 0), dynamic_size: 0, limit: max_table_size, max_size: max_table_size, max_header_list: max_header_list}), nil
}

struct HpackInt { value: int, next: int }

fn hpack_pow2(n: int) -> int {
    out := 1
    for n > 0 {
        out = out * 2
        n = n - 1
    }
    return out
}

struct HpackString { value: str, next: int }

struct HpackHuffman { left: []int, right: []int, symbol: []int, size: int }

