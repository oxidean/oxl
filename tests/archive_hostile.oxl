package main

import "std/io"

import "std/compress/flate"

import "std/compress/zlib"

import "std/compress/gzip"

import "std/archive/tar"

import "std/archive/zip"

import "std/encoding/hex"

import "std/bytes"

import "std/errors"

import "std/testing"

fn ck(e: err, m: str) {
    testing.expect(e == nil, m + ": " + errors.msg(e))
}

fn hx(s: str) -> own []byte {
    [b, e] = hex.decode(s)
    ck(e, "hex")
    return b
}

fn errchk(e: err, m: str) {
    testing.expect(e != nil && e != io.eof(), "expected error: " + m + " got nil/eof")
}

struct slicereader { b: []byte, i: int }

fn (s mut slicereader) read(b: []byte) -> [int, err] {
    if s.i >= len(s.b) {
        return 0, io.eof()
    }
    n := len(s.b) - s.i
    if n > len(b) {
        n = len(b)
    }
    j := 0
    for j < n {
        b[j] = s.b[s.i + j]
        j = j + 1
    }
    s.i = s.i + n
    return n, nil
}

fn (s mut slicereader) asreader() -> io.Reader {
    return s
}

fn bread(src: []byte) -> io.Reader {
    s := slicereader{b: src, i: 0}
    return s.asreader()
}

// NOTE: slicereader is stack-bound; use bytes.Buffer instead
fn rb(src: []byte) -> io.Reader {
    b := bytes.newbuffer()
    [_n, _e] = b.write(src)
    return b.asreader()
}

fn tread(src: []byte) -> tar.Reader {
    return tar.newreader(rb(src))
}

fn test_dist_oob() {
    [_o, e] = flate.inflate(hx("4b044200"))
    errchk(e, "dist oob")
    testing.expect_streq(errors.msg(e), "flate: corrupt input: distance too far back", "dist msg")
}

fn test_overlap_ok() {
    [o, e] = flate.inflate(hx("4b040200"))
    ck(e, "overlap")
    testing.expect_streq(o as str, "aaaa", "overlap copies in order")
}

fn test_btype3() {
    [_o, e] = flate.inflate(hx("07"))
    errchk(e, "btype3")
}

fn test_oversub() {
    [_o, e] = flate.inflate(hx("05e0ffffffffffffff03"))
    errchk(e, "oversubscribed cl code")
}

fn test_stored_badlen() {
    [_o, e] = flate.inflate(hx("01050000007878787878"))
    errchk(e, "stored len mismatch")
}

fn test_rep_noprev() {
    [_o, e] = flate.inflate(hx("05e00304000000000004"))
    errchk(e, "repeat with no previous")
}

fn test_random() {
    // 128 random bytes — must terminate (err or output), never hang/trap
    [_o, _e] = flate.inflate(hx("2a43b7f77eb40625d2b950424288dfeb5d6c7c7a997626361ea7c579f83a32e221f220aa3092b609f8c6428de95a2999abee9ad307d7803f666d22130fc8bbab55fb994e31476af290848a81c8c07b4d80e2484716c649ceebd14f413b472e3db81097854c8ba4174a616b51ca1e7d7aed8a170a06a230782b64a854f404301d"))
}

fn test_gz_nonul_name() {
    [_o, e] = gzip.decompress(hx("1f8b08080000000000ff6e616d652d6e6f2d6e756c"))
    errchk(e, "unterminated FNAME")
}

fn test_gz_badhcrc() {
    [_o, e] = gzip.decompress(hx("1f8b08020000000000ffdeadcbc80400ac2a93d802000000"))
    errchk(e, "bad header crc")
    testing.expect_streq(errors.msg(e), "gzip: header crc mismatch", "hcrc msg")
}

fn test_gz_goodhcrc() {
    [o, e] = gzip.decompress(hx("1f8b08020000000000ff90c9cbc80400ac2a93d802000000"))
    ck(e, "good hcrc member")
    testing.expect_streq(o as str, "hi", "hcrc payload")
}

fn test_gz_fextra_short() {
    [_o, e] = gzip.decompress(hx("1f8b08040000000000ff60ea7878787878787878787878787878787878787878"))
    errchk(e, "fextra overruns input")
}

fn test_gz_trailgarbage() {
    [_o, e] = gzip.decompress(hx("1f8b0800000000000203cbc80400ac2a93d80200000047415242414745"))
    errchk(e, "trailing garbage after member")
}

fn test_gz_halfmember() {
    [_o, e] = gzip.decompress(hx("1f8b0800000000000203cbc80400ac2a93d8020000001f"))
    errchk(e, "half a member header")
}

fn test_zip64() {
    [_z, e] = zip.newreader(hx("504b0304140000000000b5236b5d63f3f3ad040000000400000005000000662e74787464617461504b01021403140000000000b5236b5d63f3f3ad0400000004000000050000000000000000000000800100000000662e747874504b0506000000000100ffff33000000270000000000"))
    errchk(e, "zip64 count")
    [_z2, e2] = zip.newreader(hx("504b0304140000000000b5236b5d63f3f3ad040000000400000005000000662e74787464617461504b01021403140000000000b5236b5d63f3f3ad0400000004000000050000000000000000000000800100000000662e747874504b0506000000000100010033000000ffffffff0000"))
    errchk(e2, "zip64 cdoff")
}

fn test_zip_mismatch() {
    [z, e] = zip.newreader(hx("504b0304140000000000b5236b5d63f3f3ad040000000400000005000000662e74787464617461504b01021403140000000800b5236b5d63f3f3ad0400000004000000050000000000000000000000800100000000662e747874504b0506000000000100010033000000270000000000"))
    ck(e, "mismatch archive parses")
    [_o, e2] = z.open(0)
    errchk(e2, "local/central mismatch")
    testing.expect_streq(errors.msg(e2), "zip: local/central header mismatch", "mismatch msg")
}

fn test_zip_bigcsize() {
    [z, e] = zip.newreader(hx("504b0304140000000000b5236b5d63f3f3ad040000000400000005000000662e74787464617461504b01021403140000000000b5236b5d63f3f3ad00f0ffff04000000050000000000000000000000800100000000662e747874504b0506000000000100010033000000270000000000"))
    ck(e, "big csize parses")
    [_o, e2] = z.open(0)
    errchk(e2, "csize past EOF")
}

fn test_tar_badsum() {
    tr := tread(hx(""))
    [_h, e] = tr.next()
    errchk(e, "bad checksum")
}

fn test_tar_badoctal() {
    // a non-octal digit ('9') in the checksum field — parnum must
    // reject it as an invalid octal digit
    b := hx("")
    b[148] = 57
    tr := tread(b)
    [_h, e] = tr.next()
    errchk(e, "bad octal digit")
}

fn test_zlib_keepalive() {
    [_o, _e] = zlib.decompress(hx("789ccb48cdc9c957a8cac94c0200159503e6"))
}

fn main() {}
